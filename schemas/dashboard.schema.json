{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tmux-agent-dashboard snapshot",
  "description": "JSON snapshot of all live agent sessions and fleet totals produced by snapshot.node.ts.",
  "type": "object",
  "required": ["schema_version", "at", "totals", "sessions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "at": { "type": "string" },
    "totals": {
      "type": "object",
      "required": ["running", "exited", "stopped", "total"],
      "additionalProperties": false,
      "properties": {
        "running": { "type": "integer", "minimum": 0 },
        "exited": { "type": "integer", "minimum": 0 },
        "stopped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "tool",
          "name",
          "session",
          "prefix",
          "exists",
          "running",
          "exit_detected",
          "exit_code",
          "local_or_remote",
          "diagnostic",
          "last_capture_lines",
          "confirmation_detected",
          "blocked_reason",
          "blocked_evidence",
          "started_at",
          "last_change_at",
          "idle_seconds",
          "bytes_in_pane",
          "marker_seen",
          "state",
          "wrapper",
          "agent_name",
          "tmux_session",
          "cwd",
          "result_path",
          "created_at",
          "created_epoch",
          "age_seconds",
          "age"
        ],
        "additionalProperties": false,
        "properties": {
          "schema_version": { "type": "integer", "const": 1 },
          "tool": { "type": "string" },
          "name": { "type": "string" },
          "session": { "type": "string" },
          "prefix": { "type": "string" },
          "exists": { "type": "boolean" },
          "running": { "type": "boolean" },
          "exit_detected": { "type": "boolean" },
          "exit_code": { "type": ["integer", "null"] },
          "local_or_remote": { "type": ["string", "null"] },
          "diagnostic": { "type": ["string", "null"] },
          "last_capture_lines": { "type": "array", "items": { "type": "string" } },
          "confirmation_detected": { "type": "boolean" },
          "blocked_reason": { "type": ["string", "null"] },
          "blocked_evidence": { "type": ["string", "null"] },
          "started_at": { "type": ["string", "null"] },
          "last_change_at": { "type": ["string", "null"] },
          "idle_seconds": { "type": ["integer", "null"] },
          "bytes_in_pane": { "type": ["integer", "null"] },
          "marker_seen": { "type": "array", "items": { "type": "string" } },
          "state": { "type": "string", "enum": ["running", "exited", "stopped"] },
          "wrapper": { "type": "string" },
          "agent_name": { "type": "string" },
          "tmux_session": { "type": "string" },
          "cwd": { "type": ["string", "null"] },
          "result_path": { "type": "string" },
          "created_at": { "type": ["string", "null"] },
          "created_epoch": { "type": ["integer", "null"] },
          "age_seconds": { "type": ["integer", "null"] },
          "age": { "type": ["string", "null"] }
        }
      }
    }
  }
}
