#!/usr/bin/env zsh
# agy-tmux — DEPRECATED shim over agent-tmux; use `agent-tmux agy <command>`.
# Kept working through v0.38; removal planned for v0.39.
[[ -z "${AGENT_TMUX_SUPPRESS_DEPRECATION:-}" ]] && \
  print -u2 -- "agy-tmux is deprecated; use: agent-tmux agy <command> (removal: v0.39)"
exec "${0:A:h}/agent-tmux" agy "$@"
