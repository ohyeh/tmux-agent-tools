#!/usr/bin/env zsh
# tmux-agent-commander — wake codex, agy, and cursor when a worker finishes.
# assign / tell / stop call the shared workers CLI. collect is the node
# collector: it pastes into this pane (%N). The zsh delivery loop is gone.
set -euo pipefail

SELF="${0:A}"
SCRIPT_DIR="${0:A:h}"

usage() {
  cat <<'EOF'
tmux-agent-commander — collect worker results into a non-Claude pane

Usage:
  tmux-agent-commander start <cli> <name> <dir> [--no-attach] [--no-panel]
  tmux-agent-commander assign <profile> <worker> <dir> <brief-file>
  tmux-agent-commander tell <worker> <text-file>
  tmux-agent-commander collect [<cli> <name>]
  tmux-agent-commander stop <worker>
  tmux-agent-commander status
  tmux-agent-commander panel <session> [--width N]

start launches `agent-tmux <cli> start --exact`, then a detached collector,
then attach (unless --no-attach). Unless --no-panel, it also sets a second
status line on that session that runs `panel <session>`. assign, tell and
stop run inside that pane and call the shared workers CLI. The session name
is the session id. collect runs the node collector against this pane's %N
(`$TMUX_PANE` when this shell is in that session, otherwise the session's
pane id). panel prints one line of workers whose owner is the tmux session
name.
EOF
  exit 2
}

die() {
  print -r -- "tmux-agent-commander: $*" >&2
  exit 1
}

state_root() {
  # Same resolution as agent-tmux agent_root_dir.
  print -r -- "${TMUX_AGENT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agent-tools}"
}

sanitize_owner() {
  # register.ts heartbeatOf: chars outside [A-Za-z0-9._-] become _.
  print -r -- "${1//[^A-Za-z0-9._-]/_}"
}

agent_tmux() {
  if command -v agent-tmux >/dev/null 2>&1; then
    command agent-tmux "$@"
  else
    "$SCRIPT_DIR/agent-tmux" "$@"
  fi
}

# Same rule as agent-tmux session_target: a.b is session a, pane b.
session_target() {
  printf '=%s:' "$1"
}

tmux_has() {
  command tmux has-session -t "$(session_target "$1")" 2>/dev/null
}

# Session name agent-tmux will use: <prefix>-<name>, prefix from the profile
# search (AGENT_TMUX_PROFILE_DIR, XDG config, bundled profiles) then
# <NS>_TMUX_PREFIX / AGENT_TMUX_PREFIX, then an optional tenant suffix.
session_name() {
  local cli="$1" worker_name="$2"
  local env_ns prefix file line key value env_key dir
  case "$cli" in
    claude) env_ns=CLAUDE; prefix=claude-cli ;;
    codex)  env_ns=CODEX;  prefix=codex-cli ;;
    agy)    env_ns=AGY;    prefix=agy-cli ;;
    cursor) env_ns=CURSOR; prefix=cursor-cli ;;
    grok)   env_ns=GROK;   prefix=grok-cli ;;
    *)      env_ns=AGENT;  prefix="${cli}-cli" ;;
  esac
  local -a dirs
  dirs=()
  [[ -n "${AGENT_TMUX_PROFILE_DIR:-}" ]] && dirs+=("$AGENT_TMUX_PROFILE_DIR")
  dirs+=("${XDG_CONFIG_HOME:-$HOME/.config}/agent-tmux/profiles")
  dirs+=("$SCRIPT_DIR/profiles")
  file=""
  for dir in "${dirs[@]}"; do
    [[ -n "$dir" && -f "$dir/$cli.conf" ]] && { file="$dir/$cli.conf"; break; }
  done
  if [[ -n "$file" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      line="${line#"${line%%[![:space:]]*}"}"
      [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
      key="${line%%=*}"
      value="${line#*=}"
      key="${key//[[:space:]]/}"
      value="${value#"${value%%[![:space:]]*}"}"
      value="${value%"${value##*[![:space:]]}"}"
      case "$key" in
        prefix) prefix="$value" ;;
        env_ns) env_ns="${value:u}" ;;
      esac
    done < "$file"
  fi
  env_key="${env_ns}_TMUX_PREFIX"
  if [[ -n "${(P)env_key:-}" ]]; then
    prefix="${(P)env_key}"
  elif [[ -n "${AGENT_TMUX_PREFIX:-}" ]]; then
    prefix="$AGENT_TMUX_PREFIX"
  fi
  if [[ -n "${TMUX_AGENT_TOOLS_TENANT:-}" ]]; then
    prefix="${prefix}-${TMUX_AGENT_TOOLS_TENANT}"
  fi
  print -r -- "${prefix}-${worker_name}"
}

# Map a tmux session back to (cli, name) using session_name's own prefix.
# Probe worker "X" and strip that trailing X; the rest is the prefix.
# No known cli matches → return 1.
session_cli_name() {
  local session="$1" cli full prefix name
  local -a clis=(codex agy cursor claude grok)
  for cli in "${clis[@]}"; do
    full="$(session_name "$cli" X)"
    [[ "$full" == *X ]] || continue
    prefix="${full%X}"
    [[ -n "$prefix" && "$session" == "${prefix}"* ]] || continue
    name="${session#"$prefix"}"
    [[ -n "$name" ]] || continue
    print -r -- "$cli"
    print -r -- "$name"
    return 0
  done
  return 1
}

pid_path() {
  print -r -- "$1/.commander-$(sanitize_owner "$2").pid"
}

pid_alive() {
  local pid="$1"
  [[ "$pid" == <-> ]] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  local file="$1" pid
  [[ -f "$file" ]] || return 1
  pid="$(<"$file")"
  pid="${pid//[[:space:]]/}"
  print -r -- "$pid"
}

# Terminal statuses the mod delivers (register.ts TERMINAL) plus the
# underscore spelling in SPEC.md. Alias words such as "done" are not
# terminal for the mod, so they are not terminal here.
is_terminal_status() {
  case "$1" in
    success|failed|blocked|needs-input|needs_input) return 0 ;;
    *) return 1 ;;
  esac
}

node_bin() {
  local n="${TMUX_AGENT_NODE:-}"
  if [[ -z "$n" ]]; then
    n="$(command -v node 2>/dev/null || true)"
  fi
  [[ -n "$n" && -x "$n" ]] || die "node not found"
  print -r -- "$n"
}

# Shared workers CLI. stdout is the CLI's; stderr passes through. Status is the CLI's.
core_cli() {
  local node
  node="$(node_bin)"
  NODE_NO_WARNINGS=1 "$node" --experimental-strip-types "$SCRIPT_DIR/lib/workers.cli.node.ts" "$@"
}

# Exact pane id. Inside the host session, $TMUX_PANE. A server-started collector
# has no $TMUX (start clears it), so the session's current pane id is the same %N.
host_pane() {
  local session="$1" here
  if [[ -n "${TMUX_PANE:-}" && "${TMUX_PANE}" == %<-> && -n "${TMUX:-}" ]]; then
    here="$(command tmux display-message -p '#S' 2>/dev/null || true)"
    if [[ -n "$here" && "$here" == "$session" ]]; then
      print -r -- "$TMUX_PANE"
      return 0
    fi
  fi
  command tmux display-message -p -t "$session" '#{pane_id}'
}

require_tmux_session() {
  local session
  [[ -n "${TMUX:-}" ]] || die "not inside tmux; run $1 from the commander's pane"
  session="$(command tmux display-message -p '#S' 2>/dev/null)" || die "not inside tmux; tmux display-message failed"
  [[ -n "$session" ]] || die "not inside tmux; tmux display-message returned no session"
  print -r -- "$session"
}

# Not a split pane: agent-tmux sends to the session's active pane, so a pane
# the user focuses would swallow the delivery. A status line is not a pane.
install_worker_panel() {
  local session="$1" fmt
  fmt="#(${(qq)SELF} panel ${(qq)session})"
  command tmux set-option -t "$(session_target "$session")" status 2
  command tmux set-option -t "$(session_target "$session")" 'status-format[1]' "$fmt"
  command tmux set-option -t "$(session_target "$session")" status-interval 2
}

cmd_start() {
  local no_attach=0 no_panel=0
  local -a pos
  pos=()
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "--no-attach" ]]; then
      no_attach=1
    elif [[ "$arg" == "--no-panel" ]]; then
      no_panel=1
    else
      pos+=("$arg")
    fi
  done
  (( ${#pos} == 3 )) || usage
  local cli="${pos[1]}" name="${pos[2]}" dir="${pos[3]}"
  [[ -n "$cli" && -n "$name" && -n "$dir" ]] || usage
  local session root pidfile pid log
  session="$(session_name "$cli" "$name")"
  root="$(state_root)"
  mkdir -p "$root"
  pidfile="$(pid_path "$root" "$session")"
  if [[ -f "$pidfile" ]]; then
    pid="$(read_pid "$pidfile" || true)"
    if pid_alive "$pid"; then
      die "collector for ${session} is already running (pid ${pid})"
    fi
  fi
  agent_tmux "$cli" start --exact "$name" "$dir"
  # The host is not a worker: it must never receive the worker scope guard or a
  # result-path instruction. Mark both delivered so no later send (the user's or
  # the collector's) prepends them — on untrusted families they re-inject forever.
  mkdir -p "$root/$name"
  : > "$root/$name/scope-guard-injected"
  : > "$root/$name/.result-path-injected"
  if (( ! no_panel )); then
    install_worker_panel "$session"
  fi
  tmux_has "$session" || die "session ${session} is not up after start"
  log="$root/.commander-$(sanitize_owner "$session").log"
  # agent-tmux drops $TMUX before new-session, so the collector must too.
  # TMUX_TMPDIR still selects the server. collect writes the pid file.
  local bgpid i claimed="" detail
  env -u TMUX nohup "$SELF" collect "$cli" "$name" >>"$log" 2>&1 &
  bgpid="$!"
  disown "$bgpid" 2>/dev/null || true
  for (( i = 0; i < 200; i++ )); do
    if [[ -f "$pidfile" ]]; then
      pid="$(read_pid "$pidfile" || true)"
      if pid_alive "$pid"; then
        claimed=1
        break
      fi
    fi
    sleep 0.05
  done
  if [[ -z "$claimed" ]]; then
    detail="no pid"
    if [[ -s "$log" ]]; then
      detail+="; $(tail -n 3 "$log" | tr '\n' ' ')"
    fi
    kill "$bgpid" 2>/dev/null || true
    die "collector for ${session} exited before it wrote a pid (${detail})"
  fi
  if (( no_attach )); then
    print -r -- "commander ${session} collector pid ${pid}"
    return 0
  fi
  agent_tmux "$cli" attach "$name"
}

cmd_assign() {
  (( $# == 4 )) || usage
  local profile="$1" worker="$2" dir="$3" brief="$4"
  local session abs_dir root down="" code=0 text
  session="$(require_tmux_session assign)"
  [[ -f "$brief" ]] || die "brief file not found: $brief"
  abs_dir="${dir:A}"
  [[ "$abs_dir" == /* ]] || die "dir must be an absolute path"
  root="$(state_root)"
  start_collector_from_server "$session" "$root"
  # The pid file lands after run-shell; a known cli session is collected.
  if ! session_cli_name "$session" >/dev/null; then
    down="no collector for ${session}: run \`tmux-agent-commander collect <cli> <name>\` from a shell outside this CLI"
  fi
  if [[ -n "$down" ]]; then
    text="$(core_cli assign "$profile" "$worker" "$abs_dir" "$brief" --session "$session" --cwd "${PWD:A}" --collector-down "$down")" || code=$?
  else
    text="$(core_cli assign "$profile" "$worker" "$abs_dir" "$brief" --session "$session" --cwd "${PWD:A}")" || code=$?
  fi
  [[ "$code" -eq 0 ]] || exit "$code"
  print -r -- "$text"
}

cmd_tell() {
  (( $# == 2 )) || usage
  local session code=0 text
  session="$(require_tmux_session tell)"
  [[ -f "$2" ]] || die "text file not found: $2"
  text="$(core_cli tell "$1" "$2" --session "$session" --cwd "${PWD:A}")" || code=$?
  [[ "$code" -eq 0 ]] || exit "$code"
  print -r -- "$text"
}

# One collector per session. A live pid that is not us exits quietly.
# We remove the file on exit only when it still names us.
cmd_collect() {
  local cli="" name="" session
  if (( $# == 2 )); then
    cli="$1"
    name="$2"
    session="$(session_name "$cli" "$name")"
  elif (( $# == 0 )); then
    session="$(require_tmux_session collect)"
  else
    usage
  fi
  local root pidfile existing pane cwd node
  root="$(state_root)"
  mkdir -p "$root"
  pidfile="$(pid_path "$root" "$session")"
  if [[ -f "$pidfile" ]]; then
    existing="$(read_pid "$pidfile" || true)"
    if pid_alive "$existing" && [[ "$existing" != "$$" ]]; then
      exit 0
    fi
  fi
  pane="$(host_pane "$session" 2>/dev/null || true)"
  [[ "$pane" == %<-> ]] || die "host pane must be a %N id, got ${pane:-nothing}"
  cwd="$(command tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)"
  [[ "$cwd" == /* ]] || die "host pane cwd is not an absolute path"
  print -r -- "$$" > "$pidfile"
  COLLECTOR_PIDFILE="$pidfile"
  trap '
    cur="$(tr -d "[:space:]" < "$COLLECTOR_PIDFILE" 2>/dev/null || true)"
    if [[ "$cur" == "$$" ]]; then
      rm -f "$COLLECTOR_PIDFILE"
    fi
  ' EXIT
  node="$(node_bin)"
  NODE_NO_WARNINGS=1 "$node" --experimental-strip-types "$SCRIPT_DIR/lib/collector.node.ts" \
    --session "$session" --cwd "$cwd" --pane "$pane"
}

# The tmux server owns this process, so a CLI shell tool cannot reap it.
start_collector_from_server() {
  local session="$1" root="$2"
  local pidfile existing mapped cli name log cmd
  pidfile="$(pid_path "$root" "$session")"
  if [[ -f "$pidfile" ]]; then
    existing="$(read_pid "$pidfile" || true)"
    if pid_alive "$existing"; then
      return 0
    fi
  fi
  if ! mapped="$(session_cli_name "$session")"; then
    print -r -- "no collector for ${session}: run \`tmux-agent-commander collect <cli> <name>\` from a shell outside this CLI" >&2
    return 0
  fi
  cli="${mapped%%$'\n'*}"
  name="${mapped#*$'\n'}"
  log="$root/.commander-$(sanitize_owner "$session").log"
  # tmux expands % and # as formats before /bin/sh sees the command.
  cmd="env -u TMUX ${(qq)SELF} collect ${(qq)cli} ${(qq)name} >> ${(qq)log} 2>&1"
  cmd="${cmd//\%/%%}"
  cmd="${cmd//\#/##}"
  command tmux run-shell -b -t "$(session_target "$session")" "$cmd"
  print -r -- "collector started for ${session}"
}

cmd_stop() {
  (( $# == 1 )) || usage
  local session code=0 text
  session="$(require_tmux_session stop)"
  text="$(core_cli stop "$1" --session "$session" --cwd "${PWD:A}")" || code=$?
  [[ "$code" -eq 0 ]] || exit "$code"
  print -r -- "$text"
}

cmd_status() {
  (( $# == 0 )) || usage
  local root pidfile owner pid alive
  root="$(state_root)"
  [[ -d "$root" ]] || return 0
  local -a pidfiles
  pidfiles=("$root"/.commander-*.pid(N))
  for pidfile in "${pidfiles[@]}"; do
    owner="${pidfile:t}"
    owner="${owner#.commander-}"
    owner="${owner%.pid}"
    pid="$(read_pid "$pidfile" || true)"
    if pid_alive "$pid"; then alive=yes; else alive=no; fi
    print -r -- "${owner} alive=${alive} pid=${pid:-none}"
  done
}

cmd_panel() {
  local session="" width="" width_set=0 arg
  while (( $# )); do
    arg="$1"
    shift
    case "$arg" in
      --width)
        (( $# )) || usage
        width="$1"
        shift
        width_set=1
        ;;
      -h|--help) usage ;;
      --*) usage ;;
      *)
        [[ -z "$session" ]] || usage
        session="$arg"
        ;;
    esac
  done
  [[ -n "$session" ]] || usage
  if (( width_set )); then
    [[ "$width" == <-> ]] || die "width must be a non-negative integer"
  else
    local tw
    tw="$(command tmux display -p '#{client_width}' 2>/dev/null || true)"
    tw="${tw//[[:space:]]/}"
    if [[ "$tw" == <-> && "$tw" -gt 0 ]]; then
      width="$tw"
    else
      width=120
    fi
  fi
  width=$(( 10#$width ))
  local node_bin="${NODE:-$(command -v node 2>/dev/null || true)}"
  [[ -n "$node_bin" && -x "$node_bin" ]] || die "node not found"
  "$node_bin" "$SCRIPT_DIR/lib/snapshot.node.ts" panel "$session" --width "$width"
}

main() {
  (( $# > 0 )) || usage
  local cmd="$1"
  shift
  case "$cmd" in
    -h|--help|help) usage ;;
    start) cmd_start "$@" ;;
    assign) cmd_assign "$@" ;;
    tell) cmd_tell "$@" ;;
    collect) cmd_collect "$@" ;;
    stop) cmd_stop "$@" ;;
    panel) cmd_panel "$@" ;;
    status) cmd_status "$@" ;;
    *) usage ;;
  esac
}

main "$@"
