#!/usr/bin/env zsh
set -euo pipefail

SELF="${0:A}"
CODEX="${CODEX:-$(command -v codex 2>/dev/null || true)}"
JQ="${JQ:-$(command -v jq 2>/dev/null || true)}"
PREFIX="${CODEX_TMUX_PREFIX:-codex-cli}"
STABLE_SECONDS="${CODEX_TMUX_STABLE_SECONDS:-3}"
SUBMIT_DELAY="${CODEX_TMUX_SUBMIT_DELAY:-0.2}"
TMUX_CONF="${CODEX_TMUX_CONF:-${TMPDIR:-/tmp}/codex-tmux.tmux.conf}"
TMUX_MOUSE="${CODEX_TMUX_MOUSE:-on}"
TMUX_CLIPBOARD="${CODEX_TMUX_CLIPBOARD:-auto}"
STATUS_TAIL_LINES="${CODEX_TMUX_STATUS_TAIL_LINES:-20}"

resolve_tmux_bin() {
  if [[ -n "${TMUX:-}" && -x "${TMUX:-}" ]]; then
    print -r -- "$TMUX"
    return
  fi
  command -v tmux 2>/dev/null || true
}

TMUX_BIN="$(resolve_tmux_bin)"
unset TMUX
TMUX="$TMUX_BIN"

usage() {
  cat <<'EOF'
codex-tmux - run Codex CLI in tmux and drive it programmatically.

Usage:
  codex-tmux start [--attach] [--exact] <name> <directory> [initial text]
  codex-tmux resume [--attach] [--exact] <name> <directory> <session-id>
  codex-tmux start-ssh [--attach] [--exact] <name> <ssh-target> <remote-directory> [initial text]
  codex-tmux attach <name>
  codex-tmux send <name> <text>
  codex-tmux send-wait-literal <name> <text> <literal> [timeout_seconds]
  codex-tmux wait <name> [timeout_seconds]
  codex-tmux wait-text [--literal] <name> <regex-or-text> [timeout_seconds]
  codex-tmux wait-literal <name> <text> [timeout_seconds]
  codex-tmux wait-and-capture --marker <text> [--literal|--regex] [--timeout <s>] [--tail <n>] [--strip-ansi] [--since-marker <text>] [--json] [--no-timeout-error] <name>
  codex-tmux capture <name> [lines]
  codex-tmux result [--field <jq>] [--wait <seconds>] [--json] <name>
  codex-tmux list
  codex-tmux status [--json] <name>
  codex-tmux doctor
  codex-tmux self-test
  codex-tmux stop <name>
  codex-tmux help

Examples:
  codex-tmux start --attach pr5 ~/github/core-parking-service
  codex-tmux resume --exact pr5 ~/github/core-parking-service 019e356f-f95d-7570-9784-ea7b58e404a5
  codex-tmux start-ssh --attach pr5 openclaw-macmini ~/github/core-parking-service
  codex-tmux start --exact pr5 ~/github/core-parking-service 'hi'
  codex-tmux attach pr5
  codex-tmux send pr5 '請先讀 PR description'
  codex-tmux send-wait-literal pr5 'Reply with the requested marker.' '[CODEX-01]' 180
  codex-tmux wait pr5 180
  codex-tmux wait-text pr5 'Done|Need approval' 180
  codex-tmux wait-text --literal pr5 '[CODEX-01]' 180
  codex-tmux wait-literal pr5 '[CODEX-01]' 180
  codex-tmux capture pr5 80
  codex-tmux doctor
  codex-tmux self-test
  codex-tmux list
  codex-tmux stop pr5

Behavior:
  - Session name is codex-cli-<name> by default.
  - start and resume append a random 6-character suffix to <name>, unless --exact is used.
  - start and resume always recreate that named tmux session.
  - start-ssh keeps tmux local, then runs Codex through ssh in the remote directory.
  - Codex is launched with --yolo.
  - wait returns when the visible pane is stable for a few seconds.
  - wait-text returns when the visible pane matches a zsh extended regex.
  - wait-text --literal returns when the visible pane contains exact text.
  - wait-literal returns when the visible pane contains exact text.
  - send-wait-literal sends text, then waits for a new occurrence of exact text.
  - capture reads the tmux pane without stealing browser or terminal focus.

Environment:
  TMUX=$(command -v tmux)
  CODEX=$(command -v codex)
  CODEX_TMUX_PREFIX=codex-cli
  CODEX_TMUX_STABLE_SECONDS=3
  CODEX_TMUX_SUBMIT_DELAY=0.2
  CODEX_TMUX_CONF=/tmp/codex-tmux.tmux.conf
  CODEX_TMUX_MOUSE=on
  CODEX_TMUX_CLIPBOARD=auto
  CODEX_TMUX_STATUS_TAIL_LINES=20
EOF
}

require_bins() {
  if [[ -z "$TMUX" || ! -x "$TMUX" ]]; then
    echo "tmux not found. Install it with Homebrew or set TMUX=/path/to/tmux." >&2
    exit 1
  fi

  if [[ -z "$CODEX" || ! -x "$CODEX" ]]; then
    local codex_lookup
    codex_lookup="$(command -v codex 2>/dev/null || true)"
    echo "codex not found at ${CODEX:-<empty>}." >&2
    if [[ -n "$codex_lookup" ]]; then
      echo "Current PATH resolves codex to: $codex_lookup" >&2
      echo "Unset CODEX or set CODEX=$codex_lookup to use that install." >&2
    else
      echo "Current PATH does not resolve codex. Install Codex CLI or set CODEX=/path/to/codex." >&2
    fi
    exit 1
  fi
}

require_tmux() {
  if [[ -z "$TMUX" || ! -x "$TMUX" ]]; then
    echo "tmux not found. Install it with Homebrew or set TMUX=/path/to/tmux." >&2
    exit 1
  fi
}

require_jq() {
  if [[ -z "$JQ" || ! -x "$JQ" ]]; then
    echo "jq not found. Install it with Homebrew or set JQ=/path/to/jq." >&2
    exit 1
  fi
}

clipboard_command() {
  if [[ "$TMUX_CLIPBOARD" == "internal" ]]; then
    return 0
  fi
  if [[ "$TMUX_CLIPBOARD" != "auto" ]]; then
    echo "$TMUX_CLIPBOARD"
    return 0
  fi

  if command -v pbcopy >/dev/null 2>&1; then
    echo "pbcopy"
  elif command -v wl-copy >/dev/null 2>&1; then
    echo "wl-copy"
  elif command -v xclip >/dev/null 2>&1; then
    echo "xclip -selection clipboard"
  elif command -v xsel >/dev/null 2>&1; then
    echo "xsel --clipboard --input"
  fi
}

tmux_conf_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf "%s" "$value"
}

clipboard_description() {
  local command
  command="$(clipboard_command)"
  if [[ -n "$command" ]]; then
    if [[ "$TMUX_CLIPBOARD" == "auto" ]]; then
      echo "auto ($command)"
    else
      echo "$command"
    fi
  elif [[ "$TMUX_CLIPBOARD" == "auto" ]]; then
    echo "auto (internal fallback)"
  else
    echo "internal"
  fi
}

write_tmux_conf() {
  cat > "$TMUX_CONF" <<'EOF'
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB"
set -as terminal-features ",tmux-256color:RGB"
set -ga terminal-overrides ",xterm-256color:Tc"
set -ga terminal-overrides ",tmux-256color:Tc"
set -g allow-passthrough on
set -s extended-keys on
set -as terminal-features ",xterm*:extkeys"
set -as terminal-features ",tmux*:extkeys"
set -as terminal-features ",xterm*:clipboard"
set -as terminal-features ",tmux*:clipboard"
set -g focus-events on
set -sg escape-time 10
set -g xterm-keys on
set -g set-clipboard on
set -g mode-keys vi
set -g status-keys vi
set-environment -g COLORTERM truecolor
set -g history-limit 50000
set -g status on
set -g status-position bottom
set -g status-interval 2
set -g status-style "bg=#111827,fg=#cbd5e1"
set -g status-left-length 64
set -g status-right-length 96
set -g status-left "#[bg=#2563eb,fg=#ffffff,bold] Codex #[bg=#111827,fg=#93c5fd] #S "
set -g status-right "#[fg=#64748b]#(pwd | sed 's#^$HOME#~#') #[fg=#22c55e]%H:%M "
set -g window-status-format "#[fg=#94a3b8] #I:#W "
set -g window-status-current-format "#[bg=#1f2937,fg=#ffffff,bold] #I:#W "
set -g pane-border-style "fg=#334155"
set -g pane-active-border-style "fg=#2563eb"
set -g message-style "bg=#1f2937,fg=#ffffff"
set -g mode-style "bg=#2563eb,fg=#ffffff"
set -g clock-mode-colour "#2563eb"
set -g display-panes-colour "#64748b"
set -g display-panes-active-colour "#22c55e"
EOF
  local copy_command
  copy_command="$(clipboard_command)"
  if [[ -n "$copy_command" ]]; then
    copy_command="$(tmux_conf_quote "$copy_command")"
    printf 'bind-key -T copy-mode-vi y send -X copy-pipe-and-cancel "%s"\n' "$copy_command" >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi Enter send -X copy-pipe-and-cancel "%s"\n' "$copy_command" >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "%s"\n' "$copy_command" >> "$TMUX_CONF"
  else
    printf 'bind-key -T copy-mode-vi y send -X copy-selection-and-cancel\n' >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi Enter send -X copy-selection-and-cancel\n' >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-selection-and-cancel\n' >> "$TMUX_CONF"
  fi
  printf 'set -g mouse "%s"\n' "$TMUX_MOUSE" >> "$TMUX_CONF"
}

session_for_name() {
  local name="$1"
  if [[ ! "$name" =~ '^[A-Za-z0-9_.-]+$' ]]; then
    echo "Invalid session name: $name" >&2
    exit 2
  fi
  echo "$PREFIX-$name"
}

random_suffix() {
  LC_ALL=C /usr/bin/od -An -N3 -tx1 /dev/urandom | /usr/bin/tr -d ' \n'
}

shell_quote() {
  printf "%q" "$1"
}

paste_and_submit() {
  local session="$1"
  local buffer_name="$2"
  local prompt_text="$3"

  printf "%s" "$prompt_text" | "$TMUX" load-buffer -b "$buffer_name" -
  "$TMUX" paste-buffer -p -d -b "$buffer_name" -t "$session"
  sleep "$SUBMIT_DELAY"
  "$TMUX" send-keys -t "$session" Enter
  if [[ "$prompt_text" == *$'\n'* ]]; then
    sleep "$SUBMIT_DELAY"
    "$TMUX" send-keys -t "$session" Enter
  fi
}

# --- Sentinel / on-exit hook helpers (shared by start/resume; issue #132) ---
# Each helper either uses globals declared in the caller (sentinel,
# on_exit_cmd, sentinel_keep, session_env_args) or returns its output via
# stdout. Centralising them removes the duplication called out in the
# PR #130 review.

parse_sentinel_flags() {
  # Consumes --sentinel / --on-exit / --sentinel-keep from "$@" until the
  # next non-flag positional is seen, then publishes the remainder via the
  # SENTINEL_PARSE_REMAINING global. Caller does:
  #   parse_sentinel_flags "$@"; set -- "${SENTINEL_PARSE_REMAINING[@]}"
  #
  # `--sentinel` and `--on-exit` MUST take a value. If the value is missing
  # the function exits explicitly rather than letting `shift 2` fail under
  # `set -e` with a cryptic "shift count must be <= $#".
  SENTINEL_PARSE_REMAINING=()
  while [[ "${1:-}" == "--sentinel" || "${1:-}" == "--on-exit" || "${1:-}" == "--sentinel-keep" ]]; do
    case "$1" in
      --sentinel)
        if (( $# < 2 )); then
          echo "--sentinel requires a value (absolute path)" >&2
          exit 2
        fi
        sentinel="$2"
        shift 2
        ;;
      --on-exit)
        if (( $# < 2 )); then
          echo "--on-exit requires a value (shell command)" >&2
          exit 2
        fi
        on_exit_cmd="$2"
        shift 2
        ;;
      --sentinel-keep)
        # Placeholder: future stop_session work will use this flag to keep
        # the sentinel file across an explicit stop. Nothing reads it yet;
        # tracked alongside the #95 design doc cleanup semantics.
        sentinel_keep=1
        shift
        ;;
    esac
  done
  SENTINEL_PARSE_REMAINING=("$@")
}

validate_sentinel_flags() {
  # Validates sentinel (absolute path; not pre-existing) and warns if
  # --on-exit is set without --sentinel. May exit non-zero on hard errors.
  local tool="$1"
  if [[ -n "$sentinel" && "${sentinel:0:1}" != "/" ]]; then
    echo "--sentinel must be an absolute path: $sentinel" >&2
    exit 2
  fi
  if [[ -n "$sentinel" && -e "$sentinel" ]]; then
    echo "Sentinel path already exists: $sentinel" >&2
    echo "Remove it or pass a fresh --sentinel path to avoid stale-completion false positives." >&2
    exit 1
  fi
  if [[ -n "$on_exit_cmd" && -z "$sentinel" ]]; then
    echo "[$tool] warning: --on-exit ignored without --sentinel" >&2
    on_exit_cmd=""
  fi
}

apply_sentinel_env_args() {
  # Appends -e TMUX_AGENT_TOOLS_SENTINEL=... and -e TMUX_AGENT_TOOLS_ON_EXIT=...
  # to the caller's session_env_args array when set.
  if [[ -n "$sentinel" ]]; then
    session_env_args+=("-e" "TMUX_AGENT_TOOLS_SENTINEL=$sentinel")
  fi
  if [[ -n "$on_exit_cmd" ]]; then
    session_env_args+=("-e" "TMUX_AGENT_TOOLS_ON_EXIT=$on_exit_cmd")
  fi
}

sentinel_inline_block() {
  # Emits the shell snippet that goes between `code=$?` and the exit-message
  # printfs inside the tmux new-session command. The snippet:
  #   1. atomically writes the exit code to $TMUX_AGENT_TOOLS_SENTINEL
  #   2. runs the --on-exit hook with ON_EXIT_CODE / ON_EXIT_NAME exported,
  #      only when BOTH the sentinel path and the hook command are set.
  #
  # Escape gymnastics (DO NOT touch without re-running scripts/test-sentinel-smoke):
  #   - Outer printf is SINGLE-QUOTED so the wrapper shell does NOT expand
  #     $TMUX_AGENT_TOOLS_SENTINEL / $code etc. — those are for the pane shell.
  #   - '\''...'\'' = end-quote + literal `'` + start-quote, used to embed the
  #     inner `printf '%s\n'`.
  #   - %%s\\n = printf format that emits literal `%s\n` (two chars: percent-s
  #     and backslash-n). NOT a real newline; the tmux pane shell re-processes
  #     the `\n` when running the inner printf.
  #   - The last `%s` is the only real format spec, filled with the
  #     shell_quoted agent name so dangerous names cannot break out.
  local agent_name="$1"
  printf 'if [ -n "$TMUX_AGENT_TOOLS_SENTINEL" ]; then printf '\''%%s\\n'\'' "$code" > "$TMUX_AGENT_TOOLS_SENTINEL.tmp" && mv -f "$TMUX_AGENT_TOOLS_SENTINEL.tmp" "$TMUX_AGENT_TOOLS_SENTINEL"; fi; if [ -n "$TMUX_AGENT_TOOLS_ON_EXIT" ] && [ -n "$TMUX_AGENT_TOOLS_SENTINEL" ]; then ( export ON_EXIT_CODE="$code" ON_EXIT_NAME=%s; eval "$TMUX_AGENT_TOOLS_ON_EXIT" ) >> "$TMUX_AGENT_TOOLS_SENTINEL.hook.log" 2>&1 || true; fi' "$(shell_quote "$agent_name")"
}

# --- Result-file convention helpers (issue #97) ---------------------------
# Layout under $TMUX_AGENT_DIR (default $XDG_STATE_HOME/tmux-agent-tools):
#   <dir>/<agent-name>/result.json
# Wrapper exports TMUX_AGENT_NAME and TMUX_AGENT_RESULT into the pane so the
# agent CLI can write its structured result without inventing a path.

agent_root_dir() {
  printf '%s' "${TMUX_AGENT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agent-tools}"
}

ensure_agent_dir() {
  # Creates and prints $TMUX_AGENT_DIR/<name>/ for the given agent.
  local name="$1"
  local dir
  dir="$(agent_root_dir)/$name"
  mkdir -p "$dir"
  printf '%s' "$dir"
}

apply_result_env_args() {
  # Appends -e TMUX_AGENT_NAME=... and -e TMUX_AGENT_RESULT=... to the
  # caller's session_env_args array. Removes any stale result.json so a
  # rerun cannot satisfy a `result --wait` from a previous invocation.
  local name="$1"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  local result_path="$subdir/result.json"
  rm -f "$result_path"
  session_env_args+=("-e" "TMUX_AGENT_NAME=$name")
  session_env_args+=("-e" "TMUX_AGENT_RESULT=$result_path")
}

start_session() {
  require_bins
  write_tmux_conf
  local should_attach=0
  local exact_name=0

  while [[ "${1:-}" == "--attach" || "${1:-}" == "--exact" ]]; do
    case "$1" in
      --attach)
        should_attach=1
        ;;
      --exact)
        exact_name=1
        ;;
    esac
    shift
  done

  local sentinel=""
  local on_exit_cmd=""
  local sentinel_keep=0
  parse_sentinel_flags "$@"
  set -- "${SENTINEL_PARSE_REMAINING[@]}"

  local requested_name="${1:-}"
  local directory="${2:-}"
  shift 2 || true
  local initial_text="${*:-}"

  if [[ -z "$requested_name" || -z "$directory" ]]; then
    echo "Usage: codex-tmux start [--attach] [--exact] [--sentinel <path>] [--on-exit <cmd>] [--sentinel-keep] <name> <directory> [initial text]" >&2
    exit 2
  fi

  validate_sentinel_flags codex-tmux

  if [[ ! -d "$directory" ]]; then
    echo "Directory not found: $directory" >&2
    exit 1
  fi

  local name="$requested_name"
  if (( ! exact_name )); then
    name="$requested_name-$(random_suffix)"
  fi

  local session="$(session_for_name "$name")"
  local -a session_env_args
  local session_env_entry
  session_env_args=()
  while IFS= read -r session_env_entry; do
    [[ -n "$session_env_entry" ]] || continue
    session_env_args+=("-e" "$session_env_entry")
  done <<< "${TMUX_AGENT_TOOLS_SESSION_ENV:-}"
  apply_sentinel_env_args
  apply_result_env_args "$name"
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
  fi

  "$TMUX" -f "$TMUX_CONF" new-session "${session_env_args[@]}" -d -s "$session" -c "$directory" \
    "printf '%s\n' 'codex-tmux agent: $name' 'requested name: $requested_name' 'tmux session: $session' 'cwd: $directory' 'send: $SELF send $name <text>' 'capture: $SELF capture $name 120' ''; $(shell_quote "$CODEX") --yolo; code=\$?; $(sentinel_inline_block "$name"); printf '\n[codex-tmux] local command exited with code %s\n' \"\$code\"; printf '[codex-tmux] press Enter to close this pane\n'; read _; exit \"\$code\""

  echo "agent: $name"
  echo "Started $session"
  echo "cwd:  $directory"
  echo "send: $SELF send $name <text>"
  echo "wait: $SELF wait $name 180"
  echo "wait-text: $SELF wait-text $name '<regex>' 180"
  echo "wait-literal: $SELF wait-literal $name '<text>' 180"
  echo "capture: $SELF capture $name 120"
  if [[ -n "$initial_text" ]]; then
    sleep 3
    local buffer_name="$session-init"
    paste_and_submit "$session" "$buffer_name" "$initial_text"
    echo "sent: $initial_text"
  else
    echo "sent: <none>"
  fi

  if (( should_attach )); then
    "$TMUX" attach -t "$session"
  fi
}

resume_session() {
  require_bins
  write_tmux_conf
  local should_attach=0
  local exact_name=0

  while [[ "${1:-}" == "--attach" || "${1:-}" == "--exact" ]]; do
    case "$1" in
      --attach)
        should_attach=1
        ;;
      --exact)
        exact_name=1
        ;;
    esac
    shift
  done

  local sentinel=""
  local on_exit_cmd=""
  local sentinel_keep=0
  parse_sentinel_flags "$@"
  set -- "${SENTINEL_PARSE_REMAINING[@]}"

  local requested_name="${1:-}"
  local directory="${2:-}"
  local codex_session_id="${3:-}"

  if [[ -z "$requested_name" || -z "$directory" || -z "$codex_session_id" ]]; then
    echo "Usage: codex-tmux resume [--attach] [--exact] [--sentinel <path>] [--on-exit <cmd>] [--sentinel-keep] <name> <directory> <session-id>" >&2
    exit 2
  fi

  if [[ ! -d "$directory" ]]; then
    echo "Directory not found: $directory" >&2
    exit 1
  fi

  if [[ ! "$codex_session_id" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]; then
    echo "Invalid Codex session id: $codex_session_id" >&2
    exit 2
  fi

  validate_sentinel_flags codex-tmux

  local name="$requested_name"
  if (( ! exact_name )); then
    name="$requested_name-$(random_suffix)"
  fi

  local session="$(session_for_name "$name")"
  local -a session_env_args
  local session_env_entry
  session_env_args=()
  while IFS= read -r session_env_entry; do
    [[ -n "$session_env_entry" ]] || continue
    session_env_args+=("-e" "$session_env_entry")
  done <<< "${TMUX_AGENT_TOOLS_SESSION_ENV:-}"
  apply_sentinel_env_args
  apply_result_env_args "$name"
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
  fi

  "$TMUX" -f "$TMUX_CONF" new-session "${session_env_args[@]}" -d -s "$session" -c "$directory" \
    "printf '%s\n' 'codex-tmux agent: $name' 'requested name: $requested_name' 'tmux session: $session' 'cwd: $directory' 'codex session id: $codex_session_id' 'send: $SELF send $name <text>' 'capture: $SELF capture $name 120' ''; $(shell_quote "$CODEX") --yolo resume $(shell_quote "$codex_session_id"); code=\$?; $(sentinel_inline_block "$name"); printf '\n[codex-tmux] local command exited with code %s\n' \"\$code\"; printf '[codex-tmux] press Enter to close this pane\n'; read _; exit \"\$code\""

  echo "agent: $name"
  echo "Started $session"
  echo "cwd:  $directory"
  echo "codex session id: $codex_session_id"
  echo "send: $SELF send $name <text>"
  echo "wait: $SELF wait $name 180"
  echo "wait-text: $SELF wait-text $name '<regex>' 180"
  echo "wait-literal: $SELF wait-literal $name '<text>' 180"
  echo "capture: $SELF capture $name 120"

  if (( should_attach )); then
    "$TMUX" attach -t "$session"
  fi
}

start_ssh_session() {
  require_tmux
  write_tmux_conf
  local should_attach=0
  local exact_name=0

  while [[ "${1:-}" == "--attach" || "${1:-}" == "--exact" ]]; do
    case "$1" in
      --attach)
        should_attach=1
        ;;
      --exact)
        exact_name=1
        ;;
    esac
    shift
  done

  local requested_name="${1:-}"
  local ssh_target="${2:-}"
  local remote_directory="${3:-}"

  if [[ -z "$requested_name" || -z "$ssh_target" || -z "$remote_directory" ]]; then
    echo "Usage: codex-tmux start-ssh [--attach] [--exact] <name> <ssh-target> <remote-directory> [initial text]" >&2
    exit 2
  fi

  shift 3
  local initial_text="${*:-}"

  local name="$requested_name"
  if (( ! exact_name )); then
    name="$requested_name-$(random_suffix)"
  fi

  local session="$(session_for_name "$name")"
  local -a session_env_args
  local session_env_entry
  session_env_args=()
  while IFS= read -r session_env_entry; do
    [[ -n "$session_env_entry" ]] || continue
    session_env_args+=("-e" "$session_env_entry")
  done <<< "${TMUX_AGENT_TOOLS_SESSION_ENV:-}"
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
  fi

  local remote_command
  remote_command="export TERM=xterm-256color COLORTERM=truecolor; cd $(shell_quote "$remote_directory") && printf '%s\n' $(shell_quote 'codex-tmux remote agent:') $(shell_quote "$name") $(shell_quote 'ssh target:') $(shell_quote "$ssh_target") $(shell_quote 'remote cwd:') $(shell_quote "$remote_directory") '' && codex --yolo; code=\$?; printf '\n[codex-tmux] remote command exited with code %s\n' \"\$code\"; printf '[codex-tmux] press Enter to close this pane\n'; read _; exit \"\$code\""

  "$TMUX" -f "$TMUX_CONF" new-session "${session_env_args[@]}" -d -s "$session" \
    "printf '%s\n' 'codex-tmux agent: $name' 'requested name: $requested_name' 'tmux session: $session' 'local mode: ssh' 'ssh target: $ssh_target' 'remote cwd: $remote_directory' 'send: $SELF send $name <text>' 'capture: $SELF capture $name 120' ''; exec ssh -tt $(shell_quote "$ssh_target") $(shell_quote "$remote_command")"

  echo "agent: $name"
  echo "Started $session"
  echo "ssh:  $ssh_target"
  echo "cwd:  $remote_directory"
  echo "send: $SELF send $name <text>"
  echo "wait: $SELF wait $name 180"
  echo "wait-text: $SELF wait-text $name '<regex>' 180"
  echo "wait-literal: $SELF wait-literal $name '<text>' 180"
  echo "capture: $SELF capture $name 120"
  if [[ -n "$initial_text" ]]; then
    sleep 5
    local buffer_name="$session-init"
    paste_and_submit "$session" "$buffer_name" "$initial_text"
    echo "sent: $initial_text"
  else
    echo "sent: <none>"
  fi

  if (( should_attach )); then
    "$TMUX" attach -t "$session"
  fi
}

attach_session() {
  require_tmux
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: codex-tmux attach <name>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  "$TMUX" attach -t "$session"
}

send_session() {
  require_tmux
  local name="${1:-}"
  shift || true

  if [[ -z "$name" || "$#" -eq 0 ]]; then
    echo "Usage: codex-tmux send <name> <text>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local prompt_text="$*"
  local buffer_name="$session-send"
  paste_and_submit "$session" "$buffer_name" "$prompt_text"
  echo "Sent to $session: $prompt_text"
}

count_literal_occurrences() {
  local haystack="$1"
  local needle="$2"
  local count=0
  local rest="$haystack"

  while [[ "$rest" == *"$needle"* ]]; do
    rest="${rest#*"$needle"}"
    count=$((count + 1))
  done

  echo "$count"
}

send_wait_literal_session() {
  require_tmux
  local name="${1:-}"
  local prompt_text="${2:-}"
  local needle="${3:-}"
  local timeout_seconds="${4:-180}"

  if [[ -z "$name" || -z "$prompt_text" || -z "$needle" ]]; then
    echo "Usage: codex-tmux send-wait-literal <name> <text> <literal> [timeout_seconds]" >&2
    exit 2
  fi

  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid timeout_seconds: $timeout_seconds" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local before="$("$TMUX" capture-pane -J -t "$session" -p -S -300)"
  local before_count
  before_count="$(count_literal_occurrences "$before" "$needle")"

  local buffer_name="$session-send-wait"
  paste_and_submit "$session" "$buffer_name" "$prompt_text"

  local deadline=$((SECONDS + timeout_seconds))
  local current=""
  local current_count=0

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -300)"
    current_count="$(count_literal_occurrences "$current" "$needle")"
    if (( current_count > before_count )); then
      echo "matched new literal: $needle"
      return 0
    fi
    sleep 1
  done

  echo "timeout waiting for new literal text '$needle': $session" >&2
  return 1
}

capture_session() {
  require_tmux
  local strip_ansi=0
  local since_marker=""
  local output_json=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --strip-ansi)
        strip_ansi=1
        shift
        ;;
      --since-marker)
        if (( $# < 2 )); then
          echo "--since-marker requires a value (literal text)" >&2
          exit 2
        fi
        since_marker="$2"
        shift 2
        ;;
      --json)
        output_json=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "Unknown capture flag: $1" >&2
        exit 2
        ;;
    esac
  done

  local name="${1:-}"
  local lines="${2:-80}"

  if [[ -z "$name" ]]; then
    echo "Usage: codex-tmux capture [--strip-ansi] [--since-marker <text>] [--json] <name> [lines]" >&2
    exit 2
  fi

  if [[ ! "$lines" =~ '^[0-9]+$' || "$lines" -lt 1 ]]; then
    echo "Invalid lines: $lines" >&2
    exit 2
  fi

  if (( output_json )); then
    require_jq
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local raw
  raw="$("$TMUX" capture-pane -J -t "$session" -p -S "-$lines")"

  if (( strip_ansi )); then
    # Strip CSI/SGR escape sequences. Known coverage gap (see
    # docs/design-issue-96-capture-variants.md): OSC/DCS/APC/PM/SOS
    # terminators are NOT stripped. Documented for callers.
    raw="$(printf '%s' "$raw" | sed $'s/\x1b\\[[0-9;?]*[A-Za-z]//g')"
  fi

  local marker_found=0
  if [[ -n "$since_marker" ]]; then
    # Slice to lines AFTER the LAST occurrence of the literal marker.
    local last_idx
    # grep -nF exits 1 when no match; tolerate that under `set -e + pipefail`.
    last_idx="$(printf '%s\n' "$raw" | { grep -nF "$since_marker" || true; } | tail -1 | cut -d: -f1)"
    if [[ -n "$last_idx" ]]; then
      marker_found=1
      raw="$(printf '%s\n' "$raw" | tail -n +"$((last_idx + 1))")"
    else
      raw=""
    fi
  fi

  if (( output_json )); then
    "$JQ" -n \
      --arg name "$name" \
      --arg session "$session" \
      --argjson lines_requested "$lines" \
      --argjson marker_found "$marker_found" \
      --argjson stripped_ansi "$strip_ansi" \
      --arg body "$raw" \
      '{schema_version: 1,
        name: $name, session: $session, lines_requested: $lines_requested,
        marker_found: ($marker_found == 1), stripped_ansi: ($stripped_ansi == 1),
        lines: ($body | split("\n"))}'
  else
    printf '%s\n' "$raw"
  fi
}

result_session() {
  # Read the structured result an agent wrote to its conventional path
  # (see #97 design doc). Path resolution:
  #   $TMUX_AGENT_DIR/<name>/result.json
  # Optional --wait <seconds> polls until the file appears or timeout.
  # --field <jq> extracts a single value. --json wraps in metadata.
  local field=""
  local wait_seconds=0
  local output_json=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --field)
        if (( $# < 2 )); then
          echo "--field requires a value (jq path)" >&2
          exit 2
        fi
        field="$2"
        shift 2
        ;;
      --wait)
        if (( $# < 2 )); then
          echo "--wait requires a value (seconds)" >&2
          exit 2
        fi
        wait_seconds="$2"
        shift 2
        if [[ ! "$wait_seconds" =~ '^[0-9]+$' ]]; then
          echo "--wait must be a non-negative integer" >&2
          exit 2
        fi
        ;;
      --json)
        output_json=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "Unknown result flag: $1" >&2
        exit 2
        ;;
    esac
  done

  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: codex-tmux result [--field <jq>] [--wait <seconds>] [--json] <name>" >&2
    exit 2
  fi
  if (( output_json )); then
    require_jq
  fi
  if [[ -n "$field" ]]; then
    require_jq
  fi

  local result_path
  result_path="$(agent_root_dir)/$name/result.json"

  if (( wait_seconds > 0 )); then
    # Polling implementation. fswatch / inotifywait can replace this in a
    # follow-up; portability across macOS + Linux costs more here than
    # the ~0.5s poll latency.
    local elapsed=0
    while [[ ! -f "$result_path" && "$elapsed" -lt "$wait_seconds" ]]; do
      sleep 1
      elapsed=$((elapsed + 1))
    done
  fi

  if [[ ! -f "$result_path" ]]; then
    if (( output_json )); then
      # gemini-code-assist on PR #136: `--json` is a structured-output
      # mode; if JSON was emitted, the subcommand succeeded. The
      # "result-not-yet" condition lives in `.present`. Callers branch
      # on the payload, not the exit code.
      "$JQ" -n --arg path "$result_path" \
        '{schema_version: 1, path: $path, present: false, valid: false, body: null}'
      return 0
    fi
    echo "Result file not found: $result_path" >&2
    exit 1
  fi

  local body bytes mtime
  body="$(cat "$result_path")"
  bytes=$(wc -c < "$result_path" | tr -d ' ')
  if [[ "$(uname)" == "Darwin" ]]; then
    # BSD stat: -f %m emits epoch seconds. Format via `date -u -r EPOCH`
    # so the value is genuinely UTC.
    local epoch
    epoch=$(stat -f %m "$result_path")
    mtime=$(date -u -r "$epoch" +%Y-%m-%dT%H:%M:%SZ)
  else
    # GNU stat: -c %Y emits epoch seconds. `stat -c %y` was wrong because
    # it formatted in the local timezone but the wrapper appended a `Z`
    # suffix as if it were UTC (gemini-code-assist on PR #136).
    local epoch
    epoch=$(stat -c %Y "$result_path")
    mtime=$(date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ)
  fi

  if (( output_json )); then
    # body=null ambiguity (partner R5 critique): a `null` literal in
    # result.json is valid JSON; without a `valid` flag the consumer
    # cannot tell that case apart from "wrapper failed to parse". Emit
    # both: valid=true with parsed body, or valid=false with the raw
    # bytes wrapped as a JSON string so the caller can still inspect.
    local body_json valid_flag
    if printf '%s' "$body" | "$JQ" -e . >/dev/null 2>&1; then
      body_json="$body"
      valid_flag=true
    else
      body_json="$(printf '%s' "$body" | "$JQ" -Rs .)"
      valid_flag=false
    fi
    "$JQ" -n \
      --arg path "$result_path" \
      --argjson bytes "$bytes" \
      --arg mtime "$mtime" \
      --argjson valid "$valid_flag" \
      --argjson body "$body_json" \
      '{schema_version: 1, path: $path, present: true, bytes: $bytes,
        mtime: $mtime, valid: $valid, body: $body}'
    return 0
  fi

  if [[ -n "$field" ]]; then
    if ! printf '%s' "$body" | "$JQ" -e -r "$field"; then
      echo "Field not found in result.json: $field" >&2
      exit 1
    fi
    return 0
  fi

  printf '%s\n' "$body"
}

wait_session() {
  require_tmux
  local name="${1:-}"
  local timeout_seconds="${2:-180}"

  if [[ -z "$name" ]]; then
    echo "Usage: codex-tmux wait <name> [timeout_seconds]" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  local last=""
  local stable_count=0
  local current=""

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -100)"
    if [[ "$current" == "$last" ]]; then
      stable_count=$((stable_count + 1))
      if (( stable_count >= STABLE_SECONDS )); then
        echo "stable"
        return 0
      fi
    else
      stable_count=0
      last="$current"
    fi
    sleep 1
  done

  echo "timeout waiting for stable output: $session" >&2
  return 1
}

wait_text_session() {
  require_tmux
  local literal=0
  if [[ "${1:-}" == "--literal" ]]; then
    literal=1
    shift
  fi

  if (( literal )); then
    wait_literal_session "$@"
    return
  fi

  local name="${1:-}"
  local pattern="${2:-}"
  local timeout_seconds="${3:-180}"

  if [[ -z "$name" || -z "$pattern" ]]; then
    echo "Usage: codex-tmux wait-text [--literal] <name> <regex-or-text> [timeout_seconds]" >&2
    exit 2
  fi

  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid timeout_seconds: $timeout_seconds" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  local current=""

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -200)"
    if [[ "$current" =~ $pattern ]]; then
      echo "matched: $pattern"
      return 0
    fi
    sleep 1
  done

  echo "timeout waiting for text '$pattern': $session" >&2
  return 1
}

wait_literal_session() {
  require_tmux
  local name="${1:-}"
  local needle="${2:-}"
  local timeout_seconds="${3:-180}"

  if [[ -z "$name" || -z "$needle" ]]; then
    echo "Usage: codex-tmux wait-literal <name> <text> [timeout_seconds]" >&2
    exit 2
  fi

  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid timeout_seconds: $timeout_seconds" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  local current=""

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -200)"
    if [[ "$current" == *"$needle"* ]]; then
      echo "matched literal: $needle"
      return 0
    fi
    sleep 1
  done

  echo "timeout waiting for literal text '$needle': $session" >&2
  return 1
}

wait_and_capture_session() {
  # Combined wait + capture — the golden-path shortcut described in
  # issue #99. Replaces the two-step `wait-literal` / `capture` pair.
  # `--no-timeout-error` decouples soft-timeout opt-in from `--json`
  # (partner R3 critique on the original design).
  require_tmux
  local marker=""
  local match_style="literal"
  local timeout_seconds=180
  local tail_lines=80
  local strip_ansi=0
  local since_marker=""
  local output_json=0
  local no_timeout_error=0
  local since_set=0
  local style_set=0

  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --marker)
        if (( $# < 2 )); then echo "--marker requires a value" >&2; exit 2; fi
        marker="$2"; shift 2 ;;
      --literal) match_style="literal"; style_set=1; shift ;;
      --regex) match_style="regex"; style_set=1; shift ;;
      --timeout)
        if (( $# < 2 )); then echo "--timeout requires a value (seconds)" >&2; exit 2; fi
        timeout_seconds="$2"; shift 2 ;;
      --tail)
        if (( $# < 2 )); then echo "--tail requires a value (lines)" >&2; exit 2; fi
        tail_lines="$2"; shift 2 ;;
      --strip-ansi) strip_ansi=1; shift ;;
      --since-marker)
        if (( $# < 2 )); then echo "--since-marker requires a value (literal text)" >&2; exit 2; fi
        since_marker="$2"; since_set=1; shift 2 ;;
      --json) output_json=1; shift ;;
      --no-timeout-error) no_timeout_error=1; shift ;;
      --) shift; break ;;
      *) echo "Unknown wait-and-capture flag: $1" >&2; exit 2 ;;
    esac
  done

  local name="${1:-}"
  if [[ -z "$name" || -z "$marker" ]]; then
    echo "Usage: codex-tmux wait-and-capture --marker <text> [--literal|--regex] [--timeout <s>] [--tail <n>] [--strip-ansi] [--since-marker <text>] [--json] [--no-timeout-error] <name>" >&2
    exit 2
  fi
  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid --timeout: $timeout_seconds" >&2
    exit 2
  fi
  if [[ ! "$tail_lines" =~ '^[0-9]+$' || "$tail_lines" -lt 1 ]]; then
    echo "Invalid --tail: $tail_lines" >&2
    exit 2
  fi
  if (( output_json )); then
    require_jq
  fi

  # Default since-marker = marker, but ONLY when the marker is a literal.
  # Under --regex, defaulting since-marker to the regex pattern would feed
  # `grep -F` a string that may not appear in the pane (e.g. `Done|Error`
  # never matches `grep -F`). Caller must opt-in with explicit
  # --since-marker for regex match style. Partner R6 critique on PR #137.
  if (( ! since_set )); then
    if [[ "$match_style" == "literal" ]]; then
      since_marker="$marker"
    else
      since_marker=""
    fi
  fi

  local session
  session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    if (( output_json )); then
      "$JQ" -n \
        --arg marker "$marker" --arg style "$match_style" \
        --arg since "$since_marker" \
        --argjson timeout "$timeout_seconds" \
        '{schema_version: 1, matched: false, marker: $marker,
          match_style: $style, since_marker: $since,
          wait_seconds: 0, timeout: $timeout,
          stripped_ansi: false, reason: "session_gone", lines: []}'
      (( no_timeout_error )) && return 0
      return 1
    fi
    echo "Session does not exist: $session" >&2
    return 1
  fi

  local started=$SECONDS
  local matched=0
  local deadline=$((started + timeout_seconds))
  local current=""
  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -200)"
    if [[ "$match_style" == "literal" ]]; then
      if [[ "$current" == *"$marker"* ]]; then
        matched=1
        break
      fi
    else
      if [[ "$current" =~ $marker ]]; then
        matched=1
        break
      fi
    fi
    sleep 1
  done
  local elapsed=$((SECONDS - started))

  local raw
  raw="$("$TMUX" capture-pane -J -t "$session" -p -S "-$tail_lines")"

  if (( strip_ansi )); then
    raw="$(printf '%s' "$raw" | sed $'s/\x1b\\[[0-9;?]*[A-Za-z]//g')"
  fi

  if (( matched )) && [[ -n "$since_marker" ]]; then
    local last_idx
    last_idx="$(printf '%s\n' "$raw" | { grep -nF "$since_marker" || true; } | tail -1 | cut -d: -f1)"
    if [[ -n "$last_idx" ]]; then
      raw="$(printf '%s\n' "$raw" | tail -n +"$((last_idx + 1))")"
    else
      raw=""
    fi
  fi

  local reason
  if (( matched )); then
    reason="matched"
  else
    reason="timeout"
  fi

  if (( output_json )); then
    "$JQ" -n \
      --arg marker "$marker" --arg style "$match_style" \
      --argjson matched "$matched" \
      --argjson elapsed "$elapsed" \
      --argjson timeout "$timeout_seconds" \
      --argjson stripped "$strip_ansi" \
      --arg since "$since_marker" \
      --arg reason "$reason" \
      --arg body "$raw" \
      '{schema_version: 1,
        matched: ($matched == 1), marker: $marker, match_style: $style,
        wait_seconds: $elapsed, timeout: $timeout,
        stripped_ansi: ($stripped == 1),
        since_marker: $since,
        reason: $reason,
        lines: ($body | split("\n"))}'
  else
    printf '%s\n' "$raw"
  fi

  if (( ! matched && ! no_timeout_error )); then
    return 1
  fi
  return 0
}

doctor_session() {
  require_tmux
  echo "tmux: $TMUX"
  if [[ -n "$CODEX" && -x "$CODEX" ]]; then
    echo "codex: $CODEX"
  else
    echo "codex: not found; start requires CODEX=/path/to/codex or codex on PATH"
  fi
  echo "prefix: $PREFIX"
  echo "stable_seconds: $STABLE_SECONDS"
  echo "submit_delay: $SUBMIT_DELAY"
  echo "tmux_conf: $TMUX_CONF"
  echo "mouse: $TMUX_MOUSE"
  echo "clipboard: $(clipboard_description)"
}

self_test_session() {
  require_tmux
  local name="self-test-$$"
  local session="$(session_for_name "$name")"
  "$TMUX" kill-session -t "$session" 2>/dev/null || true
  "$TMUX" new-session -d -s "$session" "zsh -lc 'printf \"%s\n\" \"TMUX_AGENT_TOOLS_SELF_TEST_OK\" \"[TMUX_AGENT_TOOLS_SELF_TEST_OK]\"; if IFS= read -r line; then printf \"%s\n\" \"echo:\$line\" \"[TMUX_AGENT_TOOLS_SEND_WAIT_OK]\"; fi; sleep 5'"
  wait_literal_session "$name" "TMUX_AGENT_TOOLS_SELF_TEST_OK" 5
  wait_text_session --literal "$name" "[TMUX_AGENT_TOOLS_SELF_TEST_OK]" 5
  send_wait_literal_session "$name" "trigger send-wait" "[TMUX_AGENT_TOOLS_SEND_WAIT_OK]" 5
  "$TMUX" kill-session -t "$session" 2>/dev/null || true
  echo "self-test: ok"
}

status_pane_text() {
  local session="$1"
  "$TMUX" capture-pane -J -t "$session" -p -S -80 2>/dev/null || true
}

blocked_reason_for_text() {
  local lowered="$1"
  if [[ "$lowered" == *"local command exited with code"* || "$lowered" == *"remote command exited with code"* ]]; then
    print -r -- "cli_exited"
  elif [[ "$lowered" == *"password:"* || "$lowered" == *"permission denied"* || "$lowered" == *"are you sure you want to continue connecting"* ]]; then
    print -r -- "ssh_prompt"
  elif [[ "$lowered" == *"do you want to proceed"* || "$lowered" == *"press enter to continue"* || "$lowered" == *"permission confirmation"* || "$lowered" == *"permission prompt"* || "$lowered" == *"permission required"* || "$lowered" == *"trust this"* || "$lowered" == *"trust the files"* ]]; then
    print -r -- "permission_prompt"
  elif [[ "$lowered" == *"approval"* || "$lowered" == *"approve"* || "$lowered" == *"[y/n]"* ]]; then
    print -r -- "approval_prompt"
  elif [[ "$lowered" == *"please log in"* || "$lowered" == *"log in to"* || "$lowered" == *"sign in to"* || "$lowered" == *"not logged in"* ]]; then
    print -r -- "login_prompt"
  fi
}

exit_code_for_text() {
  local current="$1"
  local line
  local code=""
  local exit_re='(local|remote) command exited with code ([0-9]+)'
  while IFS= read -r line; do
    if [[ "$line" =~ $exit_re ]]; then
      code="${match[2]}"
    fi
  done <<< "$current"
  print -r -- "$code"
}

diagnostic_for_blocked_reason() {
  local reason="$1"
  case "$reason" in
    permission_prompt|approval_prompt|ssh_prompt|login_prompt)
      echo "session may be waiting for interactive confirmation; attach or capture the pane before sending prompts"
      ;;
  esac
}

status_tail_json() {
  local current="$1"
  local max_lines="$STATUS_TAIL_LINES"
  if [[ "$max_lines" != <-> ]] || (( max_lines <= 0 )); then
    max_lines=20
  fi
  print -r -- "$current" | "$JQ" -R -s --argjson max_lines "$max_lines" '
    split("\n")
    | map(select(length > 0))
    | .[-$max_lines:]
  '
}

status_session() {
  require_tmux
  local output_json=0

  if [[ "${1:-}" == "--json" ]]; then
    output_json=1
    shift
  fi

  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: codex-tmux status [--json] <name>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  local exists=false
  local running=false
  local exit_detected=false
  local local_or_remote=""
  local diagnostic=""
  local blocked_reason=""
  local exit_code=""
  local confirmation_detected=false
  local current=""
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    exists=true
    running=true
    local lowered
    current="$(status_pane_text "$session")"
    lowered="${current:l}"
    if [[ "$lowered" == *"local command exited with code"* || "$lowered" == *"remote command exited with code"* ]]; then
      exit_detected=true
      running=false
      exit_code="$(exit_code_for_text "$current")"
    fi
    if [[ "$lowered" == *"local mode: ssh"* || "$lowered" == *"remote command exited with code"* ]]; then
      local_or_remote="remote"
    else
      local_or_remote="local"
    fi
    blocked_reason="$(blocked_reason_for_text "$lowered")"
    diagnostic="$(diagnostic_for_blocked_reason "$blocked_reason")"
    case "$blocked_reason" in
      permission_prompt|approval_prompt|ssh_prompt|login_prompt)
        confirmation_detected=true
        ;;
    esac
  fi

  if (( output_json )); then
    require_jq
    "$JQ" -cn \
      --arg tool "codex" \
      --arg name "$name" \
      --arg session "$session" \
      --arg prefix "$PREFIX" \
      --arg local_or_remote "$local_or_remote" \
      --arg diagnostic "$diagnostic" \
      --arg blocked_reason "$blocked_reason" \
      --arg exit_code "$exit_code" \
      --argjson last_capture_lines "$(status_tail_json "$current")" \
      --argjson exists "$exists" \
      --argjson running "$running" \
      --argjson exit_detected "$exit_detected" \
      --argjson confirmation_detected "$confirmation_detected" \
      '{tool:$tool,name:$name,session:$session,prefix:$prefix,exists:$exists,running:$running,exit_detected:$exit_detected,exit_code:(if $exit_code == "" then null else ($exit_code | tonumber) end),local_or_remote:(if $local_or_remote == "" then null else $local_or_remote end),diagnostic:(if $diagnostic == "" then null else $diagnostic end),last_capture_lines:$last_capture_lines,confirmation_detected:$confirmation_detected,blocked_reason:(if $blocked_reason == "" then null else $blocked_reason end)}'
  elif [[ "$running" == true ]]; then
    echo "running: $session"
  else
    echo "stopped: $session"
  fi
}

list_sessions() {
  require_tmux
  "$TMUX" ls 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      "$PREFIX"-*)
        local session="${line%%:*}"
        local name="${session#$PREFIX-}"
        echo "$name -> $session"
        ;;
    esac
  done
}

stop_session() {
  require_tmux
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: codex-tmux stop <name>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
    echo "Stopped $session"
  else
    echo "Already stopped: $session"
  fi
}

command="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "$command" in
  start)
    start_session "$@"
    ;;
  resume)
    resume_session "$@"
    ;;
  start-ssh)
    start_ssh_session "$@"
    ;;
  attach)
    attach_session "$@"
    ;;
  send)
    send_session "$@"
    ;;
  send-wait-literal)
    send_wait_literal_session "$@"
    ;;
  wait)
    wait_session "$@"
    ;;
  wait-text)
    wait_text_session "$@"
    ;;
  wait-literal)
    wait_literal_session "$@"
    ;;
  wait-and-capture)
    wait_and_capture_session "$@"
    ;;
  capture)
    capture_session "$@"
    ;;
  result)
    result_session "$@"
    ;;
  status)
    status_session "$@"
    ;;
  doctor)
    doctor_session
    ;;
  self-test)
    self_test_session
    ;;
  list)
    list_sessions
    ;;
  stop)
    stop_session "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
