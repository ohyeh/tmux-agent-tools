#!/usr/bin/env zsh
set -euo pipefail

SELF="${0:A}"
CLAUDE="${CLAUDE:-$(command -v claude 2>/dev/null || true)}"
JQ="${JQ:-$(command -v jq 2>/dev/null || true)}"
PREFIX="${CLAUDE_TMUX_PREFIX:-claude-cli}"
STABLE_SECONDS="${CLAUDE_TMUX_STABLE_SECONDS:-3}"
SUBMIT_DELAY="${CLAUDE_TMUX_SUBMIT_DELAY:-0.2}"
TMUX_CONF="${CLAUDE_TMUX_CONF:-${TMPDIR:-/tmp}/claude-tmux.tmux.conf}"
TMUX_MOUSE="${CLAUDE_TMUX_MOUSE:-on}"
TMUX_CLIPBOARD="${CLAUDE_TMUX_CLIPBOARD:-auto}"
STATUS_TAIL_LINES="${CLAUDE_TMUX_STATUS_TAIL_LINES:-20}"

resolve_tmux_bin() {
  if [[ -n "${TMUX:-}" && -x "${TMUX:-}" ]]; then
    print -r -- "$TMUX"
    return
  fi
  command -v tmux 2>/dev/null || true
}

TMUX_BIN="$(resolve_tmux_bin)"
unset TMUX
TMUX="$TMUX_BIN"

usage() {
  cat <<'EOF'
claude-tmux - run Claude Code in tmux and drive it programmatically.

Usage:
  claude-tmux start [--attach] [--exact] [--transcript <path>] [--transcript-text-truncate <N>] <name> <directory> [initial text]
  claude-tmux resume [--attach] [--exact] [--transcript <path>] [--transcript-text-truncate <N>] <name> <directory> <session-id>
  claude-tmux start-ssh [--attach] [--exact] <name> <ssh-target> <remote-directory> [initial text]
  claude-tmux attach <name>
  claude-tmux send <name> <text>
  claude-tmux send-wait-literal <name> <text> <literal> [timeout_seconds]
  claude-tmux wait <name> [timeout_seconds]
  claude-tmux wait-text [--literal] <name> <regex-or-text> [timeout_seconds]
  claude-tmux wait-literal <name> <text> [timeout_seconds]
  claude-tmux wait-and-capture --marker <text> [--literal|--regex] [--timeout <s>] [--tail <n>] [--strip-ansi] [--since-marker <text>] [--json] [--no-timeout-error] <name>
  claude-tmux capture <name> [lines]
  claude-tmux result [--field <jq>] [--wait <seconds>] [--json] <name>
  claude-tmux list
  claude-tmux status [--json] <name>
  claude-tmux ping [--timeout <s>] [--json] <name>
  claude-tmux doctor
  claude-tmux self-test
  claude-tmux stop <name>
  claude-tmux help

Examples:
  claude-tmux start --attach pr5 ~/github/core-parking-service
  claude-tmux resume --exact pr5 ~/github/core-parking-service ee5aca88-a1af-48d3-af21-54f60d618f22
  claude-tmux start-ssh --attach pr5 openclaw-macmini ~/github/core-parking-service
  claude-tmux start --exact pr5 ~/github/core-parking-service 'hi'
  claude-tmux attach pr5
  claude-tmux send pr5 '請先讀 PR description'
  claude-tmux send-wait-literal pr5 'Reply with the requested marker.' '[CLAUDE-01]' 180
  claude-tmux wait pr5 180
  claude-tmux wait-text pr5 'Done|Need approval' 180
  claude-tmux wait-text --literal pr5 '[CLAUDE-01]' 180
  claude-tmux wait-literal pr5 '[CLAUDE-01]' 180
  claude-tmux capture pr5 80
  claude-tmux doctor
  claude-tmux self-test
  claude-tmux list
  claude-tmux stop pr5

Behavior:
  - Session name is claude-cli-<name> by default.
  - start and resume append a random 6-character suffix to <name>, unless --exact is used.
  - start and resume always recreate that named tmux session.
  - start-ssh keeps tmux local, then runs Claude through ssh in the remote directory.
  - Claude is launched with --dangerously-skip-permissions.
  - wait returns when the visible pane is stable for a few seconds.
  - wait-text returns when the visible pane matches a zsh extended regex.
  - wait-text --literal returns when the visible pane contains exact text.
  - wait-literal returns when the visible pane contains exact text.
  - send-wait-literal sends text, then waits for a new occurrence of exact text.
  - capture reads the tmux pane without stealing browser or terminal focus.

Environment:
  TMUX=$(command -v tmux)
  CLAUDE=$(command -v claude)
  CLAUDE_TMUX_PREFIX=claude-cli
  CLAUDE_TMUX_STABLE_SECONDS=3
  CLAUDE_TMUX_SUBMIT_DELAY=0.2
  CLAUDE_TMUX_CONF=/tmp/claude-tmux.tmux.conf
  CLAUDE_TMUX_MOUSE=on
  CLAUDE_TMUX_CLIPBOARD=auto
  CLAUDE_TMUX_STATUS_TAIL_LINES=20
EOF
}

help_for_subcommand() {
  # Per-subcommand cheatsheet for issue #106 discoverability.
  # Falls through to the full `usage` when no topic matches.
  local topic="${1:-}"
  case "$topic" in
    "")
      usage
      return 0
      ;;
    start)
      cat <<'HELP_EOF'
claude-tmux start [flags] <name> <directory> [initial text]

Launch claude inside a fresh tmux session.

Flags (place BEFORE <name>):
  --attach                       Attach immediately after creating the session.
  --exact                        Use <name> verbatim (no random suffix).
  --sentinel <abs-path>          Write CLI exit code to file when CLI exits (#95).
  --on-start <shell-cmd>         Run hook after `tmux new-session` returns (#101a).
  --on-exit  <shell-cmd>         Run hook after CLI exit; needs --sentinel.
  --sentinel-keep                Keep sentinel file across `stop` cleanup.
  --transcript <abs-path>        Append JSONL events to this path (#100).

Examples:
  claude-tmux start --exact worker ~/proj 'Run targeted tests.'
  claude-tmux start --sentinel /tmp/w.exit --on-exit 'curl -X POST $URL' \
                  --on-start 'date >> /tmp/start.log' worker ~/proj 'hi'

See also: README "Event-driven completion" and `claude-tmux help resume`.
HELP_EOF
      ;;
    resume)
      cat <<'HELP_EOF'
claude-tmux resume [flags] <name> <directory> <session-id>

Resume an existing claude session-id inside tmux. Accepts the same flags as
`start`: --attach, --exact, --sentinel, --on-start, --on-exit, --sentinel-keep,
--transcript.

Example:
  claude-tmux resume --exact rev ~/proj 019e356f-f95d-7570-9784-ea7b58e404a5
HELP_EOF
      ;;
    send)
      cat <<'HELP_EOF'
claude-tmux send <name> <text>

Paste <text> into the agent CLI and submit. Multiline OK; the wrapper
inserts a short delay between paste and submit. Tune via CLAUDE_TMUX_SUBMIT_DELAY.
HELP_EOF
      ;;
    send-wait-literal)
      cat <<'HELP_EOF'
claude-tmux send-wait-literal <name> <text> <literal> [timeout]

Send text then wait for a NEW occurrence of <literal> after the send. Use
this over `send` + `wait-literal` when stale pane content may already
contain the marker.
HELP_EOF
      ;;
    wait)
      cat <<'HELP_EOF'
claude-tmux wait <name> [timeout_seconds]

Block until pane bytes have been stable for CLAUDE_TMUX_STABLE_SECONDS. Times
out with exit 1 if the pane keeps changing.
HELP_EOF
      ;;
    wait-text|wait-literal)
      cat <<'HELP_EOF'
claude-tmux wait-text [--literal] <name> <pattern> [timeout_seconds]
claude-tmux wait-literal       <name> <text>    [timeout_seconds]

Both wait until the visible pane contains the pattern. `wait-text` uses zsh
extended regex by default; `--literal` and `wait-literal` use exact-text
match. Prefer literal forms for markers containing regex metacharacters
(`[`, `]`, `(`, `)`, `.`, `*`, `?`).
HELP_EOF
      ;;
    wait-and-capture)
      cat <<'HELP_EOF'
claude-tmux wait-and-capture --marker <text> [flags] <name>

One-shot combination of wait + capture (#99). Default match style is
literal (regex would false-positive on `[DONE]`-shaped markers).

Flags:
  --marker <text>              Required marker text.
  --literal | --regex          Match style. Default --literal (#137 R6).
  --timeout <s>                Wait timeout.
  --tail <n>                   Capture last N lines.
  --strip-ansi                 Strip CSI/SGR escapes.
  --since-marker <text>        Trim pane output before <text>; defaults to
                                --marker when match style is literal.
  --json                       Structured payload with reason:
                                  matched | timeout | session_gone.
  --no-timeout-error           SOFT timeout exits 0; session_gone still exits 1.
HELP_EOF
      ;;
    capture)
      cat <<'HELP_EOF'
claude-tmux capture [flags] <name> [lines]

Read the tmux pane without stealing focus.

Flags:
  --strip-ansi                 Remove CSI/SGR escapes (#96).
  --since-marker <text>        Keep only lines after the LAST <text>.
  --json                       Wrap as {schema_version, name, session,
                                  lines_requested, marker_found,
                                  stripped_ansi, lines}.
HELP_EOF
      ;;
    result)
      cat <<'HELP_EOF'
claude-tmux result [flags] <name>

Read the agent's result.json (#97) at $TMUX_AGENT_DIR/<name>/result.json.

Flags:
  --field <jq>                  Extract single value via `jq -r`. Exit 1 on
                                missing path.
  --wait <seconds>              Poll until the file appears or timeout.
  --json                        Wrap as {schema_version, path, present,
                                  bytes, mtime, valid, body}. Missing file
                                  → exit 0 with present:false.
HELP_EOF
      ;;
    status)
      cat <<'HELP_EOF'
claude-tmux status [--json] <name>

Show pane state + diagnostics. `--json` emits the stable contract
including liveness fields (#98): started_at, last_change_at, idle_seconds,
bytes_in_pane, marker_seen[], plus the shared exists/running/exit_detected/
local_or_remote/diagnostic fields.
HELP_EOF
      ;;
    list)
      cat <<'HELP_EOF'
claude-tmux list

List active claude-tmux-prefixed tmux sessions. Use `tmux-agent-sessions list`
for the cross-tool inventory with state filters.
HELP_EOF
      ;;
    attach)
      cat <<'HELP_EOF'
claude-tmux attach <name>

Attach to the session in the current terminal. Detach with the usual tmux
prefix + `d` (default Ctrl-b d).
HELP_EOF
      ;;
    stop)
      cat <<'HELP_EOF'
claude-tmux stop <name>

Kill the tmux session. Removes the sentinel file by default; pass
--sentinel-keep at start to retain it.
HELP_EOF
      ;;
    doctor|self-test)
      cat <<'HELP_EOF'
claude-tmux doctor          Check binaries + tmux + capture/wait behavior.
claude-tmux self-test       End-to-end smoke without launching a real CLI.

Both are credential-free and safe to run anywhere.
HELP_EOF
      ;;
    start-ssh)
      cat <<'HELP_EOF'
claude-tmux start-ssh [--attach] [--exact] <name> <ssh-target> <remote-directory> [initial text]

Keep tmux local but run claude over ssh on <ssh-target>. The remote shell
must resolve `claude` on PATH.
HELP_EOF
      ;;
    help)
      cat <<'HELP_EOF'
claude-tmux help               Show full usage.
claude-tmux help <subcommand>  Show focused cheatsheet for one subcommand.
HELP_EOF
      ;;
    *)
      printf 'No focused help for %q. Available topics:\n' "$topic" >&2
      printf '  start resume start-ssh attach send send-wait-literal wait\n  wait-text wait-literal wait-and-capture capture result status\n  list stop doctor self-test help\n' >&2
      return 2
      ;;
  esac
}


require_bins() {
  if [[ -z "$TMUX" || ! -x "$TMUX" ]]; then
    echo "tmux not found. Install it with Homebrew or set TMUX=/path/to/tmux." >&2
    exit 1
  fi

  if [[ -z "$CLAUDE" || ! -x "$CLAUDE" ]]; then
    local claude_lookup
    claude_lookup="$(command -v claude 2>/dev/null || true)"
    echo "claude not found at ${CLAUDE:-<empty>}." >&2
    if [[ -n "$claude_lookup" ]]; then
      echo "Current PATH resolves claude to: $claude_lookup" >&2
      echo "Unset CLAUDE or set CLAUDE=$claude_lookup to use that install." >&2
    else
      echo "Current PATH does not resolve claude. Install Claude Code or set CLAUDE=/path/to/claude." >&2
    fi
    exit 1
  fi
}

require_tmux() {
  if [[ -z "$TMUX" || ! -x "$TMUX" ]]; then
    echo "tmux not found. Install it with Homebrew or set TMUX=/path/to/tmux." >&2
    exit 1
  fi
}

require_jq() {
  if [[ -z "$JQ" || ! -x "$JQ" ]]; then
    echo "jq not found. Install it with Homebrew or set JQ=/path/to/jq." >&2
    exit 1
  fi
}

clipboard_command() {
  if [[ "$TMUX_CLIPBOARD" == "internal" ]]; then
    return 0
  fi
  if [[ "$TMUX_CLIPBOARD" != "auto" ]]; then
    echo "$TMUX_CLIPBOARD"
    return 0
  fi

  if command -v pbcopy >/dev/null 2>&1; then
    echo "pbcopy"
  elif command -v wl-copy >/dev/null 2>&1; then
    echo "wl-copy"
  elif command -v xclip >/dev/null 2>&1; then
    echo "xclip -selection clipboard"
  elif command -v xsel >/dev/null 2>&1; then
    echo "xsel --clipboard --input"
  fi
}

tmux_conf_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf "%s" "$value"
}

clipboard_description() {
  local command
  command="$(clipboard_command)"
  if [[ -n "$command" ]]; then
    if [[ "$TMUX_CLIPBOARD" == "auto" ]]; then
      echo "auto ($command)"
    else
      echo "$command"
    fi
  elif [[ "$TMUX_CLIPBOARD" == "auto" ]]; then
    echo "auto (internal fallback)"
  else
    echo "internal"
  fi
}

write_tmux_conf() {
  cat > "$TMUX_CONF" <<'EOF'
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB"
set -as terminal-features ",tmux-256color:RGB"
set -ga terminal-overrides ",xterm-256color:Tc"
set -ga terminal-overrides ",tmux-256color:Tc"
set -g allow-passthrough on
set -s extended-keys on
set -as terminal-features ",xterm*:extkeys"
set -as terminal-features ",tmux*:extkeys"
set -as terminal-features ",xterm*:clipboard"
set -as terminal-features ",tmux*:clipboard"
set -g focus-events on
set -sg escape-time 10
set -g xterm-keys on
set -g set-clipboard on
set -g mode-keys vi
set -g status-keys vi
set-environment -g COLORTERM truecolor
set -g history-limit 50000
set -g status on
set -g status-position bottom
set -g status-interval 2
set -g status-style "bg=#111827,fg=#cbd5e1"
set -g status-left-length 64
set -g status-right-length 96
set -g status-left "#[bg=#2563eb,fg=#ffffff,bold] Claude #[bg=#111827,fg=#93c5fd] #S "
set -g status-right "#[fg=#64748b]#(pwd | sed 's#^$HOME#~#') #[fg=#22c55e]%H:%M "
set -g window-status-format "#[fg=#94a3b8] #I:#W "
set -g window-status-current-format "#[bg=#1f2937,fg=#ffffff,bold] #I:#W "
set -g pane-border-style "fg=#334155"
set -g pane-active-border-style "fg=#2563eb"
set -g message-style "bg=#1f2937,fg=#ffffff"
set -g mode-style "bg=#2563eb,fg=#ffffff"
set -g clock-mode-colour "#2563eb"
set -g display-panes-colour "#64748b"
set -g display-panes-active-colour "#22c55e"
EOF
  local copy_command
  copy_command="$(clipboard_command)"
  if [[ -n "$copy_command" ]]; then
    copy_command="$(tmux_conf_quote "$copy_command")"
    printf 'bind-key -T copy-mode-vi y send -X copy-pipe-and-cancel "%s"\n' "$copy_command" >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi Enter send -X copy-pipe-and-cancel "%s"\n' "$copy_command" >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "%s"\n' "$copy_command" >> "$TMUX_CONF"
  else
    printf 'bind-key -T copy-mode-vi y send -X copy-selection-and-cancel\n' >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi Enter send -X copy-selection-and-cancel\n' >> "$TMUX_CONF"
    printf 'bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-selection-and-cancel\n' >> "$TMUX_CONF"
  fi
  printf 'set -g mouse "%s"\n' "$TMUX_MOUSE" >> "$TMUX_CONF"
}

session_for_name() {
  local name="$1"
  if [[ ! "$name" =~ '^[A-Za-z0-9_.-]+$' ]]; then
    echo "Invalid session name: $name" >&2
    exit 2
  fi
  echo "$PREFIX-$name"
}

random_suffix() {
  LC_ALL=C /usr/bin/od -An -N3 -tx1 /dev/urandom | /usr/bin/tr -d ' \n'
}

shell_quote() {
  printf "%q" "$1"
}

paste_and_submit() {
  local session="$1"
  local buffer_name="$2"
  local prompt_text="$3"

  printf "%s" "$prompt_text" | "$TMUX" load-buffer -b "$buffer_name" -
  "$TMUX" paste-buffer -p -d -b "$buffer_name" -t "$session"
  sleep "$SUBMIT_DELAY"
  "$TMUX" send-keys -t "$session" Enter
  if [[ "$prompt_text" == *$'\n'* ]]; then
    sleep "$SUBMIT_DELAY"
    "$TMUX" send-keys -t "$session" Enter
  fi
}

# --- Sentinel / on-exit hook helpers (shared by start/resume; issue #132) ---
# Each helper either uses globals declared in the caller (sentinel,
# on_exit_cmd, sentinel_keep, session_env_args) or returns its output via
# stdout. Centralising them removes the duplication called out in the
# PR #130 review.

parse_sentinel_flags() {
  # Consumes --sentinel / --on-exit / --sentinel-keep from "$@" until the
  # next non-flag positional is seen, then publishes the remainder via the
  # SENTINEL_PARSE_REMAINING global. Caller does:
  #   parse_sentinel_flags "$@"; set -- "${SENTINEL_PARSE_REMAINING[@]}"
  #
  # `--sentinel` and `--on-exit` MUST take a value. If the value is missing
  # the function exits explicitly rather than letting `shift 2` fail under
  # `set -e` with a cryptic "shift count must be <= $#".
  SENTINEL_PARSE_REMAINING=()
  while [[ "${1:-}" == "--sentinel" || "${1:-}" == "--on-exit" || "${1:-}" == "--on-start" || "${1:-}" == "--sentinel-keep" ]]; do
    case "$1" in
      --sentinel)
        if (( $# < 2 )); then
          echo "--sentinel requires a value (absolute path)" >&2
          exit 2
        fi
        sentinel="$2"
        shift 2
        ;;
      --on-exit)
        if (( $# < 2 )); then
          echo "--on-exit requires a value (shell command)" >&2
          exit 2
        fi
        on_exit_cmd="$2"
        shift 2
        ;;
      --on-start)
        if (( $# < 2 )); then
          echo "--on-start requires a value (shell command)" >&2
          exit 2
        fi
        on_start_cmd="$2"
        shift 2
        ;;
      --sentinel-keep)
        # Placeholder: future stop_session work will use this flag to keep
        # the sentinel file across an explicit stop. Nothing reads it yet;
        # tracked alongside the #95 design doc cleanup semantics.
        sentinel_keep=1
        shift
        ;;
    esac
  done
  SENTINEL_PARSE_REMAINING=("$@")
}

validate_sentinel_flags() {
  # Validates sentinel (absolute path; not pre-existing) and warns if
  # --on-exit is set without --sentinel. May exit non-zero on hard errors.
  local tool="$1"
  if [[ -n "$sentinel" && "${sentinel:0:1}" != "/" ]]; then
    echo "--sentinel must be an absolute path: $sentinel" >&2
    exit 2
  fi
  if [[ -n "$sentinel" && -e "$sentinel" ]]; then
    echo "Sentinel path already exists: $sentinel" >&2
    echo "Remove it or pass a fresh --sentinel path to avoid stale-completion false positives." >&2
    exit 1
  fi
  if [[ -n "$on_exit_cmd" && -z "$sentinel" ]]; then
    echo "[$tool] warning: --on-exit ignored without --sentinel" >&2
    on_exit_cmd=""
  fi
}

apply_sentinel_env_args() {
  # Appends -e TMUX_AGENT_TOOLS_SENTINEL=... and -e TMUX_AGENT_TOOLS_ON_EXIT=...
  # to the caller's session_env_args array when set.
  if [[ -n "$sentinel" ]]; then
    session_env_args+=("-e" "TMUX_AGENT_TOOLS_SENTINEL=$sentinel")
  fi
  if [[ -n "$on_exit_cmd" ]]; then
    session_env_args+=("-e" "TMUX_AGENT_TOOLS_ON_EXIT=$on_exit_cmd")
  fi
}

sentinel_inline_block() {
  # Emits the shell snippet that goes between `code=$?` and the exit-message
  # printfs inside the tmux new-session command. The snippet:
  #   1. atomically writes the exit code to $TMUX_AGENT_TOOLS_SENTINEL
  #   2. runs the --on-exit hook with ON_EXIT_CODE / ON_EXIT_NAME exported,
  #      only when BOTH the sentinel path and the hook command are set.
  #
  # Escape gymnastics (DO NOT touch without re-running scripts/test-sentinel-smoke):
  #   - Outer printf is SINGLE-QUOTED so the wrapper shell does NOT expand
  #     $TMUX_AGENT_TOOLS_SENTINEL / $code etc. — those are for the pane shell.
  #   - '\''...'\'' = end-quote + literal `'` + start-quote, used to embed the
  #     inner `printf '%s\n'`.
  #   - %%s\\n = printf format that emits literal `%s\n` (two chars: percent-s
  #     and backslash-n). NOT a real newline; the tmux pane shell re-processes
  #     the `\n` when running the inner printf.
  #   - The last `%s` is the only real format spec, filled with the
  #     shell_quoted agent name so dangerous names cannot break out.
  local agent_name="$1"
  printf 'if [ -n "$TMUX_AGENT_TOOLS_SENTINEL" ]; then printf '\''%%s\\n'\'' "$code" > "$TMUX_AGENT_TOOLS_SENTINEL.tmp" && mv -f "$TMUX_AGENT_TOOLS_SENTINEL.tmp" "$TMUX_AGENT_TOOLS_SENTINEL"; fi; if [ -n "$TMUX_AGENT_TOOLS_ON_EXIT" ] && [ -n "$TMUX_AGENT_TOOLS_SENTINEL" ]; then ( export ON_EXIT_CODE="$code" ON_EXIT_NAME=%s; eval "$TMUX_AGENT_TOOLS_ON_EXIT" ) >> "$TMUX_AGENT_TOOLS_SENTINEL.hook.log" 2>&1 || true; fi' "$(shell_quote "$agent_name")"
}

# --- Safety fuses: --max-runtime / --max-idle (issue #105) ----------------
# Consumes `--max-runtime <seconds>` and `--max-idle <seconds>` from "$@",
# exposing MAX_FUSE_PARSE_REMAINING with the rest of the argv. Caller must
# pre-declare scalar locals `max_runtime` and `max_idle` (empty = unset).
parse_max_fuse_flags() {
  MAX_FUSE_PARSE_REMAINING=()
  while [[ "${1:-}" == "--max-runtime" || "${1:-}" == "--max-idle" ]]; do
    case "$1" in
      --max-runtime)
        if (( $# < 2 )); then
          echo "--max-runtime requires a value (seconds)" >&2
          exit 2
        fi
        if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
          echo "--max-runtime must be a positive integer (seconds): $2" >&2
          exit 2
        fi
        max_runtime="$2"
        shift 2
        ;;
      --max-idle)
        if (( $# < 2 )); then
          echo "--max-idle requires a value (seconds)" >&2
          exit 2
        fi
        if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
          echo "--max-idle must be a positive integer (seconds): $2" >&2
          exit 2
        fi
        max_idle="$2"
        shift 2
        ;;
    esac
  done
  MAX_FUSE_PARSE_REMAINING=("$@")
}

# Background watcher loop, runs in a detached subshell launched via nohup.
# Polls the tmux session every second; if --max-runtime or --max-idle is
# tripped, writes 124 + reason to the sentinel/reason sidecar, runs the
# on-exit hook with ON_EXIT_REASON, and tears down the tmux session.
#
# Invariants:
#   - Both fuses may coexist; whichever fires first wins.
#   - Watcher exits silently when the tmux session disappears (normal stop
#     handled teardown).
#   - Pane idle = sha256 of `capture-pane -p` unchanged. Hash kept in the
#     watcher's own memory to avoid racing `status --json`'s hash file.
max_fuse_watcher_loop() {
  local agent_name="$1" tmux_session="$2" sentinel="$3" on_exit_cmd="$4"
  local max_runtime="$5" max_idle="$6" tmux_bin="$7"
  zmodload zsh/datetime 2>/dev/null || true
  local started_epoch="${EPOCHSECONDS:-$(date +%s)}"
  local last_hash=""
  local last_change_epoch="$started_epoch"
  local reason=""
  local now_epoch pane_text new_hash
  while :; do
    sleep 1
    if ! "$tmux_bin" has-session -t "$tmux_session" 2>/dev/null; then
      return 0
    fi
    now_epoch="${EPOCHSECONDS:-$(date +%s)}"
    if [[ -n "$max_runtime" ]] && (( now_epoch - started_epoch >= max_runtime )); then
      reason="max_runtime"
      break
    fi
    if [[ -n "$max_idle" ]]; then
      pane_text="$("$tmux_bin" capture-pane -p -t "$tmux_session" 2>/dev/null || true)"
      if command -v sha256sum >/dev/null 2>&1; then
        new_hash="$(printf '%s' "$pane_text" | sha256sum | awk '{print $1}')"
      else
        new_hash="$(printf '%s' "$pane_text" | shasum -a 256 | awk '{print $1}')"
      fi
      if [[ "$new_hash" != "$last_hash" ]]; then
        last_hash="$new_hash"
        last_change_epoch="$now_epoch"
      elif (( now_epoch - last_change_epoch >= max_idle )); then
        reason="max_idle"
        break
      fi
    fi
  done

  if [[ -z "$reason" ]]; then
    return 0
  fi

  # Trip: write sentinel + reason BEFORE killing the session so the pane
  # epilogue's own sentinel write loses the race (mv -f is last writer,
  # and we want 124 to win).
  if [[ -n "$sentinel" ]]; then
    ( printf '%s\n' "124" > "$sentinel.tmp" && mv -f "$sentinel.tmp" "$sentinel" ) 2>/dev/null || true
    ( printf '%s\n' "$reason" > "$sentinel.reason.tmp" && mv -f "$sentinel.reason.tmp" "$sentinel.reason" ) 2>/dev/null || true
  fi
  if [[ -n "$on_exit_cmd" && -n "$sentinel" ]]; then
    (
      export ON_EXIT_CODE=124 ON_EXIT_NAME="$agent_name" ON_EXIT_REASON="$reason"
      eval "$on_exit_cmd"
    ) >> "$sentinel.hook.log" 2>&1 || true
  fi
  "$tmux_bin" kill-session -t "$tmux_session" 2>/dev/null || true
  rm -f "$(agent_root_dir)/$agent_name/fuse.pid" 2>/dev/null || true
  return 0
}

# Spawn the watcher as a detached background process. Records PID under
# $TMUX_AGENT_DIR/<name>/fuse.pid so `stop` can kill it before tearing
# down tmux.
spawn_max_fuse_watcher() {
  local agent_name="$1" tmux_session="$2" sentinel="$3" on_exit_cmd="$4"
  local max_runtime="$5" max_idle="$6"
  [[ -z "$max_runtime" && -z "$max_idle" ]] && return 0
  local subdir
  subdir="$(ensure_agent_dir "$agent_name")"
  local pid_file="$subdir/fuse.pid"
  nohup "$SELF" __fuse_watcher \
    "$agent_name" "$tmux_session" "$sentinel" "$on_exit_cmd" \
    "$max_runtime" "$max_idle" "$TMUX" \
    >/dev/null 2>&1 </dev/null &
  local watcher_pid=$!
  disown 2>/dev/null || true
  printf '%s\n' "$watcher_pid" > "$pid_file" 2>/dev/null || true
}

# Kill the watcher PID recorded by spawn_max_fuse_watcher, if any.
kill_max_fuse_watcher() {
  local agent_name="$1"
  local pid_file
  pid_file="$(agent_root_dir)/$agent_name/fuse.pid"
  [[ -f "$pid_file" ]] || return 0
  local pid
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file" 2>/dev/null || true
}

run_on_start_hook() {
  # Fires the --on-start hook (issue #101a) after `tmux new-session` returns.
  # Best-effort timing: pane is created but the CLI may not yet have rendered
  # its first prompt. Hook runs in a detached subshell so wrapper return is
  # not blocked. Non-zero hook exit is logged but never fails the agent.
  #
  # Hook log path mirrors the on-exit hook:
  #   - <sentinel>.hook.log when --sentinel is set
  #   - $TMUX_AGENT_DIR/<name>/hook.log otherwise
  local agent_name="$1" agent_session="$2"
  [[ -n "$on_start_cmd" ]] || return 0
  local log_path
  if [[ -n "$sentinel" ]]; then
    log_path="$sentinel.hook.log"
  else
    ensure_agent_dir "$agent_name"
    log_path="$(agent_root_dir)/$agent_name/hook.log"
  fi
  (
    export TMUX_AGENT_NAME="$agent_name" TMUX_AGENT_SESSION="$agent_session"
    {
      printf '[on-start %s] %s\n' "$(transcript_iso_now)" "$agent_name"
      # Isolate eval in its OWN subshell so `exit N` only kills the inner
      # shell, allowing the exit-code line below to still be logged.
      hook_code=0
      ( eval "$on_start_cmd" ) || hook_code=$?
      printf '[on-start exit] %s\n' "$hook_code"
    } >> "$log_path" 2>&1
  ) &
}

# --- Dry-run pre-flight checks (issue #110) -------------------------------
# Verify the named start would succeed without launching tmux or the CLI.
# Emits a JSON summary on stdout. Exit 0 if all checks pass, 2 if any
# critical check fails. Warnings (e.g. transcript probe fallback) do not
# fail the run.
run_dry_run_checks() {
  require_jq
  local tool="$1" req_name="$2" directory="$3" exact_name="$4"
  local sentinel="$5" on_exit_cmd="$6" transcript_path="$7"
  local checks_json="[]"

  add_check() {
    local check_name="$1" check_status="$2" detail="$3"
    checks_json="$("$JQ" -c -n --argjson cs "$checks_json" \
      --arg name "$check_name" --arg status "$check_status" --arg detail "$detail" \
      '$cs + [{name: $name, status: $status, detail: $detail}]')"
  }

  local ok=1
  # workdir
  if [[ -d "$directory" ]]; then
    add_check "workdir_exists" "pass" "$directory"
  else
    add_check "workdir_exists" "fail" "directory not found: $directory"
    ok=0
  fi

  # tmux binary
  if [[ -x "$TMUX" ]] || command -v "$TMUX" >/dev/null 2>&1; then
    add_check "tmux_binary" "pass" "$TMUX"
  else
    add_check "tmux_binary" "fail" "tmux not found at $TMUX"
    ok=0
  fi

  # agent CLI binary — pick the correct env var based on tool
  local cli_path
  case "$tool" in
    codex-tmux)  cli_path="${CODEX:-codex}" ;;
    claude-tmux) cli_path="${CLAUDE:-claude}" ;;
    *)           cli_path="" ;;
  esac
  if [[ -n "$cli_path" ]] && ( [[ -x "$cli_path" ]] || command -v "$cli_path" >/dev/null 2>&1 ); then
    add_check "agent_cli_binary" "pass" "$cli_path"
  else
    add_check "agent_cli_binary" "fail" "agent CLI not resolvable: $cli_path (tool=$tool)"
    ok=0
  fi

  # session name conflict (only with --exact; non-exact appends a suffix)
  local session_name
  if (( exact_name )); then
    session_name="$(session_for_name "$req_name")"
    if "$TMUX" has-session -t "$session_name" 2>/dev/null; then
      add_check "session_not_in_use" "fail" "session already exists: $session_name (would be killed by start)"
      ok=0
    else
      add_check "session_not_in_use" "pass" "$session_name"
    fi
  else
    add_check "session_not_in_use" "skip" "non-exact name appends random suffix"
  fi

  # sentinel
  if [[ -n "$sentinel" ]]; then
    if [[ "${sentinel:0:1}" != "/" ]]; then
      add_check "sentinel_path" "fail" "--sentinel must be absolute: $sentinel"
      ok=0
    elif [[ -e "$sentinel" ]]; then
      add_check "sentinel_path" "fail" "pre-existing: $sentinel (would block start)"
      ok=0
    else
      local sentinel_parent="${sentinel:h}"
      if [[ -d "$sentinel_parent" && -w "$sentinel_parent" ]]; then
        add_check "sentinel_path" "pass" "$sentinel"
      else
        add_check "sentinel_path" "fail" "parent not writable: $sentinel_parent"
        ok=0
      fi
    fi
  else
    add_check "sentinel_path" "skip" "no --sentinel"
  fi

  # on-exit hook requires sentinel
  if [[ -n "$on_exit_cmd" ]]; then
    if [[ -z "$sentinel" ]]; then
      add_check "on_exit_pairing" "fail" "--on-exit requires --sentinel"
      ok=0
    else
      add_check "on_exit_pairing" "pass" "hook = $on_exit_cmd"
    fi
  else
    add_check "on_exit_pairing" "skip" "no --on-exit"
  fi

  # transcript — check parent dir is writable WITHOUT creating the file
  if [[ -n "$transcript_path" ]]; then
    if [[ "${transcript_path:0:1}" != "/" ]]; then
      add_check "transcript_path" "fail" "--transcript must be absolute: $transcript_path"
      ok=0
    elif [[ -e "$transcript_path" ]]; then
      add_check "transcript_path" "fail" "pre-existing: $transcript_path"
      ok=0
    else
      local transcript_parent="${transcript_path:h}"
      if [[ -d "$transcript_parent" && -w "$transcript_parent" ]]; then
        add_check "transcript_path" "pass" "$transcript_path"
      else
        add_check "transcript_path" "fail" "parent not writable: $transcript_parent"
        ok=0
      fi
    fi
  else
    add_check "transcript_path" "skip" "no --transcript"
  fi

  local ok_bool
  if (( ok )); then ok_bool=true; else ok_bool=false; fi
  "$JQ" -n --argjson checks "$checks_json" --argjson ok "$ok_bool" \
    --arg tool "$tool" --arg name "$req_name" --arg directory "$directory" \
    '{schema_version: 1, tool: $tool, name: $name, directory: $directory,
      ok: $ok, checks: $checks}'
  if (( ok )); then return 0; else return 2; fi
}

# --- Result-file convention helpers (issue #97) ---------------------------
# Layout under $TMUX_AGENT_DIR (default $XDG_STATE_HOME/tmux-agent-tools):
#   <dir>/<agent-name>/result.json
# Wrapper exports TMUX_AGENT_NAME and TMUX_AGENT_RESULT into the pane so the
# agent CLI can write its structured result without inventing a path.

agent_root_dir() {
  printf '%s' "${TMUX_AGENT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agent-tools}"
}

ensure_agent_dir() {
  local name="$1"
  local dir
  dir="$(agent_root_dir)/$name"
  mkdir -p "$dir"
  printf '%s' "$dir"
}

# --- Advisory send lock (issue #102) --------------------------------------
# Serialize concurrent pane-mutating calls (`send`, `send-wait-literal`) on
# the same agent so two callers cannot interleave keystrokes into the same
# tmux pane.
#
# Lock file: $TMUX_AGENT_DIR/<name>/send.lock
# Prefers flock(1) (Linux/coreutils). On macOS without flock, falls back to
# mkdir-based locking with PID stamping for stale-holder recovery — design
# in docs/design-issue-102-advisory-lock.md.
#
# The fallback recovers from `kill -9`, OOM, or reboot by probing the
# holder PID with `kill -0`. The trap inside the subshell is intentionally
# scoped to the subshell so it does NOT clobber the caller's process-wide
# trap (partner review on the original sketch).

SEND_LOCK_DEFAULT_TIMEOUT=30

send_lock_around() {
  # Usage: send_lock_around <agent_name> <timeout_seconds> <cmd> [args...]
  # Returns 75 on timeout (EX_TEMPFAIL) with stderr message, else inner rc.
  local agent_name="$1"
  local timeout_seconds="$2"
  shift 2
  local subdir
  subdir="$(ensure_agent_dir "$agent_name")"
  local lock_file="$subdir/send.lock"

  if command -v flock >/dev/null 2>&1; then
    : > "$lock_file" 2>/dev/null || true
    (
      flock -w "$timeout_seconds" -x 9 || {
        echo "lock contended on $agent_name after ${timeout_seconds}s" >&2
        exit 75
      }
      "$@"
    ) 9>"$lock_file"
    return $?
  fi

  # mkdir fallback with PID-stamped stale-holder recovery.
  zmodload zsh/datetime 2>/dev/null || true
  local lock_dir="$lock_file.d"
  local now_epoch end
  now_epoch="${EPOCHSECONDS:-$(date +%s)}"
  end=$(( now_epoch + timeout_seconds ))
  while ! mkdir "$lock_dir" 2>/dev/null; do
    local holder_pid=""
    [[ -f "$lock_dir/pid" ]] && holder_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    if [[ -n "$holder_pid" ]] && ! kill -0 "$holder_pid" 2>/dev/null; then
      # Holder died without releasing — reclaim. rm -rf because the pid
      # file lives inside the lock dir; rmdir alone would fail.
      rm -rf "$lock_dir" 2>/dev/null || true
      continue
    fi
    if [[ -z "$holder_pid" ]]; then
      sleep 0.2
      [[ -f "$lock_dir/pid" ]] || { rm -rf "$lock_dir" 2>/dev/null || true; continue; }
    fi
    now_epoch="${EPOCHSECONDS:-$(date +%s)}"
    if (( now_epoch >= end )); then
      echo "lock contended on $agent_name after ${timeout_seconds}s (holder pid=$holder_pid)" >&2
      return 75
    fi
    sleep 0.1
  done
  printf '%s\n' "$$" > "$lock_dir/pid"
  # Subshell-scoped trap: do NOT use a process-wide trap here, it would
  # overwrite the caller's trap. rm -rf because the pid file lives inside
  # the lock dir; rmdir alone would fail and leak the lock.
  (
    trap "rm -rf '$lock_dir' 2>/dev/null || true" EXIT INT TERM
    "$@"
  )
  local rc=$?
  rm -rf "$lock_dir" 2>/dev/null || true
  return $rc
}

# --- Single-agent transcript helpers (issue #100) -------------------------
# A transcript captures wrapper-level events (start / send / capture / stop)
# as JSONL. Path is configured at `start --transcript <abs>` and remembered
# for subsequent subcommands via $TMUX_AGENT_DIR/<name>/transcript-path.

transcript_path_for() {
  # IMPORTANT: zsh aliases lowercase `path` to PATH; never use `local
  # path=` in any helper here. Use `target` or another name.
  local name="$1"
  local marker="$(agent_root_dir)/$name/transcript-path"
  [[ -f "$marker" ]] && cat "$marker" || true
}

transcript_record_path() {
  # NOTE: parameter named `target` not `path` — zsh ties lowercase `path`
  # to PATH, and `local path=...` would clobber PATH for the rest of the
  # function, breaking every external command lookup that follows.
  local name="$1" target="$2"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  printf '%s\n' "$target" > "$subdir/transcript-path"
}

transcript_iso_now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

transcript_truncate_record() {
  # Persist per-agent text-truncate threshold (#140). Stored as a single
  # decimal byte-count under $TMUX_AGENT_DIR/<name>/transcript-truncate.
  local name="$1" bytes="$2"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  ( printf '%s\n' "$bytes" > "$subdir/transcript-truncate" ) 2>/dev/null || true
}

transcript_truncate_threshold() {
  # Returns the persisted threshold, or empty when unset.
  local name="$1"
  local marker="$(agent_root_dir)/$name/transcript-truncate"
  [[ -f "$marker" ]] && cat "$marker" || true
}

transcript_truncate_text() {
  # Apply the #140 truncate policy to a send-event text payload.
  # Echoes a JSON object with `text`, `text_sha256`, `text_bytes`. When the
  # threshold is unset or the text fits, `text` is the verbatim payload
  # and the hash/bytes fields are null.
  local name="$1" text="$2"
  local threshold
  threshold="$(transcript_truncate_threshold "$name")"
  local bytes=${#text}
  if [[ -n "$threshold" ]] && (( threshold > 0 )) && (( bytes > threshold )); then
    local sha
    if command -v sha256sum >/dev/null 2>&1; then
      sha="$(printf '%s' "$text" | sha256sum | awk '{print $1}')"
    else
      sha="$(printf '%s' "$text" | shasum -a 256 | awk '{print $1}')"
    fi
    "$JQ" -c -n --arg text "[truncated, original $bytes bytes]" \
      --arg sha "$sha" --argjson bytes "$bytes" \
      '{text: $text, text_sha256: $sha, text_bytes: $bytes}'
  else
    "$JQ" -c -n --arg text "$text" --argjson bytes "$bytes" \
      '{text: $text, text_sha256: null, text_bytes: $bytes}'
  fi
}

transcript_emit_wait_event() {
  # Emit a single wait_* event into the transcript when one is configured
  # (issue #141). Caller passes the wrapper-specific wait kind and the
  # outcome reason. needle/timeout are best-effort metadata.
  local name="$1" event_name="$2" outcome="$3" needle="${4:-}" timeout="${5:-}"
  local transcript_path
  transcript_path="$(transcript_path_for "$name")"
  [[ -n "$transcript_path" ]] || return 0
  local line
  line="$("$JQ" -c -n \
    --arg event "$event_name" --arg name "$name" --arg outcome "$outcome" \
    --arg needle "$needle" --arg timeout "$timeout" \
    --arg at "$(transcript_iso_now)" \
    '{schema_version: 1, event: $event, name: $name, outcome: $outcome,
      needle: (if $needle == "" then null else $needle end),
      timeout_seconds: (if $timeout == "" then null else ($timeout | tonumber) end),
      at: $at}')"
  transcript_append "$transcript_path" "$line"
}

result_schema_record() {
  # Persist per-agent --result-schema path (#125) under
  # $TMUX_AGENT_DIR/<name>/result-schema-path. Best-effort write.
  local name="$1" target="$2"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  ( printf '%s\n' "$target" > "$subdir/result-schema-path" ) 2>/dev/null || true
}

result_schema_path_for() {
  # Returns the configured schema path or empty if none.
  local name="$1"
  local marker="$(agent_root_dir)/$name/result-schema-path"
  [[ -f "$marker" ]] && cat "$marker" || true
}

result_validate_lightweight() {
  # Lightweight v1 validator (#125): checks top-level type + required +
  # additionalProperties:false. Emits a single JSON line.
  # Args: $1 result_path, $2 schema_path
  local result_path="$1" schema_path="$2"
  require_jq

  if [[ ! -f "$schema_path" ]]; then
    "$JQ" -n --arg p "$schema_path" \
      '{schema_version: 1, present: false, valid: false,
        errors: [{path: ".", message: ("schema file not found: " + $p)}], body: null}'
    return 1
  fi
  local schema
  schema="$(cat "$schema_path")"

  if [[ ! -f "$result_path" ]]; then
    "$JQ" -n '{schema_version: 1, present: false, valid: false, errors: [], body: null}'
    return 0
  fi

  # Parse result. If parse fails, report parse_error.
  local body
  body="$("$JQ" '.' "$result_path" 2>/dev/null)" || {
    "$JQ" -n --arg raw "$(cat "$result_path")" \
      '{schema_version: 1, present: true, valid: false,
        errors: [{path: ".", message: "parse_error: result is not valid JSON"}],
        body: $raw}'
    return 2
  }

  # Run v1 validator in one jq invocation.
  "$JQ" -n --argjson schema "$schema" --argjson body "$body" '
    def v1_validate($schema; $body):
      # type check
      ( $schema.type as $t
        | if $t == "object" and ($body | type) != "object"
          then [{path: ".", message: ("type mismatch: expected " + $t + ", got " + ($body | type))}]
          elif $t == "array" and ($body | type) != "array"
          then [{path: ".", message: ("type mismatch: expected " + $t + ", got " + ($body | type))}]
          elif $t == "string" and ($body | type) != "string"
          then [{path: ".", message: ("type mismatch: expected " + $t + ", got " + ($body | type))}]
          elif $t == "integer" and ($body | type) != "number"
          then [{path: ".", message: ("type mismatch: expected " + $t + ", got " + ($body | type))}]
          elif $t == "number" and ($body | type) != "number"
          then [{path: ".", message: ("type mismatch: expected " + $t + ", got " + ($body | type))}]
          elif $t == "boolean" and ($body | type) != "boolean"
          then [{path: ".", message: ("type mismatch: expected " + $t + ", got " + ($body | type))}]
          else [] end
      ) as $type_errors
      | # required keys (object only)
        ( if ($schema.type // "object") == "object" and ($body | type) == "object"
          then ($schema.required // [])
               | map(select(. as $k | ($body | has($k)) | not))
               | map({path: ".", message: ("missing required key: " + .)})
          else [] end
        ) as $required_errors
      | # additionalProperties:false (object only)
        ( if $schema.additionalProperties == false
             and ($body | type) == "object"
          then ($body | keys) - (($schema.properties // {}) | keys)
               | map({path: ., message: "additional property not allowed"})
          else [] end
        ) as $extra_errors
      | $type_errors + $required_errors + $extra_errors;
    ($body | tojson) as $body_json
    | v1_validate($schema; $body) as $errs
    | {schema_version: 1, present: true, valid: ($errs | length == 0),
       errors: $errs, body: $body}'

  # Exit code: 0 if valid, 2 if invalid.
  local valid
  valid="$("$JQ" -n --argjson schema "$schema" --argjson body "$body" '
    def v1_validate($schema; $body):
      ( $schema.type as $t
        | if $t == "object" and ($body | type) != "object" then [1]
          elif $t == "array" and ($body | type) != "array" then [1]
          else [] end
      ) as $type_errors
      | ( if ($schema.type // "object") == "object" and ($body | type) == "object"
          then ($schema.required // [])
               | map(select(. as $k | ($body | has($k)) | not))
          else [] end
        ) as $required_errors
      | ( if $schema.additionalProperties == false
             and ($body | type) == "object"
          then ($body | keys) - (($schema.properties // {}) | keys)
          else [] end
        ) as $extra_errors
      | ($type_errors + $required_errors + $extra_errors | length == 0);
    v1_validate($schema; $body)
  ')"
  [[ "$valid" == "true" ]] && return 0 || return 2
}

tag_record() {
  # Persist --tag key=value pairs (#124) under $TMUX_AGENT_DIR/<name>/tags.json.
  # Args: $1 name, $2 raw "k=v" string. Validates k matches [A-Za-z0-9_.-]+.
  # Multiple values for the same key are kept (last write wins per repeat).
  local name="$1" kv="$2"
  if [[ "$kv" != *=* ]]; then
    echo "--tag must be key=value: $kv" >&2
    return 2
  fi
  local k="${kv%%=*}" v="${kv#*=}"
  if ! [[ "$k" =~ ^[A-Za-z0-9_.-]+$ ]]; then
    echo "--tag key must match [A-Za-z0-9_.-]+: $k" >&2
    return 2
  fi
  require_jq
  local subdir tags_file existing
  subdir="$(ensure_agent_dir "$name")"
  tags_file="$subdir/tags.json"
  existing='{}'
  if [[ -f "$tags_file" ]]; then
    existing="$(cat "$tags_file")"
  fi
  local merged
  merged="$("$JQ" -c -n --arg k "$k" --arg v "$v" --argjson cur "$existing" \
    '$cur + {($k): $v}')"
  ( printf '%s\n' "$merged" > "$tags_file" ) 2>/dev/null || true
}

tag_list_json() {
  # Emit the persisted tags as a JSON object, or {} if absent.
  local name="$1"
  local tags_file="$(agent_root_dir)/$name/tags.json"
  if [[ -f "$tags_file" ]]; then
    cat "$tags_file"
  else
    printf '{}'
  fi
}

# --- status --json liveness helpers (issue #98) ----------------------------

record_started_at() {
  local name="$1"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  ( date -u +%Y-%m-%dT%H:%M:%SZ > "$subdir/started_at" ) 2>/dev/null || true
}

read_started_at() {
  local name="$1"
  local file="$(agent_root_dir)/$name/started_at"
  [[ -f "$file" ]] && cat "$file" || true
}

marker_seen_add() {
  local name="$1" needle="$2"
  [[ -z "$needle" ]] && return 0
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  local file="$subdir/marker_seen"
  if [[ -f "$file" ]] && grep -Fxq "$needle" "$file" 2>/dev/null; then
    return 0
  fi
  printf '%s\n' "$needle" >> "$file"
  if [[ -f "$file" ]] && (( $(wc -l < "$file") > 100 )); then
    tail -n 100 "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
  fi
}

marker_seen_list_json() {
  # Single-jq form (gemini-code-assist on PR #142): `-Rs` slurps the file
  # as a string, then split on newline and drop empty entries.
  local name="$1"
  local file="$(agent_root_dir)/$name/marker_seen"
  if [[ -f "$file" ]]; then
    "$JQ" -Rs 'split("\n") | map(select(length > 0))' "$file"
  else
    printf '[]'
  fi
}

update_pane_hash() {
  local name="$1" pane_text="$2"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  local hash_file="$subdir/pane-hash"
  # Prefer sha256sum (GNU coreutils — ubiquitous on Linux); fall back to
  # shasum (Perl-based, default on macOS). gemini-code-assist on PR #142
  # caught that minimal Linux distros may ship without Perl.
  local new_hash
  if command -v sha256sum >/dev/null 2>&1; then
    new_hash="$(printf '%s' "$pane_text" | sha256sum | awk '{print $1}')"
  else
    new_hash="$(printf '%s' "$pane_text" | shasum -a 256 | awk '{print $1}')"
  fi
  local now_iso
  now_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local stored_hash="" stored_at=""
  if [[ -f "$hash_file" ]]; then
    stored_hash="$(awk '{print $1}' "$hash_file")"
    stored_at="$(awk '{print $2}' "$hash_file")"
  fi
  if [[ "$new_hash" != "$stored_hash" ]]; then
    # #144: degrade silently — status --json must remain readable even
    # if the hash file cannot be written.
    # Subshell isolates the shell's own redirect-open error, which
    # `2>/dev/null` on the printf line alone does NOT catch in zsh.
    if ( printf '%s %s\n' "$new_hash" "$now_iso" > "$hash_file" ) 2>/dev/null; then
      stored_at="$now_iso"
    fi
  fi
  printf '%s' "$stored_at"
}

iso_epoch_diff_seconds() {
  local iso="$1"
  [[ -z "$iso" ]] && { printf '%s' 0; return 0; }
  local now=$(date -u +%s)
  local then
  if [[ "$(uname)" == "Darwin" ]]; then
    then="$(date -u -j -f %Y-%m-%dT%H:%M:%SZ "$iso" +%s 2>/dev/null || echo "$now")"
  else
    then="$(date -u -d "$iso" +%s 2>/dev/null || echo "$now")"
  fi
  printf '%s' $((now - then))
}

transcript_append() {
  # NOTE: parameter is `target` (not `path`) — see transcript_record_path
  # for the zsh PATH/path tied-pair gotcha.
  local target="$1" line="$2"
  [[ -z "$target" ]] && return 0
  printf '%s\n' "$line" >> "$target" 2>/dev/null || true
}

apply_result_env_args() {
  local name="$1"
  local subdir
  subdir="$(ensure_agent_dir "$name")"
  local result_path="$subdir/result.json"
  rm -f "$result_path"
  session_env_args+=("-e" "TMUX_AGENT_NAME=$name")
  session_env_args+=("-e" "TMUX_AGENT_RESULT=$result_path")
}

start_session() {
  require_bins
  write_tmux_conf
  local should_attach=0
  local exact_name=0

  local dry_run=0
  while [[ "${1:-}" == "--attach" || "${1:-}" == "--exact" || "${1:-}" == "--dry-run" ]]; do
    case "$1" in
      --attach)
        should_attach=1
        ;;
      --exact)
        exact_name=1
        ;;
      --dry-run)
        dry_run=1
        ;;
    esac
    shift
  done

  local sentinel=""
  local on_exit_cmd=""
  local on_start_cmd=""
  local sentinel_keep=0
  parse_sentinel_flags "$@"
  set -- "${SENTINEL_PARSE_REMAINING[@]}"

  local max_runtime=""
  local max_idle=""
  parse_max_fuse_flags "$@"
  set -- "${MAX_FUSE_PARSE_REMAINING[@]}"

  local transcript_path=""
  local transcript_truncate=""
  local result_schema_path=""
  local -a pending_tags
  pending_tags=()
  while [[ "${1:-}" == "--transcript" || "${1:-}" == "--record" || "${1:-}" == "--transcript-text-truncate" || "${1:-}" == "--result-schema" || "${1:-}" == "--tag" ]]; do
    case "$1" in
      --transcript|--record)
        if (( $# < 2 )); then
          echo "--transcript requires a value (absolute path)" >&2
          exit 2
        fi
        transcript_path="$2"
        shift 2
        ;;
      --transcript-text-truncate)
        if (( $# < 2 )); then
          echo "--transcript-text-truncate requires a positive integer" >&2
          exit 2
        fi
        if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
          echo "--transcript-text-truncate must be a positive integer: $2" >&2
          exit 2
        fi
        transcript_truncate="$2"
        shift 2
        ;;
      --result-schema)
        if (( $# < 2 )); then
          echo "--result-schema requires a value (absolute path)" >&2
          exit 2
        fi
        if [[ "${2:0:1}" != "/" ]]; then
          echo "--result-schema must be an absolute path: $2" >&2
          exit 2
        fi
        if [[ ! -f "$2" ]]; then
          echo "--result-schema file not found: $2" >&2
          exit 1
        fi
        result_schema_path="$2"
        shift 2
        ;;
      --tag)
        if (( $# < 2 )); then
          echo "--tag requires a value (key=value)" >&2
          exit 2
        fi
        if [[ "$2" != *=* ]]; then
          echo "--tag must be key=value: $2" >&2
          exit 2
        fi
        pending_tags+=("$2")
        shift 2
        ;;
    esac
  done

  local requested_name="${1:-}"
  local directory="${2:-}"
  shift 2 || true
  local initial_text="${*:-}"

  if [[ -z "$requested_name" || -z "$directory" ]]; then
    echo "Usage: claude-tmux start [--attach] [--exact] [--dry-run] [--sentinel <path>] [--on-start <cmd>] [--on-exit <cmd>] [--sentinel-keep] [--max-runtime <seconds>] [--max-idle <seconds>] [--transcript <path>] [--transcript-text-truncate <N>] <name> <directory> [initial text]" >&2
    exit 2
  fi

  if (( dry_run )); then
    run_dry_run_checks claude-tmux "$requested_name" "$directory" "$exact_name" \
      "$sentinel" "$on_exit_cmd" "$transcript_path"
    exit $?
  fi

  if [[ ! -d "$directory" ]]; then
    echo "Directory not found: $directory" >&2
    exit 1
  fi

  validate_sentinel_flags claude-tmux
  if [[ -n "$transcript_path" && "${transcript_path:0:1}" != "/" ]]; then
    echo "--transcript must be an absolute path: $transcript_path" >&2
    exit 2
  fi
  if [[ -n "$transcript_path" && -e "$transcript_path" ]]; then
    echo "Transcript path already exists: $transcript_path" >&2
    exit 1
  fi
  if [[ -n "$transcript_path" ]]; then
    require_jq
    # Write probe (partner R7 critique): transcript_append is best-effort
    # for runtime resilience, but a silent silent-failure at start would
    # produce an empty audit trail with no operator-visible warning. Fail
    # loudly at start if the path is not writable.
    if ! ( : > "$transcript_path" ) 2>/dev/null; then
      echo "--transcript path is not writable: $transcript_path" >&2
      exit 1
    fi
    rm -f "$transcript_path"
  fi

  local name="$requested_name"
  if (( ! exact_name )); then
    name="$requested_name-$(random_suffix)"
  fi

  local session="$(session_for_name "$name")"
  local -a session_env_args
  local session_env_entry
  session_env_args=()
  while IFS= read -r session_env_entry; do
    [[ -n "$session_env_entry" ]] || continue
    session_env_args+=("-e" "$session_env_entry")
  done <<< "${TMUX_AGENT_TOOLS_SESSION_ENV:-}"
  apply_sentinel_env_args
  apply_result_env_args "$name"
  record_started_at "$name"
  for tag in "${pending_tags[@]}"; do
    tag_record "$name" "$tag" || true
  done
  if [[ -n "$transcript_path" ]]; then
    transcript_record_path "$name" "$transcript_path"
    if [[ -n "$transcript_truncate" ]]; then
      transcript_truncate_record "$name" "$transcript_truncate"
    fi
  fi
  if [[ -n "$result_schema_path" ]]; then
    result_schema_record "$name" "$result_schema_path"
  fi
  if true; then
  fi
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
  fi

  "$TMUX" -f "$TMUX_CONF" new-session "${session_env_args[@]}" -d -s "$session" -c "$directory" \
    "printf '%s\n' 'claude-tmux agent: $name' 'requested name: $requested_name' 'tmux session: $session' 'cwd: $directory' 'send: $SELF send $name <text>' 'capture: $SELF capture $name 120' ''; $(shell_quote "$CLAUDE") --dangerously-skip-permissions; code=\$?; $(sentinel_inline_block "$name"); printf '\n[claude-tmux] local command exited with code %s\n' \"\$code\"; printf '[claude-tmux] press Enter to close this pane\n'; read _; exit \"\$code\""

  spawn_max_fuse_watcher "$name" "$session" "$sentinel" "$on_exit_cmd" "$max_runtime" "$max_idle"
  run_on_start_hook "$name" "$session"

  if [[ -n "$transcript_path" ]]; then
    local start_line
    start_line="$("$JQ" -c -n \
      --arg event start --arg tool claude --arg name "$name" \
      --arg session "$session" --arg cwd "$directory" \
      --arg at "$(transcript_iso_now)" \
      '{schema_version: 1, event: $event, tool: $tool, name: $name,
        session: $session, cwd: $cwd, at: $at}')"
    transcript_append "$transcript_path" "$start_line"
  fi

  echo "agent: $name"
  echo "Started $session"
  echo "cwd:  $directory"
  echo "send: $SELF send $name <text>"
  echo "wait: $SELF wait $name 180"
  echo "wait-text: $SELF wait-text $name '<regex>' 180"
  echo "wait-literal: $SELF wait-literal $name '<text>' 180"
  echo "capture: $SELF capture $name 120"
  if [[ -n "$initial_text" ]]; then
    sleep 3
    local buffer_name="$session-init"
    paste_and_submit "$session" "$buffer_name" "$initial_text"
    echo "sent: $initial_text"
  else
    echo "sent: <none>"
  fi

  if (( should_attach )); then
    "$TMUX" attach -t "$session"
  fi
}

resume_session() {
  require_bins
  write_tmux_conf
  local should_attach=0
  local exact_name=0

  while [[ "${1:-}" == "--attach" || "${1:-}" == "--exact" ]]; do
    case "$1" in
      --attach)
        should_attach=1
        ;;
      --exact)
        exact_name=1
        ;;
    esac
    shift
  done

  local sentinel=""
  local on_exit_cmd=""
  local on_start_cmd=""
  local sentinel_keep=0
  parse_sentinel_flags "$@"
  set -- "${SENTINEL_PARSE_REMAINING[@]}"

  local max_runtime=""
  local max_idle=""
  parse_max_fuse_flags "$@"
  set -- "${MAX_FUSE_PARSE_REMAINING[@]}"

  local transcript_path=""
  local transcript_truncate=""
  local result_schema_path=""
  local -a pending_tags
  pending_tags=()
  while [[ "${1:-}" == "--transcript" || "${1:-}" == "--record" || "${1:-}" == "--transcript-text-truncate" || "${1:-}" == "--result-schema" || "${1:-}" == "--tag" ]]; do
    case "$1" in
      --transcript|--record)
        if (( $# < 2 )); then
          echo "--transcript requires a value (absolute path)" >&2
          exit 2
        fi
        transcript_path="$2"
        shift 2
        ;;
      --transcript-text-truncate)
        if (( $# < 2 )); then
          echo "--transcript-text-truncate requires a positive integer" >&2
          exit 2
        fi
        if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
          echo "--transcript-text-truncate must be a positive integer: $2" >&2
          exit 2
        fi
        transcript_truncate="$2"
        shift 2
        ;;
      --result-schema)
        if (( $# < 2 )); then
          echo "--result-schema requires a value (absolute path)" >&2
          exit 2
        fi
        if [[ "${2:0:1}" != "/" ]]; then
          echo "--result-schema must be an absolute path: $2" >&2
          exit 2
        fi
        if [[ ! -f "$2" ]]; then
          echo "--result-schema file not found: $2" >&2
          exit 1
        fi
        result_schema_path="$2"
        shift 2
        ;;
      --tag)
        if (( $# < 2 )); then
          echo "--tag requires a value (key=value)" >&2
          exit 2
        fi
        if [[ "$2" != *=* ]]; then
          echo "--tag must be key=value: $2" >&2
          exit 2
        fi
        pending_tags+=("$2")
        shift 2
        ;;
    esac
  done

  local requested_name="${1:-}"
  local directory="${2:-}"
  local claude_session_id="${3:-}"

  if [[ -z "$requested_name" || -z "$directory" || -z "$claude_session_id" ]]; then
    echo "Usage: claude-tmux resume [--attach] [--exact] [--sentinel <path>] [--on-start <cmd>] [--on-exit <cmd>] [--sentinel-keep] [--transcript <path>] [--transcript-text-truncate <N>] <name> <directory> <session-id>" >&2
    exit 2
  fi

  if [[ ! -d "$directory" ]]; then
    echo "Directory not found: $directory" >&2
    exit 1
  fi

  if [[ ! "$claude_session_id" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]]; then
    echo "Invalid Claude session id: $claude_session_id" >&2
    exit 2
  fi

  validate_sentinel_flags claude-tmux
  if [[ -n "$transcript_path" && "${transcript_path:0:1}" != "/" ]]; then
    echo "--transcript must be an absolute path: $transcript_path" >&2
    exit 2
  fi
  if [[ -n "$transcript_path" && -e "$transcript_path" ]]; then
    echo "Transcript path already exists: $transcript_path" >&2
    exit 1
  fi
  if [[ -n "$transcript_path" ]]; then
    require_jq
    # Write probe (partner R7 critique): transcript_append is best-effort
    # for runtime resilience, but a silent silent-failure at start would
    # produce an empty audit trail with no operator-visible warning. Fail
    # loudly at start if the path is not writable.
    if ! ( : > "$transcript_path" ) 2>/dev/null; then
      echo "--transcript path is not writable: $transcript_path" >&2
      exit 1
    fi
    rm -f "$transcript_path"
  fi

  local name="$requested_name"
  if (( ! exact_name )); then
    name="$requested_name-$(random_suffix)"
  fi

  local session="$(session_for_name "$name")"
  local -a session_env_args
  local session_env_entry
  session_env_args=()
  while IFS= read -r session_env_entry; do
    [[ -n "$session_env_entry" ]] || continue
    session_env_args+=("-e" "$session_env_entry")
  done <<< "${TMUX_AGENT_TOOLS_SESSION_ENV:-}"
  apply_sentinel_env_args
  apply_result_env_args "$name"
  record_started_at "$name"
  for tag in "${pending_tags[@]}"; do
    tag_record "$name" "$tag" || true
  done
  if [[ -n "$transcript_path" ]]; then
    transcript_record_path "$name" "$transcript_path"
    if [[ -n "$transcript_truncate" ]]; then
      transcript_truncate_record "$name" "$transcript_truncate"
    fi
  fi
  if [[ -n "$result_schema_path" ]]; then
    result_schema_record "$name" "$result_schema_path"
  fi
  if true; then
  fi
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
  fi

  "$TMUX" -f "$TMUX_CONF" new-session "${session_env_args[@]}" -d -s "$session" -c "$directory" \
    "printf '%s\n' 'claude-tmux agent: $name' 'requested name: $requested_name' 'tmux session: $session' 'cwd: $directory' 'claude session id: $claude_session_id' 'send: $SELF send $name <text>' 'capture: $SELF capture $name 120' ''; $(shell_quote "$CLAUDE") --dangerously-skip-permissions --resume $(shell_quote "$claude_session_id"); code=\$?; $(sentinel_inline_block "$name"); printf '\n[claude-tmux] local command exited with code %s\n' \"\$code\"; printf '[claude-tmux] press Enter to close this pane\n'; read _; exit \"\$code\""

  spawn_max_fuse_watcher "$name" "$session" "$sentinel" "$on_exit_cmd" "$max_runtime" "$max_idle"
  run_on_start_hook "$name" "$session"

  if [[ -n "$transcript_path" ]]; then
    local start_line
    start_line="$("$JQ" -c -n \
      --arg event start --arg tool claude --arg name "$name" \
      --arg session "$session" --arg cwd "$directory" \
      --arg resume_id "$claude_session_id" \
      --arg at "$(transcript_iso_now)" \
      '{schema_version: 1, event: $event, tool: $tool, name: $name,
        session: $session, cwd: $cwd, resume_id: $resume_id, at: $at}')"
    transcript_append "$transcript_path" "$start_line"
  fi

  echo "agent: $name"
  echo "Started $session"
  echo "cwd:  $directory"
  echo "claude session id: $claude_session_id"
  echo "send: $SELF send $name <text>"
  echo "wait: $SELF wait $name 180"
  echo "wait-text: $SELF wait-text $name '<regex>' 180"
  echo "wait-literal: $SELF wait-literal $name '<text>' 180"
  echo "capture: $SELF capture $name 120"

  if (( should_attach )); then
    "$TMUX" attach -t "$session"
  fi
}

start_ssh_session() {
  require_tmux
  write_tmux_conf
  local should_attach=0
  local exact_name=0

  while [[ "${1:-}" == "--attach" || "${1:-}" == "--exact" ]]; do
    case "$1" in
      --attach)
        should_attach=1
        ;;
      --exact)
        exact_name=1
        ;;
    esac
    shift
  done

  local requested_name="${1:-}"
  local ssh_target="${2:-}"
  local remote_directory="${3:-}"

  if [[ -z "$requested_name" || -z "$ssh_target" || -z "$remote_directory" ]]; then
    echo "Usage: claude-tmux start-ssh [--attach] [--exact] <name> <ssh-target> <remote-directory> [initial text]" >&2
    exit 2
  fi

  shift 3
  local initial_text="${*:-}"

  local name="$requested_name"
  if (( ! exact_name )); then
    name="$requested_name-$(random_suffix)"
  fi

  local session="$(session_for_name "$name")"
  local -a session_env_args
  local session_env_entry
  session_env_args=()
  while IFS= read -r session_env_entry; do
    [[ -n "$session_env_entry" ]] || continue
    session_env_args+=("-e" "$session_env_entry")
  done <<< "${TMUX_AGENT_TOOLS_SESSION_ENV:-}"
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
  fi

  local remote_command
  remote_command="export TERM=xterm-256color COLORTERM=truecolor; cd $(shell_quote "$remote_directory") && printf '%s\n' $(shell_quote 'claude-tmux remote agent:') $(shell_quote "$name") $(shell_quote 'ssh target:') $(shell_quote "$ssh_target") $(shell_quote 'remote cwd:') $(shell_quote "$remote_directory") '' && claude --dangerously-skip-permissions; code=\$?; printf '\n[claude-tmux] remote command exited with code %s\n' \"\$code\"; printf '[claude-tmux] press Enter to close this pane\n'; read _; exit \"\$code\""

  "$TMUX" -f "$TMUX_CONF" new-session "${session_env_args[@]}" -d -s "$session" \
    "printf '%s\n' 'claude-tmux agent: $name' 'requested name: $requested_name' 'tmux session: $session' 'local mode: ssh' 'ssh target: $ssh_target' 'remote cwd: $remote_directory' 'send: $SELF send $name <text>' 'capture: $SELF capture $name 120' ''; exec ssh -tt $(shell_quote "$ssh_target") $(shell_quote "$remote_command")"

  echo "agent: $name"
  echo "Started $session"
  echo "ssh:  $ssh_target"
  echo "cwd:  $remote_directory"
  echo "send: $SELF send $name <text>"
  echo "wait: $SELF wait $name 180"
  echo "wait-text: $SELF wait-text $name '<regex>' 180"
  echo "wait-literal: $SELF wait-literal $name '<text>' 180"
  echo "capture: $SELF capture $name 120"
  if [[ -n "$initial_text" ]]; then
    sleep 5
    local buffer_name="$session-init"
    paste_and_submit "$session" "$buffer_name" "$initial_text"
    echo "sent: $initial_text"
  else
    echo "sent: <none>"
  fi

  if (( should_attach )); then
    "$TMUX" attach -t "$session"
  fi
}

attach_session() {
  require_tmux
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux attach <name>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  "$TMUX" attach -t "$session"
}

send_session() {
  require_tmux
  local name="${1:-}"
  shift || true

  if [[ -z "$name" || "$#" -eq 0 ]]; then
    echo "Usage: claude-tmux send <name> <text>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local prompt_text="$*"
  local buffer_name="$session-send"
  send_lock_around "$name" "$SEND_LOCK_DEFAULT_TIMEOUT" \
    paste_and_submit "$session" "$buffer_name" "$prompt_text" || return $?

  local transcript_path
  transcript_path="$(transcript_path_for "$name")"
  if [[ -n "$transcript_path" ]]; then
    # #140: apply optional --transcript-text-truncate to keep long send
    # payloads out of the transcript while preserving an integrity hash.
    local text_obj send_line
    text_obj="$(transcript_truncate_text "$name" "$prompt_text")"
    send_line="$("$JQ" -c -n \
      --argjson text_obj "$text_obj" \
      --arg event send --arg name "$name" \
      --arg at "$(transcript_iso_now)" \
      '{schema_version: 1, event: $event, name: $name,
        text: $text_obj.text, text_sha256: $text_obj.text_sha256,
        text_bytes: $text_obj.text_bytes, at: $at}')"
    transcript_append "$transcript_path" "$send_line"
  fi

  echo "Sent to $session: $prompt_text"
}

count_literal_occurrences() {
  local haystack="$1"
  local needle="$2"
  local count=0
  local rest="$haystack"

  while [[ "$rest" == *"$needle"* ]]; do
    rest="${rest#*"$needle"}"
    count=$((count + 1))
  done

  echo "$count"
}

send_wait_literal_session() {
  require_tmux
  local name="${1:-}"
  local prompt_text="${2:-}"
  local needle="${3:-}"
  local timeout_seconds="${4:-180}"

  if [[ -z "$name" || -z "$prompt_text" || -z "$needle" ]]; then
    echo "Usage: claude-tmux send-wait-literal <name> <text> <literal> [timeout_seconds]" >&2
    exit 2
  fi

  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid timeout_seconds: $timeout_seconds" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  send_lock_around "$name" "$SEND_LOCK_DEFAULT_TIMEOUT" \
    _send_wait_literal_locked "$name" "$session" "$prompt_text" "$needle" "$timeout_seconds"
}

_send_wait_literal_locked() {
  local name="$1" session="$2" prompt_text="$3" needle="$4" timeout_seconds="$5"

  local before="$("$TMUX" capture-pane -J -t "$session" -p -S -300)"
  local before_count
  before_count="$(count_literal_occurrences "$before" "$needle")"

  local buffer_name="$session-send-wait"
  paste_and_submit "$session" "$buffer_name" "$prompt_text"

  local deadline=$((SECONDS + timeout_seconds))
  local current=""
  local current_count=0

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -300)"
    current_count="$(count_literal_occurrences "$current" "$needle")"
    if (( current_count > before_count )); then
      marker_seen_add "$name" "$needle"
      transcript_emit_wait_event "$name" send_wait_literal matched "$needle" "$timeout_seconds"
      echo "matched new literal: $needle"
      return 0
    fi
    sleep 1
  done

  transcript_emit_wait_event "$name" send_wait_literal timeout "$needle" "$timeout_seconds"
  echo "timeout waiting for new literal text '$needle': $session" >&2
  return 1
}

capture_session() {
  require_tmux
  local strip_ansi=0
  local since_marker=""
  local output_json=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --strip-ansi)
        strip_ansi=1
        shift
        ;;
      --since-marker)
        if (( $# < 2 )); then
          echo "--since-marker requires a value (literal text)" >&2
          exit 2
        fi
        since_marker="$2"
        shift 2
        ;;
      --json)
        output_json=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "Unknown capture flag: $1" >&2
        exit 2
        ;;
    esac
  done

  local name="${1:-}"
  local lines="${2:-80}"

  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux capture [--strip-ansi] [--since-marker <text>] [--json] <name> [lines]" >&2
    exit 2
  fi

  if [[ ! "$lines" =~ '^[0-9]+$' || "$lines" -lt 1 ]]; then
    echo "Invalid lines: $lines" >&2
    exit 2
  fi

  if (( output_json )); then
    require_jq
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local raw
  raw="$("$TMUX" capture-pane -J -t "$session" -p -S "-$lines")"

  if (( strip_ansi )); then
    # Strip ANSI escape sequences (#96 + #135 extension). Covers:
    #   - CSI / SGR:  ESC [ ... <letter>
    #   - OSC:        ESC ] ...  (terminated by BEL \x07 or ST ESC \\)
    #   - DCS:        ESC P ... ESC \\
    #   - APC:        ESC _ ... ESC \\
    #   - PM:         ESC ^ ... ESC \\
    #   - SOS:        ESC X ... ESC \\
    # Out of scope (per design doc non-goal): 8-bit C1 controls like \x9b.
    # Note: sed strips per-line, which is fine because tmux capture-pane
    # joins soft-wrapped lines and terminal OSC/DCS payloads do not span
    # logical lines in normal CLI output.
    raw="$(printf '%s' "$raw" | sed -E $'
      s/\x1b\\[[0-9;?]*[A-Za-z]//g
      s/\x1b\\][^\x07\x1b]*\x07//g
      s/\x1b\\][^\x1b]*\x1b\\\\//g
      s/\x1bP[^\x1b]*\x1b\\\\//g
      s/\x1b_[^\x1b]*\x1b\\\\//g
      s/\x1b\\^[^\x1b]*\x1b\\\\//g
      s/\x1bX[^\x1b]*\x1b\\\\//g
    ')"
  fi

  local marker_found=0
  if [[ -n "$since_marker" ]]; then
    # Slice to lines AFTER the LAST occurrence of the literal marker.
    local last_idx
    # grep -nF exits 1 when no match; tolerate that under `set -e + pipefail`.
    last_idx="$(printf '%s\n' "$raw" | { grep -nF "$since_marker" || true; } | tail -1 | cut -d: -f1)"
    if [[ -n "$last_idx" ]]; then
      marker_found=1
      raw="$(printf '%s\n' "$raw" | tail -n +"$((last_idx + 1))")"
    else
      raw=""
    fi
  fi

  if (( output_json )); then
    "$JQ" -n \
      --arg name "$name" \
      --arg session "$session" \
      --argjson lines_requested "$lines" \
      --argjson marker_found "$marker_found" \
      --argjson stripped_ansi "$strip_ansi" \
      --arg body "$raw" \
      '{schema_version: 1,
        name: $name, session: $session, lines_requested: $lines_requested,
        marker_found: ($marker_found == 1), stripped_ansi: ($stripped_ansi == 1),
        lines: ($body | split("\n"))}'
  else
    printf '%s\n' "$raw"
  fi

  local transcript_path
  transcript_path="$(transcript_path_for "$name")"
  if [[ -n "$transcript_path" ]]; then
    local capture_line
    capture_line="$("$JQ" -c -n \
      --arg event capture --arg name "$name" \
      --argjson lines_requested "$lines" \
      --argjson strip_ansi "$strip_ansi" \
      --arg since_marker "$since_marker" \
      --argjson marker_found "$marker_found" \
      --arg at "$(transcript_iso_now)" \
      '{schema_version: 1, event: $event, name: $name,
        lines_requested: $lines_requested,
        stripped_ansi: ($strip_ansi == 1),
        since_marker: $since_marker,
        marker_found: ($marker_found == 1),
        at: $at}')"
    transcript_append "$transcript_path" "$capture_line"
  fi
}

result_session() {
  # Read the structured result an agent wrote to its conventional path
  # (see #97 design doc). Path resolution:
  #   $TMUX_AGENT_DIR/<name>/result.json
  local field=""
  local wait_seconds=0
  local output_json=0
  local validate_mode=0
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --field)
        if (( $# < 2 )); then
          echo "--field requires a value (jq path)" >&2
          exit 2
        fi
        field="$2"
        shift 2
        ;;
      --wait)
        if (( $# < 2 )); then
          echo "--wait requires a value (seconds)" >&2
          exit 2
        fi
        wait_seconds="$2"
        shift 2
        if [[ ! "$wait_seconds" =~ '^[0-9]+$' ]]; then
          echo "--wait must be a non-negative integer" >&2
          exit 2
        fi
        ;;
      --json)
        output_json=1
        shift
        ;;
      --validate)
        validate_mode=1
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "Unknown result flag: $1" >&2
        exit 2
        ;;
    esac
  done

  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux result [--field <jq>] [--wait <seconds>] [--json] <name>" >&2
    exit 2
  fi
  if (( output_json )); then
    require_jq
  fi
  if [[ -n "$field" ]]; then
    require_jq
  fi

  local result_path
  result_path="$(agent_root_dir)/$name/result.json"

  if (( validate_mode )); then
    require_jq
    local schema_path
    schema_path="$(result_schema_path_for "$name")"
    if [[ -z "$schema_path" ]]; then
      # No schema configured: emit a skipped-validation marker.
      "$JQ" -n --arg path "$result_path" \
        '{schema_version: 1, present: ($path | test("/")), valid: true,
          errors: [{path: ".", message: "no --result-schema configured for this agent"}],
          body: null}'
      return 0
    fi
    result_validate_lightweight "$result_path" "$schema_path"
    return $?
  fi

  if (( wait_seconds > 0 )); then
    local elapsed=0
    while [[ ! -f "$result_path" && "$elapsed" -lt "$wait_seconds" ]]; do
      sleep 1
      elapsed=$((elapsed + 1))
    done
  fi

  if [[ ! -f "$result_path" ]]; then
    if (( output_json )); then
      # gemini-code-assist on PR #136: `--json` is a structured-output
      # mode; if JSON was emitted, the subcommand succeeded. The
      # "result-not-yet" condition lives in `.present`. Callers branch
      # on the payload, not the exit code.
      "$JQ" -n --arg path "$result_path" \
        '{schema_version: 1, path: $path, present: false, valid: false, body: null}'
      return 0
    fi
    echo "Result file not found: $result_path" >&2
    exit 1
  fi

  local body bytes mtime
  body="$(cat "$result_path")"
  bytes=$(wc -c < "$result_path" | tr -d ' ')
  if [[ "$(uname)" == "Darwin" ]]; then
    # BSD stat: -f %m emits epoch seconds. Format via `date -u -r EPOCH`
    # so the value is genuinely UTC.
    local epoch
    epoch=$(stat -f %m "$result_path")
    mtime=$(date -u -r "$epoch" +%Y-%m-%dT%H:%M:%SZ)
  else
    # GNU stat: -c %Y emits epoch seconds. `stat -c %y` was wrong because
    # it formatted in the local timezone but the wrapper appended a `Z`
    # suffix as if it were UTC (gemini-code-assist on PR #136).
    local epoch
    epoch=$(stat -c %Y "$result_path")
    mtime=$(date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%SZ)
  fi

  if (( output_json )); then
    # body=null ambiguity (partner R5 critique): a `null` literal in
    # result.json is valid JSON; without a `valid` flag the consumer
    # cannot tell that case apart from "wrapper failed to parse". Emit
    # both: valid=true with parsed body, or valid=false with the raw
    # bytes wrapped as a JSON string so the caller can still inspect.
    local body_json valid_flag
    if printf '%s' "$body" | "$JQ" -e . >/dev/null 2>&1; then
      body_json="$body"
      valid_flag=true
    else
      body_json="$(printf '%s' "$body" | "$JQ" -Rs .)"
      valid_flag=false
    fi
    "$JQ" -n \
      --arg path "$result_path" \
      --argjson bytes "$bytes" \
      --arg mtime "$mtime" \
      --argjson valid "$valid_flag" \
      --argjson body "$body_json" \
      '{schema_version: 1, path: $path, present: true, bytes: $bytes,
        mtime: $mtime, valid: $valid, body: $body}'
    return 0
  fi

  if [[ -n "$field" ]]; then
    if ! printf '%s' "$body" | "$JQ" -e -r "$field"; then
      echo "Field not found in result.json: $field" >&2
      exit 1
    fi
    return 0
  fi

  printf '%s\n' "$body"
}

wait_session() {
  require_tmux
  local name="${1:-}"
  local timeout_seconds="${2:-180}"

  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux wait <name> [timeout_seconds]" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  local last=""
  local stable_count=0
  local current=""

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -100)"
    if [[ "$current" == "$last" ]]; then
      stable_count=$((stable_count + 1))
      if (( stable_count >= STABLE_SECONDS )); then
        transcript_emit_wait_event "$name" wait stable "" "$timeout_seconds"
        echo "stable"
        return 0
      fi
    else
      stable_count=0
      last="$current"
    fi
    sleep 1
  done

  transcript_emit_wait_event "$name" wait timeout "" "$timeout_seconds"
  echo "timeout waiting for stable output: $session" >&2
  return 1
}

wait_text_session() {
  require_tmux
  local literal=0
  if [[ "${1:-}" == "--literal" ]]; then
    literal=1
    shift
  fi

  if (( literal )); then
    wait_literal_session "$@"
    return
  fi

  local name="${1:-}"
  local pattern="${2:-}"
  local timeout_seconds="${3:-180}"

  if [[ -z "$name" || -z "$pattern" ]]; then
    echo "Usage: claude-tmux wait-text [--literal] <name> <regex-or-text> [timeout_seconds]" >&2
    exit 2
  fi

  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid timeout_seconds: $timeout_seconds" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  local current=""

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -200)"
    if [[ "$current" =~ $pattern ]]; then
      transcript_emit_wait_event "$name" wait_text matched "$pattern" "$timeout_seconds"
      echo "matched: $pattern"
      return 0
    fi
    sleep 1
  done

  transcript_emit_wait_event "$name" wait_text timeout "$pattern" "$timeout_seconds"
  echo "timeout waiting for text '$pattern': $session" >&2
  return 1
}

wait_literal_session() {
  require_tmux
  local name="${1:-}"
  local needle="${2:-}"
  local timeout_seconds="${3:-180}"

  if [[ -z "$name" || -z "$needle" ]]; then
    echo "Usage: claude-tmux wait-literal <name> <text> [timeout_seconds]" >&2
    exit 2
  fi

  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid timeout_seconds: $timeout_seconds" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    echo "Session does not exist: $session" >&2
    exit 1
  fi

  local deadline=$((SECONDS + timeout_seconds))
  local current=""

  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -200)"
    if [[ "$current" == *"$needle"* ]]; then
      marker_seen_add "$name" "$needle"
      transcript_emit_wait_event "$name" wait_literal matched "$needle" "$timeout_seconds"
      echo "matched literal: $needle"
      return 0
    fi
    sleep 1
  done

  transcript_emit_wait_event "$name" wait_literal timeout "$needle" "$timeout_seconds"
  echo "timeout waiting for literal text '$needle': $session" >&2
  return 1
}

wait_and_capture_session() {
  # Combined wait + capture — the golden-path shortcut described in
  # issue #99. Replaces the two-step `wait-literal` / `capture` pair.
  # `--no-timeout-error` decouples soft-timeout opt-in from `--json`
  # (partner R3 critique on the original design).
  require_tmux
  local marker=""
  local match_style="literal"
  local timeout_seconds=180
  local tail_lines=80
  local strip_ansi=0
  local since_marker=""
  local output_json=0
  local no_timeout_error=0
  local since_set=0
  local style_set=0

  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --marker)
        if (( $# < 2 )); then echo "--marker requires a value" >&2; exit 2; fi
        marker="$2"; shift 2 ;;
      --literal) match_style="literal"; style_set=1; shift ;;
      --regex) match_style="regex"; style_set=1; shift ;;
      --timeout)
        if (( $# < 2 )); then echo "--timeout requires a value (seconds)" >&2; exit 2; fi
        timeout_seconds="$2"; shift 2 ;;
      --tail)
        if (( $# < 2 )); then echo "--tail requires a value (lines)" >&2; exit 2; fi
        tail_lines="$2"; shift 2 ;;
      --strip-ansi) strip_ansi=1; shift ;;
      --since-marker)
        if (( $# < 2 )); then echo "--since-marker requires a value (literal text)" >&2; exit 2; fi
        since_marker="$2"; since_set=1; shift 2 ;;
      --json) output_json=1; shift ;;
      --no-timeout-error) no_timeout_error=1; shift ;;
      --) shift; break ;;
      *) echo "Unknown wait-and-capture flag: $1" >&2; exit 2 ;;
    esac
  done

  local name="${1:-}"
  if [[ -z "$name" || -z "$marker" ]]; then
    echo "Usage: claude-tmux wait-and-capture --marker <text> [--literal|--regex] [--timeout <s>] [--tail <n>] [--strip-ansi] [--since-marker <text>] [--json] [--no-timeout-error] <name>" >&2
    exit 2
  fi
  if [[ ! "$timeout_seconds" =~ '^[0-9]+$' || "$timeout_seconds" -lt 1 ]]; then
    echo "Invalid --timeout: $timeout_seconds" >&2
    exit 2
  fi
  if [[ ! "$tail_lines" =~ '^[0-9]+$' || "$tail_lines" -lt 1 ]]; then
    echo "Invalid --tail: $tail_lines" >&2
    exit 2
  fi
  if (( output_json )); then
    require_jq
  fi

  # Default since-marker = marker, but ONLY when the marker is a literal.
  # Under --regex, defaulting since-marker to the regex pattern would feed
  # `grep -F` a string that may not appear in the pane (e.g. `Done|Error`
  # never matches `grep -F`). Caller must opt-in with explicit
  # --since-marker for regex match style. Partner R6 critique on PR #137.
  if (( ! since_set )); then
    if [[ "$match_style" == "literal" ]]; then
      since_marker="$marker"
    else
      since_marker=""
    fi
  fi

  local session
  session="$(session_for_name "$name")"
  if ! "$TMUX" has-session -t "$session" 2>/dev/null; then
    if (( output_json )); then
      "$JQ" -n \
        --arg marker "$marker" --arg style "$match_style" \
        --arg since "$since_marker" \
        --argjson timeout "$timeout_seconds" \
        '{schema_version: 1, matched: false, marker: $marker,
          match_style: $style, since_marker: $since,
          wait_seconds: 0, timeout: $timeout,
          stripped_ansi: false, reason: "session_gone", lines: []}'
    else
      echo "Session does not exist: $session" >&2
    fi
    # session_gone is a HARD failure (the agent is no longer reachable);
    # --no-timeout-error decouples only the soft-timeout case from exit
    # code, NOT session-gone. gemini-code-assist on PR #137.
    return 1
  fi

  local started=$SECONDS
  local matched=0
  local deadline=$((started + timeout_seconds))
  local current=""
  while (( SECONDS < deadline )); do
    current="$("$TMUX" capture-pane -J -t "$session" -p -S -200)"
    if [[ "$match_style" == "literal" ]]; then
      if [[ "$current" == *"$marker"* ]]; then
        matched=1
        break
      fi
    else
      if [[ "$current" =~ $marker ]]; then
        matched=1
        break
      fi
    fi
    sleep 1
  done
  local elapsed=$((SECONDS - started))

  local raw
  raw="$("$TMUX" capture-pane -J -t "$session" -p -S "-$tail_lines")"

  if (( strip_ansi )); then
    raw="$(printf '%s' "$raw" | sed $'s/\x1b\\[[0-9;?]*[A-Za-z]//g')"
  fi

  if (( matched )) && [[ -n "$since_marker" ]]; then
    local last_idx
    last_idx="$(printf '%s\n' "$raw" | { grep -nF "$since_marker" || true; } | tail -1 | cut -d: -f1)"
    if [[ -n "$last_idx" ]]; then
      raw="$(printf '%s\n' "$raw" | tail -n +"$((last_idx + 1))")"
    else
      raw=""
    fi
  fi

  local reason
  if (( matched )); then
    reason="matched"
    transcript_emit_wait_event "$name" wait_and_capture matched "$marker" "$timeout_seconds"
  else
    reason="timeout"
    transcript_emit_wait_event "$name" wait_and_capture timeout "$marker" "$timeout_seconds"
  fi

  if (( output_json )); then
    "$JQ" -n \
      --arg marker "$marker" --arg style "$match_style" \
      --argjson matched "$matched" \
      --argjson elapsed "$elapsed" \
      --argjson timeout "$timeout_seconds" \
      --argjson stripped "$strip_ansi" \
      --arg since "$since_marker" \
      --arg reason "$reason" \
      --arg body "$raw" \
      '{schema_version: 1,
        matched: ($matched == 1), marker: $marker, match_style: $style,
        wait_seconds: $elapsed, timeout: $timeout,
        stripped_ansi: ($stripped == 1),
        since_marker: $since,
        reason: $reason,
        lines: ($body | split("\n"))}'
  else
    printf '%s\n' "$raw"
  fi

  if (( ! matched && ! no_timeout_error )); then
    return 1
  fi
  return 0
}

doctor_session() {
  require_tmux
  echo "tmux: $TMUX"
  if [[ -n "$CLAUDE" && -x "$CLAUDE" ]]; then
    echo "claude: $CLAUDE"
  else
    echo "claude: not found; start requires CLAUDE=/path/to/claude or claude on PATH"
  fi
  echo "prefix: $PREFIX"
  echo "stable_seconds: $STABLE_SECONDS"
  echo "submit_delay: $SUBMIT_DELAY"
  echo "tmux_conf: $TMUX_CONF"
  echo "mouse: $TMUX_MOUSE"
  echo "clipboard: $(clipboard_description)"
}

status_pane_text() {
  local session="$1"
  "$TMUX" capture-pane -J -t "$session" -p -S -80 2>/dev/null || true
}

blocked_reason_for_text() {
  local lowered="$1"
  if [[ "$lowered" == *"local command exited with code"* || "$lowered" == *"remote command exited with code"* ]]; then
    print -r -- "cli_exited"
  elif [[ "$lowered" == *"password:"* || "$lowered" == *"permission denied"* || "$lowered" == *"are you sure you want to continue connecting"* ]]; then
    print -r -- "ssh_prompt"
  elif [[ "$lowered" == *"do you want to proceed"* || "$lowered" == *"press enter to continue"* || "$lowered" == *"permission confirmation"* || "$lowered" == *"permission prompt"* || "$lowered" == *"permission required"* || "$lowered" == *"trust this"* || "$lowered" == *"trust the files"* ]]; then
    print -r -- "permission_prompt"
  elif [[ "$lowered" == *"approval"* || "$lowered" == *"approve"* || "$lowered" == *"[y/n]"* ]]; then
    print -r -- "approval_prompt"
  elif [[ "$lowered" == *"please log in"* || "$lowered" == *"log in to"* || "$lowered" == *"sign in to"* || "$lowered" == *"not logged in"* ]]; then
    print -r -- "login_prompt"
  fi
}

exit_code_for_text() {
  local current="$1"
  local line
  local code=""
  local exit_re='(local|remote) command exited with code ([0-9]+)'
  while IFS= read -r line; do
    if [[ "$line" =~ $exit_re ]]; then
      code="${match[2]}"
    fi
  done <<< "$current"
  print -r -- "$code"
}

diagnostic_for_blocked_reason() {
  local reason="$1"
  case "$reason" in
    permission_prompt|approval_prompt|ssh_prompt|login_prompt)
      echo "session may be waiting for interactive confirmation; attach or capture the pane before sending prompts"
      ;;
  esac
}

status_tail_json() {
  local current="$1"
  local max_lines="$STATUS_TAIL_LINES"
  if [[ "$max_lines" != <-> ]] || (( max_lines <= 0 )); then
    max_lines=20
  fi
  print -r -- "$current" | "$JQ" -R -s --argjson max_lines "$max_lines" '
    split("\n")
    | map(select(length > 0))
    | .[-$max_lines:]
  '
}

self_test_session() {
  require_tmux
  local name="self-test-$$"
  local session="$(session_for_name "$name")"
  "$TMUX" kill-session -t "$session" 2>/dev/null || true
  "$TMUX" new-session -d -s "$session" "zsh -lc 'printf \"%s\n\" \"TMUX_AGENT_TOOLS_SELF_TEST_OK\" \"[TMUX_AGENT_TOOLS_SELF_TEST_OK]\"; if IFS= read -r line; then printf \"%s\n\" \"echo:\$line\" \"[TMUX_AGENT_TOOLS_SEND_WAIT_OK]\"; fi; sleep 5'"
  wait_literal_session "$name" "TMUX_AGENT_TOOLS_SELF_TEST_OK" 5
  wait_text_session --literal "$name" "[TMUX_AGENT_TOOLS_SELF_TEST_OK]" 5
  send_wait_literal_session "$name" $'trigger send-wait\nsecond line' "[TMUX_AGENT_TOOLS_SEND_WAIT_OK]" 5
  "$TMUX" kill-session -t "$session" 2>/dev/null || true
  echo "self-test: ok"
}

status_session() {
  require_tmux
  local output_json=0

  if [[ "${1:-}" == "--json" ]]; then
    output_json=1
    shift
  fi

  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux status [--json] <name>" >&2
    exit 2
  fi

  local session="$(session_for_name "$name")"
  local exists=false
  local running=false
  local exit_detected=false
  local local_or_remote=""
  local diagnostic=""
  local blocked_reason=""
  local exit_code=""
  local confirmation_detected=false
  local current=""
  # Liveness fields (issue #98). Additive only — existing field shape is preserved.
  local last_change_at=""
  local bytes_in_pane=""
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    exists=true
    running=true
    local lowered
    current="$(status_pane_text "$session")"
    lowered="${current:l}"
    if [[ "$lowered" == *"local command exited with code"* || "$lowered" == *"remote command exited with code"* ]]; then
      exit_detected=true
      running=false
      exit_code="$(exit_code_for_text "$current")"
    fi
    if [[ "$lowered" == *"local mode: ssh"* || "$lowered" == *"remote command exited with code"* ]]; then
      local_or_remote="remote"
    else
      local_or_remote="local"
    fi
    blocked_reason="$(blocked_reason_for_text "$lowered")"
    diagnostic="$(diagnostic_for_blocked_reason "$blocked_reason")"
    case "$blocked_reason" in
      permission_prompt|approval_prompt|ssh_prompt|login_prompt)
        confirmation_detected=true
        ;;
    esac
    last_change_at="$(update_pane_hash "$name" "$current")"
    bytes_in_pane=$(printf '%s' "$current" | wc -c | tr -d ' ')
  fi
  local started_at
  started_at="$(read_started_at "$name")"
  local idle_seconds=""
  if [[ "$exists" == true && -n "$last_change_at" ]]; then
    idle_seconds="$(iso_epoch_diff_seconds "$last_change_at")"
  fi
  local marker_seen_json
  if [[ "$exists" == true || -f "$(agent_root_dir)/$name/marker_seen" ]]; then
    marker_seen_json="$(marker_seen_list_json "$name")"
  else
    marker_seen_json='[]'
  fi

  if (( output_json )); then
    require_jq
    "$JQ" -cn \
      --arg tool "claude" \
      --arg name "$name" \
      --arg session "$session" \
      --arg prefix "$PREFIX" \
      --arg local_or_remote "$local_or_remote" \
      --arg diagnostic "$diagnostic" \
      --arg blocked_reason "$blocked_reason" \
      --arg exit_code "$exit_code" \
      --arg started_at "$started_at" \
      --arg last_change_at "$last_change_at" \
      --arg idle_seconds "$idle_seconds" \
      --arg bytes_in_pane "$bytes_in_pane" \
      --argjson marker_seen "$marker_seen_json" \
      --argjson last_capture_lines "$(status_tail_json "$current")" \
      --argjson exists "$exists" \
      --argjson running "$running" \
      --argjson exit_detected "$exit_detected" \
      --argjson confirmation_detected "$confirmation_detected" \
      '{schema_version:1,tool:$tool,name:$name,session:$session,prefix:$prefix,exists:$exists,running:$running,exit_detected:$exit_detected,exit_code:(if $exit_code == "" then null else ($exit_code | tonumber) end),local_or_remote:(if $local_or_remote == "" then null else $local_or_remote end),diagnostic:(if $diagnostic == "" then null else $diagnostic end),last_capture_lines:$last_capture_lines,confirmation_detected:$confirmation_detected,blocked_reason:(if $blocked_reason == "" then null else $blocked_reason end),started_at:(if $started_at == "" then null else $started_at end),last_change_at:(if $last_change_at == "" then null else $last_change_at end),idle_seconds:(if $idle_seconds == "" then null else ($idle_seconds | tonumber) end),bytes_in_pane:(if $bytes_in_pane == "" then null else ($bytes_in_pane | tonumber) end),marker_seen:$marker_seen}'
  elif [[ "$running" == true ]]; then
    echo "running: $session"
    if [[ -n "$diagnostic" ]]; then
      echo "diagnostic: $diagnostic"
    fi
  else
    echo "stopped: $session"
  fi
}

# ping_now_ms: monotonic-enough millisecond timestamp. Uses zsh $EPOCHREALTIME
# when zsh/datetime is available (sub-second precision); falls back to
# `date +%s%3N` (GNU date / coreutils) and finally to `date +%s` * 1000.
ping_now_ms() {
  if zmodload -e zsh/datetime 2>/dev/null || zmodload zsh/datetime 2>/dev/null; then
    # EPOCHREALTIME looks like "1716256789.123456" — strip the dot, keep ms.
    local ert="$EPOCHREALTIME"
    local secs="${ert%%.*}"
    local frac="${ert#*.}"
    # Pad/truncate to exactly 3 digits.
    frac="${frac}000"
    frac="${frac[1,3]}"
    print -r -- $(( secs * 1000 + frac ))
    return
  fi
  local out
  out=$(date +%s%3N 2>/dev/null || true)
  if [[ "$out" =~ '^[0-9]+$' ]]; then
    print -r -- "$out"
  else
    print -r -- $(( $(date +%s) * 1000 ))
  fi
}

# --- ping: active liveness probe (issue #128) ------------------------------
# Complements status --json (#98) which only observes idle_seconds passively.
# ping sends a no-op key sequence (C-u clears the input line; we do NOT submit
# Enter so a real interactive CLI keeps its in-progress buffer untouched) and
# watches the pane byte count for any change within --timeout seconds.
#   exit 0: pane changed         result=ok       (CLI responsive)
#   exit 1: pane unchanged       result=timeout  (tmux alive, CLI silent / hung)
#   exit 2: tmux session gone    result=dead
ping_session() {
  require_tmux
  local output_json=0
  local timeout=10
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) output_json=1; shift ;;
      --timeout)
        if [[ -z "${2:-}" ]]; then
          echo "Usage: claude-tmux ping [--timeout <s>] [--json] <name>" >&2
          exit 2
        fi
        timeout="$2"; shift 2 ;;
      --timeout=*) timeout="${1#--timeout=}"; shift ;;
      --) shift; break ;;
      -*)
        echo "Unknown flag: $1" >&2
        exit 2 ;;
      *) break ;;
    esac
  done
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux ping [--timeout <s>] [--json] <name>" >&2
    exit 2
  fi
  if ! [[ "$timeout" =~ '^[0-9]+$' ]] || (( timeout < 1 )); then
    echo "Invalid --timeout: $timeout (expect positive integer)" >&2
    exit 2
  fi

  local session
  session="$(session_for_name "$name")"
  local at
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local result="dead"
  local rtt_ms=0
  local exit_code=2

  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    local before_bytes after_bytes
    before_bytes="$("$TMUX" capture-pane -J -t "$session" -p -S -200 2>/dev/null | wc -c | tr -d ' ')"
    # Send Enter then C-u: Enter pokes line-buffered consumers (CLIs that
    # block on `read`); C-u immediately clears the input line so no stray
    # text persists in an interactive REPL's prompt buffer.
    "$TMUX" send-keys -t "$session" Enter C-u 2>/dev/null || true
    local start_ms deadline_ms now_ms timeout_ms
    timeout_ms=$(( timeout * 1000 ))
    start_ms=$(ping_now_ms)
    deadline_ms=$(( start_ms + timeout_ms ))
    result="timeout"
    exit_code=1
    while :; do
      after_bytes="$("$TMUX" capture-pane -J -t "$session" -p -S -200 2>/dev/null | wc -c | tr -d ' ')"
      if [[ -n "$after_bytes" && -n "$before_bytes" && "$after_bytes" != "$before_bytes" ]]; then
        result="ok"
        exit_code=0
        break
      fi
      now_ms=$(ping_now_ms)
      if (( now_ms >= deadline_ms )); then
        break
      fi
      sleep 0.1
    done
    now_ms=$(ping_now_ms)
    rtt_ms=$(( now_ms - start_ms ))
    (( rtt_ms < 0 )) && rtt_ms=0
  fi

  if (( output_json )); then
    require_jq
    "$JQ" -cn \
      --arg name "$name" \
      --arg session "$session" \
      --arg result "$result" \
      --arg at "$at" \
      --argjson rtt_ms "$rtt_ms" \
      '{schema_version: 1, name: $name, session: $session, result: $result, rtt_ms: $rtt_ms, at: $at}'
  else
    case "$result" in
      ok)      echo "ping ok: $name (rtt ${rtt_ms}ms)" ;;
      timeout) echo "ping timeout: $name (after ${timeout}s)" ;;
      dead)    echo "ping dead: $name (no tmux session)" ;;
    esac
  fi
  exit "$exit_code"
}

list_sessions() {
  require_tmux
  "$TMUX" ls 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      "$PREFIX"-*)
        local session="${line%%:*}"
        local name="${session#$PREFIX-}"
        echo "$name -> $session"
        ;;
    esac
  done
}

stop_session() {
  require_tmux
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: claude-tmux stop <name>" >&2
    exit 2
  fi

  # Kill the safety-fuse watcher (issue #105) BEFORE tearing down tmux so
  # the watcher cannot race a sentinel write against a clean stop.
  kill_max_fuse_watcher "$name"

  local session
  session="$(session_for_name "$name")"
  local stopped=0
  if "$TMUX" has-session -t "$session" 2>/dev/null; then
    "$TMUX" kill-session -t "$session"
    stopped=1
    echo "Stopped $session"
  else
    echo "Already stopped: $session"
  fi

  local transcript_path
  transcript_path="$(transcript_path_for "$name")"
  if [[ -n "$transcript_path" ]]; then
    local stop_line
    stop_line="$("$JQ" -c -n \
      --arg event stop --arg name "$name" \
      --argjson stopped "$stopped" \
      --arg at "$(transcript_iso_now)" \
      '{schema_version: 1, event: $event, name: $name,
        stopped: ($stopped == 1), at: $at}')"
    transcript_append "$transcript_path" "$stop_line"
  fi
}

# Allow test harnesses (issue #102 smoke) to source the wrapper purely for
# its helpers without executing the dispatcher.
if [[ -n "${TMUX_AGENT_TOOLS_SOURCE_ONLY:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

command="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "$command" in
  __fuse_watcher)
    # Internal: detached safety-fuse watcher (issue #105). Args:
    # <agent_name> <tmux_session> <sentinel> <on_exit_cmd> <max_runtime> <max_idle> <tmux_bin>
    max_fuse_watcher_loop "$@"
    exit 0
    ;;
  start)
    start_session "$@"
    ;;
  resume)
    resume_session "$@"
    ;;
  start-ssh)
    start_ssh_session "$@"
    ;;
  attach)
    attach_session "$@"
    ;;
  send)
    send_session "$@"
    ;;
  send-wait-literal)
    send_wait_literal_session "$@"
    ;;
  wait)
    wait_session "$@"
    ;;
  wait-text)
    wait_text_session "$@"
    ;;
  wait-literal)
    wait_literal_session "$@"
    ;;
  wait-and-capture)
    wait_and_capture_session "$@"
    ;;
  capture)
    capture_session "$@"
    ;;
  result)
    result_session "$@"
    ;;
  tags)
    if [[ -z "${1:-}" ]]; then
      echo "Usage: $SELF tags <name>" >&2
      exit 2
    fi
    tag_list_json "$1"
    ;;
  status)
    status_session "$@"
    ;;
  ping)
    ping_session "$@"
    ;;
  doctor)
    doctor_session
    ;;
  self-test)
    self_test_session
    ;;
  list)
    list_sessions
    ;;
  stop)
    stop_session "$@"
    ;;
  -h|--help|help)
    help_for_subcommand "${1:-}"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
