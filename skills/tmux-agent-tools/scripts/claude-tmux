#!/usr/bin/env zsh
# claude-tmux — DEPRECATED shim over agent-tmux; use `agent-tmux claude <command>`.
# Kept working through v0.38; removal planned for v0.39.
[[ -z "${AGENT_TMUX_SUPPRESS_DEPRECATION:-}" ]] && \
  print -u2 -- "claude-tmux is deprecated; use: agent-tmux claude <command> (removal: v0.39)"
exec "${0:A:h}/agent-tmux" claude "$@"
