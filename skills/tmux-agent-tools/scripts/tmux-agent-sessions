#!/usr/bin/env zsh
set -euo pipefail

SELF="${0:t}"
SCRIPT_DIR="${0:A:h}"

resolve_tmux_bin() {
  if [[ -n "${TMUX:-}" && -x "${TMUX:-}" ]]; then
    print -r -- "$TMUX"
    return
  fi
  command -v tmux 2>/dev/null || true
}

TMUX_BIN="$(resolve_tmux_bin)"
unset TMUX
TMUX="$TMUX_BIN"
JQ="${JQ:-$(command -v jq 2>/dev/null || true)}"
CLAUDE_PREFIX="${CLAUDE_TMUX_PREFIX:-claude-cli}"
CODEX_PREFIX="${CODEX_TMUX_PREFIX:-codex-cli}"
DIALOGUE_PREFIX="tmux-agent-dialogue"
FILTER_TOOL=""
FILTER_NAME=""
FILTER_STATE=""
SORT_FIELD=""

usage() {
  cat <<'EOF'
tmux-agent-sessions - inspect and clean up tmux-agent-tools sessions

Usage:
  tmux-agent-sessions list [--json] [--tool <claude|codex|dialogue>] [--name <name>] [--state <running|exited|stopped|missing>] [--sort <tool|name|session|state>]
  tmux-agent-sessions list --watch --json --count <n> [--interval <seconds>] [--tool <claude|codex|dialogue>] [--name <name>] [--state <running|exited|stopped|missing>] [--sort <tool|name|session|state>]
  tmux-agent-sessions watch [--count <n>] [--interval <seconds>] [--tool <claude|codex|dialogue>] [--name <name>] [--state <running|exited|stopped|missing>]
  tmux-agent-sessions cleanup --preview [--json] [--tool <claude|codex|dialogue>] [--name <name>]
  tmux-agent-sessions cleanup --execute (--all | --tool <claude|codex|dialogue> | --name <name>)

Behavior:
  - list is read-only;
  - list --watch is bounded by --count and emits one JSON array snapshot per poll;
  - watch polls inventory and emits one JSONL event per state transition (session_added, session_state_changed, session_removed); bounded by --count (0 = unlimited);
  - cleanup --preview is read-only;
  - cleanup --execute requires --all or a filter before stopping sessions;
  - cleanup --execute only stops matching sessions owned by claude-tmux, codex-tmux, or tmux-agent-dialogue;
  - sessions outside known tmux-agent-tools prefixes are never stopped.
EOF
}

die() {
  echo "$SELF: $*" >&2
  exit 1
}

require_tmux() {
  [[ -x "$TMUX" ]] || die "tmux not found"
}

require_jq() {
  [[ -n "$JQ" && -x "$JQ" ]] || die "jq not found"
}

wrapper_for_tool() {
  local tool="$1"
  case "$tool" in
    claude) print -r -- "$SCRIPT_DIR/claude-tmux" ;;
    codex) print -r -- "$SCRIPT_DIR/codex-tmux" ;;
    *) die "unsupported wrapper tool: $tool" ;;
  esac
}

emit_session_json() {
  local tool="$1"
  local name="$2"
  local session="$3"
  require_jq
  local prefix=""
  case "$tool" in
    claude) prefix="$CLAUDE_PREFIX" ;;
    codex) prefix="$CODEX_PREFIX" ;;
    dialogue) prefix="$DIALOGUE_PREFIX" ;;
  esac
  "$JQ" -cn \
    --arg tool "$tool" \
    --arg name "$name" \
    --arg session "$session" \
    --arg prefix "$prefix" \
    --arg state "running" \
    '{tool:$tool,name:$name,session:$session,prefix:$prefix,exists:true,state:$state,running:true,exit_detected:false,exit_code:null,local_or_remote:null,diagnostic:null,last_capture_lines:[],confirmation_detected:false,blocked_reason:null}'
}

add_state_field() {
  require_jq
  "$JQ" -c '. + {
    state: (
      if (.exists | not) then "missing"
      elif .exit_detected then "exited"
      elif .running then "running"
      else "stopped"
      end
    )
  }'
}

exit_code_for_text() {
  local current="$1"
  local line
  local code=""
  local exit_re='(local|remote) command exited with code ([0-9]+)'
  while IFS= read -r line; do
    if [[ "$line" =~ $exit_re ]]; then
      code="${match[2]}"
    fi
  done <<< "$current"
  print -r -- "$code"
}

fallback_status_json() {
  local tool="$1"
  local name="$2"
  local session="$3"
  local prefix="$4"
  local current lowered
  current="$("$TMUX" capture-pane -J -t "$session" -p -S -80 2>/dev/null || true)"
  lowered="${current:l}"

  local running=true
  local exit_detected=false
  local exit_code=""
  local local_or_remote="local"
  if [[ "$lowered" == *"local command exited with code"* || "$lowered" == *"remote command exited with code"* ]]; then
    running=false
    exit_detected=true
    exit_code="$(exit_code_for_text "$current")"
  fi
  if [[ "$lowered" == *"local mode: ssh"* || "$lowered" == *"remote command exited with code"* ]]; then
    local_or_remote="remote"
  fi

  require_jq
  "$JQ" -cn \
    --arg tool "$tool" \
    --arg name "$name" \
    --arg session "$session" \
    --arg prefix "$prefix" \
    --arg local_or_remote "$local_or_remote" \
    --arg exit_code "$exit_code" \
    --argjson running "$running" \
    --argjson exit_detected "$exit_detected" \
    '{tool:$tool,name:$name,session:$session,prefix:$prefix,exists:true,running:$running,exit_detected:$exit_detected,exit_code:(if $exit_code == "" then null else ($exit_code | tonumber) end),local_or_remote:$local_or_remote,diagnostic:null,last_capture_lines:[],confirmation_detected:false,blocked_reason:null}' \
    | add_state_field
}

emit_wrapper_session_json() {
  local tool="$1"
  local name="$2"
  local session="$3"
  local wrapper output prefix
  wrapper="$(wrapper_for_tool "$tool")"
  case "$tool" in
    claude) prefix="$CLAUDE_PREFIX" ;;
    codex) prefix="$CODEX_PREFIX" ;;
  esac
  if output="$("$wrapper" status --json "$name" 2>/dev/null)"; then
    print -r -- "$output" | add_state_field
    return
  fi
  fallback_status_json "$tool" "$name" "$session" "$prefix"
}

emit_inventory_json() {
  local tool="$1"
  local name="$2"
  local session="$3"
  case "$tool" in
    claude|codex)
      emit_wrapper_session_json "$tool" "$name" "$session"
      ;;
    dialogue)
      emit_session_json "$tool" "$name" "$session"
      ;;
  esac
}

emit_inventory_text() {
  local tool="$1"
  local name="$2"
  local session="$3"
  local json state
  require_jq
  json="$(emit_inventory_json "$tool" "$name" "$session")"
  state="$(print -r -- "$json" | "$JQ" -r '.state')"
  print -r -- "$tool	$name	$session	$state"
}

parse_filter_arg() {
  case "$1" in
    claude|codex|dialogue)
      print -r -- "$1"
      ;;
    *)
      die "--tool must be one of: claude, codex, dialogue"
      ;;
  esac
}

parse_state_arg() {
  case "$1" in
    running|exited|stopped|missing)
      print -r -- "$1"
      ;;
    *)
      die "--state must be one of: running, exited, stopped, missing"
      ;;
  esac
}

parse_sort_arg() {
  case "$1" in
    tool|name|session|state)
      print -r -- "$1"
      ;;
    *)
      die "--sort must be one of: tool, name, session, state"
      ;;
  esac
}

parse_nonnegative_integer_arg() {
  local flag="$1"
  local value="$2"
  local integer_re='^[0-9]+$'
  [[ "$value" =~ $integer_re ]] || die "$flag requires a non-negative integer"
  print -r -- "$value"
}

matches_filters() {
  local tool="$1"
  local name="$2"
  [[ -z "$FILTER_TOOL" || "$tool" == "$FILTER_TOOL" ]] || return 1
  [[ -z "$FILTER_NAME" || "$name" == "$FILTER_NAME" ]] || return 1
  return 0
}

filter_sort_inventory_json() {
  require_jq
  "$JQ" -cs \
    --arg state "$FILTER_STATE" \
    --arg sort_field "$SORT_FIELD" \
    'map(select($state == "" or .state == $state))
     | if $sort_field == "" then .
       elif $sort_field == "tool" then sort_by(.tool, .name, .session)
       elif $sort_field == "name" then sort_by(.name, .tool, .session)
       elif $sort_field == "session" then sort_by(.session, .tool, .name)
       elif $sort_field == "state" then sort_by(.state, .tool, .name, .session)
       else .
       end'
}

inventory_json_array() {
  list_owned_sessions | while IFS=$'\t' read -r tool name session; do
    emit_inventory_json "$tool" "$name" "$session"
  done | filter_sort_inventory_json
}

list_owned_sessions() {
  require_tmux
  "$TMUX" ls 2>/dev/null | while IFS= read -r line; do
    local session="${line%%:*}"
    local tool=""
    local name=""
    case "$session" in
      "$CLAUDE_PREFIX"-*)
        tool="claude"
        name="${session#$CLAUDE_PREFIX-}"
        ;;
      "$CODEX_PREFIX"-*)
        tool="codex"
        name="${session#$CODEX_PREFIX-}"
        ;;
      "$DIALOGUE_PREFIX"-*)
        tool="dialogue"
        name="${session#$DIALOGUE_PREFIX-}"
        ;;
    esac
    if [[ -n "$tool" ]] && matches_filters "$tool" "$name"; then
      print -r -- "$tool	$name	$session"
    fi
  done
}

list_sessions() {
  local output_json=0
  local watch=0
  local watch_count=""
  local watch_interval=1
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --json)
        output_json=1
        ;;
      --watch)
        watch=1
        ;;
      --count)
        shift
        watch_count="$(parse_nonnegative_integer_arg --count "${1:-}")"
        ;;
      --interval)
        shift
        watch_interval="$(parse_nonnegative_integer_arg --interval "${1:-}")"
        ;;
      --tool)
        shift
        FILTER_TOOL="$(parse_filter_arg "${1:-}")"
        ;;
      --name)
        shift
        FILTER_NAME="${1:-}"
        [[ -n "$FILTER_NAME" ]] || die "--name requires a value"
        ;;
      --state)
        shift
        FILTER_STATE="$(parse_state_arg "${1:-}")"
        ;;
      --sort)
        shift
        SORT_FIELD="$(parse_sort_arg "${1:-}")"
        ;;
      *)
        die "Usage: tmux-agent-sessions list [--json] [--tool <claude|codex|dialogue>] [--name <name>] [--state <running|exited|stopped|missing>] [--sort <tool|name|session|state>] | list --watch --json --count <n> [--interval <seconds>] [--tool <claude|codex|dialogue>] [--name <name>] [--state <running|exited|stopped|missing>] [--sort <tool|name|session|state>]"
        ;;
    esac
    shift
  done

  if (( watch )); then
    (( output_json )) || die "list --watch requires --json"
    [[ -n "$watch_count" ]] || die "list --watch requires --count"
    require_jq
    local i=0
    while (( i < watch_count )); do
      inventory_json_array
      i=$((i + 1))
      if (( i < watch_count )); then
        sleep "$watch_interval"
      fi
    done
    return
  fi

  if (( output_json )); then
    inventory_json_array | "$JQ" -c '.[]'
  else
    inventory_json_array | "$JQ" -r '.[] | [.tool, .name, .session, .state] | @tsv'
  fi
}

watch_events() {
  local watch_count=0
  local watch_interval=2
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --count)
        shift
        watch_count="$(parse_nonnegative_integer_arg --count "${1:-}")"
        ;;
      --interval)
        shift
        watch_interval="$(parse_nonnegative_integer_arg --interval "${1:-}")"
        ;;
      --tool)
        shift
        FILTER_TOOL="$(parse_filter_arg "${1:-}")"
        ;;
      --name)
        shift
        FILTER_NAME="${1:-}"
        [[ -n "$FILTER_NAME" ]] || die "--name requires a value"
        ;;
      --state)
        shift
        FILTER_STATE="$(parse_state_arg "${1:-}")"
        ;;
      *)
        die "Usage: tmux-agent-sessions watch [--count <n>] [--interval <seconds>] [--tool <claude|codex|dialogue>] [--name <name>] [--state <running|exited|stopped|missing>]"
        ;;
    esac
    shift
  done

  require_jq

  # Previous and current snapshots keyed by tool|name|session -> state.
  # Pre-declare scalars outside the loop so `local` re-declaration does not
  # echo existing values on subsequent iterations (zsh `local foo` reprints).
  typeset -A prev_state curr_state
  local first=1
  local i=0
  local snapshot="" now="" key="" tool="" sname="" session="" state="" rest="" cur="" old=""
  while (( watch_count == 0 || i < watch_count )); do
    snapshot="$(inventory_json_array)"
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    # Rebuild current map from snapshot lines: tool\tname\tsession\tstate.
    curr_state=()
    while IFS=$'\t' read -r tool sname session state; do
      [[ -z "$tool" ]] && continue
      key="$tool|$sname|$session"
      curr_state[$key]="$state"
    done < <(print -r -- "$snapshot" | "$JQ" -r '.[] | [.tool, .name, .session, .state] | @tsv')

    if (( ! first )); then
      # Added or state_changed.
      for key in "${(@k)curr_state}"; do
        cur="${curr_state[$key]}"
        old="${prev_state[$key]-}"
        tool="${key%%|*}"
        rest="${key#*|}"
        sname="${rest%|*}"
        session="${rest##*|}"
        if [[ -z "$old" ]]; then
          "$JQ" -cn \
            --argjson schema_version 1 \
            --arg event "session_added" \
            --arg tool "$tool" \
            --arg name "$sname" \
            --arg session "$session" \
            --arg state "$cur" \
            --arg at "$now" \
            '{schema_version:$schema_version,event:$event,tool:$tool,name:$name,session:$session,state:$state,at:$at}'
        elif [[ "$old" != "$cur" ]]; then
          "$JQ" -cn \
            --argjson schema_version 1 \
            --arg event "session_state_changed" \
            --arg tool "$tool" \
            --arg name "$sname" \
            --arg session "$session" \
            --arg from "$old" \
            --arg to "$cur" \
            --arg at "$now" \
            '{schema_version:$schema_version,event:$event,tool:$tool,name:$name,session:$session,from:$from,to:$to,at:$at}'
        fi
      done
      # Removed.
      for key in "${(@k)prev_state}"; do
        if [[ -z "${curr_state[$key]-}" ]]; then
          tool="${key%%|*}"
          rest="${key#*|}"
          sname="${rest%|*}"
          session="${rest##*|}"
          "$JQ" -cn \
            --argjson schema_version 1 \
            --arg event "session_removed" \
            --arg tool "$tool" \
            --arg name "$sname" \
            --arg session "$session" \
            --arg at "$now" \
            '{schema_version:$schema_version,event:$event,tool:$tool,name:$name,session:$session,at:$at}'
        fi
      done
    fi

    prev_state=()
    for key in "${(@k)curr_state}"; do
      prev_state[$key]="${curr_state[$key]}"
    done
    first=0

    i=$((i + 1))
    if (( watch_count == 0 || i < watch_count )); then
      sleep "$watch_interval"
    fi
  done
}

cleanup_sessions() {
  local mode=""
  local output_json=0
  local all=0
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --preview)
        mode="preview"
        ;;
      --execute)
        mode="execute"
        ;;
      --json)
        output_json=1
        ;;
      --all)
        all=1
        ;;
      --tool)
        shift
        FILTER_TOOL="$(parse_filter_arg "${1:-}")"
        ;;
      --name)
        shift
        FILTER_NAME="${1:-}"
        [[ -n "$FILTER_NAME" ]] || die "--name requires a value"
        ;;
      *)
        die "Usage: tmux-agent-sessions cleanup --preview [--json] [--tool <claude|codex|dialogue>] [--name <name>] | cleanup --execute (--all | --tool <claude|codex|dialogue> | --name <name>)"
        ;;
    esac
    shift
  done

  [[ -n "$mode" ]] || die "cleanup requires --preview or --execute"
  [[ "$mode" != "execute" || "$output_json" -eq 0 ]] || die "--json is only supported with cleanup --preview"
  if [[ "$mode" == "execute" && "$all" -eq 0 && -z "$FILTER_TOOL" && -z "$FILTER_NAME" ]]; then
    die "cleanup --execute requires --all, --tool, or --name"
  fi

  local tool name session
  list_owned_sessions | while IFS=$'\t' read -r tool name session; do
    if [[ "$mode" == "preview" ]]; then
      if (( output_json )); then
        emit_inventory_json "$tool" "$name" "$session"
      else
        print -r -- "would stop: $(emit_inventory_text "$tool" "$name" "$session")"
      fi
      continue
    fi

    case "$tool" in
      claude|codex)
        "$(wrapper_for_tool "$tool")" stop "$name"
        ;;
      dialogue)
        "$TMUX" kill-session -t "$session"
        print -r -- "Stopped $session"
        ;;
    esac
  done
}

command="${1:-help}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "$command" in
  list)
    list_sessions "$@"
    ;;
  cleanup)
    cleanup_sessions "$@"
    ;;
  watch)
    watch_events "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
