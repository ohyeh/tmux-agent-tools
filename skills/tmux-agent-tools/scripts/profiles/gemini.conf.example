# Example profile: copy to ~/.config/agent-tmux/profiles/gemini.conf
# then run: agent-tmux gemini start <name> <dir> [prompt]
bin=gemini
env_ns=GEMINI
prefix=gemini-cli
launch_flags=
resume_keyword=resume
heuristic_family=generic
# Optional detection overrides (extended regex, case-insensitive):
# pattern_busy=(thinking|generating|esc to cancel)
# pattern_approval_prompt=allow this (command|action)\?
# pattern_login_prompt=sign in with google
