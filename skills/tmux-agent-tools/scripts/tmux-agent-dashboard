#!/usr/bin/env zsh
# tmux-agent-dashboard (issue #123 v1 JSON-snapshot slice, workers-core P4).
#
# Emits a JSON snapshot of all live agent sessions and fleet totals from the
# core read-only snapshot (snapshot.node.ts).

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
NODE="${NODE:-$(command -v node 2>/dev/null || true)}"

usage() {
  cat <<'EOF'
tmux-agent-dashboard - JSON snapshot of all live agent sessions (#123 v1).

Usage:
  tmux-agent-dashboard [--watch [--interval <seconds>] [--count <n>]]

Emits a single JSON object per snapshot:
  {
    "schema_version": 1,
    "at": "<ISO-8601 UTC>",
    "sessions": [<session objects>],
    "totals": {"running": N, "exited": M, "stopped": K, "total": L}
  }

Flags:
  --watch              re-emit every interval (bounded foreground loop).
  --interval <s>       seconds between snapshots when --watch (default 2).
  --count <n>          exit after n snapshots when --watch (default unlimited).
EOF
}

require_node() {
  [[ -n "$NODE" && -x "$NODE" ]] || { echo "node not found" >&2; exit 1; }
}

emit_snapshot() {
  require_node
  "$NODE" "$SCRIPT_DIR/lib/snapshot.node.ts" dashboard
}

# argv parse
watch=0
interval=2
count=0
while (( $# )); do
  case "$1" in
    --watch)    watch=1; shift ;;
    --interval) interval="${2:-2}"; shift 2 || true ;;
    --count)    count="${2:-0}"; shift 2 || true ;;
    -h|--help|help) usage; exit 0 ;;
    *)          echo "Unknown flag: $1" >&2; exit 2 ;;
  esac
done

if (( ! watch )); then
  emit_snapshot
  exit 0
fi

i=0
while (( count == 0 || i < count )); do
  emit_snapshot
  i=$((i + 1))
  (( count > 0 && i >= count )) && break
  /bin/sleep "$interval"
done
