#!/usr/bin/env zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
WRAPPER="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"
WORK="$(mktemp -d -t tmux-agent-supervise-smoke.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
trap '"$WRAPPER" stop supervise-ok >/dev/null 2>&1 || true; "$WRAPPER" stop supervise-lost >/dev/null 2>&1 || true; rm -rf "$WORK"' EXIT

cat > "$WORK/fake-cli" <<'EOF'
#!/bin/sh
sleep 60
EOF
chmod +x "$WORK/fake-cli"

pass=0 fail=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"; pass=$((pass + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2; fail=$((fail + 1))
  fi
}

echo "case: unchanged state is silent until terminal result"
CODEX="$WORK/fake-cli" "$WRAPPER" start --exact supervise-ok "$WORK" >/dev/null
out="$WORK/supervise.out"
set +e
"$WRAPPER" supervise --timeout 15 --interval 1 --result-required --silent-while-unchanged --json supervise-ok >"$out" &
pid=$!
set -e
sleep 2
assert "no output while unchanged" "$([[ -s "$out" ]] && echo noisy || echo silent)" "silent"
mkdir -p "$TMUX_AGENT_DIR/supervise-ok"
printf '%s\n' '{"schema_version":1,"status":"success","summary":"done","artifacts":[],"errors":[]}' > "$TMUX_AGENT_DIR/supervise-ok/result.json"
sup_code=0
wait "$pid" || sup_code=$?
assert "terminal supervise exit" "$sup_code" "0"
assert "terminal event" "$(jq -r .event "$out")" "terminal"
assert "terminal status" "$(jq -r .status "$out")" "success"
assert "terminal does not guess worker liveness" "$(jq -r 'has("worker_alive")' "$out")" "false"

echo "case: #317 result init seed must not satisfy terminal"
"$WRAPPER" result init seed-probe >/dev/null
seed_status="$(jq -r .status "$TMUX_AGENT_DIR/seed-probe/result.json")"
assert "init seeds non-terminal status" "$seed_status" "pending"
seed_val="$("$WRAPPER" result validate seed-probe --json 2>/dev/null)"
assert "seed is schema-valid" "$(printf '%s' "$seed_val" | jq -r .valid)" "true"
assert "seed canonical is non-terminal" "$(printf '%s' "$seed_val" | jq -r .canonical_status)" "pending"
seed_code=0
seed_out="$("$WRAPPER" supervise --timeout 1 --interval 1 --result-required --silent-while-unchanged --json seed-probe)" || seed_code=$?
assert "seed does not report terminal success" "$seed_code" "1"
assert "seed supervise event is not terminal" "$(printf '%s' "$seed_out" | jq -r '.event != "terminal"')" "true"
# A legacy-shaped success seed (empty summary) must also be rejected: supervise
# enforces the same non-empty completion evidence as `result wait-required`.
printf '%s\n' '{"schema_version":1,"status":"success","summary":"","artifacts":[],"errors":[]}' > "$TMUX_AGENT_DIR/seed-probe/result.json"
empty_code=0
empty_out="$("$WRAPPER" supervise --timeout 1 --interval 1 --result-required --silent-while-unchanged --json seed-probe)" || empty_code=$?
assert "empty-summary success is not terminal" "$empty_code" "1"
assert "empty-summary success event is not terminal" "$(printf '%s' "$empty_out" | jq -r '.event != "terminal"')" "true"
# Backward compat: a real success with a non-empty summary still terminates.
printf '%s\n' '{"schema_version":1,"status":"success","summary":"did the thing","artifacts":[],"errors":[]}' > "$TMUX_AGENT_DIR/seed-probe/result.json"
ok_code=0
ok_out="$("$WRAPPER" supervise --timeout 1 --interval 1 --result-required --silent-while-unchanged --json seed-probe)" || ok_code=$?
assert "non-empty summary success is terminal" "$ok_code" "0"
assert "non-empty summary success event" "$(printf '%s' "$ok_out" | jq -r .event)" "terminal"

echo "case: ownership flags are explicit"
flags_code=0
"$WRAPPER" supervise --timeout 1 --json supervise-ok >/dev/null 2>&1 || flags_code=$?
assert "missing ownership flags rejected" "$flags_code" "2"

echo "case: lost liveness is terminal without capture"
CODEX="$WORK/fake-cli" "$WRAPPER" start --exact supervise-lost "$WORK" >/dev/null
"$WRAPPER" stop supervise-lost >/dev/null
code=0
lost="$($WRAPPER supervise --timeout 5 --interval 1 --result-required --silent-while-unchanged --json supervise-lost)" || code=$?
assert "lost liveness exit" "$code" "1"
assert "lost liveness event" "$(printf '%s' "$lost" | jq -r .event)" "lost-liveness"

echo "supervise smoke: $pass passed, $fail failed"
(( fail == 0 ))
