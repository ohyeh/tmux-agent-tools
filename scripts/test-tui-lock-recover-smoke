#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
# Kill the lock holder across a process boundary. Kept out of
# test-core-contract-smoke (two waits of TUI_LOCK_RECOVER_MS). Lane:
# scripts/run-all-smokes (it globs scripts/test-*-smoke).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
FILE="$REPO_ROOT/skills/tmux-agent-tools/scripts/lib/tui-lock.recover.node.ts"
timeout_bin="$(command -v timeout || command -v gtimeout || true)"
if [[ -z "$timeout_bin" ]]; then
  echo "  FAIL timeout or gtimeout is required" >&2
  echo "0 passed, 1 failed" >&2
  exit 1
fi

set +e
out="$("$timeout_bin" --kill-after=5s 30s node --test --test-timeout=25000 "$FILE" 2>&1)"
code=$?
set -e
print -r -- "$out"
if (( code != 0 )); then
  echo "  FAIL tui lock recover exited $code" >&2
  echo "0 passed, 1 failed" >&2
  exit 1
fi
echo "1 passed, 0 failed"
