#!/usr/bin/env zsh
# Smoke for #189 --secret URI backends + redaction:
#   - file:<path> success
#   - env-file:<path> success
#   - missing backend CLI (op://) when op not installed → exit 4
#   - missing key in env-file → exit 4
#   - registered secret value gets redacted in capture output

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CODEX_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"
CLAUDE_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/claude-tmux"

WORK="$(mktemp -d -t tmux-agent-secret-uri.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
export TMUX_AGENT_TOOLS_AUDIT_LOG="$WORK/audit.jsonl"
export TMUX_AGENT_TOOLS_AUDIT_KEY="testkey-189"
trap 'rm -rf "$WORK"' EXIT

# Fake long-running CLI that echoes its env to the pane so capture can see it.
cat > "$WORK/fake.sh" <<'EOF'
#!/bin/sh
# Print API_TOKEN once so capture would expose it unless redacted.
echo "AGENT_BOOT api_token=${API_TOKEN:-unset}"
sleep 30
EOF
chmod +x "$WORK/fake.sh"

# Hide `op` from PATH so the op:// backend test actually triggers
# "backend missing" rather than depending on the host machine.
mkdir -p "$WORK/cleanbin"
# Recreate a minimal PATH that intentionally excludes `op`.
typeset CLEAN_PATH
CLEAN_PATH="$WORK/cleanbin:/usr/bin:/bin:/usr/sbin:/sbin"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"; PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

run_one() {
  local wrapper="$1" cli_env="$2" prefix="$3"

  echo "case: $prefix file: backend success"
  echo "tok-file-123" > "$WORK/$prefix.tok"
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact \
    --secret "API_TOKEN=file:$WORK/$prefix.tok" \
    "$prefix-f" "$WORK" >/dev/null
  /bin/sleep 1
  local session="${${wrapper:t}%-tmux}-cli-$prefix-f"
  local actual
  actual="$(tmux show-environment -t "$session" 2>/dev/null | grep '^API_TOKEN=' | cut -d= -f2-)"
  assert "$prefix file backend value" "$actual" "tok-file-123"
  "$wrapper" stop "$prefix-f" >/dev/null 2>&1 || true

  echo "case: $prefix env-file: backend success"
  cat > "$WORK/$prefix.env" <<EOT
# comment
OTHER=ignored
API_TOKEN=tok-envfile-456
EOT
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact \
    --secret "API_TOKEN=env-file:$WORK/$prefix.env" \
    "$prefix-e" "$WORK" >/dev/null
  /bin/sleep 1
  session="${${wrapper:t}%-tmux}-cli-$prefix-e"
  actual="$(tmux show-environment -t "$session" 2>/dev/null | grep '^API_TOKEN=' | cut -d= -f2-)"
  assert "$prefix env-file backend value" "$actual" "tok-envfile-456"
  "$wrapper" stop "$prefix-e" >/dev/null 2>&1 || true

  echo "case: $prefix env-file missing key rejected"
  local code=0
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact \
    --secret "NOT_THERE=env-file:$WORK/$prefix.env" \
    "$prefix-em" "$WORK" >/dev/null 2>&1 || code=$?
  assert "$prefix env-file missing-key exit=4" "$code" "4"

  echo "case: $prefix op:// without op CLI → exit 4"
  code=0
  env PATH="$CLEAN_PATH" "$cli_env=$WORK/fake.sh" "$wrapper" start --exact \
    --secret "OP_TOK=op://Vault/Item/field" \
    "$prefix-op" "$WORK" >/dev/null 2>&1 || code=$?
  assert "$prefix op:// missing CLI exit=4" "$code" "4"

  echo "case: $prefix bare path backcompat"
  echo "tok-bare-789" > "$WORK/$prefix.bare"
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact \
    --secret "API_TOKEN=$WORK/$prefix.bare" \
    "$prefix-b" "$WORK" >/dev/null
  /bin/sleep 1
  session="${${wrapper:t}%-tmux}-cli-$prefix-b"
  actual="$(tmux show-environment -t "$session" 2>/dev/null | grep '^API_TOKEN=' | cut -d= -f2-)"
  assert "$prefix bare path backcompat" "$actual" "tok-bare-789"

  echo "case: $prefix secret redacted in capture output"
  /bin/sleep 2
  local cap
  cap="$("$wrapper" capture "$prefix-b" 50 2>/dev/null || true)"
  if [[ "$cap" == *"tok-bare-789"* ]]; then
    assert "$prefix capture redaction" "leaked" "redacted"
  else
    assert "$prefix capture redaction" "redacted" "redacted"
  fi
  if [[ "$cap" == *"[REDACTED:API_TOKEN]"* ]]; then
    assert "$prefix capture redaction marker" "present" "present"
  else
    # marker may not appear if the value never landed in the pane (e.g.
    # fake.sh didn't run in time); not a hard fail.
    echo "  note $prefix capture marker absent (pane may not have rendered yet)"
  fi
  "$wrapper" stop "$prefix-b" >/dev/null 2>&1 || true

  echo "case: $prefix audit log records secret.read with backend, not value"
  if [[ -f "$TMUX_AGENT_TOOLS_AUDIT_LOG" ]]; then
    if grep -q '"event":"secret.read"' "$TMUX_AGENT_TOOLS_AUDIT_LOG" && \
       grep -q '"backend":"env-file"' "$TMUX_AGENT_TOOLS_AUDIT_LOG"; then
      assert "$prefix audit secret.read present" "yes" "yes"
    else
      assert "$prefix audit secret.read present" "no" "yes"
    fi
    if grep -q 'tok-envfile-456\|tok-file-123\|tok-bare-789' "$TMUX_AGENT_TOOLS_AUDIT_LOG"; then
      assert "$prefix audit value leak" "leaked" "absent"
    else
      assert "$prefix audit value leak" "absent" "absent"
    fi
  fi
}

run_one "$CODEX_TMUX"  "CODEX"  "u-codex"
run_one "$CLAUDE_TMUX" "CLAUDE" "u-claude"

# --- multi-line + trailing-newline + regex-meta redaction (#189 follow-up) ---
# Verifies HIGH bot findings: multi-line PEM-style secrets, trailing-\n
# files, and regex-metachar values are all redacted from `capture` output.
ml_run() {
  local wrapper="$1" cli_env="$2" prefix="$3"

  # (a) multi-line secret (3 lines): all three lines must NOT appear.
  cat > "$WORK/$prefix.pem" <<EOT
-----BEGIN FAKE KEY-----
mlSECRET-line-2-ZZ
-----END FAKE KEY-----
EOT
  # Note: tmux's `set-environment` does not preserve embedded newlines,
  # so we cannot rely on the agent CLI re-emitting the multi-line value
  # via env. Instead inject the literal value into the pane via tmux
  # send-keys after start; the redactor must scrub it from `capture`.
  cat > "$WORK/$prefix-pem.sh" <<'EOF'
#!/bin/sh
# Read injected payload file once and print it so it lands in the pane.
if [ -f "$PAYLOAD_FILE" ]; then cat "$PAYLOAD_FILE"; fi
sleep 30
EOF
  chmod +x "$WORK/$prefix-pem.sh"
  env "$cli_env=$WORK/$prefix-pem.sh" PAYLOAD_FILE="$WORK/$prefix.pem" "$wrapper" start --exact \
    --secret "PEM_KEY=file:$WORK/$prefix.pem" \
    "$prefix-pem" "$WORK" >/dev/null
  /bin/sleep 3
  local cap
  cap="$("$wrapper" capture "$prefix-pem" 200 2>/dev/null || true)"
  local leaked=no
  if [[ "$cap" == *"-----BEGIN FAKE KEY-----"* ]]; then leaked=yes; fi
  if [[ "$cap" == *"mlSECRET-line-2-ZZ"* ]]; then leaked=yes; fi
  if [[ "$cap" == *"-----END FAKE KEY-----"* ]]; then leaked=yes; fi
  assert "$prefix multiline secret not in capture" "$leaked" "no"
  "$wrapper" stop "$prefix-pem" >/dev/null 2>&1 || true

  # (b) secret with trailing newline: still redacted (matcher trims).
  printf 'trail-tok-XYZ\n' > "$WORK/$prefix.trail"
  cat > "$WORK/$prefix-trail.sh" <<'EOF'
#!/bin/sh
if [ -f "$PAYLOAD_FILE" ]; then cat "$PAYLOAD_FILE"; fi
sleep 30
EOF
  chmod +x "$WORK/$prefix-trail.sh"
  env "$cli_env=$WORK/$prefix-trail.sh" PAYLOAD_FILE="$WORK/$prefix.trail" "$wrapper" start --exact \
    --secret "TRAIL_TOK=file:$WORK/$prefix.trail" \
    "$prefix-tr" "$WORK" >/dev/null
  /bin/sleep 2
  cap="$("$wrapper" capture "$prefix-tr" 200 2>/dev/null || true)"
  leaked=no
  if [[ "$cap" == *"trail-tok-XYZ"* ]]; then leaked=yes; fi
  assert "$prefix trailing-newline secret redacted" "$leaked" "no"
  "$wrapper" stop "$prefix-tr" >/dev/null 2>&1 || true

  # (c) secret containing regex metachars: literal match required.
  printf '%s' 'p[a-z]*+.^$|(\d)?' > "$WORK/$prefix.rex"
  cat > "$WORK/$prefix-rex.sh" <<'EOF'
#!/bin/sh
if [ -f "$PAYLOAD_FILE" ]; then cat "$PAYLOAD_FILE"; fi
sleep 30
EOF
  chmod +x "$WORK/$prefix-rex.sh"
  env "$cli_env=$WORK/$prefix-rex.sh" PAYLOAD_FILE="$WORK/$prefix.rex" "$wrapper" start --exact \
    --secret "REX_TOK=file:$WORK/$prefix.rex" \
    "$prefix-rx" "$WORK" >/dev/null
  /bin/sleep 2
  cap="$("$wrapper" capture "$prefix-rx" 200 2>/dev/null || true)"
  leaked=no
  if [[ "$cap" == *'p[a-z]*+.^$|(\d)?'* ]]; then leaked=yes; fi
  assert "$prefix regex-meta secret redacted" "$leaked" "no"
  "$wrapper" stop "$prefix-rx" >/dev/null 2>&1 || true
}

ml_run "$CODEX_TMUX"  "CODEX"  "m-codex"
ml_run "$CLAUDE_TMUX" "CLAUDE" "m-claude"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
