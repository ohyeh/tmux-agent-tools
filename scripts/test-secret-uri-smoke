#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke for #189 --secret URI backends + redaction, one CLI, one launch:
#   - file:<path>, env-file:<path> and a bare path reach the session env
#   - every registered value is redacted from capture: plain, multi-line (PEM),
#     trailing newline, regex metacharacters
#   - the audit log records secret.read with the backend, never a value
#   - refusals (no launch): missing env-file key, missing bare file, op:// without
#     the op CLI (bounded) -> exit 4

set -euo pipefail
zmodload zsh/datetime

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
CODEX_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" codex)"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/tmux-agent-secret-uri.XXXXXX")"
export TMUX_AGENT_DIR="$WORK/state"
export TMUX_AGENT_TOOLS_AUDIT_LOG="$WORK/audit.jsonl"
export TMUX_AGENT_TOOLS_AUDIT_KEY="testkey-189"
trap 'rm -rf "$WORK"' EXIT

# Hide `op` from PATH so the op:// backend test actually triggers
# "backend missing" rather than depending on the host machine.
mkdir -p "$WORK/cleanbin"
tmux_path="$(command -v tmux 2>/dev/null || true)"
[[ -n "$tmux_path" ]] || { echo "tmux not found" >&2; exit 127; }
ln -s "$tmux_path" "$WORK/cleanbin/tmux"
# Recreate a minimal PATH that intentionally excludes `op`.
typeset CLEAN_PATH
CLEAN_PATH="$WORK/cleanbin:/usr/bin:/bin:/usr/sbin:/sbin"

# Portable bounded-run helper: exec child under a 3-second SIGALRM via perl
# (timeout/gtimeout are not guaranteed on dev hosts). If the child exits
# within the bound, returns the child's exit code. If alarm fires, exits 142.
run_bounded() {
  local secs="$1"; shift
  perl -e 'my $s=shift; alarm($s); exec @ARGV or exit 127' "$secs" "$@"
}

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"; PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

echo "case: one launch with file:, env-file:, bare-path and multi-line secrets"
echo "tok-file-123" > "$WORK/a.tok"
cat > "$WORK/b.env" <<EOT
# comment
OTHER=ignored
ENV_TOKEN=tok-envfile-456
EOT
echo "tok-bare-789" > "$WORK/c.bare"
cat > "$WORK/d.pem" <<EOT
-----BEGIN FAKE KEY-----
mlSECRET-line-2-ZZ
-----END FAKE KEY-----
EOT
printf 'trail-tok-XYZ\n' > "$WORK/e.trail"
printf '%s' 'p[a-z]*+.^$|(\d)?' > "$WORK/f.rex"
# The fake prints every value to the pane (tmux env drops newlines, so the
# multi-line and odd values come from the files), then a marker.
cat > "$WORK/fake.sh" <<EOF
#!/bin/sh
echo "AGENT_BOOT api=\$API_TOKEN env=\$ENV_TOKEN bare=\$BARE_TOKEN"
cat "$WORK/d.pem" "$WORK/e.trail" "$WORK/f.rex"
echo
# A colour change inside a secret: --color capture must still redact it.
printf 'split=tok-\\033[31mfile-123\\033[0m\\n'
echo AGENT_PRINTED
sleep 30
EOF
chmod +x "$WORK/fake.sh"
CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact \
  --secret "API_TOKEN=file:$WORK/a.tok" \
  --secret "ENV_TOKEN=env-file:$WORK/b.env" \
  --secret "BARE_TOKEN=$WORK/c.bare" \
  --secret "PEM_KEY=file:$WORK/d.pem" \
  --secret "TRAIL_TOK=file:$WORK/e.trail" \
  --secret "REX_TOK=file:$WORK/f.rex" \
  sec "$WORK" >/dev/null
cap=""
for (( i = 0; i < 40; i++ )); do
  cap="$("$CODEX_TMUX" capture sec 200 2>/dev/null || true)"
  [[ "$cap" == *AGENT_PRINTED* ]] && break
  sleep 0.05
done
session_env="$(tmux show-environment -t codex-cli-sec 2>/dev/null || true)"
for kv in API_TOKEN=tok-file-123 ENV_TOKEN=tok-envfile-456 BARE_TOKEN=tok-bare-789; do
  assert "session env ${kv%%=*}" "$(print -r -- "$session_env" | grep "^${kv%%=*}=" | cut -d= -f2-)" "${kv#*=}"
done
assert "the fake printed its values" "$([[ "$cap" == *AGENT_PRINTED* ]] && echo yes || echo no)" "yes"
for v in tok-file-123 tok-envfile-456 tok-bare-789 "-----BEGIN FAKE KEY-----" mlSECRET-line-2-ZZ \
         "-----END FAKE KEY-----" trail-tok-XYZ 'p[a-z]*+.^$|(\d)?'; do
  assert "capture redacts $v" "$([[ "$cap" == *"$v"* ]] && echo leaked || echo redacted)" "redacted"
done
assert "capture shows the redaction marker" "$([[ "$cap" == *"[REDACTED:API_TOKEN]"* ]] && echo present || echo absent)" "present"
capc="$("$CODEX_TMUX" capture --color sec 200 2>/dev/null || true)"
plainc="$(print -r -- "$capc" | sed -E $'s/\x1b\\[[0-9;:]*m//g')"
assert "--color capture redacts a secret split by a colour change" "$([[ "$plainc" == *tok-file-123* ]] && echo leaked || echo redacted)" "redacted"
assert "--color capture still has the split line" "$([[ "$plainc" == *"split=[REDACTED:API_TOKEN]"* ]] && echo present || echo absent)" "present"
"$CODEX_TMUX" stop sec >/dev/null 2>&1 || true

echo "case: refusals (no launch)"
code=0
CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact --secret "NOT_THERE=env-file:$WORK/b.env" sec-em "$WORK" >/dev/null 2>&1 || code=$?
assert "env-file missing key exits 4" "$code" "4"
code=0
CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact --secret "X=/no/such" sec-sm "$WORK" >/dev/null 2>&1 || code=$?
assert "bare missing file exits 4" "$code" "4"
code=0
t0=$EPOCHREALTIME
run_bounded 3 env PATH="$CLEAN_PATH" CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact \
  --secret "OP_TOK=op://Vault/Item/field" sec-op "$WORK" >/dev/null 2>&1 || code=$?
assert "op:// without the op CLI exits 4" "$code" "4"
assert "op:// refusal is bounded (<= 3 s)" "$(( EPOCHREALTIME - t0 <= 3 ))" "1"

echo "case: audit log records secret.read with backend, not value"
audit="$(cat "$TMUX_AGENT_TOOLS_AUDIT_LOG" 2>/dev/null || true)"
assert "audit secret.read env-file" "$([[ "$audit" == *'"event":"secret.read"'* && "$audit" == *'"backend":"env-file"'* ]] && echo yes || echo no)" "yes"
assert "audit holds no value" "$(print -r -- "$audit" | grep -c 'tok-envfile-456\|tok-file-123\|tok-bare-789\|mlSECRET' || true)" "0"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
