#!/usr/bin/env zsh
# Smoke for issue #139 lint. Verifies the lint:
#   1. passes on the clean tree
#   2. catches a synthetic violation when one is planted
#   3. ignores its own pattern documentation

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LINT="$REPO_ROOT/scripts/lint-no-path-tied-locals"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

# 1. Clean tree should pass
echo "case: clean tree"
code=0
"$LINT" >/dev/null || code=$?
assert "lint clean tree exit=0" "$code" "0"

# 2. Plant a synthetic violation under scripts/, lint must catch it,
#    then remove. Use a temp script-like file.
echo "case: synthetic violation caught"
VIOLATOR="$REPO_ROOT/scripts/_tmp_lint_violator_$$"
# Build the banned line at runtime so this smoke source file itself stays
# clean and the lint does not flag the smoke as a violation.
banned_name="p"; banned_name="${banned_name}ath"
printf '#!/bin/sh\nsome_fn() {\n  local %s="$1"\n}\n' "$banned_name" > "$VIOLATOR"
trap 'rm -f "$VIOLATOR"' EXIT
code=0
out="$("$LINT" 2>&1)" || code=$?
assert "lint catches synthetic violation exit=1" "$code" "1"
if [[ "$out" == *"_tmp_lint_violator_"* ]]; then
  echo "  ok   lint output names violating file"
  PASS=$((PASS + 1))
else
  echo "  FAIL lint output did not name violator" >&2
  FAIL=$((FAIL + 1))
fi
rm -f "$VIOLATOR"
trap - EXIT

# 3. Tied-pair names that are NOT banned (e.g. `local target=`) should pass
echo "case: rename-to-target passes"
SAFE_FILE="$REPO_ROOT/scripts/_tmp_lint_safe_$$"
cat > "$SAFE_FILE" <<'EOF'
some_fn() {
  local target="$1"
  echo "$target"
}
EOF
trap 'rm -f "$SAFE_FILE"' EXIT
code=0
"$LINT" >/dev/null || code=$?
assert "lint passes with safe name" "$code" "0"
rm -f "$SAFE_FILE"
trap - EXIT

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
