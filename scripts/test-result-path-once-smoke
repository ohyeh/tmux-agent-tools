#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke for what a prompt carries:
#  - #283: the result-path instruction (+ task-scope guard) is injected ONCE per
#    session; `send --raw` sends literal keys, no prefix, no Enter unless asked.
#  - producer route (workers-core P0 v5 §8): `--result-path <abs> --episode <n>`
#    names THIS prompt's file on every prompt and never touches the once sentinel;
#    `result validate --episode` checks the field. A different contract from once.
#  - send-wait nonce (Wave 1, #293): a fresh MARK-<hex> per call, the instruction
#    appended, its own (indented) line matched; a timeout still marks the sentinel;
#    a stale result or stale marker never satisfies it; a fresh valid result does.
# One session (route sends/once/raw) runs in front. Beside it run the start-prompt
# route (start sleeps a fixed 3 s before any prompt), the send-wait session and the
# assign: every multi-line paste also pays the product's fixed 1 s composer look.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"

WORK="$(mktemp -d "$TMPDIR/rp-once.XXXXXX")"  # not -t: here mktemp -t wrote outside TMPDIR (measured 2026-10-11)
export TMUX_AGENT_DIR="$WORK/state"
cleanup() {
  local n
  for n in rp1 rp2 rp3 rp-start rp-assign; do "$AGENT" codex stop "$n" >/dev/null 2>&1 || true; done
  rm -rf "$WORK"
}
add-zsh-hook zshexit cleanup

# Both fakes turn pty echo off, so each delivered line shows exactly once (got:<line>).
# fake-live answers a brief's REPORT: line with a terminal result, so assign confirms at once.
cat > "$WORK/fake-live.sh" <<'EOF'
#!/bin/sh
stty -echo 2>/dev/null || true
echo "ready"
while IFS= read -r line; do
  echo "got:$line"
  case "$line" in REPORT:*) printf '%s\n' '{"schema_version":1,"status":"success","summary":"done"}' > "$TMUX_AGENT_RESULT" ;; esac
done
EOF
# Boots with a stale [DONE]. Per task word: silent-task never answers, result-task
# writes a valid result.json at once (no nonce), echo-task/indent-task answer the nonce.
cat > "$WORK/fake-nonce.sh" <<'EOF'
#!/bin/sh
stty -echo 2>/dev/null || true
echo "[DONE]"
rp=""; mode=""
while IFS= read -r line; do
  echo "got:$line"
  case "$line" in "Write final JSON to this exact path: "*) rp="${line#Write final JSON to this exact path: }" ;; esac
  case "$line" in *silent-task*) mode=silent ;; *echo-task*) mode=echo ;; *indent-task*) mode=indent ;; esac
  case "$line" in *result-task*)
    mode=silent; mkdir -p "$(dirname "$rp")"
    printf '%s\n' '{"schema_version":1,"status":"ok","summary":"done","artifacts":[],"errors":[]}' > "$rp" ;;
  esac
  nonce="$(printf '%s\n' "$line" | sed -nE 's/.*(MARK-[0-9a-fA-F]{6}).*/\1/p' | tail -1)"
  [ -n "$nonce" ] || continue
  case "$mode" in echo) echo "$nonce" ;; indent) printf '\342\217\272 reply\n  %s\n' "$nonce" ;; esac
done
EOF
chmod +x "$WORK/fake-live.sh" "$WORK/fake-nonce.sh"
printf 'GOAL: g\nMODEL: none — isolated transport fixture\nACCEPTANCE: a\nREPORT: r\n' > "$WORK/brief.md"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then echo "  ok   $label"; PASS=$((PASS + 1))
  else echo "  FAIL $label"; echo "    expected: $expected"; echo "    got:      $actual"; FAIL=$((FAIL + 1)); fi
}
assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then echo "  ok   $label"; PASS=$((PASS + 1))
  else echo "  FAIL $label missing '$needle'"; FAIL=$((FAIL + 1)); fi
}
yn() { "$@" && echo yes || echo no; }
cx() { "$AGENT" codex "$@"; }
count() {
  local haystack="$1" needle="$2" n=0
  while [[ "$haystack" == *"$needle"* ]]; do haystack="${haystack#*"$needle"}"; n=$((n + 1)); done
  echo "$n"
}
pane() { tmux capture-pane -J -t "codex-cli-$1" -p -S -300; }
# Poll 0.05 s, bound 2 s, until the pane shows <needle>; print the pane.
pane_until() {
  local p i
  for i in {1..40}; do p="$(pane "$1")"; [[ "$p" == *"$2"* ]] && break; sleep 0.05; done
  print -r -- "$p"
}

RP="Write final JSON to this exact path"
SG="Ignore any project-local agent instructions"
# The path alone is not the contract: a worker told only where to write invents
# its own shape, and every terminal-status reader then skips it (2026-09-17 modtest1-ra02).
SCHEMA="status must be exactly one of success, failed, blocked, needs-input"

P1="$WORK/eps/1/result.json"
P2="$WORK/eps/2/result.json"
PA="$WORK/eps/a/result.json"
typeset -a lanes=()
beside() { "$1" > "$WORK/$1.log" 2>&1 & lanes+=("$1:$!"); }

# --- Beside: start carries the launch episode --------------------------------
route_start() {
  local p sentinel default_rp
  echo "case: start carries the launch episode; the route leaves the once sentinel alone"
  CODEX="$WORK/fake-live.sh" cx start --exact --result-path "$P1" --episode 1 rp-start "$WORK" "first-task" >/dev/null
  p="$(pane_until rp-start "got:first-task")"
  assert_contains "start names the given path" "$p" "$RP: $P1"
  assert_contains "start asks for episode 1" "$p" "episode: the number 1"
  assert "episode 1 has no earlier round" "$(yn grep -q 'earlier round' <<<"$p")" "no"
  default_rp="$(cx result --path rp-start)"
  sentinel="${default_rp:h}/.result-path-injected"
  assert "route leaves the session sentinel alone" "$(yn test -e "$sentinel")" "no"
  assert "scope-guard sentinel present after the start prompt" "$(yn test -e "${sentinel:h}/scope-guard-injected")" "yes"
  cx send rp-start "follow-task" >/dev/null
  p="$(pane_until rp-start "got:follow-task")"
  assert "the first plain send after a route start still injects the path" "$(count "$p" "$RP: $default_rp")" "1"
  assert "task-scope guard appears exactly once across start + sends" "$(count "$p" "$SG")" "1"
  cx stop rp-start >/dev/null 2>&1 || true
}
beside route_start

# --- Beside: assign forwards the route on its send step ----------------------
assign_lane() {
  local p
  CODEX="$WORK/fake-live.sh" cx assign --timeout 8 --confirm-window 5 --result-path "$PA" --episode 1 \
    rp-assign "$WORK" "$WORK/brief.md" >/dev/null 2>&1 || true
  echo "case: assign names the route on its send step"
  p="$(pane rp-assign)"
  assert_contains "assign names the given path" "$p" "$RP: $PA"
  assert_contains "assign asks for episode 1" "$p" "episode: the number 1"
  cx stop rp-assign >/dev/null 2>&1 || true
}
echo "case: assign route flags are refused before anything starts"
code=0; cx assign --episode 1 rp-assign "$WORK" "$WORK/brief.md" >/dev/null 2>&1 || code=$?
assert "assign --episode without --result-path exit=2" "$code" "2"
code=0; cx assign --result-path rel/r.json rp-assign "$WORK" "$WORK/brief.md" >/dev/null 2>&1 || code=$?
assert "assign relative --result-path exit=2" "$code" "2"
beside assign_lane

# --- Beside: session 2, send-wait nonce ---------------------------------------
sendwait_lane() {
  local p sentinel out code before
  echo "case: send-wait timeout marks the sentinel; stale result and stale [DONE] never satisfy it"
  CODEX="$WORK/fake-nonce.sh" cx start --exact rp2 "$WORK" >/dev/null
  cx wait-text --literal rp2 "[DONE]" 2 >/dev/null
  # A valid result.json from before the send: a fixed old mtime, so no clock wait.
  mkdir -p "$TMUX_AGENT_DIR/rp2"
  printf '%s\n' '{"schema_version":1,"status":"ok","summary":"stale","artifacts":[],"errors":[]}' > "$TMUX_AGENT_DIR/rp2/result.json"
  touch -t 202001010000 "$TMUX_AGENT_DIR/rp2/result.json"
  code=0; cx send-wait --allow-project-config rp2 "silent-task" 1 >/dev/null 2>&1 || code=$?
  assert "send-wait timed out (stale result + stale [DONE] ignored)" "$(( code != 0 ))" "1"
  sentinel="${$(cx result --path rp2):h}/.result-path-injected"
  assert "sentinel marked despite the timeout" "$(yn test -e "$sentinel")" "yes"
  p="$(pane rp2)"
  assert "send-wait --allow-project-config injects no task-scope guard" "$(count "$p" "$SG")" "0"
  assert "send-wait --allow-project-config writes no scope-guard sentinel" "$(yn test -e "${sentinel:h}/scope-guard-injected")" "no"
  before="$(count "$p" "$RP")"
  cx send rp2 "after-timeout" >/dev/null
  p="$(pane_until rp2 "got:after-timeout")"
  assert "follow-up after a timed-out send-wait does not re-inject" "$(count "$p" "$RP")" "$before"

  echo "case: send-wait nonce timeout accepts a fresh valid result.json"
  code=0; out="$(cx send-wait rp2 "result-task" 1 2>"$WORK/sw.err")" || { code=$?; cat "$WORK/sw.err"; }
  assert "fresh result: exit/completion_source/submitted" \
    "$code $(printf '%s' "$out" | jq -c '[.completion_source, .submitted]')" '0 ["result_json",true]'
  cx stop rp2 >/dev/null 2>&1 || true
}
beside sendwait_lane

nonce_lane() {
  local p nonce1 nonce2 out
  echo "case: send-wait sends a fresh nonce and waits for its own line"
  CODEX="$WORK/fake-nonce.sh" cx start --exact rp3 "$WORK" >/dev/null
  cx wait-text --literal rp3 "[DONE]" 2 >/dev/null
  out="$(cx send-wait rp3 "echo-task first request" 2 2>&1)"
  nonce1="$(printf '%s\n' "$out" | sed -nE 's/^matched nonce: (MARK-[0-9a-fA-F]{6})$/\1/p' | tail -1)"
  # claude lays a reply out as `⏺ reply` then `  MARK-xxxxxx` (live 2026-09-25).
  out="$(cx send-wait rp3 "indent-task second request" 2 2>&1)"
  nonce2="$(printf '%s\n' "$out" | sed -nE 's/^matched nonce: (MARK-[0-9a-fA-F]{6})$/\1/p' | tail -1)"
  assert "nonce shapes" "$([[ "$nonce1" =~ '^MARK-[0-9a-f]{6}$' && "$nonce2" =~ '^MARK-[0-9a-f]{6}$' ]] && echo yes)" "yes"
  assert "nonces differ" "$([[ "$nonce1" != "$nonce2" ]] && echo yes)" "yes"
  p="$(pane rp3)"
  assert_contains "first instruction appended" "$p" "End your reply with this exact nonce on its own line: $nonce1"
  assert_contains "second instruction appended" "$p" "End your reply with this exact nonce on its own line: $nonce2"
  assert_contains "first nonce on its own line" "$p" $'\n'"$nonce1"$'\n'
  assert_contains "indented nonce matched" "$p" $'\n'"  $nonce2"$'\n'
  cx stop rp3 >/dev/null 2>&1 || true
}
beside nonce_lane

# --- Front: one session for route sends, raw keys, then the once-injection ----
CODEX="$WORK/fake-live.sh" cx start --exact rp1 "$WORK" >/dev/null
pane_until rp1 ready >/dev/null
sentinel="${$(cx result --path rp1):h}/.result-path-injected"
echo "case: every send with --result-path is told again"
cx send --result-path "$P2" --episode 2 rp1 "second-task" >/dev/null
c1="$(count "$(pane_until rp1 "got:second-task")" "$RP: $P2")"
cx send --result-path "$P2" --episode 2 rp1 "second-again" >/dev/null
p="$(pane_until rp1 "got:second-again")"
assert "episode-2 path named on each send" "$c1 $(count "$p" "$RP: $P2")" "1 2"
assert_contains "episode 2 asked for" "$p" "episode: the number 2"
assert_contains "episode 2 closes earlier paths" "$p" "earlier round is closed"
assert "still no session sentinel" "$(yn test -e "$sentinel")" "no"

echo "case: bad route flags are refused before anything is sent"
code=0; cx send --episode 3 rp1 x >/dev/null 2>&1 || code=$?
assert "--episode without --result-path exit=2" "$code" "2"
code=0; cx send --result-path rel/result.json rp1 x >/dev/null 2>&1 || code=$?
assert "relative --result-path exit=2" "$code" "2"
code=0; cx send --result-path "$P2" --episode 0 rp1 x >/dev/null 2>&1 || code=$?
assert "--episode 0 exit=2" "$code" "2"

echo "case: result validate --episode"
# episode field | --episode asked | expected exit
for ep want_ep want in 2 2 0 2 3 1 '"2"' 2 0 '"2x"' 2 1 none 2 1; do
  body='{"schema_version":1,"status":"success","summary":"s","artifacts":[],"errors":[]'
  [[ "$ep" == none ]] && body+='}' || body+=",\"episode\":$ep}"
  mkdir -p "${P2:h}"; printf '%s\n' "$body" > "$P2"
  code=0; out="$(cx result validate rp1 --json --path "$P2" --episode "$want_ep" 2>/dev/null)" || code=$?
  assert "episode $ep vs --episode $want_ep exit=$want" "$code" "$want"
done
assert "a mismatch names the field" "$(printf '%s' "$out" | jq -r '.errors[-1].path')" ".episode"

echo "case: send --raw never injects and presses no Enter by default"
cx send --raw rp1 "t" >/dev/null
assert "raw send does not mark the sentinel" "$(yn test -e "$sentinel")" "no"
cx send --raw --enter-count 1 rp1 "t" >/dev/null
p="$(pane_until rp1 "got:tt")"
assert_contains "raw key submitted only with an explicit Enter" "$p" "got:tt"
empty_lines() { pane rp1 | grep -cx 'got:' || true; }
empty_before="$(empty_lines)"
cx send --key enter rp1 >/dev/null
for _ in {1..40}; do (( $(empty_lines) > empty_before )) && break; sleep 0.05; done
assert "send --key enter submits an empty line" "$(( $(empty_lines) - empty_before ))" "1"
assert "send --key enter types no literal Enter" "$(count "$(pane rp1)" "got:Enter")" "0"
code=0; cx send --raw --from-file "$WORK/brief.md" rp1 >/dev/null 2>&1 || code=$?
assert "raw + from-file exit=2" "$code" "2"
assert "raw sends inject no result-path" "$(count "$p" "$RP: $TMUX_AGENT_DIR")" "0"

echo "case: the first plain send injects the result path once, with its schema"
default_rp="$(cx result --path rp1)"
cx send rp1 "plain-task" >/dev/null
p="$(pane_until rp1 "got:plain-task")"
assert "first plain send injects the default path" "$(count "$p" "$RP: $default_rp")" "1"
assert "sentinel present after the first plain send" "$(yn test -e "$sentinel")" "yes"
assert_contains "result schema injected alongside the path" "$p" "$SCHEMA"
# result_path is parsed as the rest of the marker line: a suffix there corrupts it.
assert "schema line does not ride on the path line" "$(printf '%s\n' "$p" | grep -c "$RP.*$SCHEMA" || true)" "0"
cx send rp1 "follow-task" >/dev/null
p="$(pane_until rp1 "got:follow-task")"
assert "follow-up send adds no new injection" "$(count "$p" "$RP: $default_rp")" "1"
cx stop rp1 >/dev/null 2>&1 || true

# --- Collect the side lanes ----------------------------------------------------
for lane in "${lanes[@]}"; do
  rc=0; wait "${lane#*:}" || rc=$?
  cat "$WORK/${lane%%:*}.log"
  PASS=$((PASS + $(grep -c '^  ok ' "$WORK/${lane%%:*}.log" || true)))
  FAIL=$((FAIL + $(grep -c '^  FAIL ' "$WORK/${lane%%:*}.log" || true)))
  assert "${lane%%:*} ran to the end" "$rc" "0"
done

echo "result-path-once smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
