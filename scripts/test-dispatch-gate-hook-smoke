#!/usr/bin/env bash
# Smoke test for hooks/tmux-dispatch-gate.sh — feeds PreToolUse-shaped
# stdin JSON straight into the hook and asserts exit codes + deny messages.
# No tmux, no Claude runtime needed.
set -euo pipefail

HOOK="$(cd "$(dirname "$0")/.." && pwd)/hooks/tmux-dispatch-gate.sh"
SID="smoke-$$"
STATE_DIR="$HOME/.local/state/agent-hooks/$SID"
cleanup() { rm -rf "$STATE_DIR"; }
trap cleanup EXIT

FAILS=0
check() { # check <name> <expected_exit> <json> [expected_stderr_grep]
  local name="$1" want="$2" json="$3" grep_for="${4:-}"
  local err rc=0
  err="$(printf '%s' "$json" | bash "$HOOK" 2>&1 >/dev/null)" || rc=$?
  if [ "$rc" != "$want" ]; then
    echo "FAIL [$name] exit=$rc want=$want"; FAILS=$((FAILS+1)); return
  fi
  if [ -n "$grep_for" ] && ! printf '%s' "$err" | grep -q "$grep_for"; then
    echo "FAIL [$name] stderr missing '$grep_for': $err"; FAILS=$((FAILS+1)); return
  fi
  echo "PASS [$name]"
}

j() { # j <command> -> parent-context PreToolUse JSON
  printf '{"session_id":"%s","tool_name":"Bash","tool_input":{"command":"%s"}}' "$SID" "$1"
}

# 1. non-dispatch command passes
check "non-dispatch" 0 "$(j 'git status')"
# 2. read-only wrapper subcommand passes
check "readonly-subcmd" 0 "$(j 'agent-tmux codex status foo --json')"
# 3. parent dispatch without receipt -> GATE 1 deny
check "gate1-deny" 2 "$(j 'agent-tmux codex start worker1 --headless')" "BLOCKED by dispatch gate"
# 4. subagent context passes even without receipt
check "subagent-pass" 0 '{"session_id":"'"$SID"'","agent_type":"general-purpose","tool_input":{"command":"agent-tmux codex start worker1"}}'
# 5. an undated/short receipt is still rejected
mkdir -p "$STATE_DIR"; printf 'short receipt\n' > "$STATE_DIR/gate-receipt-parent-dispatch"
check "gate1-invalid-receipt" 2 "$(j 'agent-tmux codex start worker1 --headless')" "BLOCKED by dispatch gate"
# 6. dated substantive receipt -> GATE 1 passes
printf '%s User explicitly authorized direct parent dispatch for this smoke test; the fixture exercises the enforced receipt contract.\n' "$(date -u +%F)" > "$STATE_DIR/gate-receipt-parent-dispatch"
check "gate1-receipt-pass" 0 "$(j 'agent-tmux codex start worker1 --headless')"
# 7. first review-shaped dispatch passes (counter=1... but #6 already logged one
#    'worker1' — non-review name, so counter starts here)
check "review-1st-pass" 0 "$(j 'agent-tmux codex start sol_review_e1 --headless')"
# 8. second review-shaped dispatch -> GATE 2 deny; --exact flag between
#    start and the name must not hide the review shape
check "review-2nd-deny" 2 "$(j 'agent-tmux codex start --exact sol_review_e2 --headless')" "BLOCKED by workflow gate"
# 9. dated substantive workflow receipt -> GATE 2 passes
printf '%s consensus-gate is the selected workflow for this second review-shaped dispatch; this is the smoke rationale.\n' "$(date -u +%F)" > "$STATE_DIR/gate-receipt-workflow"
check "gate2-receipt-pass" 0 "$(j 'agent-tmux codex start sol_review_e3 --headless')"
# 10. non-review start never counts toward GATE 2
check "nonreview-start-pass" 0 "$(j 'agent-tmux codex start impl_worker --headless')"

# 11–13. false-positive regressions (fresh session id: no receipts, so a
# misclassified dispatch would DENY, not pass). Observed live 2026-08-08:
# `help send-wait` and a git commit whose message quoted the subcommands.
SID2="smoke2-$$"
j2() { printf '{"session_id":"%s","tool_name":"Bash","tool_input":{"command":"%s"}}' "$SID2" "$1"; }
check "help-subcmd-pass" 0 "$(j2 'agent-tmux codex help send-wait')"
check "commit-msg-pass" 0 "$(j2 'git commit -m \"docs: agent-tmux codex flow — result init then send --from-file\"')"
check "assign-pass" 0 "$(j2 'agent-tmux codex assign job /repo /abs/prompt.txt')"
rm -rf "$HOME/.local/state/agent-hooks/$SID2"

# 14–16. one tool call counts once for GATE 2 (F6): cursor-agent runs the gate
# once per loaded copy of the plugin, with the same tool_use_id, concurrently.
SID3="smoke3-$$"; ST3="$HOME/.local/state/agent-hooks/$SID3"
mkdir -p "$ST3"
printf '%s User explicitly authorized direct parent dispatch for this smoke test; GATE 1 is not under test here.\n' "$(date -u +%F)" > "$ST3/gate-receipt-parent-dispatch"
j3() { printf '{"session_id":"%s","tool_use_id":"%s","tool_name":"Shell","tool_input":{"command":"%s"}}' "$SID3" "$1" "$2"; }
for i in 1 2 3; do ( printf '%s' "$(j3 call-a 'agent-tmux codex start sol_review_a')" | bash "$HOOK" >"$ST3/out$i" 2>&1; echo $? >"$ST3/rc$i" ) & done; wait
lines="$(wc -l < "$ST3/review-dispatch.log" | tr -d ' ')"
if [ "$lines" = 1 ]; then echo "PASS [same-id-concurrent-counts-once]"; else echo "FAIL [same-id-concurrent-counts-once] log lines=$lines want=1"; FAILS=$((FAILS+1)); fi
copies="$(cat "$ST3"/rc1 "$ST3"/rc2 "$ST3"/rc3 | tr -d '\n'):$(cat "$ST3"/out1 "$ST3"/out2 "$ST3"/out3)"
if [ "$copies" = "000:" ]; then echo "PASS [same-id-concurrent-copies-clean]"; else echo "FAIL [same-id-concurrent-copies-clean] rc:output=$copies"; FAILS=$((FAILS+1)); fi
check "same-id-repeat-pass" 0 "$(j3 call-a 'agent-tmux codex start sol_review_a')"
check "new-id-2nd-review-deny" 2 "$(j3 call-b 'agent-tmux codex start sol_review_b')" "dispatch #2"
rm -rf "$ST3"

# 17. ids that differ only in characters outside [A-Za-z0-9._-] are two calls (Sol r10 #1).
SID4="smoke4-$$"; ST4="$HOME/.local/state/agent-hooks/$SID4"
mkdir -p "$ST4"
printf '%s User explicitly authorized direct parent dispatch for this smoke test; GATE 1 is not under test here.\n' "$(date -u +%F)" > "$ST4/gate-receipt-parent-dispatch"
j4() { printf '{"session_id":"%s","tool_use_id":"%s","tool_name":"Shell","tool_input":{"command":"%s"}}' "$SID4" "$1" "$2"; }
check "slash-id-1st-pass" 0 "$(j4 'call/a' 'agent-tmux codex start sol_review_a')"
check "query-id-2nd-review-deny" 2 "$(j4 'call?a' 'agent-tmux codex start sol_review_b')" "dispatch #2"
check "dotdot-id-counts" 2 "$(j4 '..' 'agent-tmux codex start sol_review_c')" "dispatch #3"
rm -rf "$ST4"

# 18–19. a long id still counts, and a copy that died before writing its line is no pass (Sol r11 #1, #2).
SID5="smoke5-$$"; ST5="$HOME/.local/state/agent-hooks/$SID5"
mkdir -p "$ST5"
printf '%s User explicitly authorized direct parent dispatch for this smoke test; GATE 1 is not under test here.\n' "$(date -u +%F)" > "$ST5/gate-receipt-parent-dispatch"
j5() { printf '{"session_id":"%s","tool_use_id":"%s","tool_name":"Shell","tool_input":{"command":"%s"}}' "$SID5" "$1" "$2"; }
long="$(printf 'a%.0s' $(seq 127))"
check "long-id-1st-pass" 0 "$(j5 first 'agent-tmux codex start sol_review_a')"
check "long-id-2nd-review-deny" 2 "$(j5 "$long" 'agent-tmux codex start sol_review_b')" "dispatch #2"
if command -v sha256sum >/dev/null 2>&1; then h="$(printf '%s' dead-copy | sha256sum)"; else h="$(printf '%s' dead-copy | shasum -a 256)"; fi
rm -rf "$ST5"; mkdir -p "$ST5"   # fresh: exactly one counted dispatch before the dead copy
printf '%s User explicitly authorized direct parent dispatch for this smoke test; GATE 1 is not under test here.\n' "$(date -u +%F)" > "$ST5/gate-receipt-parent-dispatch"
check "dead-copy-setup-1st-pass" 0 "$(j5 first 'agent-tmux codex start sol_review_a')"
mkdir -p "$ST5/seen/id-${h%% *}"   # the recording copy made its marker, then died before its line
check "dead-copy-no-pass" 2 "$(j5 dead-copy 'agent-tmux codex start sol_review_c')" "did not finish recording"
rm -rf "$ST5"

# 20. no working sha256 tool: deny, never share one `id-` marker (Sol r11 ep2).
SID6="smoke6-$$"; ST6="$HOME/.local/state/agent-hooks/$SID6"; FAKE="$(mktemp -d)"
mkdir -p "$ST6"
printf '%s User explicitly authorized direct parent dispatch for this smoke test; GATE 1 is not under test here.\n' "$(date -u +%F)" > "$ST6/gate-receipt-parent-dispatch"
printf '#!/bin/sh\nexit 1\n' > "$FAKE/sha256sum"; chmod +x "$FAKE/sha256sum"
rc=0; err="$(printf '{"session_id":"%s","tool_use_id":"x1","tool_name":"Shell","tool_input":{"command":"agent-tmux codex start sol_review_a"}}' "$SID6" | PATH="$FAKE:$PATH" bash "$HOOK" 2>&1 >/dev/null)" || rc=$?
if [ "$rc" = 2 ] && printf '%s' "$err" | grep -q "no sha256 digest"; then echo "PASS [no-digest-deny]"; else echo "FAIL [no-digest-deny] rc=$rc $err"; FAILS=$((FAILS+1)); fi
rm -rf "$ST6" "$FAKE"

# 21–23. a count that cannot be trusted is no pass (Sol r11 ep3): unreadable log,
# unwritable log on the no-id path, and ids that differ only in a trailing newline.
SID7="smoke7-$$"; ST7="$HOME/.local/state/agent-hooks/$SID7"
j7() { printf '{"session_id":"%s","tool_use_id":"%s","tool_name":"Shell","tool_input":{"command":"%s"}}' "$SID7" "$1" "$2"; }
fresh7() { rm -rf "$ST7"; mkdir -p "$ST7"; printf '%s User explicitly authorized direct parent dispatch for this smoke test; GATE 1 is not under test here.\n' "$(date -u +%F)" > "$ST7/gate-receipt-parent-dispatch"; }
fresh7; : > "$ST7/review-dispatch.log"; chmod 0200 "$ST7/review-dispatch.log"
check "unreadable-log-deny" 2 "$(j7 r1 'agent-tmux codex start sol_review_a')" "log unreadable"
fresh7; : > "$ST7/review-dispatch.log"; chmod 0400 "$ST7/review-dispatch.log"
check "noid-unwritable-log-deny" 2 "$(j 'agent-tmux codex start sol_review_a' | sed "s/$SID/$SID7/")" "log write failed"
fresh7
check "newline-id-1st-pass" 0 "$(j7 'call-a' 'agent-tmux codex start sol_review_a')"
check "newline-id-2nd-review-deny" 2 "$(j7 'call-a\n' 'agent-tmux codex start sol_review_b')" "dispatch #2"
chmod -R u+rw "$ST7" 2>/dev/null; rm -rf "$ST7"

if [ "$FAILS" -ne 0 ]; then echo "SMOKE FAIL ($FAILS)"; exit 1; fi
echo "SMOKE OK — all checks passed"
