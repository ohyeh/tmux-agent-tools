#!/usr/bin/env zsh
# Smoke for tmux-agent-commander (SPEC.md §Tests).
# Five cases, each with an explicit assertion:
#   1. assign publishes the v5 descriptor (owner = session) before the launch
#   2. a terminal result is pasted once; the next tick pastes nothing; acks/done closes it
#   3. a live other owner's episode is never pasted
#   4. the activation beat is refreshed each tick
#   5. collect exits when the commander session is gone
#   6. panel with no workers is the snapshot line; R9 lists a .v3 worker.
#      Mark, order, and width fixtures stay in snapshot.contract.node.ts.
#   7. start sets a per-session second status line; --no-panel does not
#   8. assign in a <cli prefix>-<name> pane starts one server-owned collector
#   9. a second assign does not start another collector
#  10. a session matching no cli prints the hint and exits 0
#  11. collect exits 0 without writing when a live collector owns the pid file
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
REPO_ROOT="${SCRIPT_DIR:h}"
COMMANDER="$REPO_ROOT/skills/tmux-agent-tools/scripts/tmux-agent-commander"

WORK="$(mktemp -d -t tmux-agent-commander.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
export XDG_CONFIG_HOME="$WORK/xdg"
export AGENT_TMUX_PROFILE_DIR="$WORK/noprofiles"
export XDG_STATE_HOME="$WORK/xdg-state"
unset TMUX TMUX_PANE AGENT_TMUX_PREFIX CODEX_TMUX_PREFIX CLAUDE_TMUX_PREFIX AGY_TMUX_PREFIX
unset CURSOR_TMUX_PREFIX GROK_TMUX_PREFIX TMUX_AGENT_TOOLS_TENANT
# macOS socket paths top out near 104 bytes. This is tmux's own default socket
# under TMUX_TMPDIR, so a client that only has the dir still hits this server.
# $TMUX outranks the dir, so every call also passes -S and the child env drops it.
export TMUX_TMPDIR="/tmp/tcmd-$$"
REAL_TMUX="$(command -v tmux)"
export TMUX_AGENT_TMUX_SOCKET="$TMUX_TMPDIR/tmux-$(id -u)/default"
# Direct smoke calls. Commander and the fake agent-tmux still exec plain tmux;
# the PATH shim below adds -S for those, because $TMUX outranks TMUX_TMPDIR.
private_tmux() { command env -u TMUX -u TMUX_PANE "$REAL_TMUX" -S "$TMUX_AGENT_TMUX_SOCKET" "$@"; }
mkdir -p "$TMUX_AGENT_DIR" "$XDG_CONFIG_HOME" "$AGENT_TMUX_PROFILE_DIR" "${TMUX_AGENT_TMUX_SOCKET:h}" "$WORK/bin"
# ~/.zshenv prepends ~/.local/bin on every new zsh. The commander is one, so
# that stale agent-tmux would win over the fake. An empty ZDOTDIR skips it.
export ZDOTDIR="$WORK/zdot"
mkdir -p "$ZDOTDIR"

PREFIX="$(awk -F= '/^prefix=/{print $2; exit}' "$REPO_ROOT/skills/tmux-agent-tools/scripts/profiles/codex.conf")"
[[ -n "$PREFIX" ]] || { echo "codex profile has no prefix" >&2; exit 1; }
export COMMANDER_PREFIX="$PREFIX"

export FAKE_LOG="$WORK/fake.log"
export FAKE_SNAP="$WORK/dispatch-at-launch.json"
export FAKE_PROMPTS="$WORK/prompts.list"
: > "$FAKE_LOG"
: > "$FAKE_PROMPTS"

cleanup() {
  local pid
  if [[ -n "${COLLECT_PID:-}" ]]; then
    kill "$COLLECT_PID" 2>/dev/null || true
  fi
  if [[ -n "${DCOLLECT_PID:-}" ]]; then
    kill "$DCOLLECT_PID" 2>/dev/null || true
  fi
  if [[ -n "${TIMER_PID:-}" ]]; then
    kill "$TIMER_PID" 2>/dev/null || true
  fi
  private_tmux kill-server 2>/dev/null || true
  rm -rf "$WORK" "$TMUX_TMPDIR"
}
trap cleanup EXIT

cat > "$WORK/bin/agent-tmux" <<'EOF'
#!/bin/sh
printf '%s\n' "$*" >> "$FAKE_LOG"
case "$2" in
  start)
    # agent-tmux <cli> start --exact <name> <dir>
    command env -u TMUX -u TMUX_PANE tmux -S "$TMUX_AGENT_TMUX_SOCKET" new-session -d -s "${COMMANDER_PREFIX}-$4" "sleep 180"
    ;;
  assign)
    prev=""
    rp=""
    for a in "$@"; do
      if [ "$prev" = "--result-path" ]; then
        rp=$a
      fi
      prev=$a
    done
    if [ -n "$rp" ]; then
      wdir=$(dirname "$rp")
      desc="$wdir/episodes/1/dispatch.json"
      wj="$wdir/worker.json"
      if [ -f "$desc" ] && [ -f "$wj" ]; then
        jq -n --slurpfile w "$wj" --slurpfile d "$desc" \
          '$w[0] + {goal:$d[0].goal, base:$d[0].base}' > "$FAKE_SNAP"
        printf '%s\n' "dispatch-before-launch:$(jq -r .name "$wj")" >> "$FAKE_LOG"
      else
        printf '%s\n' "dispatch-missing:${rp}" >> "$FAKE_LOG"
      fi
    else
      printf '%s\n' "dispatch-missing:no-result-path" >> "$FAKE_LOG"
    fi
    ;;
  send)
    prev=""
    for a in "$@"; do
      if [ "$prev" = "--prompt-file" ]; then
        printf '%s\n' "$a" >> "$FAKE_PROMPTS"
        # The commander deletes its prompt file once send returns; keep the text.
        cp "$a" "$a.copy"
      fi
      prev=$a
    done
    ;;
esac
exit 0
EOF
cat > "$WORK/bin/tmux" <<EOF
#!/bin/sh
# Private server only. -S/-L already on the command line is left as written.
unset TMUX TMUX_PANE
for a in "\$@"; do
  case "\$a" in
    -S|-L) exec ${REAL_TMUX} "\$@" ;;
  esac
done
exec ${REAL_TMUX} -S ${TMUX_AGENT_TMUX_SOCKET} "\$@"
EOF
chmod +x "$WORK/bin/agent-tmux" "$WORK/bin/tmux" "$COMMANDER"
# Only this bin dir has the fake. A later copy on PATH rejects flags the core passes.
export PATH="$WORK/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

PASS=0
FAIL=0
assert() {
  local label="$1" got="$2" want="$3"
  if [[ "$got" == "$want" ]]; then
    print -r -- "  ok   $label"
    PASS=$((PASS + 1))
  else
    print -r -- "  FAIL $label: got '$got' want '$want'"
    FAIL=$((FAIL + 1))
  fi
}
assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    print -r -- "  ok   $label"
    PASS=$((PASS + 1))
  else
    print -r -- "  FAIL $label: '$needle' not in output"
    FAIL=$((FAIL + 1))
  fi
}
assert_excludes() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" != *"$needle"* ]]; then
    print -r -- "  ok   $label"
    PASS=$((PASS + 1))
  else
    print -r -- "  FAIL $label: '$needle' was present"
    FAIL=$((FAIL + 1))
  fi
}
index_of() {
  local needle="$1" hay="$2" prefix
  prefix="${hay%%"$needle"*}"
  if [[ "$prefix" == "$hay" ]]; then
    print -r -- -1
  else
    print -r -- "${#prefix}"
  fi
}
poll() {
  local tries="$1"
  shift
  local i
  for (( i = 0; i < tries; i++ )); do
    if "$@"; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

prompt_lines() {
  wc -l < "$FAKE_PROMPTS" | tr -d ' '
}

echo "case: assign outside tmux is refused"
code=0
out="$("$COMMANDER" assign codex worker "$WORK" "$WORK/nope" 2>&1)" || code=$?
assert "assign outside tmux exits 1" "$code" "1"
assert_contains "assign outside tmux says why" "$out" "not inside tmux"

echo
echo "case 1: assign publishes the v5 descriptor with owner = session name before the launch"
ASSIGN_SESSION="commander-smoke-assign-$$"
ASSIGN_CWD="$WORK/pane"
REPO="$WORK/repo"
BRIEF="$WORK/brief.md"
WORKER="worker$$"
mkdir -p "$ASSIGN_CWD" "$REPO"
git -C "$REPO" init -q
git -C "$REPO" -c user.email=t@example.com -c user.name=t commit --allow-empty -q -m init
HEAD_SHA="$(git -C "$REPO" rev-parse HEAD)"
printf 'GOAL: ship the commander\nACCEPTANCE: tests pass\nREPORT: done\n' > "$BRIEF"
ASSIGN_OUT="$WORK/assign.out"
ASSIGN_ERR="$WORK/assign.err"
ASSIGN_CODE="$WORK/assign.code"
cat > "$WORK/run-assign.zsh" <<EOF
#!/usr/bin/env zsh
set -euo pipefail
export PATH=${(q)WORK}/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
export TMUX_AGENT_DIR=${(q)TMUX_AGENT_DIR}
export XDG_CONFIG_HOME=${(q)XDG_CONFIG_HOME}
export AGENT_TMUX_PROFILE_DIR=${(q)AGENT_TMUX_PROFILE_DIR}
export FAKE_LOG=${(q)FAKE_LOG}
export FAKE_SNAP=${(q)FAKE_SNAP}
export FAKE_PROMPTS=${(q)FAKE_PROMPTS}
export COMMANDER_PREFIX=${(q)COMMANDER_PREFIX}
export TMUX_AGENT_TMUX_SOCKET=${(q)TMUX_AGENT_TMUX_SOCKET}
export ZDOTDIR=${(q)WORK}/zdot
unset AGENT_TMUX_PREFIX CODEX_TMUX_PREFIX TMUX_AGENT_TOOLS_TENANT
cd ${(q)ASSIGN_CWD}
${(q)COMMANDER} assign codex ${(q)WORKER} ${(q)REPO} ${(q)BRIEF} >${(q)ASSIGN_OUT} 2>${(q)ASSIGN_ERR}
print -r -- \$? > ${(q)ASSIGN_CODE}
EOF
chmod +x "$WORK/run-assign.zsh"
private_tmux new-session -d -s "$ASSIGN_SESSION" "$WORK/run-assign.zsh"
assign_done() { [[ -f "$ASSIGN_CODE" ]]; }
poll 50 assign_done || { echo "assign did not finish" >&2; echo "--- err ---"; cat "$ASSIGN_ERR" 2>/dev/null || true; echo "--- log ---"; cat "$FAKE_LOG"; exit 1; }
have_snap() { [[ -s "$FAKE_SNAP" ]] && grep -q 'dispatch-before-launch:' "$FAKE_LOG"; }
poll 50 have_snap || {
  echo "launch did not see the descriptor" >&2
  echo "--- fake log ---"; cat "$FAKE_LOG"
  echo "--- out ---"; cat "$ASSIGN_OUT" 2>/dev/null || true
  echo "--- err ---"; cat "$ASSIGN_ERR" 2>/dev/null || true
  logp="$(sed -n 's/.*launch log: \([^)]*\)).*/\1/p' "$ASSIGN_OUT" | head -1)"
  echo "--- launch log ($logp) ---"
  cat "$logp" 2>/dev/null || true
  exit 1
}
assert "assign inside tmux exits 0" "$(<"$ASSIGN_CODE")" "0"
NOCLI_HINT="no collector for ${ASSIGN_SESSION}: run \`tmux-agent-commander collect <cli> <name>\` from a shell outside this CLI"
assert "no cli match prints the hint" "$(tr -d '\n' < "$ASSIGN_ERR")" "$NOCLI_HINT"
assert_excludes "no cli match does not start a collector" "$(<"$ASSIGN_OUT")" "collector started"
assert "no cli match writes no pid file" "$([[ -e "$TMUX_AGENT_DIR/.commander-${ASSIGN_SESSION}.pid" ]] && echo yes || echo no)" "no"
assert_contains "fake saw dispatch.json before launch" "$(<"$FAKE_LOG")" "dispatch-before-launch:$WORKER"
assert "owner is the tmux session name" "$(jq -r '.owner' "$FAKE_SNAP")" "$ASSIGN_SESSION"
assert "profile recorded" "$(jq -r '.profile' "$FAKE_SNAP")" "codex"
RECORDED="$(jq -r '.name' "$FAKE_SNAP")"
assert "worker name is the given name plus a 5-char v5 suffix" "$([[ "$RECORDED" == ${WORKER}.[0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z] ]] && echo yes || echo "$RECORDED")" "yes"
assert "dir recorded" "$(jq -r '.dir' "$FAKE_SNAP")" "${REPO:A}"
assert "since is a number" "$(jq -r '.since|type' "$FAKE_SNAP")" "number"
assert "goal is the GOAL line" "$(jq -r '.goal' "$FAKE_SNAP")" "ship the commander"
assert "base is git HEAD" "$(jq -r '.base' "$FAKE_SNAP")" "$HEAD_SHA"
assert "ownerCwd is the pane cwd" "$(jq -r '.ownerCwd' "$FAKE_SNAP")" "${ASSIGN_CWD:A}"
assert_contains "launch argv is assign --detach" "$(<"$FAKE_LOG")" "assign --detach"
assert_contains "launch argv carries --result-path" "$(<"$FAKE_LOG")" "--result-path"
assert_contains "launch argv carries --episode" "$(<"$FAKE_LOG")" "--episode"
assert_contains "stdout names the worker" "$(<"$ASSIGN_OUT")" "$WORKER"
assert_contains "stdout says nobody is collecting" "$(<"$ASSIGN_OUT")" "collector: NONE"
# R9: the status line reads .v3. A worker assigned through this command shows up.
R9_LINE="$(cd "$ASSIGN_CWD" && "$COMMANDER" panel "$ASSIGN_SESSION" --width 200)"
assert_contains "R9: panel lists the worker assigned by commander assign" "$R9_LINE" "$RECORDED"
# Same name again: a fresh directory, so the first run's result.json can never
# be read as the second run's answer.
rm -f "$ASSIGN_CODE" "$FAKE_SNAP"
sleep 0.01
private_tmux new-session -d -s "${ASSIGN_SESSION}b" "$WORK/run-assign.zsh"
poll 50 assign_done || { echo "second assign did not finish" >&2; exit 1; }
poll 50 have_snap || { echo "second launch did not see the descriptor" >&2; cat "$FAKE_LOG"; exit 1; }
SECOND="$(jq -r '.name' "$FAKE_SNAP")"
assert "a reused worker name gets a new directory" "$([[ "$SECOND" != "$RECORDED" && -d "$TMUX_AGENT_DIR/.v3/$SECOND" ]] && echo yes || echo no)" "yes"

session_key() {
  python3 -c 'import sys; print(sys.argv[1].encode().hex())' "$1"
}

echo
echo "case 2-5: collect pastes an owned terminal result once, refreshes the beat, then exits"
CNAME="smokeboss$$"
SESSION="${PREFIX}-${CNAME}"
OWNED="owned$$"
OTHER="other$$"
SINCE=1700000000001
LONG="$(perl -e 'print "OWNEDOK" . ("x" x 693)')"
# The collector pastes only into a known CLI's empty composer (64b48c1), so the host pane
# runs the core's fake composer; its state dir name lets hostCli see "cursor-agent".
FAKE_HOST_STATE="$(mktemp -d "$WORK/cursor-agent-fake.XXXX")"
private_tmux new-session -d -s "$SESSION" -x 4000 -y 50 \
  "${(q)$(command -v node)} ${(q)REPO_ROOT}/skills/tmux-agent-tools/scripts/lib/fixtures/composer/fake-cursor.mjs ${(q)FAKE_HOST_STATE}"
PANE="$(private_tmux display-message -p -t "$SESSION" '#{pane_id}')"
PANE_CWD="$(private_tmux display-message -p -t "$PANE" '#{pane_current_path}')"
V3="$TMUX_AGENT_DIR/.v3"
mkdir -p "$V3/$OWNED/episodes/1/sent" "$V3/$OTHER/episodes/1/sent" "$REPO"
jq -n \
  --arg profile codex --arg name "$OWNED" --arg dir "${REPO:A}" \
  --argjson since "$SINCE" --arg owner "$SESSION" --arg ownerCwd "$PANE_CWD" \
  '{profile:$profile,name:$name,dir:$dir,since:$since,owner:$owner,ownerCwd:$ownerCwd,origin:"assign"}' \
  > "$V3/$OWNED/worker.json"
jq -n \
  --argjson since "$SINCE" --arg owner "$SESSION" --arg result "$V3/$OWNED/result.json" \
  '{seq:1,since:$since,owner:$owner,goal:"ship",resultPath:$result,origin:"launch"}' \
  > "$V3/$OWNED/episodes/1/dispatch.json"
jq -n --arg summary "$LONG" \
  '{schema_version:1,status:"success",summary:$summary,artifacts:[],errors:[],episode:1}' \
  > "$V3/$OWNED/result.json"
jq -n \
  --arg profile agy --arg name "$OTHER" --arg dir "${REPO:A}" \
  --argjson since 1700000000002 --arg owner "someone-else" --arg ownerCwd "$PANE_CWD" \
  '{profile:$profile,name:$name,dir:$dir,since:$since,owner:$owner,ownerCwd:$ownerCwd,origin:"assign"}' \
  > "$V3/$OTHER/worker.json"
jq -n \
  --argjson since 1700000000002 --arg owner "someone-else" --arg result "$V3/$OTHER/result.json" \
  '{seq:1,since:$since,owner:$owner,resultPath:$result,origin:"launch"}' \
  > "$V3/$OTHER/episodes/1/dispatch.json"
jq -n '{schema_version:1,status:"success",summary:"OTHERWORKERTOKEN",artifacts:[],errors:[],episode:1}' \
  > "$V3/$OTHER/result.json"
OKEY="$(session_key someone-else)"
mkdir -p "$V3/.sessions/$OKEY/act/1"
: > "$V3/.sessions/$OKEY/act/1.beat"

"$COMMANDER" collect codex "$CNAME" >"$WORK/collect.out" 2>"$WORK/collect.err" &
COLLECT_PID=$!

# Submitted, not just pasted: the fake logged the Enter and its composer is empty again.
# A paste still in the composer draws each line with a 4-column prefix (CI read 704, not 700).
have_prompt() {
  grep -q '^ENTER:idle:.*OWNEDOK' "$FAKE_HOST_STATE/log" 2>/dev/null || return 1
  local pane; pane="$(private_tmux capture-pane -p -J -t "$PANE")"
  [[ "$pane" == *OWNEDOK* && "$pane" == *"→ Plan, search, build anything"* ]]
}
poll 75 have_prompt || {
  echo "no paste within 15s" >&2
  echo "--- collect err ---"; cat "$WORK/collect.err" 2>/dev/null || true
  echo "--- pane ---"; private_tmux capture-pane -p -J -t "$PANE" >&2 || true
  exit 1
}
BODY="$(private_tmux capture-pane -p -J -t "$PANE")"
assert "case 2: pasted once on the first tick" "$(print -r -- "$BODY" | grep -c OWNEDOK)" "1"
assert_contains "case 2: paste names the worker" "$BODY" "$OWNED"
assert_contains "case 2: paste names the status" "$BODY" "success"
assert_contains "case 2: paste names the result path" "$BODY" "$V3/$OWNED/result.json"
SUMMARY_LINE="$(print -r -- "$BODY" | awk '/<worker-output/{p=1; next} /<\/worker-output>/{exit} p{print; exit}')"
assert "case 2: summary is the full 700 chars (core fence is 12000)" "${#SUMMARY_LINE}" "700"
assert_contains "case 2: summary keeps its prefix" "$SUMMARY_LINE" "OWNEDOK"
SKEY="$(session_key "$SESSION")"
HB="$V3/.sessions/$SKEY/act/1.beat"
[[ -f "$HB" ]] || { echo "beat missing after first tick" >&2; echo "--- collect err ---"; cat "$WORK/collect.err"; exit 1; }
HB1="$(tr -d '[:space:]' < "$HB")"
assert "case 4: first beat is numeric ms" "$([[ "$HB1" == <-> ]] && echo yes || echo no)" "yes"

hb_changed() { [[ "$(tr -d '[:space:]' < "$HB")" != "$HB1" ]]; }
poll 125 hb_changed || {
  echo "beat did not refresh within 25s" >&2
  echo "--- collect err ---"; cat "$WORK/collect.err" 2>/dev/null || true
  exit 1
}
sleep 1
BODY="$(private_tmux capture-pane -p -J -t "$PANE")"
HB2="$(tr -d '[:space:]' < "$HB")"
assert "case 4: beat refreshed on the next tick" "$([[ "$HB1" != "$HB2" ]] && echo yes || echo no)" "yes"
assert "case 2: second tick pastes nothing" "$(print -r -- "$BODY" | grep -c OWNEDOK)" "1"
assert "case 2: episode closed with acks/done" "$([[ -d "$V3/$OWNED/episodes/1/acks/done" ]] && echo yes || echo no)" "yes"
assert "case 2: descriptor stays in place" "$([[ -f "$V3/$OWNED/episodes/1/dispatch.json" ]] && echo yes || echo no)" "yes"
assert "case 2: descriptor is not renamed aside" "$([[ ! -e "$V3/$OWNED/dispatch.delivered.json" && ! -e "$TMUX_AGENT_DIR/$OWNED/dispatch.delivered.json" ]] && echo yes || echo no)" "yes"
assert "case 3: other owner's descriptor is untouched" "$([[ -f "$V3/$OTHER/episodes/1/dispatch.json" ]] && echo yes || echo no)" "yes"
assert_excludes "case 3: other owner's worker is not in the paste" "$BODY" "$OTHER"
assert_excludes "case 3: other owner's summary is not sent" "$BODY" "OTHERWORKERTOKEN"
assert "case 3: other owner has no done ack" "$([[ -e "$V3/$OTHER/episodes/1/acks/done" ]] && echo yes || echo no)" "no"

echo
echo "case 5: collect exits when the commander session is gone"
private_tmux kill-session -t "$SESSION"
ec=0
(
  sleep 20
  kill "$COLLECT_PID" 2>/dev/null || true
) &
TIMER_PID=$!
wait "$COLLECT_PID" || ec=$?
kill "$TIMER_PID" 2>/dev/null || true
wait "$TIMER_PID" 2>/dev/null || true
COLLECT_PID=""
TIMER_PID=""
assert "case 5: collect exits 0" "$ec" "0"

echo
echo "extra: start --no-attach refuses a live collector; stop clears it"
SNAME="startboss$$"
SSESSION="${PREFIX}-${SNAME}"
"$COMMANDER" start codex "$SNAME" "$WORK" --no-attach >"$WORK/start.out" 2>"$WORK/start.err"
PIDFILE="$TMUX_AGENT_DIR/.commander-${SSESSION}.pid"
assert "start wrote a pid file" "$([[ -f "$PIDFILE" ]] && echo yes || echo no)" "yes"
assert "start marks the host result-path delivered" "$([[ -f "$TMUX_AGENT_DIR/$SNAME/.result-path-injected" ]] && echo yes || echo no)" "yes"
assert "start marks the host scope guard delivered" "$([[ -f "$TMUX_AGENT_DIR/$SNAME/scope-guard-injected" ]] && echo yes || echo no)" "yes"
SPID="$(tr -d '[:space:]' < "$PIDFILE")"
assert "start collector is alive" "$(kill -0 "$SPID" 2>/dev/null && echo yes || echo no)" "yes"
SBEAT="$TMUX_AGENT_DIR/.v3/.sessions/$(session_key "$SSESSION")/act/1.beat"
have_start_hb() { [[ -f "$SBEAT" ]]; }
poll 50 have_start_hb || { echo "start collector wrote no beat" >&2; cat "$WORK/start.err"; echo "--- log ---"; cat "$TMUX_AGENT_DIR/.commander-${SSESSION}.log" 2>/dev/null || true; exit 1; }
assert "start beat is numeric ms" "$([[ "$(tr -d '[:space:]' < "$SBEAT")" == <-> ]] && echo yes || echo no)" "yes"
ST_STATUS="$(private_tmux show-options -t "$SSESSION" -v status)"
assert "start sets per-session status 2" "$ST_STATUS" "2"
ST_INT="$(private_tmux show-options -t "$SSESSION" -v status-interval)"
assert "start sets per-session status-interval 2" "$ST_INT" "2"
ST_FMT="$(private_tmux show-options -t "$SSESSION" -v 'status-format[1]')"
assert_contains "start status line runs panel" "$ST_FMT" " panel "
assert_contains "start status line quotes the session" "$ST_FMT" "'$SSESSION'"
assert_contains "start status line names this script" "$ST_FMT" "tmux-agent-commander"
G_FMT="$(private_tmux show-options -g -v 'status-format[1]' 2>/dev/null || true)"
assert_excludes "panel command is not a global option" "$G_FMT" "tmux-agent-commander"
code=0
"$COMMANDER" start codex "$SNAME" "$WORK" --no-attach >"$WORK/start2.out" 2>"$WORK/start2.err" || code=$?
assert "second start exits 1" "$code" "1"
assert_contains "second start names the live collector" "$(<"$WORK/start2.err")" "already running"
private_tmux kill-session -t "$SSESSION"
start_gone() { ! kill -0 "$SPID" 2>/dev/null; }
poll 50 start_gone || { echo "collector still alive after the session died" >&2; exit 1; }
assert "collector exits when its session is gone" "$(kill -0 "$SPID" 2>/dev/null && echo yes || echo no)" "no"
assert "collector removes its pid file when the session is gone" "$([[ -e "$PIDFILE" ]] && echo yes || echo no)" "no"

echo
echo "case: start --no-panel does not install the status line"
NPNAME="nopanel$$"
NPSESSION="${PREFIX}-${NPNAME}"
np_code=0
"$COMMANDER" start codex "$NPNAME" "$WORK" --no-attach --no-panel >"$WORK/np.out" 2>"$WORK/np.err" || np_code=$?
if (( np_code != 0 )); then
  echo "--- np.err ---" >&2
  cat "$WORK/np.err" >&2 || true
fi
assert "--no-panel start exits 0" "$np_code" "0"
if (( np_code == 0 )); then
  NPOPTS="$(private_tmux show-options -t "$NPSESSION" 2>/dev/null || true)"
  assert_excludes "--no-panel does not set the panel command" "$NPOPTS" "tmux-agent-commander"
  private_tmux kill-session -t "$NPSESSION"
fi

echo
echo "case: panel with no owned workers"
EMPTY_SESSION="panel-empty-$$"
eline="$("$COMMANDER" panel "$EMPTY_SESSION" --width 80)"
assert "panel with no owned workers" "$eline" "tmux-agent: no workers"

echo
echo "case: panel marks running, success, failed, delivered; hides foreign owners"
MSESSION="panel-marks-$$"
NOW_MS="$(perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000')"
s_bad=$(( NOW_MS - (5 * 3600 + 120) * 1000 ))
s_ok=$(( NOW_MS - (3 * 3600 + 120) * 1000 ))
s_run=$(( NOW_MS - (12 * 60 + 30) * 1000 ))
s_sec=$(( NOW_MS - 45000 ))
s_new=$(( NOW_MS - (4 * 3600 + 120) * 1000 ))
s_midb=$(( NOW_MS - (6 * 3600 + 120) * 1000 ))
s_mida=$(( NOW_MS - (8 * 3600 + 120) * 1000 ))
s_old=$(( NOW_MS - (10 * 3600 + 120) * 1000 ))
write_dispatch() {
  # panel() reads the v3 ledger (worker.json + episodes/<n>/dispatch.json).
  # A flat dispatch.json never creates .v3, so the line is "no workers".
  local _dir="$1" kind="$2" profile="$3" name="$4" since="$5" owner="$6"
  local ep="$TMUX_AGENT_DIR/.v3/$name/episodes/1"
  local result="$ep/result.json"
  mkdir -p "$ep/sent"
  jq -n \
    --arg profile "$profile" --arg name "$name" --arg dir "$REPO" \
    --argjson since "$since" --arg owner "$owner" --arg ownerCwd "$WORK" \
    '{profile:$profile,name:$name,dir:$dir,since:$since,owner:$owner,ownerCwd:$ownerCwd,origin:"assign"}' \
    > "$TMUX_AGENT_DIR/.v3/$name/worker.json"
  jq -n \
    --argjson seq 1 --argjson since "$since" --arg owner "$owner" --arg resultPath "$result" \
    '{seq:$seq,since:$since,owner:$owner,resultPath:$resultPath,origin:"launch"}' \
    > "$ep/dispatch.json"
  if [[ "$kind" == "dispatch.delivered.json" ]]; then
    mkdir -p "$ep/acks/done"
  fi
}
write_dispatch p-bad dispatch.json agy bad1 "$s_bad" "$MSESSION"
write_dispatch p-ok dispatch.json codex ok1 "$s_ok" "$MSESSION"
write_dispatch p-run dispatch.json codex run1 "$s_run" "$MSESSION"
write_dispatch p-sec dispatch.json codex secw "$s_sec" "$MSESSION"
write_dispatch p-new dispatch.delivered.json codex newD "$s_new" "$MSESSION"
write_dispatch p-midb dispatch.delivered.json codex midB "$s_midb" "$MSESSION"
write_dispatch p-mida dispatch.delivered.json codex midA "$s_mida" "$MSESSION"
write_dispatch p-old dispatch.delivered.json codex oldD "$s_old" "$MSESSION"
write_dispatch p-foreign dispatch.json agy FOREIGNTOKEN 1700000000000 someone-else
write_dispatch p-fordel dispatch.delivered.json agy FOREIGNDELIV 1700000000003 someone-else
jq -n '{schema_version:1,status:"failed",summary:"nope",artifacts:[],errors:[],episode:1}' \
  > "$TMUX_AGENT_DIR/.v3/bad1/episodes/1/result.json"
jq -n '{schema_version:1,status:"success",summary:"ok",artifacts:[],errors:[],episode:1}' \
  > "$TMUX_AGENT_DIR/.v3/ok1/episodes/1/result.json"
jq -n '{schema_version:1,status:"success",summary:"delivered anyway",artifacts:[],errors:[],episode:1}' \
  > "$TMUX_AGENT_DIR/.v3/newD/episodes/1/result.json"
jq -n '{schema_version:1,status:"success",summary:"FOREIGNWORKERTOKEN",artifacts:[],errors:[],episode:1}' \
  > "$TMUX_AGENT_DIR/.v3/FOREIGNTOKEN/episodes/1/result.json"
mline="$("$COMMANDER" panel "$MSESSION" --width 400)"
assert_contains "running mark" "$mline" "run1 codex 12m ▶"
assert_contains "success mark" "$mline" "ok1 codex 3h ✓ success"
assert_contains "failed mark" "$mline" "bad1 agy 5h ✗ failed"
assert_contains "newest delivered" "$mline" "newD codex 4h ✓ delivered"
assert_contains "middle delivered" "$mline" "midB codex 6h ✓ delivered"
assert_contains "older delivered kept" "$mline" "midA codex 8h ✓ delivered"
assert_excludes "fourth delivered is not shown" "$mline" "oldD"
assert_excludes "foreign owner is not shown" "$mline" "FOREIGNTOKEN"
assert_excludes "foreign delivered is not shown" "$mline" "FOREIGNDELIV"
assert_excludes "wide panel does not truncate" "$mline" "more"
sec_tok="${mline#*secw codex }"
sec_tok="${sec_tok%% ▶*}"
case "$sec_tok" in
  45s|46s|47s|48s|49s) sec_ok=yes ;;
  *) sec_ok="no:$sec_tok" ;;
esac
assert "running seconds mark" "$sec_ok" "yes"
prev=""
order_ok=yes
for token in "secw " "run1 " "ok1 " "bad1 " "newD " "midB " "midA "; do
  here="$(index_of "$token" "$mline")"
  if [[ "$here" == -1 ]]; then
    order_ok="missing:$token"
    break
  fi
  if [[ -n "$prev" && "$here" -le "$prev" ]]; then
    order_ok="out-of-order:$token"
    break
  fi
  prev="$here"
done
assert "active newest-first, then newest delivered" "$order_ok" "yes"
delivered_n=0
rest="$mline"
while [[ "$rest" == *'✓ delivered'* ]]; do
  delivered_n=$(( delivered_n + 1 ))
  rest="${rest#*✓ delivered}"
done
assert "exactly three delivered records" "$delivered_n" "3"

echo
echo "case: panel --width drops whole entries and prints +N more"
WSESSION="panel-width-$$"
NOW_MS="$(perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000')"
s_w=$(( NOW_MS - (9 * 3600 + 1800) * 1000 ))
# aaaa is newest, so it survives truncation (newest-first).
w_age=0
for wname in aaaa bbbb cccc dddd; do
  write_dispatch "w-$wname" dispatch.json zz "$wname" "$(( s_w - w_age ))" "$WSESSION"
  w_age=$(( w_age + 60000 ))
done
e1="aaaa zz 9h ▶"
e2="bbbb zz 9h ▶"
e3="cccc zz 9h ▶"
e4="dddd zz 9h ▶"
two="$e1 $e2"
two_more="$two +2 more"
one_more="$e1 +3 more"
wline="$("$COMMANDER" panel "$WSESSION" --width "${#two_more}")"
assert "width fits two entries plus +2 more" "$wline" "$two_more"
assert_excludes "third entry was dropped whole" "$wline" "cccc"
assert_excludes "fourth entry was dropped whole" "$wline" "dddd"
wline="$("$COMMANDER" panel "$WSESSION" --width "${#two}")"
assert "no room for the suffix drops another whole entry" "$wline" "$one_more"
assert_excludes "dropped entry is not cut mid-word" "$wline" "bbbb"
wline="$("$COMMANDER" panel "$WSESSION" --width 1)"
assert "narrower than one entry prints +N more" "$wline" "+4 more"
assert_excludes "narrow line does not contain an entry" "$wline" "aaaa"

echo
echo "case: commander session name matches real agent-tmux (tenant too)"
# The fake above names sessions the way session_name does; pin that to the
# real wrapper so a prefix change in agent-tmux fails here, not in a live pane.
REAL_AT="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
real_session() {
  "$REAL_AT" codex start --dry-run --exact "$1" "$WORK" 2>/dev/null \
    | jq -r '.invocation.session // empty' 2>/dev/null || true
}
assert "real agent-tmux session name" "$(real_session pin$$)" "${PREFIX}-pin$$"
assert "real agent-tmux session name with tenant" \
  "$(TMUX_AGENT_TOOLS_TENANT=t1 real_session pin$$)" "${PREFIX}-t1-pin$$"

count_matching() {
  local pat="$1" n=0 line
  local -a ps_lines
  ps_lines=("${(@f)$(ps -ax -o command=)}")
  for line in "${ps_lines[@]}"; do
    [[ "$line" == *"$pat"* ]] && n=$((n + 1))
  done
  print -r -- "$n"
}

proc_gone() {
  [[ "$(count_matching "$1")" == 0 ]]
}

has_tmux_ancestor() {
  local pid="$1" i ppid comm
  for (( i = 0; i < 6; i++ )); do
    ppid="$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d '[:space:]' || true)"
    [[ "$ppid" == <-> && "$ppid" -gt 1 ]] || return 1
    comm="$(ps -p "$ppid" -o comm= 2>/dev/null | tr -d '[:space:]' || true)"
    args="$(ps -p "$ppid" -o args= 2>/dev/null || true)"
    # comm is the exec path, cut to 16 bytes, so an absolute tmux is not the word tmux.
    [[ "$comm" == tmux || "$args" == tmux || "$args" == tmux\ * || "$args" == */tmux || "$args" == */tmux\ * ]] && return 0
    pid="$ppid"
  done
  return 1
}

dump_ancestors() {
  local pid="$1" i ppid
  for (( i = 0; i < 6; i++ )); do
    ps -p "$pid" -o pid=,comm=,args= 2>/dev/null || true
    ppid="$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d '[:space:]' || true)"
    [[ "$ppid" == <-> && "$ppid" -gt 1 ]] || break
    pid="$ppid"
  done
}

run_assign_in() {
  local session="$1" out="$2" err="$3" code="$4" script="$5"
  rm -f "$code"
  cat > "$script" <<EOF
#!/usr/bin/env zsh
set -euo pipefail
export PATH=${(q)WORK}/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
export TMUX_AGENT_DIR=${(q)TMUX_AGENT_DIR}
export XDG_CONFIG_HOME=${(q)XDG_CONFIG_HOME}
export AGENT_TMUX_PROFILE_DIR=${(q)AGENT_TMUX_PROFILE_DIR}
export FAKE_LOG=${(q)FAKE_LOG}
export FAKE_SNAP=${(q)FAKE_SNAP}
export FAKE_PROMPTS=${(q)FAKE_PROMPTS}
export COMMANDER_PREFIX=${(q)COMMANDER_PREFIX}
export TMUX_AGENT_TMUX_SOCKET=${(q)TMUX_AGENT_TMUX_SOCKET}
export ZDOTDIR=${(q)WORK}/zdot
unset AGENT_TMUX_PREFIX CODEX_TMUX_PREFIX TMUX_AGENT_TOOLS_TENANT
cd ${(q)ASSIGN_CWD}
${(q)COMMANDER} assign codex ${(q)WORKER} ${(q)REPO} ${(q)BRIEF} >${(q)out} 2>${(q)err}
print -r -- \$? > ${(q)code}
EOF
  chmod +x "$script"
  private_tmux split-window -d -t "$session" "$script"
}

echo
echo "case: assign starts one collector from the tmux server"
ANAME="autocol$$"
ASESSION="${PREFIX}-${ANAME}"
AC_OUT="$WORK/ac.out"
AC_ERR="$WORK/ac.err"
AC_CODE="$WORK/ac.code"
AC_SCRIPT="$WORK/run-ac.zsh"
private_tmux new-session -d -s "$ASESSION" "sleep 180"
run_assign_in "$ASESSION" "$AC_OUT" "$AC_ERR" "$AC_CODE" "$AC_SCRIPT"
ac_done() { [[ -f "$AC_CODE" ]]; }
poll 50 ac_done || {
  echo "assign in prefixed session did not finish" >&2
  echo "--- err ---"; cat "$AC_ERR" 2>/dev/null || true
  exit 1
}
assert "prefixed assign exits 0" "$(<"$AC_CODE")" "0"
assert_contains "prefixed assign says collector started" "$(<"$AC_OUT")" "collector started for ${ASESSION}"
assert_contains "prefixed assign tells the commander to end the turn" "$(<"$AC_OUT")" "end the turn"
AC_PIDFILE="$TMUX_AGENT_DIR/.commander-${ASESSION}.pid"
have_ac_pid() {
  [[ -f "$AC_PIDFILE" ]] || return 1
  local p
  p="$(tr -d '[:space:]' < "$AC_PIDFILE")"
  [[ "$p" == <-> ]] && kill -0 "$p" 2>/dev/null
}
poll 50 have_ac_pid || {
  echo "assign did not leave a live collector pid" >&2
  echo "--- err ---"; cat "$AC_ERR" 2>/dev/null || true
  echo "--- log ---"; cat "$TMUX_AGENT_DIR/.commander-${ASESSION}.log" 2>/dev/null || true
  exit 1
}
poll 25 proc_gone "$AC_SCRIPT" || { echo "assign pane script still running" >&2; exit 1; }
ACPID="$(tr -d '[:space:]' < "$AC_PIDFILE")"
assert "collector still alive after the assign pane exits" "$(kill -0 "$ACPID" 2>/dev/null && echo yes || echo no)" "yes"
AC_ARGS="$(ps -p "$ACPID" -o args= 2>/dev/null || true)"
assert_contains "pid file is a collect process" "$AC_ARGS" " collect "
assert_contains "collect process names the worker" "$AC_ARGS" "$ANAME"
if has_tmux_ancestor "$ACPID"; then
  anc=yes
else
  anc=no
  echo "--- ancestor chain ---" >&2
  dump_ancestors "$ACPID" >&2
fi
assert "collector is owned by the tmux server" "$anc" "yes"
ACBEAT="$TMUX_AGENT_DIR/.v3/.sessions/$(session_key "$ASESSION")/act/1.beat"
have_ac_hb() { [[ -f "$ACBEAT" ]]; }
poll 50 have_ac_hb || {
  echo "assign collector wrote no beat" >&2
  echo "--- log ---"; cat "$TMUX_AGENT_DIR/.commander-${ASESSION}.log" 2>/dev/null || true
  exit 1
}
assert "assign beat is numeric ms" "$([[ "$(tr -d '[:space:]' < "$ACBEAT")" == <-> ]] && echo yes || echo no)" "yes"

echo
echo "case: a second assign does not start a second collector"
AC_OUT2="$WORK/ac2.out"
AC_ERR2="$WORK/ac2.err"
AC_CODE2="$WORK/ac2.code"
AC_SCRIPT2="$WORK/run-ac2.zsh"
run_assign_in "$ASESSION" "$AC_OUT2" "$AC_ERR2" "$AC_CODE2" "$AC_SCRIPT2"
ac2_done() { [[ -f "$AC_CODE2" ]]; }
poll 50 ac2_done || {
  echo "second prefixed assign did not finish" >&2
  echo "--- err ---"; cat "$AC_ERR2" 2>/dev/null || true
  exit 1
}
assert "second prefixed assign exits 0" "$(<"$AC_CODE2")" "0"
assert_excludes "second assign does not say collector started" "$(<"$AC_OUT2")" "collector started"
assert "second assign keeps the same pid" "$(tr -d '[:space:]' < "$AC_PIDFILE")" "$ACPID"
assert "first collector still alive" "$(kill -0 "$ACPID" 2>/dev/null && echo yes || echo no)" "yes"
# The collector's argv is "<script> collect codex <name>". run-shell's sh -c quotes those words.
assert "only one collect process" "$(count_matching " collect codex ${ANAME}")" "1"

echo
echo "case: collect exits 0 without writing when a live collector owns the pid"
DNAME="ownedcol$$"
DSESSION="${PREFIX}-${DNAME}"
private_tmux new-session -d -s "$DSESSION" "sleep 180"
"$COMMANDER" collect codex "$DNAME" >"$WORK/down.out" 2>"$WORK/derr.err" &
DCOLLECT_PID=$!
DPIDFILE="$TMUX_AGENT_DIR/.commander-${DSESSION}.pid"
have_dp() { [[ -f "$DPIDFILE" ]]; }
poll 25 have_dp || {
  echo "owner collect wrote no pid" >&2
  echo "--- err ---"; cat "$WORK/derr.err" 2>/dev/null || true
  exit 1
}
assert "owner collect recorded its own pid" "$(tr -d '[:space:]' < "$DPIDFILE")" "$DCOLLECT_PID"
dcode=0
"$COMMANDER" collect codex "$DNAME" >"$WORK/d2.out" 2>"$WORK/d2.err" || dcode=$?
assert "second collect exits 0" "$dcode" "0"
assert "second collect writes nothing to stdout" "$(<"$WORK/d2.out")" ""
assert "second collect writes nothing to stderr" "$(<"$WORK/d2.err")" ""
assert "second collect leaves the owner's pid" "$(tr -d '[:space:]' < "$DPIDFILE")" "$DCOLLECT_PID"
assert "owner collect still alive" "$(kill -0 "$DCOLLECT_PID" 2>/dev/null && echo yes || echo no)" "yes"
private_tmux kill-session -t "$DSESSION"
dec=0
wait "$DCOLLECT_PID" || dec=$?
DCOLLECT_PID=""
assert "owner collect exits 0 when its session is gone" "$dec" "0"
assert "owner collect removes its pid file" "$([[ -e "$DPIDFILE" ]] && echo yes || echo no)" "no"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ "$FAIL" -eq 0 ]]
