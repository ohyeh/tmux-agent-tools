# One engine process classifies every fixture the way status_session does
# (prompt-area dialogs first, then runtime blockers on the whole screen), and
# runs the pure liveness/probe helpers. No errexit: the engine's helpers
# return non-zero on "no match".
cat > "$WORK/classify.zsh" <<'EOF'
set -- codex
source "$ENGINE"
for f in "$FX"/*; do
  text="$(<"$f")"
  area="$(current_prompt_area_for_text "$text")"
  reason="$(blocked_reason_for_text "${area:l}")"
  evidence=""
  if [[ -z "$reason" ]]; then
    rb="$(runtime_blocker_for_text "$text")"
    if [[ -n "$rb" ]]; then reason="${rb%%$'\t'*}"; evidence="${${rb#*$'\t'}[1,300]}"; fi
  fi
  print -r -- "${f:t}"$'\t'"${reason:-null}"$'\t'"${evidence:-null}"
done
# idle_seconds ignores what a CLI redraws below its composer (issue #98 follow-up).
same() { [[ "$(pane_activity_text "$1")" == "$(pane_activity_text "$2")" ]] && print same || print differs; }
print -r -- "act:footer"$'\t'"$(same $'answer: done\n→ Add a follow-up\nUsage 9% (1)' $'answer: done\n→ Add a follow-up\nUsage 9% (2)')"
print -r -- "act:output"$'\t'"$(same $'working 1\n→ Add a follow-up\nUsage 9%' $'working 2\n→ Add a follow-up\nUsage 9%')"
q1="> quoted"; q2="> quoted"
for i in {1..13}; do q1+=$'\n'"line $i 1"; q2+=$'\n'"line $i 2"; done
print -r -- "act:quote"$'\t'"$(same "$q1" "$q2")"
# codex/generic probe parse (issue #203).
ptext=$'Codex progress 42%\nrunning shell command\napproval pending: allow command?'
for metric in progress tool_active approval_pending; do
  value=null; probe_generic_metric_parse "$metric" "$ptext"
  print -r -- "probe:$metric"$'\t'"$value"
done
# #144: a pane-hash that cannot be written degrades to the stored stamp.
d="$(ensure_agent_dir deg)"
print -r -- "oldhash 2001-01-01T00:00:00Z" > "$d/pane-hash"
chmod 444 "$d/pane-hash"; chmod 555 "$d"
out="$(update_pane_hash deg "changed pane")"; rc=$?
print -r -- "degrade"$'\t'"$rc:$out"
EOF
typeset -A got got_evidence
while IFS=$'\t' read -r key a b; do got[$key]="$a"; got_evidence[$key]="$b"; done < <(
  TMUX_AGENT_TOOLS_SOURCE_ONLY=1 ENGINE="$AGENT_TMUX" FX="$FX" zsh "$WORK/classify.zsh"
)

echo "case: classification fixtures (${#want_reason} screens)"
for name in ${(ko)want_reason}; do
  assert "$name blocked_reason" "${got[$name]}" "${want_reason[$name]}"
  if (( ${+want_evidence[$name]} )); then
    assert "$name blocked_evidence" "${got_evidence[$name]}" "${want_evidence[$name]}"
  fi
done
echo "case: activity, probe parse and degrade helpers"
assert "a footer-only redraw is not activity" "${got[act:footer]}" "same"
assert "a change above the composer is activity" "${got[act:output]}" "differs"
assert "a quote high in the output is not a composer" "${got[act:quote]}" "differs"
assert "codex progress parsed" "${got[probe:progress]}" "42"
assert "codex tool_active parsed" "${got[probe:tool_active]}" "true"
assert "codex approval_pending parsed" "${got[probe:approval_pending]}" "true"
assert "unwritable pane-hash keeps the stored stamp" "${got[degrade]}" "0:2001-01-01T00:00:00Z"

# --- No session: null liveness, ping dead, probe refuses ---------------------
echo "case: missing session"
st="$("$CODEX_TMUX" status --json "missing-$$")"
assert "missing liveness fields" "$(jq -c '[.exists,.started_at,.last_change_at,.bytes_in_pane,.idle_seconds,(.marker_seen|length)]' <<< "$st")" '[false,null,null,null,null,0]'
code=0; st="$("$CODEX_TMUX" ping --json --timeout 1 "missing-$$")" || code=$?
assert "missing ping dead exit=2" "$code:$(jq -r '"\(.schema_version):\(.result)"' <<< "$st")" "2:1:dead"
code=0; "$CODEX_TMUX" probe --json --metric progress "missing-$$" >/dev/null 2>&1 || code=$?
assert "missing probe exit=1" "$code" "1"

# --- Real panes --------------------------------------------------------------
wait
wait_pane() {  # <launcher> <name> <text>
  local i
  for i in {1..40}; do
    "$1" capture --strip-ansi --tail 60 "$2" 2>/dev/null | grep -qF -- "$3" && return 0
    sleep 0.05
  done
  echo "  FAIL $2 never showed: $3"; FAIL=$((FAIL + 1)); return 1
}

echo "case: quiet claude pane — runtime blocker through status, probe, ping timeout"
wait_pane "$CLAUDE_TMUX" quiet "Credit balance"
st="$("$CLAUDE_TMUX" status --json quiet)"
assert "blocked_reason quota_exhausted" "$(jq -r .blocked_reason <<< "$st")" "quota_exhausted"
assert "evidence is claude's line" "$(jq -r .blocked_evidence <<< "$st")" "  ⎿  Credit balance is too low"
assert "not a confirmation dialog" "$(jq -r .confirmation_detected <<< "$st")" "false"
assert "diagnostic names the limit" "$(jq -r '.diagnostic // ""' <<< "$st" | grep -c 'usage/quota limit')" "1"
st="$("$CLAUDE_TMUX" probe --json --metric context_percent quiet)"
assert "claude context probe" "$(jq -r '"\(.schema_version) \(.value) \(.confidence)"' <<< "$st")" "1 73 high"
assert "claude goal_active probe" "$("$CLAUDE_TMUX" probe --json --metric goal_active quiet | jq -r .value)" "true"
code=0; "$CLAUDE_TMUX" probe --metric nope quiet >/dev/null 2>&1 || code=$?
assert "unknown metric exit=2" "$code" "2"
code=0; st="$("$CLAUDE_TMUX" ping --json --timeout 1 quiet)" || code=$?
assert "silent pane ping timeout exit=1" "$code:$(jq -r .result <<< "$st")" "1:timeout"
assert "ping waited its 1 s" "$(jq -r '.rtt_ms >= 1000' <<< "$st")" "true"

echo "case: permission pane — every send path refuses, then clears"
wait_pane "$CODEX_TMUX" perm "trust the contents"
st="$("$CODEX_TMUX" status --json perm)"
assert "permission_prompt confirmation" "$(jq -r '"\(.blocked_reason) \(.confirmation_detected) \(.diagnostic|type)"' <<< "$st")" "permission_prompt true string"
for spec in "send|m-plain" "send-wait|m-wait|1" "send-wait-literal|m-literal|never-seen|1"; do
  args=("${(@s:|:)spec}")
  code=0; out="$("$CODEX_TMUX" "${args[1]}" perm "${(@)args[2,-1]}" 2>&1)" || code=$?
  assert "${args[1]} refused" "$code:$(jq -r '"\(.blocked) \(.submitted) \(.blocked_reason) \(.diagnostic|type)"' <<< "${out##*$'\n'}")" "1:true false permission_prompt string"
  assert "${args[1]} pasted nothing" "$("$CODEX_TMUX" capture --strip-ansi --tail 60 perm | grep -cF -- "${args[2]}" || true)" "0"
done
"$CODEX_TMUX" send --raw --enter-count 1 perm y >/dev/null
wait_pane "$CODEX_TMUX" perm "Write a prompt"
st="$("$CODEX_TMUX" status --json perm)"
assert "cleared prompt not blocked" "$(jq -r '.blocked_reason // "null"' <<< "$st")" "null"
assert "schema_version=1" "$(jq -r .schema_version <<< "$st")" "1"
assert "started_at ISO-8601 UTC" "$([[ "$(jq -r .started_at <<< "$st")" =~ $ISO_RE ]] && echo yes)" "yes"
assert "last_change_at ISO-8601 UTC" "$([[ "$(jq -r .last_change_at <<< "$st")" =~ $ISO_RE ]] && echo yes)" "yes"
assert "bytes_in_pane non-zero" "$(jq -r '.bytes_in_pane > 0' <<< "$st")" "true"
assert "marker_seen empty at start" "$(jq -r '.marker_seen | length' <<< "$st")" "0"
# An unchanged pane keeps its last_change_at: age the stored stamp, no sleep.
hash_file="$TMUX_AGENT_DIR/perm/pane-hash"
read -r h _ < "$hash_file"; print -r -- "$h 2000-01-01T00:00:00Z" > "$hash_file"
st="$("$CODEX_TMUX" status --json perm)"
assert "unchanged pane keeps last_change_at" "$(jq -r .last_change_at <<< "$st")" "2000-01-01T00:00:00Z"
assert "idle_seconds grows" "$(jq -r '.idle_seconds > 1000' <<< "$st")" "true"
markers() { "$CODEX_TMUX" status --json perm | jq -c .marker_seen; }
"$CODEX_TMUX" wait-literal perm "Write a prompt" 2 >/dev/null
assert "wait-literal records its marker" "$(markers)" '["Write a prompt"]'
"$CODEX_TMUX" wait-literal perm "Write a prompt" 2 >/dev/null
"$CODEX_TMUX" wait-text --regex perm 'Write a pro.*' 2 >/dev/null
assert "repeat deduped, wait-text adds nothing" "$(markers)" '["Write a prompt"]'
seq 1 101 | awk '{printf "m-%d\n", $1}' > "$TMUX_AGENT_DIR/perm/marker_seen"
"$CODEX_TMUX" wait-literal perm "trusted:y" 2 >/dev/null
assert "marker_seen FIFO-capped at 100" "$(markers | jq -r '"\(length) \(.[0])"')" "100 m-3"
"$CODEX_TMUX" send perm after-clear-marker >/dev/null
wait_pane "$CODEX_TMUX" perm "got:after-clear-marker" && { echo "  ok   send works after the prompt cleared"; PASS=$((PASS + 1)); }
code=0; st="$("$CODEX_TMUX" ping --json --timeout 5 perm)" || code=$?
assert "live pane ping ok exit=0" "$code:$(jq -r '"\(.schema_version) \(.result) \(.rtt_ms >= 0)"' <<< "$st")" "0:1 ok true"
assert "human ping output" "$("$CODEX_TMUX" ping --timeout 5 perm | cut -d' ' -f1-3)" "ping ok: perm"

"$CODEX_TMUX" stop perm >/dev/null 2>&1 || true
"$CLAUDE_TMUX" stop quiet >/dev/null 2>&1 || true
echo "runtime-blocker-status smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
