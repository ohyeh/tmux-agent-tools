#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke test: what `status --json` reads off a worker's screen.
#   - Classification is a no-wait fixture table run through the engine's own
#     functions (sourced): runtime blockers (blocked_reason quota_exhausted /
#     login_required / model_error with blocked_evidence) and dialog prompts
#     (hook_trust / permission / approval / login), plus the prose, tool-output,
#     scrollback and idle-chrome screens that must NOT read as either.
#   - Liveness/activity/probe parse helpers as fixtures too.
#   - Two real panes for the CLI entries: a permission pane that refuses send,
#     send-wait and send-wait-literal, then clears and takes a send (liveness
#     fields, marker_seen, ping ok on the same pane); a quiet claude pane for
#     the runtime blocker wired through status, probe and the ping timeout.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
CODEX_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" codex)"
CLAUDE_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" claude)"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/tmux-agent-runtime-blocker.XXXXXX")"
export TMUX_AGENT_DIR="$WORK/state"
trap 'chmod -R u+w "$WORK" 2>/dev/null; rm -rf "$WORK"' EXIT
FX="$WORK/fx"
mkdir -p "$FX"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then echo "  ok   $label"; PASS=$((PASS + 1))
  else echo "  FAIL $label"; echo "    expected: $expected"; echo "    got:      $actual"; FAIL=$((FAIL + 1)); fi
}
ISO_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'

# --- Real panes: start first so they draw while the fixtures run ------------
cat > "$WORK/fake-permission.sh" <<'EOF'
#!/bin/sh
echo "Do you trust the contents of this directory?"
if IFS= read -r answer; then
  echo "trusted:$answer"
fi
echo "› Write a prompt"
while IFS= read -r line; do echo "got:$line"; done
EOF
cat > "$WORK/fake-claude.sh" <<'EOF'
#!/bin/sh
echo "Claude footer: Context 73%"
echo "Goal active: rotate session"
echo "⠋ Thinking"
echo "  ⎿  Credit balance is too low"
exec sleep 600
EOF
chmod +x "$WORK/fake-permission.sh" "$WORK/fake-claude.sh"
CODEX="$WORK/fake-permission.sh" "$CODEX_TMUX" start --exact perm "$WORK" >/dev/null &
CLAUDE="$WORK/fake-claude.sh" "$CLAUDE_TMUX" start --exact quiet "$WORK" >/dev/null &

# --- Classification fixture table --------------------------------------------
# fx <name> <blocked_reason|null> [blocked_evidence] <<'EOF' <screen> EOF
typeset -A want_reason want_evidence
fx() {
  want_reason[$1]="$2"
  if (( $# > 2 )); then want_evidence[$1]="$3"
  elif [[ "$2" == null ]]; then want_evidence[$1]=null; fi
  cat > "$FX/$1"
}

