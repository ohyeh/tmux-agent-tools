#!/usr/bin/env zsh
set -u

script_dir="${0:A:h}"
repo_root="${script_dir:h}"
node "$script_dir/check-tmux-socket-isolation" || exit 1
lint_out="$(zsh "$script_dir/lint-no-path-tied-locals" 2>&1)" || { print -r -- "$lint_out" >&2; exit 1; }

unset TMUX TMUX_PANE
export TMUX_TMPDIR="$(mktemp -d /tmp/tas-main.XXXXXX)"
scratch_dir="$(mktemp -d /tmp/tas-scratch.XXXXXX)"
typeset -a pids=() job_dirs=()
runner_tmux="$(command -v tmux)"
kill_job_sockets() {
  local dir="$1" s
  [[ -d "$dir" ]] || return 0
  while IFS= read -r s; do
    env -u TMUX -u TMUX_PANE "$runner_tmux" -S "$s" kill-server 2>/dev/null || true
  done < <(find "$dir" -type s)
}
runner_cleanup() {
  local p dir
  for p in "${pids[@]}"; do
    pkill -TERM -P "$p" 2>/dev/null || true
    kill -TERM "$p" 2>/dev/null || true
    wait "$p" 2>/dev/null || true
  done
  for dir in "${job_dirs[@]}" "$TMUX_TMPDIR"; do
    kill_job_sockets "$dir"
    rm -rf "$dir"
  done
  rm -rf "$scratch_dir"
}
trap runner_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

timeout_seconds=240
kill_after_seconds=15

if command -v timeout >/dev/null 2>&1; then
  timeout_bin="$(command -v timeout)"
elif command -v gtimeout >/dev/null 2>&1; then
  timeout_bin="$(command -v gtimeout)"
else
  echo "run-all-smokes: timeout or gtimeout is required" >&2
  exit 127
fi

typeset -a test_files
if (( $# > 0 )); then
  for arg in "$@"; do
    if [[ "$arg" == /* ]]; then
      candidate_file="$arg"
    elif [[ "$arg" == */* ]]; then
      candidate_file="$repo_root/$arg"
    else
      candidate_file="$script_dir/$arg"
    fi
    if [[ ! -f "$candidate_file" ]]; then
      echo "run-all-smokes: missing test: $arg" >&2
      exit 2
    fi
    test_files+=("${candidate_file:A}")
  done
else
  # Longest first, so the slow ones do not land in the tail of the pool.
  typeset -a slow=("$script_dir"/{test-core-contract-smoke,test-tui-e2e-smoke,test-mcp-bundle-smoke,test-dispatch-delivery-smoke,test-audit-smoke})
  typeset -a rest=("$script_dir"/test-*-smoke(N))
  test_files=($slow ${rest:|slow})
  # A fresh clone has no adapter deps: mcp-bundle, mod-permissions and version-sync would fail
  # three ways for one missing step (remote-44 B10, 2026-10-15).
  if [[ ! -d "$repo_root/mcp-adapter/node_modules" ]]; then
    echo "run-all-smokes: mcp-adapter/node_modules missing; run: npm --prefix mcp-adapter ci" >&2
    exit 2
  fi
fi
# Load-sensitive: FAIL under PARALLEL_JOBS=4 on remote-44 and PASS alone (B10). They run one at a
# time after the pool, so the default job count needs no manual serial rerun.
typeset -a serial_names=(test-dispatch-delivery-smoke test-assign-dialog-smoke test-session-meta-smoke)

if (( ${#test_files[@]} == 0 )); then
  echo "run-all-smokes: no smoke tests found" >&2
  exit 2
fi

is_timeout_code() {
  local exit_code="$1"
  [[ "$exit_code" == "124" || "$exit_code" == "137" ]]
}

PARALLEL_JOBS="${PARALLEL_JOBS:-4}"
if (( PARALLEL_JOBS < 1 )); then
  PARALLEL_JOBS=1
fi

cd "$repo_root" || exit 1

run_job() {
  local test_file="$1"
  local test_name="${test_file:t}"
  local out_file="$2"
  local meta_file="$3"
  local job_dir="$4"

  local started_at ended_at duration code label
  started_at="$(date +%s)"

  (
    unset TMUX TMUX_PANE
    export TMUX_TMPDIR="$job_dir"
    export TAS_JOB_DIR="$job_dir"
    # Smokes that never source lib/smoke-tmux.sh still put their temp files in the job tree.
    export TMPDIR="$job_dir/tmp"
    mkdir -p -m 0700 "$TMPDIR"
    # Each job gets its own HOME (lib/smoke-home-guard.sh refuses the real one): a hook, a shim or a
    # mutation can then only touch this directory. XDG and ZDOTDIR would point back at the real home.
    export HOME="$job_dir/home"
    mkdir -p -m 0700 "$HOME"
    unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_DATA_HOME XDG_CACHE_HOME ZDOTDIR
    local socket="$job_dir/tmux-$(id -u)/default"
    mkdir -p -m 0700 "${socket:h}"
    trap 'kill_job_sockets "$job_dir"; rm -rf "$job_dir"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    "$timeout_bin" --kill-after="${kill_after_seconds}s" "${timeout_seconds}s" "$test_file" < /dev/null
  ) > "$out_file" 2>&1
  code=$?
  ended_at="$(date +%s)"
  duration=$(( ended_at - started_at ))

  if (( code == 0 )); then
    label="PASS"
  elif is_timeout_code "$code"; then
    label="TIMEOUT"
  else
    label="FAIL"
  fi

  printf '%s\t%s\t%d\t%d\t1\n' "$test_name" "$label" "$code" "$duration" > "$meta_file"
}

typeset -i active_jobs=0
suite_started_at="$(date +%s)"

wait_for_slot() {
  while (( active_jobs >= PARALLEL_JOBS )); do
    for p in "${pids[@]}"; do
      if ! kill -0 "$p" 2>/dev/null; then
        wait "$p" 2>/dev/null || true
        pids=(${pids:#$p})
        active_jobs=$(( active_jobs - 1 ))
        return 0
      fi
    done
    sleep 0.05
  done
}

start_job() {
  local test_file="$1" test_name="${1:t}" job_dir
  job_dir="$(mktemp -d /tmp/tas-job.XXXXXX)"
  job_dirs+=("$job_dir")
  run_job "$test_file" "$scratch_dir/${test_name}.out" "$scratch_dir/${test_name}.meta" "$job_dir" &
  pids+=($!)
  active_jobs=$(( active_jobs + 1 ))
}
wait_all() {
  for p in "${pids[@]}"; do
    wait "$p" 2>/dev/null || true
  done
  pids=()
  active_jobs=0
}

typeset -a serial_files=()
for test_file in "${test_files[@]}"; do
  if (( ${serial_names[(Ie)${test_file:t}]} )); then
    serial_files+=("$test_file")
    continue
  fi
  wait_for_slot
  start_job "$test_file"
done
wait_all
for test_file in "${serial_files[@]}"; do
  start_job "$test_file"
  wait_all
done

typeset -a result_names=() result_labels=() result_codes=() result_durations=() result_attempts=()
typeset -i overall_failed=0

for test_file in "${test_files[@]}"; do
  test_name="${test_file:t}"
  meta_file="$scratch_dir/${test_name}.meta"
  out_file="$scratch_dir/${test_name}.out"

  if [[ -f "$meta_file" ]]; then
    IFS=$'\t' read -r m_name m_label m_code m_duration m_attempts < "$meta_file"
  else
    m_name="$test_name"
    m_label="FAIL"
    m_code=1
    m_duration=0
    m_attempts=1
  fi

  echo
  echo "==> $test_name (attempt 1)"
  if [[ -f "$out_file" ]]; then
    cat "$out_file"
  fi

  result_names+=("$m_name")
  result_labels+=("$m_label")
  result_codes+=("$m_code")
  result_durations+=("$m_duration")
  result_attempts+=("$m_attempts")

  if (( m_code != 0 )); then
    overall_failed=1
    # Kept after the scratch dir is gone: a caller that truncates stdout still has the assertion (W43-23).
    [[ -n "${kept_dir:-}" ]] || kept_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agent-tools/smoke-failures/$(date +%Y%m%dT%H%M%S)"
    [[ ! -f "$out_file" ]] || { mkdir -p "$kept_dir" && cp "$out_file" "$kept_dir/"; } \
      || echo "run-all-smokes: could not keep failing output in $kept_dir" >&2
  fi
done

echo
printf '%-42s %-11s %8s %8s %8s\n' "TEST" "RESULT" "ATTEMPTS" "EXIT" "SECONDS"
printf '%-42s %-11s %8s %8s %8s\n' "----" "------" "--------" "----" "-------"
for idx in {1..${#result_names[@]}}; do
  printf '%-42s %-11s %8s %8s %8s\n' \
    "${result_names[$idx]}" \
    "${result_labels[$idx]}" \
    "${result_attempts[$idx]}" \
    "${result_codes[$idx]}" \
    "${result_durations[$idx]}"
done

echo "suite wall: $(( $(date +%s) - suite_started_at ))s (${#result_names[@]} tests, PARALLEL_JOBS=$PARALLEL_JOBS)"
[[ -z "${kept_dir:-}" ]] || echo "failing output kept: $kept_dir"
exit "$overall_failed"
