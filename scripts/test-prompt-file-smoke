#!/usr/bin/env zsh
# Smoke test for issue #289: --from-file / --prompt-file / stdin (-) support
# across start, send, send-wait, send-wait-literal.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CODEX_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"
CLAUDE_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/claude-tmux"

WORK="$(mktemp -d -t tmux-agent-prompt-file-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT

# Minimal fake CLI that exits 0 immediately.
cat > "$WORK/fake.sh" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod +x "$WORK/fake.sh"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label (needle not found)" >&2
    echo "    needle:   $needle" >&2
    echo "    haystack: ${haystack:0:300}" >&2
    FAIL=$((FAIL + 1))
  fi
}

jq_val() { printf '%s' "$1" | jq -r "$2"; }

# ── start --from-file / --prompt-file ────────────────────────────────────────

run_start_from_file() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix start --from-file / --prompt-file"

  # Write a prompt file
  local pfile="$WORK/$prefix-prompt.txt"
  printf 'Hello from file\n' > "$pfile"

  # --from-file with --dry-run: the dry-run JSON should capture initial_text
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --from-file "$pfile" "${prefix}-ff" "$WORK" 2>&1)" || code=$?
  assert "$prefix start --from-file exit=0" "$code" "0"
  assert "$prefix start --from-file ok=true" "$(jq_val "$out" .ok)" "true"
  assert "$prefix start --from-file initial_text" \
    "$(jq_val "$out" .invocation.initial_text)" "Hello from file"

  # --prompt-file alias
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --prompt-file "$pfile" "${prefix}-pf" "$WORK" 2>&1)" || code=$?
  assert "$prefix start --prompt-file exit=0" "$code" "0"
  assert "$prefix start --prompt-file initial_text" \
    "$(jq_val "$out" .invocation.initial_text)" "Hello from file"

  # --from-file and inline text together → must error
  code=0
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --from-file "$pfile" "${prefix}-mx" "$WORK" "also inline" >/dev/null 2>&1 || code=$?
  assert "$prefix start mutual-exclusion exit≠0" "$code" "2"

  # Non-existent file → error
  code=0
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --from-file "/no/such/file.txt" "${prefix}-ne" "$WORK" >/dev/null 2>&1 || code=$?
  assert "$prefix start nonexistent-file exit≠0" "$code" "2"

  # Relative path → error
  code=0
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --from-file "relative.txt" "${prefix}-rel" "$WORK" >/dev/null 2>&1 || code=$?
  assert "$prefix start relative-path exit≠0" "$code" "2"

  # stdin via -
  code=0
  out="$(printf 'stdin prompt\n' | env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --from-file - "${prefix}-stdin" "$WORK" 2>&1)" || code=$?
  assert "$prefix start stdin exit=0" "$code" "0"
  assert "$prefix start stdin initial_text" \
    "$(jq_val "$out" .invocation.initial_text)" "stdin prompt"
}

# ── help text mentions --from-file ────────────────────────────────────────────

run_help_from_file() {
  local wrapper="$1" prefix="$2"
  echo "case: $prefix help text includes --from-file"

  local out
  out="$("$wrapper" help start 2>&1)"
  assert_contains "$prefix help start --from-file" "$out" "--from-file"
  assert_contains "$prefix help start --prompt-file" "$out" "--prompt-file"

  out="$("$wrapper" help send 2>&1)"
  assert_contains "$prefix help send --from-file" "$out" "--from-file"
  assert_contains "$prefix help send --prompt-file" "$out" "--prompt-file"

  out="$("$wrapper" help send-wait 2>&1)"
  assert_contains "$prefix help send-wait --from-file" "$out" "--from-file"

  out="$("$wrapper" help send-wait-literal 2>&1)"
  assert_contains "$prefix help send-wait-literal --from-file" "$out" "--from-file"
}

# ── send-wait / send-wait-literal flag parse (error paths only, no real tmux) ─

run_send_wait_error_paths() {
  local wrapper="$1" prefix="$2"
  echo "case: $prefix send-wait / send-wait-literal error paths"

  # send-wait: missing name → error
  local code=0
  "$wrapper" send-wait 2>/dev/null || code=$?
  assert "$prefix send-wait no-args exit≠0" "$code" "2"

  # send-wait: --from-file nonexistent file → error
  code=0
  "$wrapper" send-wait --from-file /no/such/file.txt myagent 2>/dev/null || code=$?
  assert "$prefix send-wait nonexistent-file exit≠0" "$code" "2"

  # send-wait: --from-file relative path → error
  code=0
  "$wrapper" send-wait --from-file relative.txt myagent 2>/dev/null || code=$?
  assert "$prefix send-wait relative-path exit≠0" "$code" "2"

  # send-wait-literal: --from-file nonexistent file → error
  code=0
  "$wrapper" send-wait-literal --from-file /no/such/file.txt myagent DONE 2>/dev/null || code=$?
  assert "$prefix send-wait-literal nonexistent-file exit≠0" "$code" "2"

  # send-wait-literal: --from-file missing marker → error
  local pfile="$WORK/$prefix-sw-prompt.txt"
  printf 'test prompt\n' > "$pfile"
  code=0
  "$wrapper" send-wait-literal --from-file "$pfile" 2>/dev/null || code=$?
  # missing name and marker → exits 2 (needs at least name + literal)
  # exit code may be 2 (usage) or 1 (no session), accept either non-zero
  [[ "$code" -ne 0 ]] && { echo "  ok   $prefix send-wait-literal missing-args exit≠0"; PASS=$((PASS+1)); } || \
    { echo "  FAIL $prefix send-wait-literal missing-args expected non-zero got 0" >&2; FAIL=$((FAIL+1)); }
}

# ── send --prompt-file alias (flag recognised, not "unknown flag") ────────────

run_send_prompt_file_alias() {
  local wrapper="$1" prefix="$2"
  echo "case: $prefix send --prompt-file alias recognised"

  # --prompt-file with missing value → usage error (exit 2), not "unknown flag"
  local code=0 out=""
  out="$("$wrapper" send --prompt-file 2>&1)" || code=$?
  assert "$prefix send --prompt-file no-value exit=2" "$code" "2"
  # must NOT say "Unknown flag"
  if [[ "$out" == *"Unknown flag"* ]]; then
    echo "  FAIL $prefix send --prompt-file unknown-flag leak" >&2
    FAIL=$((FAIL + 1))
  else
    echo "  ok   $prefix send --prompt-file no unknown-flag leak"
    PASS=$((PASS + 1))
  fi
}

# ── start: trailing --prompt-file / --from-file (issue #289 round 2) ─────────

run_start_trailing_flag() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix start trailing --prompt-file / --from-file"

  local pfile="$WORK/$prefix-trail.txt"
  printf 'Trailing flag content\n' > "$pfile"

  # <name> <dir> --prompt-file <file>  (trailing)
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    "${prefix}-trail" "$WORK" --prompt-file "$pfile" 2>&1)" || code=$?
  assert "$prefix start trailing --prompt-file exit=0" "$code" "0"
  assert "$prefix start trailing --prompt-file initial_text" \
    "$(jq_val "$out" .invocation.initial_text)" "Trailing flag content"

  # <name> <dir> --from-file <file>  (trailing alias)
  code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    "${prefix}-trailff" "$WORK" --from-file "$pfile" 2>&1)" || code=$?
  assert "$prefix start trailing --from-file exit=0" "$code" "0"
  assert "$prefix start trailing --from-file initial_text" \
    "$(jq_val "$out" .invocation.initial_text)" "Trailing flag content"

  # <name> <dir> --from-file -  (stdin in trailing position)
  code=0
  out="$(printf 'Trailing stdin content\n' | env "$cli_env=$WORK/fake.sh" "$wrapper" \
    start --exact --dry-run "${prefix}-trailstdin" "$WORK" --from-file - 2>&1)" || code=$?
  assert "$prefix start trailing stdin exit=0" "$code" "0"
  assert "$prefix start trailing stdin initial_text" \
    "$(jq_val "$out" .invocation.initial_text)" "Trailing stdin content"

  # Trailing --prompt-file + inline text → still errors
  code=0
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    "${prefix}-trailmx" "$WORK" --prompt-file "$pfile" "also inline" >/dev/null 2>&1 || code=$?
  assert "$prefix start trailing mutual-exclusion exit≠0" "$code" "2"
}

# ── send-wait / send-wait-literal: real positional ordering (fake CLI + tmux) ─
# Exercises the EXACT shapes from issue #289: flag in middle or trailing position,
# then verifies the file body was submitted (not the literal flag text) and that
# timeout / literal were parsed correctly.

run_positional_ordering_real() {
  local wrapper="$1" cli_env="$2" prefix="$3"

  local tmux_bin
  tmux_bin="$(command -v tmux 2>/dev/null || true)"
  if [[ -z "$tmux_bin" || ! -x "$tmux_bin" ]]; then
    echo "  skip $prefix positional-ordering real (tmux not available)"
    return 0
  fi

  echo "case: $prefix send-wait/send-wait-literal positional ordering (real submission)"

  # Fake CLI: reads lines; echoes the nonce standalone (for send-wait) and
  # echoes [SWLDONE] standalone (for send-wait-literal).
  cat > "$WORK/fake-pos-$prefix.sh" <<'FAKEOF'
#!/bin/sh
printf 'fake cli ready\n'
while IFS= read -r line; do
  nonce="$(printf '%s\n' "$line" | sed -nE 's/.*(MARK-[0-9a-fA-F]+).*/\1/p' | tail -1)"
  [ -n "$nonce" ] && printf '%s\n' "$nonce"
  case "$line" in *'[SWLDONE]'*) printf '[SWLDONE]\n' ;; esac
done
FAKEOF
  chmod +x "$WORK/fake-pos-$prefix.sh"

  # ── send-wait <name> --prompt-file <file> <timeout> ──────────────────────

  local pfile_sw="$WORK/$prefix-sw-body.txt"
  printf 'SW_FILE_BODY_CONTENT\n' > "$pfile_sw"
  local sess_sw="${prefix}-posord-sw"

  env "$cli_env=$WORK/fake-pos-$prefix.sh" \
    "$wrapper" start --exact "$sess_sw" "$WORK" >/dev/null 2>&1 || true
  local ready_sw=0
  "$wrapper" wait-text "$sess_sw" "fake cli ready" 8 >/dev/null 2>&1 || ready_sw=$?
  if [[ "$ready_sw" -ne 0 ]]; then
    echo "  FAIL $prefix send-wait positional: session not ready" >&2
    FAIL=$((FAIL + 1))
    "$wrapper" stop "$sess_sw" >/dev/null 2>&1 || true
    return 0
  fi

  local sw_code=0
  "$wrapper" send-wait "$sess_sw" --prompt-file "$pfile_sw" 10 >/dev/null 2>&1 || sw_code=$?
  assert "$prefix send-wait flag-between-positionals exit=0" "$sw_code" "0"

  local sw_pane
  sw_pane="$("$wrapper" capture "$sess_sw" 150 2>/dev/null || true)"
  assert_contains "$prefix send-wait file body reached pane" "$sw_pane" "SW_FILE_BODY_CONTENT"
  if [[ "$sw_pane" == *"--prompt-file"* ]]; then
    echo "  FAIL $prefix send-wait: literal --prompt-file leaked into pane" >&2
    FAIL=$((FAIL + 1))
  else
    echo "  ok   $prefix send-wait: no --prompt-file literal in pane"
    PASS=$((PASS + 1))
  fi

  "$wrapper" stop "$sess_sw" >/dev/null 2>&1 || true

  # ── send-wait-literal <name> --prompt-file <file> <literal> <timeout> ───

  local pfile_swl="$WORK/$prefix-swl-body.txt"
  printf 'SWL_FILE_BODY\n[SWLDONE]\n' > "$pfile_swl"
  local sess_swl="${prefix}-posord-swl"

  env "$cli_env=$WORK/fake-pos-$prefix.sh" \
    "$wrapper" start --exact "$sess_swl" "$WORK" >/dev/null 2>&1 || true
  local ready_swl=0
  "$wrapper" wait-text "$sess_swl" "fake cli ready" 8 >/dev/null 2>&1 || ready_swl=$?
  if [[ "$ready_swl" -ne 0 ]]; then
    echo "  FAIL $prefix send-wait-literal positional: session not ready" >&2
    FAIL=$((FAIL + 1))
    "$wrapper" stop "$sess_swl" >/dev/null 2>&1 || true
    return 0
  fi

  local swl_code=0
  "$wrapper" send-wait-literal "$sess_swl" --prompt-file "$pfile_swl" "[SWLDONE]" 10 \
    >/dev/null 2>&1 || swl_code=$?
  assert "$prefix send-wait-literal flag-between-positionals exit=0" "$swl_code" "0"

  local swl_pane
  swl_pane="$("$wrapper" capture "$sess_swl" 150 2>/dev/null || true)"
  assert_contains "$prefix send-wait-literal file body reached pane" "$swl_pane" "SWL_FILE_BODY"

  "$wrapper" stop "$sess_swl" >/dev/null 2>&1 || true
}

# ── run all cases ─────────────────────────────────────────────────────────────

for wrapper_pair in "$CODEX_TMUX|CODEX|cd" "$CLAUDE_TMUX|CLAUDE|cl"; do
  IFS='|' read -r wrapper env_var prefix <<< "$wrapper_pair"
  run_start_from_file           "$wrapper" "$env_var" "$prefix"
  run_start_trailing_flag       "$wrapper" "$env_var" "$prefix"
  run_help_from_file            "$wrapper" "$prefix"
  run_send_wait_error_paths     "$wrapper" "$prefix"
  run_send_prompt_file_alias    "$wrapper" "$prefix"
  run_positional_ordering_real  "$wrapper" "$env_var" "$prefix"
done

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
