#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke for prompt text from a file or stdin: --from-file / --prompt-file / - (#289),
# multi-line sends (#202) and the `brief` compiler that feeds --from-file.
#   fixtures (dry-run, no launch): leading/trailing flag, stdin, refusals, brief
#   live workers whose fake CLI appends every line it reads to one log:
#   send-wait and send-wait-literal with the flag between positionals, send from
#   stdin, and a 17 KB multi-line send (transcript + audit metadata, no body)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
CODEX_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" codex)"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/tmux-agent-prompt-file-smoke.XXXXXX")"
export TMUX_AGENT_DIR="$WORK/state"
trap '"$CODEX_TMUX" stop pf-live >/dev/null 2>&1 || true; "$CODEX_TMUX" stop pf-live2 >/dev/null 2>&1 || true; rm -rf "$WORK"' EXIT

PASS=0
FAIL=0
assert() {
  if [[ "$2" == "$3" ]]; then echo "  ok   $1"; PASS=$((PASS + 1))
  else echo "  FAIL $1 expected=$3 got=$2" >&2; FAIL=$((FAIL + 1)); fi
}
assert_contains() {
  if [[ "$2" == *"$3"* ]]; then echo "  ok   $1"; PASS=$((PASS + 1))
  else echo "  FAIL $1 missing=$3 in: ${2:0:300}" >&2; FAIL=$((FAIL + 1)); fi
}
jq_val() { printf '%s' "$1" | jq -r "$2"; }
# wait_got <text>: poll the receive log 0.05 s, 2 s bound.
wait_got() {
  local i
  for (( i = 0; i < 40; i++ )); do
    grep -qF -- "$1" "$WORK/got" 2>/dev/null && return 0
    sleep 0.05
  done
  return 1
}
printf '#!/bin/sh\nexit 0\n' > "$WORK/fake.sh"; chmod +x "$WORK/fake.sh"
dry() { CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact --dry-run "$@"; }

echo "case: start --from-file / --prompt-file / - (dry-run)"
pfile="$WORK/prompt.txt"
printf 'Hello from file\n' > "$pfile"
out="$(dry --from-file "$pfile" pf-lead "$WORK")"
assert "leading --from-file initial_text" "$(jq_val "$out" .invocation.initial_text)" "Hello from file"
out="$(dry pf-trail "$WORK" --prompt-file "$pfile")"
assert "trailing --prompt-file initial_text" "$(jq_val "$out" .invocation.initial_text)" "Hello from file"
out="$(printf 'stdin prompt\n' | dry pf-stdin "$WORK" --from-file -)"
assert "stdin - initial_text" "$(jq_val "$out" .invocation.initial_text)" "stdin prompt"
# refusal table: <label>|<args...> (each must exit 2)
for row in "file plus inline text|--from-file $pfile pf-mx $WORK also-inline" \
           "trailing file plus inline text|pf-tmx $WORK --prompt-file $pfile also-inline" \
           "missing file|--from-file /no/such/file.txt pf-ne $WORK" \
           "relative path|--from-file relative.txt pf-rel $WORK"; do
  rc=0; dry ${=row#*|} >/dev/null 2>&1 || rc=$?
  assert "start ${row%%|*} exits 2" "$rc" "2"
done
rc=0; "$CODEX_TMUX" send-wait --from-file relative.txt myagent 2>/dev/null || rc=$?
assert "send-wait relative path exits 2" "$rc" "2"
rc=0; "$CODEX_TMUX" send-wait-literal --from-file /no/such/file.txt myagent DONE 2>/dev/null || rc=$?
assert "send-wait-literal missing file exits 2" "$rc" "2"
rc=0; out="$("$CODEX_TMUX" send --prompt-file 2>&1)" || rc=$?
assert "send --prompt-file without value exits 2" "$rc" "2"
assert "send --prompt-file is a known flag" "$([[ "$out" == *"Unknown flag"* ]] && echo unknown || echo known)" "known"

echo "case: brief compiles a prompt file that start --from-file consumes"
bfile="$("$CODEX_TMUX" brief --template implement --goal 'Fix flaky login test' --acceptance 'pytest tests/test_login.py passes' --model '.workflow/run/system-model.json')"
out="$(dry --from-file "$bfile" pf-brief "$WORK")"
btext="$(jq_val "$out" .invocation.initial_text)"
assert_contains "brief GOAL" "$btext" "GOAL: Fix flaky login test"
assert_contains "brief ACCEPTANCE" "$btext" "ACCEPTANCE: pytest tests/test_login.py passes"
assert_contains "brief REPORT" "$btext" "REPORT:"
rc=0; out="$("$CODEX_TMUX" brief --template implement --goal 'only goal' 2>&1)" || rc=$?
assert "brief without --acceptance exits 2" "$rc" "2"
assert_contains "brief usage text" "$out" "Usage: agent-tmux <cli> brief"

echo "case: one live worker receives file, stdin, and multi-line sends"
# Fake CLI: logs each line read; echoes a MARK-<hex> nonce or [SWLDONE] alone for the waits.
cat > "$WORK/fake-live.sh" <<EOF
#!/bin/sh
printf 'fake cli ready\n'
while IFS= read -r line; do
  printf 'got:%s\n' "\$line" >> ${(q)WORK}/got
  nonce="\$(printf '%s\n' "\$line" | sed -nE 's/.*(MARK-[0-9a-fA-F]+).*/\1/p' | tail -1)"
  [ -n "\$nonce" ] && printf '%s\n' "\$nonce"
  case "\$line" in *'[SWLDONE]'*) printf '[SWLDONE]\n' ;; esac
done
EOF
chmod +x "$WORK/fake-live.sh"
transcript="$WORK/live.transcript.jsonl"
audit="$WORK/live.audit.jsonl"
CODEX="$WORK/fake-live.sh" "$CODEX_TMUX" start --exact --transcript "$transcript" pf-live "$WORK" >/dev/null
# A second worker on the same log takes send-wait-literal: the waits poll each second, so run both at once.
CODEX="$WORK/fake-live.sh" "$CODEX_TMUX" start --exact pf-live2 "$WORK" >/dev/null
"$CODEX_TMUX" wait-text pf-live "fake cli ready" 5 >/dev/null 2>&1 || true
"$CODEX_TMUX" wait-text pf-live2 "fake cli ready" 5 >/dev/null 2>&1 || true

printf 'SW_FILE_BODY_CONTENT\n' > "$WORK/sw.txt"
printf 'SWL_FILE_BODY\n[SWLDONE]\n' > "$WORK/swl.txt"
( rc=0; "$CODEX_TMUX" send-wait-literal pf-live2 --prompt-file "$WORK/swl.txt" "[SWLDONE]" 8 >/dev/null 2>&1 || rc=$?; echo $rc > "$WORK/swl.rc" ) &
swl_job=$!
rc=0; "$CODEX_TMUX" send-wait pf-live --prompt-file "$WORK/sw.txt" 8 >/dev/null 2>&1 || rc=$?
wait $swl_job || true
assert "send-wait flag between positionals exits 0" "$rc" "0"
assert "send-wait-literal flag between positionals exits 0" "$(cat "$WORK/swl.rc" 2>/dev/null)" "0"
wait_got "SW_FILE_BODY_CONTENT" || true
assert_contains "send-wait file body received" "$(cat "$WORK/got" 2>/dev/null)" "got:SW_FILE_BODY_CONTENT"
assert_contains "send-wait-literal file body received" "$(cat "$WORK/got" 2>/dev/null)" "got:SWL_FILE_BODY"
assert "no --prompt-file literal received" "$(grep -c -- '--prompt-file' "$WORK/got" 2>/dev/null || true)" "0"

printf 'stdin-send-line\n' | "$CODEX_TMUX" send --from-file - pf-live >/dev/null
wait_got "got:stdin-send-line" && r=yes || r=no
assert "send --from-file - received" "$r" "yes"

payload="$WORK/payload.txt"
{ printf 'alpha\n'; printf 'beta: with colon\n'; perl -e 'print "x" x 17000'; } > "$payload"
TMUX_AGENT_TOOLS_AUDIT_LOG="$audit" "$CODEX_TMUX" send --from-file "$payload" --enter-count 3 --enter-delay 0.05 pf-live >/dev/null
wait_got "got:beta: with colon" || true
assert_contains "multi-line first line received" "$(cat "$WORK/got" 2>/dev/null)" "got:alpha"
assert_contains "multi-line second line received" "$(cat "$WORK/got" 2>/dev/null)" "got:beta: with colon"
send_line="$(grep '"event":"send"' "$transcript" | tail -1)"
assert "transcript multiline=true" "$(jq_val "$send_line" .multiline)" "true"
assert "transcript has sha" "$(jq_val "$send_line" '.text_sha256 | type')" "string"
assert "transcript bytes > 16k" "$(jq_val "$send_line" '.text_bytes > 16000')" "true"
audit_line="$(grep '"event":"send.multiline"' "$audit" | tail -1)"
assert "audit multiline event" "$(jq_val "$audit_line" .event)" "send.multiline"
assert "audit omits body" "$(jq_val "$audit_line" 'has("text")')" "false"
assert "audit enter_count" "$(jq_val "$audit_line" .enter_count)" "3"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
