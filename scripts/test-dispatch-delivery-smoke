#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke test for dispatch delivery defects (2026-09-08 investigation in
# agent-scripts .workflow/202609090043-cli-session-investigation, and 2026-09-25):
#
#  1. Launch blockers were indistinguishable from slow workers. `cursor-agent
#     --version` returned "your macOS login keychain is locked" and the review
#     was never dispatched; nothing in the wrapper said so. assign must now
#     stop at step 0 with blocked_reason and start NO tmux session.
#  2. A bracketed-pasted multiline prompt reached agy as 12 separate inputs.
#     `prompt_delivery=file-ref` must deliver the task as exactly ONE input
#     naming a composed file that carries the whole task.
#  3. An UNSENT paste placeholder left in the composer (cursor) was reported
#     assigned:true. assign presses Enter at most twice, then fails by name.
#     This is the one real-time case: the product only looks for it after 20 s
#     and spaces the Enters 10 s apart (agent-tmux confirm-processing). A
#     SUBMITTED placeholder is a different condition: test-assign-dialog-smoke.
#     A plain multi-line `send` held after two Enters is pressed again too.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"

WORK="$(mktemp -d "$TMPDIR/work.XXXXXX")"
export TMUX_AGENT_DIR="$WORK/state"
export AGENT_TMUX_PREFLIGHT_TIMEOUT=5
# Keep this run's audit events out of the machine's real trail.
export TMUX_AGENT_TOOLS_AUDIT_LOG="$WORK/audit.jsonl"
export AGENT_TMUX_PROFILE_DIR="$WORK/profiles"
export PATH="$WORK:$PATH"
# smoke-tmux.sh kills this run's tmux server, and with it every worker.
trap 'rm -rf "$WORK"' EXIT

PASS=0; FAIL=0
assert() {
  local label="$1" got="$2" want="$3"
  if [[ "$got" == "$want" ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: got '$got' want '$want'"; FAIL=$((FAIL+1)); fi
}
assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: '$needle' not in output"; FAIL=$((FAIL+1)); fi
}
exists() { [[ -e "$1" ]] && echo yes || echo no; }

printf 'GOAL: prove the whole prompt arrives.\nCONTEXT: read these first.\nMODEL: none — isolated transport fixture\nACCEPTANCE: one input.\nREPORT: say done.\n' > "$WORK/multi.txt"

# pastecli (generic family): echoes what it reads and holds the paste
# placeholder in its composer; a bare Enter only redraws (the redraw once read
# as activity) until the --enters'th one submits and writes --result; by
# default it never submits. Paths arrive as launch flags: a running tmux
# server hands its own env to new panes.
cat > "$WORK/pastecli" <<'EOF'
#!/bin/sh
[ "$1" = "--version" ] && { echo "pastecli 1.0"; exit 0; }
stty -echo 2>/dev/null
RES=""; need=99; enters=0
while [ $# -gt 0 ]; do case "$1" in --result) RES="$2"; shift 2 ;; --enters) need="$2"; shift 2 ;; *) shift ;; esac; done
echo "→ ready"
while IFS= read -r line; do
  if [ -n "$line" ]; then printf '%s\n\342\206\222 [Pasted text #1 +25 lines]\n' "$line"; continue; fi
  enters=$((enters+1))
  if [ "$enters" -ge "$need" ]; then
    printf '  [Pasted text #1 +25 lines]\n\342\240\240 Working\n\342\206\222 Add a follow-up\n'
    [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"submitted","artifacts":[],"errors":[]}\n' > "$RES"
  else printf 'Usage plan 78%%\r'; fi
done
EOF
# echocli: a TUI that treats every newline as submit; logs one entry per input
# and writes a terminal result on the first one, so the count measures the
# delivery shape alone.
cat > "$WORK/echocli" <<'EOF'
#!/bin/sh
[ "$1" = "--version" ] && { echo "echocli 1.0"; exit 0; }
LOG=/dev/null; RES=""
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; --result) RES="$2"; shift 2 ;; *) shift ;; esac; done
echo "> ready"
while IFS= read -r line; do
  [ -n "$line" ] && printf '%s\n' "$line" >> "$LOG"
  printf 'got:%s\n' "$line"
  [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"echoed","artifacts":[],"errors":[]}\n' > "$RES"
done
EOF
cat > "$WORK/lockedcli" <<'EOF'
#!/bin/sh
echo "Error: Your macOS login keychain is locked." >&2
echo "Run security unlock-keychain and try again." >&2
exit 1
EOF
chmod +x "$WORK"/pastecli "$WORK"/echocli "$WORK"/lockedcli
mkdir -p "$WORK/profiles"
printf 'bin=%s\nheuristic_family=generic\n' "$WORK/pastecli" > "$WORK/profiles/pastecursor.conf"

# The long case starts first; the others run in its shadow.
mkdir -p "$TMUX_AGENT_DIR/unsent"
"$AGENT_TMUX" pastecursor assign --timeout 60 --confirm-window 50 --detach \
  --prompt-delivery file-ref unsent "$WORK" "$WORK/multi.txt" \
  >"$WORK/unsent.out" 2>"$WORK/unsent.err" &
PID_UNSENT=$!
# Plain multi-line `send` that the composer still holds after two Enters
# (cursor, 2026-09-26). No prefixes: their blank lines would reach pastecli as
# Enters and hide the bug.
mkdir -p "$TMUX_AGENT_DIR/send"
: > "$TMUX_AGENT_DIR/send/scope-guard-injected"
: > "$TMUX_AGENT_DIR/send/.result-path-injected"
(
  AGENT_TMUX_LAUNCH_FLAGS="--result $TMUX_AGENT_DIR/send/result.json --enters 3" \
    "$AGENT_TMUX" pastecursor start --exact send "$WORK" >/dev/null 2>&1
  for _ in {1..40}; do "$AGENT_TMUX" pastecursor capture --strip-ansi send 2>/dev/null | grep -q 'ready' && break; sleep 0.05; done
  "$AGENT_TMUX" pastecursor send send $'line one\nline two' >"$WORK/send.out" 2>&1 || true
) &
PID_SEND=$!

echo "case: launch blocker is reported, never waited on"
code=0
out="$("$AGENT_TMUX" lockedcli preflight --json 2>/dev/null)" || code=$?
assert "preflight exit" "$code" "4"
assert "preflight blocked" "$(printf '%s' "$out" | jq -r .blocked)" "true"
assert "preflight reason" "$(printf '%s' "$out" | jq -r .blocked_reason)" "keychain_locked"
assert_contains "preflight keeps the CLI's own words" "$(printf '%s' "$out" | jq -r .detail)" "keychain is locked"
assert_contains "preflight says what to do" "$(printf '%s' "$out" | jq -r .diagnostic)" "unlock-keychain"

printf 'GOAL: never dispatched\n' > "$WORK/blocked-prompt.txt"
code=0
out="$("$AGENT_TMUX" lockedcli assign --timeout 20 blocked-smoke "$WORK" "$WORK/blocked-prompt.txt" 2>/dev/null)" || code=$?
assert "assign exit on launch blocker" "$code" "4"
assert "assign reports not assigned" "$(printf '%s' "$out" | jq -r .assigned)" "false"
assert "assign names the step" "$(printf '%s' "$out" | jq -r .failed_step)" "preflight"
assert "assign names the reason" "$(printf '%s' "$out" | jq -r .blocked_reason)" "keychain_locked"
assert "no session was started" "$("$AGENT_TMUX" lockedcli list 2>/dev/null | grep -c blocked-smoke || true)" "0"

echo
echo "case: file-ref delivery is one input that carries the whole task"
N=fileref; LOG="$WORK/$N.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/$N"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG --result $TMUX_AGENT_DIR/$N/result.json" \
  "$AGENT_TMUX" echocli assign --timeout 8 --confirm-window 5 \
    --prompt-delivery file-ref "$N" "$WORK" "$WORK/multi.txt" \
    >"$WORK/$N.out" 2>"$WORK/$N.err" || code=$?
assert "file-ref: assign exit=0" "$code" "0"
assert "file-ref arrived as a single input" "$(awk 'NF' "$LOG" | wc -l | tr -d ' ')" "1"
COMPOSED="$TMUX_AGENT_DIR/$N/prompt.md"
assert "composed prompt exists" "$(exists "$COMPOSED")" "yes"
assert_contains "the one input names the composed file" "$(cat "$LOG")" "$COMPOSED"
COMPOSED_BODY="$(cat "$COMPOSED" 2>/dev/null || true)"
assert_contains "composed prompt keeps GOAL" "$COMPOSED_BODY" "GOAL: prove the whole prompt arrives."
assert_contains "composed prompt keeps CONTEXT" "$COMPOSED_BODY" "CONTEXT: read these first."
assert_contains "composed prompt keeps REPORT" "$COMPOSED_BODY" "REPORT: say done."
assert_contains "composed prompt carries the result path" "$COMPOSED_BODY" "result.json"
# File-ref delivery cannot half-land, so both prepended instructions must be
# recorded as landed. A pane-echo check here would always come back
# UNCONFIRMED (the marker text is in the file, never pasted) and every
# follow-up send would re-inject the same instructions.
assert "result-path instruction recorded as landed" "$(exists "$TMUX_AGENT_DIR/$N/.result-path-injected")" "yes"
assert "scope-guard instruction recorded as landed" "$(exists "$TMUX_AGENT_DIR/$N/scope-guard-injected")" "yes"
assert_contains "the audit trail records the delivery" \
  "$(grep -h assign.file_ref "$WORK/audit.jsonl" 2>/dev/null | tail -1)" "$N"

echo
echo "case: a paste placeholder that never leaves the composer gets two Enters, then fails by name"
code=0; wait $PID_UNSENT || code=$?
assert "unsent: assign failed" "$(( code != 0 ))" "1"
assert_contains "unsent: the second Enter was pressed" "$(cat "$WORK/unsent.err")" "composer nudge 2/2"
assert_contains "unsent: the reason names the composer" "$(cat "$WORK/unsent.err")" "still sitting unsent in the composer"
assert "unsent: never confirmed on the nudge's redraw" "$(jq -r .assigned "$WORK/unsent.out" 2>/dev/null)" "false"
assert "unsent: the prompt was pasted once, not resent" \
  "$("$AGENT_TMUX" pastecursor capture --strip-ansi --tail 60 unsent 2>/dev/null | grep -c '^Your task' || true)" "1"

echo
echo "case: a plain multi-line send that the composer holds after two Enters is pressed again"
wait $PID_SEND || true
assert "send: the held paste was submitted (result written)" \
  "$(jq -r .status "$TMUX_AGENT_DIR/send/result.json" 2>/dev/null)" "success"

echo
echo "summary: $PASS passed, $FAIL failed"
(( FAIL == 0 )) || exit 1
echo "PASS: dispatch delivery smoke"
