#!/usr/bin/env zsh
# Smoke for tmux-agent-fanout run (issue #184).
# Uses a fake wrapper to avoid real tmux sessions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
FANOUT="$REPO_ROOT/skills/tmux-agent-tools/scripts/tmux-agent-fanout"
SCHEMA="$REPO_ROOT/schemas/fanout-summary.schema.json"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"; PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}
assert_file_exists() {
  local label="$1" path="$2"
  if [[ -f "$path" ]]; then
    echo "  ok   $label"; PASS=$((PASS + 1))
  else
    echo "  FAIL $label missing=$path" >&2; FAIL=$((FAIL + 1))
  fi
}

TMP="$(mktemp -d -t fanout-smoke.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

# Per-agent policy file. Fake wrapper reads $TMP/policy/<workdir-basename>.
mkdir -p "$TMP/policy"

# Fake wrapper. Argv: start --exact <name> <workdir> <prompt>
cat >"$TMP/fake-wrapper" <<'EOF'
#!/usr/bin/env zsh
# Minimal stub: writes result.json based on policy.
set -euo pipefail
# Args: start --exact <name> <workdir> <prompt>
[[ "${1:-}" == "start" ]] || exit 0
shift
[[ "${1:-}" == "--exact" ]] && shift
a_name="$1"; workdir="$2"
policy_file="${FAKE_POLICY_DIR:-/tmp}/$(basename "$workdir")"
result_status="ok"
if [[ -f "$policy_file" ]]; then
  result_status="$(cat "$policy_file")"
fi
out="${TMUX_AGENT_RESULT:-}"
if [[ -z "$out" ]]; then
  exit 0
fi
mkdir -p "$(dirname "$out")"
cat >"$out" <<JSON
{"schema_version":1,"status":"$result_status","summary":"fake $a_name"}
JSON
EOF
chmod +x "$TMP/fake-wrapper"

# Prompt file
echo "test prompt" >"$TMP/prompt.txt"

# Three workdirs
mkdir -p "$TMP/wd-a" "$TMP/wd-b" "$TMP/wd-c"

run_fanout() {
  TMUX_AGENT_FANOUT_FAKE_WRAPPER="$TMP/fake-wrapper" \
    FAKE_POLICY_DIR="$TMP/policy" \
    "$FANOUT" "$@"
}

# -------- Case 1: 3 agents all succeed, mode=all --------
echo "case: 3 agents all succeed, mode=all"
echo "ok" >"$TMP/policy/wd-a"
echo "ok" >"$TMP/policy/wd-b"
echo "ok" >"$TMP/policy/wd-c"
RD="$TMP/run1"
out="$(run_fanout run --prompt-file "$TMP/prompt.txt" \
    --agent claude:a --agent codex:b --agent claude:c \
    --workdir "$TMP/wd-a" --workdir "$TMP/wd-b" --workdir "$TMP/wd-c" \
    --result-dir "$RD" --timeout 5 2>/dev/null)"
ok="$(echo "$out" | jq -r '.ok')"
assert "case1 ok=true" "$ok" "true"
sv="$(echo "$out" | jq -r '.schema_version')"
assert "case1 schema_version=1" "$sv" "1"
n="$(echo "$out" | jq -r '.agents | length')"
assert "case1 agents.length=3" "$n" "3"
assert_file_exists "case1 wd-a result.json" "$RD/a-1/result.json"
assert_file_exists "case1 wd-b result.json" "$RD/b-2/result.json"
assert_file_exists "case1 wd-c result.json" "$RD/c-3/result.json"

# -------- Case 2: 1 fails, mode=all → ok=false; other results still on disk --------
echo "case: 1 fails, mode=all"
echo "ok"     >"$TMP/policy/wd-a"
echo "failed" >"$TMP/policy/wd-b"
echo "ok"     >"$TMP/policy/wd-c"
RD="$TMP/run2"
set +e
out="$(run_fanout run --prompt-file "$TMP/prompt.txt" \
    --agent claude:a --agent codex:b --agent claude:c \
    --workdir "$TMP/wd-a" --workdir "$TMP/wd-b" --workdir "$TMP/wd-c" \
    --result-dir "$RD" --merge-mode all --timeout 5 2>/dev/null)"
rc=$?
set -e
ok="$(echo "$out" | jq -r '.ok')"
assert "case2 ok=false" "$ok" "false"
assert "case2 exit nonzero" "$rc" "1"
assert_file_exists "case2 wd-a result.json preserved" "$RD/a-1/result.json"
assert_file_exists "case2 wd-b result.json preserved" "$RD/b-2/result.json"
assert_file_exists "case2 wd-c result.json preserved" "$RD/c-3/result.json"
status_b="$(jq -r '.agents[] | select(.name=="b") | .status' <<<"$out")"
assert "case2 b.status=failed" "$status_b" "failed"

# -------- Case 3: 1 fails, mode=first-success → ok=true --------
echo "case: 1 fails, mode=first-success"
echo "ok"     >"$TMP/policy/wd-a"
echo "failed" >"$TMP/policy/wd-b"
echo "ok"     >"$TMP/policy/wd-c"
RD="$TMP/run3"
out="$(run_fanout run --prompt-file "$TMP/prompt.txt" \
    --agent claude:a --agent codex:b --agent claude:c \
    --workdir "$TMP/wd-a" --workdir "$TMP/wd-b" --workdir "$TMP/wd-c" \
    --result-dir "$RD" --merge-mode first-success --timeout 5 2>/dev/null)"
ok="$(echo "$out" | jq -r '.ok')"
assert "case3 ok=true" "$ok" "true"
mode="$(echo "$out" | jq -r '.mode')"
assert "case3 mode=first-success" "$mode" "first-success"

# -------- Case 4: all fail --------
echo "case: all fail"
echo "failed" >"$TMP/policy/wd-a"
echo "failed" >"$TMP/policy/wd-b"
echo "failed" >"$TMP/policy/wd-c"
RD="$TMP/run4"
set +e
out="$(run_fanout run --prompt-file "$TMP/prompt.txt" \
    --agent claude:a --agent codex:b --agent claude:c \
    --workdir "$TMP/wd-a" --workdir "$TMP/wd-b" --workdir "$TMP/wd-c" \
    --result-dir "$RD" --merge-mode first-success --timeout 5 2>/dev/null)"
rc=$?
set -e
ok="$(echo "$out" | jq -r '.ok')"
assert "case4 ok=false" "$ok" "false"
assert "case4 exit nonzero" "$rc" "1"

# -------- Case 5: --summary-out written --------
echo "case: --summary-out"
echo "ok" >"$TMP/policy/wd-a"
RD="$TMP/run5"
SO="$TMP/summary.json"
run_fanout run --prompt-file "$TMP/prompt.txt" \
    --agent claude:a --workdir "$TMP/wd-a" \
    --result-dir "$RD" --summary-out "$SO" --timeout 5 >/dev/null 2>&1
assert_file_exists "case5 summary-out written" "$SO"

# -------- Case 6: legacy back-compat (no --agent, no run) --------
echo "case: legacy back-compat"
echo "ok" >"$TMP/policy/wd-a"
echo "ok" >"$TMP/policy/wd-b"
RD="$TMP/run6"
out="$(run_fanout --prompt-file "$TMP/prompt.txt" \
    --workdir "$TMP/wd-a" --workdir "$TMP/wd-b" \
    --result-dir "$RD" --timeout 5 2>/dev/null)"
ok="$(echo "$out" | jq -r '.ok')"
assert "case6 legacy form ok=true" "$ok" "true"
n="$(echo "$out" | jq -r '.agents | length')"
assert "case6 legacy agents=2" "$n" "2"
t1="$(echo "$out" | jq -r '.agents[0].tool')"
assert "case6 legacy default tool=claude" "$t1" "claude"

# -------- Case 7: shape validation against schema (manual, since no ajv) --------
echo "case: summary shape"
required_keys="$(echo "$out" | jq -r 'keys | join(",")')"
assert "case7 top-level keys" "$required_keys" "agents,mode,ok,run_id,schema_version"
agent_keys="$(echo "$out" | jq -r '.agents[0] | keys | join(",")')"
assert "case7 agent keys" "$agent_keys" "error,name,result_path,status,tool"

# Confirm schema file exists.
assert_file_exists "case7 schema file present" "$SCHEMA"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
