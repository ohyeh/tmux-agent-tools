#!/usr/bin/env zsh
# Lint: ban `local +(path|cdpath|fignore|fpath|manpath|psvar)=` in wrapper
# helpers (issue #139). zsh ties these lowercase identifiers to their
# uppercase env counterparts — `local path="..."` clobbers $PATH for the
# rest of the scope, which bit us in #100 transcript work.
#
# Scope: files under skills/tmux-agent-tools/scripts/ and scripts/. Smoke
# runners that intentionally do not declare these names are unaffected.
#
# Exit 0 on clean, exit 1 on any violation. Outputs grep-style file:line
# matches so a CI run can point at the offending lines directly.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

TARGETS=(
  "$REPO_ROOT/skills/tmux-agent-tools/scripts"
  "$REPO_ROOT/scripts"
)

# Pattern: `local <space>* <name>=` where <name> is a zsh tied-pair var.
# Matches `local path=` and `typeset path=` styles. Allows `local +A`-style
# typed declarations to pass — those are syntactically distinct.
TIED_NAMES='(path|cdpath|fignore|fpath|manpath|psvar)'
PATTERN="(^|[[:space:]])(local|typeset)[[:space:]]+([[:alnum:]_]+[[:space:]]+)*${TIED_NAMES}="

local violations=0
local match
for dir in "${TARGETS[@]}"; do
  [[ -d "$dir" ]] || continue
  while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    # Skip ourselves so this lint script can document the banned pattern.
    [[ "$match" == *"lint-no-path-tied-locals"* ]] && continue
    printf '%s\n' "$match"
    violations=$((violations + 1))
  done < <(grep -REn -e "$PATTERN" "$dir" --include='*' 2>/dev/null || true)
done

if (( violations > 0 )); then
  echo
  echo "lint-no-path-tied-locals: $violations violation(s) found" >&2
  echo "Banned: \`local <tied-name>=...\` where tied-name in zsh is one of:" >&2
  echo "  path / cdpath / fignore / fpath / manpath / psvar" >&2
  echo "These shadow + tie to their UPPERCASE env counterparts and silently break PATH." >&2
  echo "Rename the local to something else (e.g. \`target\` instead of \`path\`)." >&2
  exit 1
fi

echo "lint-no-path-tied-locals: clean"
exit 0
