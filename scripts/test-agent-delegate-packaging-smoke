#!/usr/bin/env zsh
# Smoke test for issue #283 Gap 1: the tmux-delegate subagent is shipped at the
# plugin-root agents/ dir (where Claude Code registers plugin subagents at
# startup), has valid frontmatter + the no-cascade worker constraint, and does
# not drift from the project-local .claude/agents/ copy used for repo dogfooding.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

AGENTS=(tmux-delegate codex-oneshot claude-oneshot)

PASS=0
FAIL=0
ok()   { echo "  ok   $1"; PASS=$((PASS + 1)); }
bad()  { echo "  FAIL $1" >&2; FAIL=$((FAIL + 1)); }
check(){ if eval "$2"; then ok "$1"; else bad "$1"; fi }

for agent in "${AGENTS[@]}"; do
  PLUGIN_AGENT="$REPO_ROOT/agents/$agent.md"
  PROJECT_AGENT="$REPO_ROOT/.claude/agents/$agent.md"
  CODEX_AGENT="$REPO_ROOT/.codex/agents/$agent.toml"
  SKILL_AGENT="$REPO_ROOT/skills/tmux-agent-tools/agents/$agent.md"

  # The skill package must carry the delegation policy, not just the scripts.
  if cmp -s "$PLUGIN_AGENT" "$SKILL_AGENT"; then
    ok "$agent skill-packaged copy is identical"
  else
    bad "$agent skill copy missing or drifted (re-sync skills/tmux-agent-tools/agents/$agent.md)"
  fi

  [[ -f "$PLUGIN_AGENT" ]]  && ok "plugin-root agents/$agent.md exists"      || bad "plugin-root agents/$agent.md missing"
  [[ -f "$PROJECT_AGENT" ]] && ok ".claude/agents/$agent.md exists"          || bad ".claude/agents/$agent.md missing"
  [[ -f "$CODEX_AGENT" ]]   && ok ".codex/agents/$agent.toml exists"         || bad ".codex/agents/$agent.toml missing"

  # Valid Claude Code subagent frontmatter: first line is '---', has name/description.
  head -1 "$PLUGIN_AGENT" | grep -q '^---$' && ok "$agent frontmatter opens with ---"      || bad "$agent frontmatter does not open with ---"
  grep -q "^name: $agent$" "$PLUGIN_AGENT" && ok "$agent frontmatter name present"  || bad "$agent frontmatter name missing"
  grep -q '^description: ' "$PLUGIN_AGENT" && ok "$agent frontmatter description present"  || bad "$agent frontmatter description missing"

  # The no-further-delegation worker constraint must be present.
  grep -qF 'Do not spawn additional tmux sessions or delegate further.' "$PLUGIN_AGENT" \
    && ok "$agent no-cascade worker constraint present" || bad "$agent no-cascade worker constraint missing"

  # No drift between the shipped plugin agent and the project-local copy.
  if cmp -s "$PLUGIN_AGENT" "$PROJECT_AGENT"; then
    ok "$agent plugin and project subagent copies are identical"
  else
    bad "$agent plugin and project subagent copies have drifted (re-sync agents/$agent.md)"
  fi

  if python3 - "$CODEX_AGENT" "$agent" <<'PY'
import sys
import tomllib
path, expected = sys.argv[1:]
with open(path, "rb") as fh:
    doc = tomllib.load(fh)
body = doc.get("developer_instructions", "")
assert doc.get("name") == expected
assert doc.get("description")
assert "Do not spawn additional tmux sessions or delegate further." in body
PY
  then
    ok "$agent Codex custom-agent TOML is valid"
  else
    bad "$agent Codex custom-agent TOML invalid"
  fi
done

# Skill-packaged doc/schema copies must not drift from their repo canonicals.
SKILL_DIR="$REPO_ROOT/skills/tmux-agent-tools"
typeset -A DOC_PAIRS=(
  ["schemas/result-status-summary.schema.json"]="schemas/result-status-summary.schema.json"
  ["schemas/fanout-summary.schema.json"]="schemas/fanout-summary.schema.json"
  ["docs/wiki/Troubleshooting.md"]="references/troubleshooting.md"
  ["docs/wiki/Recipes.md"]="references/recipes.md"
)
for src in "${(k)DOC_PAIRS[@]}"; do
  dst="$SKILL_DIR/${DOC_PAIRS[$src]}"
  if cmp -s "$REPO_ROOT/$src" "$dst"; then
    ok "skill copy of $src is identical"
  else
    bad "skill copy of $src missing or drifted (re-sync ${DOC_PAIRS[$src]})"
  fi
done

# Dev-only eval fixtures must not ship inside the installable skill payload.
[[ ! -e "$SKILL_DIR/evals" ]] && ok "skill payload carries no evals/ dir" || bad "skill payload still contains evals/ (dev-only; move to workspace)"

CODEX_SKILL="$REPO_ROOT/.codex/skills/tmux-agent-tools"
[[ -L "$CODEX_SKILL" ]] && ok ".codex/skills/tmux-agent-tools is a symlink" || bad ".codex/skills/tmux-agent-tools symlink missing"
[[ "$(readlink "$CODEX_SKILL" 2>/dev/null)" == "../../skills/tmux-agent-tools" ]] \
  && ok ".codex/skills/tmux-agent-tools points at canonical skill" || bad ".codex/skills/tmux-agent-tools points at wrong target"

# CI-mode exit code tables in the source contract and the skill-packaged
# reference must carry the same set of codes (issue: contracts.md silently
# dropped reserved codes 4/5 that docs/ci-mode-exit-codes.md documents).
DOC_CODES=("${(@f)$(grep -E '^\| [0-9]+ \|' "$REPO_ROOT/docs/ci-mode-exit-codes.md" | awk -F'|' '{gsub(/ /,"",$2); print $2}')}")
CONTRACTS_CODES="$(grep -E '^\| [0-9]+ \|' "$SKILL_DIR/references/contracts.md" | awk -F'|' '{gsub(/ /,"",$2); print $2}')"
for code in "${DOC_CODES[@]}"; do
  if grep -qx "$code" <<< "$CONTRACTS_CODES"; then
    ok "contracts.md carries CI exit code $code"
  else
    bad "contracts.md missing CI exit code $code (present in docs/ci-mode-exit-codes.md)"
  fi
done

echo "agent-delegate-packaging smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
