#!/usr/bin/env zsh
# Packaging shape of the installable skill: doc/schema copies match their
# repo canonicals, no dev-only evals/ ships, and the .codex skill symlink
# points at the canonical skill.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PASS=0
FAIL=0
ok()   { echo "  ok   $1"; PASS=$((PASS + 1)); }
bad()  { echo "  FAIL $1" >&2; FAIL=$((FAIL + 1)); }

# Skill-packaged doc/schema copies must not drift from their repo canonicals.
SKILL_DIR="$REPO_ROOT/skills/tmux-agent-tools"
typeset -A DOC_PAIRS=(
  ["schemas/result-status-summary.schema.json"]="schemas/result-status-summary.schema.json"
  ["schemas/fanout-summary.schema.json"]="schemas/fanout-summary.schema.json"
  ["docs/wiki/Troubleshooting.md"]="references/troubleshooting.md"
  ["docs/wiki/Recipes.md"]="references/recipes.md"
)
for src in "${(k)DOC_PAIRS[@]}"; do
  dst="$SKILL_DIR/${DOC_PAIRS[$src]}"
  if cmp -s "$REPO_ROOT/$src" "$dst"; then
    ok "skill copy of $src is identical"
  else
    bad "skill copy of $src missing or drifted (re-sync ${DOC_PAIRS[$src]})"
  fi
done

# Dev-only eval fixtures must not ship inside the installable skill payload.
[[ ! -e "$SKILL_DIR/evals" ]] && ok "skill payload carries no evals/ dir" || bad "skill payload still contains evals/ (dev-only; move to workspace)"

CODEX_SKILL="$REPO_ROOT/.codex/skills/tmux-agent-tools"
[[ -L "$CODEX_SKILL" ]] && ok ".codex/skills/tmux-agent-tools is a symlink" || bad ".codex/skills/tmux-agent-tools symlink missing"
[[ "$(readlink "$CODEX_SKILL" 2>/dev/null)" == "../../skills/tmux-agent-tools" ]] \
  && ok ".codex/skills/tmux-agent-tools points at canonical skill" || bad ".codex/skills/tmux-agent-tools points at wrong target"

echo "agent-delegate-packaging smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
