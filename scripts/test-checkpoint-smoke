#!/usr/bin/env zsh
# Smoke for issue #111 v1 checkpoint/restore.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CODEX_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"
CLAUDE_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/claude-tmux"

WORK="$(mktemp -d -t tmux-agent-ckpt-smoke.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
trap 'rm -rf "$WORK"' EXIT

cat > "$WORK/fake.sh" <<'EOF'
#!/bin/sh
sleep 30
EOF
chmod +x "$WORK/fake.sh"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"; PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

run_cycle() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix checkpoint + restore cycle"
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact "$prefix-c" "$WORK" >/dev/null
  /bin/sleep 1
  local out="$WORK/$prefix.tar.gz"
  "$wrapper" checkpoint "$prefix-c" "$out" >/dev/null
  assert "$prefix tarball exists" "$(test -s "$out" && echo yes)" "yes"
  local list
  list="$(tar -tzf "$out" 2>/dev/null)"
  if [[ "$list" == *"$prefix-c/started_at"* ]]; then
    echo "  ok   $prefix tarball contains started_at"; PASS=$((PASS + 1))
  else
    echo "  FAIL $prefix tarball missing started_at" >&2; FAIL=$((FAIL + 1))
  fi
  local restore_out
  restore_out="$("$wrapper" restore "$out" 2>&1)"
  if [[ "$restore_out" == *"restored to:"* ]]; then
    echo "  ok   $prefix restore prints location"; PASS=$((PASS + 1))
  else
    echo "  FAIL $prefix restore missing location output" >&2; FAIL=$((FAIL + 1))
  fi
  "$wrapper" stop "$prefix-c" >/dev/null 2>&1 || true
}

run_rejects() {
  local wrapper="$1" prefix="$2"
  echo "case: $prefix flag rejections"
  local code=0
  "$wrapper" checkpoint missing-agent "$WORK/$prefix-x.tar.gz" >/dev/null 2>&1 || code=$?
  assert "$prefix missing-agent exit=1" "$code" "1"
  code=0
  "$wrapper" checkpoint name "relative.tar.gz" >/dev/null 2>&1 || code=$?
  assert "$prefix relative path exit=2" "$code" "2"
  code=0
  "$wrapper" restore "/no/such.tar.gz" >/dev/null 2>&1 || code=$?
  assert "$prefix restore missing exit=1" "$code" "1"
}

run_cycle   "$CODEX_TMUX"  "CODEX"  "cp-codex"
run_cycle   "$CLAUDE_TMUX" "CLAUDE" "cp-claude"
run_rejects "$CODEX_TMUX"  "rj-codex"
run_rejects "$CLAUDE_TMUX" "rj-claude"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
