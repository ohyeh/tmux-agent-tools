#!/usr/bin/env zsh
# Smoke test for issue #126 tmux-agent-replay (diff + redact subcommands).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPLAY="$REPO_ROOT/skills/tmux-agent-tools/scripts/tmux-agent-replay"

WORK="$(mktemp -d -t tmux-agent-replay-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label" >&2
    echo "    expected: $expected" >&2
    echo "    got:      $actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label" >&2
    echo "    needle:   $needle" >&2
    FAIL=$((FAIL + 1))
  fi
}

# Build two transcripts that intentionally diverge.
cat > "$WORK/a.jsonl" <<'EOF'
{"schema_version":1,"event":"start","name":"a","at":"2026-05-21T00:00:00Z"}
{"schema_version":1,"event":"send","name":"a","text":"step 1","at":"2026-05-21T00:00:01Z"}
{"schema_version":1,"event":"wait_literal","name":"a","outcome":"matched","needle":"[DONE-1]","at":"2026-05-21T00:00:05Z"}
{"schema_version":1,"event":"send","name":"a","text":"step 2","at":"2026-05-21T00:00:06Z"}
{"schema_version":1,"event":"wait_literal","name":"a","outcome":"matched","needle":"[DONE-2]","at":"2026-05-21T00:00:10Z"}
{"schema_version":1,"event":"stop","name":"a","at":"2026-05-21T00:00:11Z"}
EOF
cat > "$WORK/b.jsonl" <<'EOF'
{"schema_version":1,"event":"start","name":"b","at":"2026-05-21T01:00:00Z"}
{"schema_version":1,"event":"send","name":"b","text":"step 1","at":"2026-05-21T01:00:01Z"}
{"schema_version":1,"event":"wait_literal","name":"b","outcome":"matched","needle":"[DONE-1]","at":"2026-05-21T01:00:05Z"}
{"schema_version":1,"event":"wait_literal","name":"b","outcome":"timeout","needle":"[DONE-2]","at":"2026-05-21T01:00:10Z"}
EOF

# ----- diff (text) -----
echo "case: diff text mode"
out="$("$REPLAY" diff "$WORK/a.jsonl" "$WORK/b.jsonl" 2>&1)"
assert_contains "text mode lists sends delta" "$out" "sends"
assert_contains "text mode lists -1 delta for sends" "$out" "-1"
assert_contains "text mode lists +1 timeout delta" "$out" "1"
assert_contains "text mode dumps markers in a" "$out" "[DONE-1]"
assert_contains "text mode dumps markers in b" "$out" "[DONE-1]"

# ----- diff --json -----
echo "case: diff json mode"
json="$("$REPLAY" diff "$WORK/a.jsonl" "$WORK/b.jsonl" --json 2>&1)"
assert "diff json schema_version=1" "$(printf '%s' "$json" | jq -r .schema_version)" "1"
assert "diff json delta.sends=-1" "$(printf '%s' "$json" | jq -r .delta.sends)" "-1"
assert "diff json delta.waits_timeout=1" "$(printf '%s' "$json" | jq -r .delta.waits_timeout)" "1"
assert "diff json a.markers length=2" "$(printf '%s' "$json" | jq '.a.markers | length')" "2"
assert "diff json b.markers length=1" "$(printf '%s' "$json" | jq '.b.markers | length')" "1"
assert "diff json a.path is recorded" "$(printf '%s' "$json" | jq -r .a.path)" "$WORK/a.jsonl"

# ----- diff missing file -----
echo "case: diff missing file"
code=0
"$REPLAY" diff "$WORK/a.jsonl" "/no/such/file" >/dev/null 2>&1 || code=$?
assert "diff missing-b exit=1" "$code" "1"

# ----- redact -----
echo "case: redact default patterns"
# FAKE_AWS_KEY is AWS's documented public example key, split so repo-wide
# secret scans (scrub.sh AKIA pattern) never match this file's source text.
FAKE_AWS_KEY='AKIA''IOSFODNN7EXAMPLE'
cat > "$WORK/secrets.jsonl" <<EOF
{"schema_version":1,"event":"send","text":"AWS key $FAKE_AWS_KEY here"}
{"schema_version":1,"event":"send","text":"Bearer abc.def.ghi.jklmnop"}
{"schema_version":1,"event":"send","text":"api_key=ABCDEFGHIJ1234"}
{"schema_version":1,"event":"send","text":"nothing sensitive"}
EOF
"$REPLAY" redact "$WORK/secrets.jsonl" --output "$WORK/clean.jsonl"
clean="$(cat "$WORK/clean.jsonl")"
assert_contains "redact removes AWS access key" "$clean" "[redacted]"
# Original secret literal must not appear
if [[ "$clean" == *"$FAKE_AWS_KEY"* ]]; then
  echo "  FAIL redact leaked AWS key" >&2; FAIL=$((FAIL + 1))
else
  echo "  ok   redact does not leak raw AWS key"; PASS=$((PASS + 1))
fi
if [[ "$clean" == *"abc.def.ghi.jklmnop"* ]]; then
  echo "  FAIL redact leaked bearer token" >&2; FAIL=$((FAIL + 1))
else
  echo "  ok   redact does not leak bearer token"; PASS=$((PASS + 1))
fi
assert_contains "redact preserves safe text" "$clean" "nothing sensitive"

# ----- redact custom --pattern -----
echo "case: redact custom pattern"
cat > "$WORK/custom.jsonl" <<'EOF'
{"schema_version":1,"event":"send","text":"internal-only:topsecret-internal"}
{"schema_version":1,"event":"send","text":"public ok"}
EOF
"$REPLAY" redact "$WORK/custom.jsonl" --output "$WORK/custom-clean.jsonl" --pattern 'topsecret-[a-z]+'
clean="$(cat "$WORK/custom-clean.jsonl")"
assert_contains "custom pattern redacts target" "$clean" "[redacted]"
if [[ "$clean" == *"topsecret-internal"* ]]; then
  echo "  FAIL custom pattern did not redact" >&2; FAIL=$((FAIL + 1))
else
  echo "  ok   custom pattern strips match"; PASS=$((PASS + 1))
fi

# ----- redact refuses to overwrite -----
echo "case: redact refuses pre-existing output"
echo "stale" > "$WORK/exists.jsonl"
code=0
"$REPLAY" redact "$WORK/secrets.jsonl" --output "$WORK/exists.jsonl" >/dev/null 2>&1 || code=$?
assert "redact refuses pre-existing output exit=1" "$code" "1"

# ----- help -----
echo "case: help / unknown sub"
"$REPLAY" help 2>&1 | grep -q "tmux-agent-replay" && { echo "  ok   help prints usage"; PASS=$((PASS + 1)); } || { echo "  FAIL help missing"; FAIL=$((FAIL + 1)); }
code=0
"$REPLAY" bogus 2>/dev/null || code=$?
assert "unknown subcommand exit=2" "$code" "2"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
