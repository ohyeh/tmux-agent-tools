#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
# Two OS processes claim one TUI owner. Kept out of test-core-contract-smoke
# (that lane's 90s cap already trips under load). Lane: scripts/run-all-smokes
# (it globs scripts/test-*-smoke).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
RACE="$REPO_ROOT/skills/tmux-agent-tools/scripts/lib/tui-claim.race.node.ts"
timeout_bin="$(command -v timeout || command -v gtimeout || true)"
if [[ -z "$timeout_bin" ]]; then
  echo "  FAIL timeout or gtimeout is required" >&2
  echo "0 passed, 1 failed" >&2
  exit 1
fi

root="$(mktemp -d)"
launch="$(mktemp -d)"
trap 'rm -rf "$root" "$launch"' EXIT

set +e
"$timeout_bin" --kill-after=2s 8s zsh -c '
  node "$1" "$2" sess "$3" &
  node "$1" "$2" sess "$3" &
  for i in {1..40}; do
    n=( "$2"/result-*.json(N) )
    (( ${#n} >= 2 )) && break
    sleep 0.1
  done
  touch "$2/race-done"
  wait
' _ "$RACE" "$root" "$launch"
code=$?
set -e
if (( code != 0 )); then
  echo "  FAIL two-process claim timed out or exited $code" >&2
  echo "0 passed, 1 failed" >&2
  exit 1
fi

node --input-type=module -e '
import { readFileSync, readdirSync } from "node:fs"
const { sessionDirOf, v3Of } = await import(process.argv[2])
const dir = process.argv[1]
const files = readdirSync(dir).filter(n => n.startsWith("result-")).sort()
if (files.length !== 2) { console.error("expected 2 results, got " + files.length); process.exit(1) }
const results = files.map(n => JSON.parse(readFileSync(dir + "/" + n, "utf8")))
const kinds = results.map(r => r.kind).sort()
if (kinds.join(",") !== "occupied-pending,won") {
  console.error("expected won + occupied-pending, got " + JSON.stringify(kinds))
  process.exit(1)
}
const won = results.find(r => r.kind === "won")
const owner = JSON.parse(readFileSync(sessionDirOf(v3Of(dir), "sess") + "/tui.owner", "utf8"))
if (owner.token !== won.claim.token || owner.pid !== won.claim.pid || owner.host !== won.claim.host || owner.pidStart !== won.claim.pidStart) {
  console.error("owner does not match the winner: " + JSON.stringify({ owner, won: won.claim }))
  process.exit(1)
}
console.log("ok   two-process TUI claim: one won (" + results.map(r => r.kind).join(", ") + ")")
' "$root" "$REPO_ROOT/skills/tmux-agent-tools/scripts/lib/workers.ts"

echo "1 passed, 0 failed"
