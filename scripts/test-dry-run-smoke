#!/usr/bin/env zsh
# Smoke test for issue #110 --dry-run pre-flight checks on `start`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CODEX_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"
CLAUDE_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/claude-tmux"

WORK="$(mktemp -d -t tmux-agent-dry-run-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT

cat > "$WORK/fake.sh" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod +x "$WORK/fake.sh"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

jq_val() { printf '%s' "$1" | jq -r "$2"; }

run_ok_case() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-ok ($wrapper, all green)"
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run "$prefix-ok" "$WORK" 2>&1)" || code=$?
  assert "$prefix-ok exit=0" "$code" "0"
  assert "$prefix-ok ok=true" "$(jq_val "$out" .ok)" "true"
  assert "$prefix-ok schema_version=1" "$(jq_val "$out" .schema_version)" "1"
  assert "$prefix-ok workdir_exists=pass" "$(jq_val "$out" '.checks[] | select(.name=="workdir_exists") | .status')" "pass"
  assert "$prefix-ok agent_cli_binary=pass" "$(jq_val "$out" '.checks[] | select(.name=="agent_cli_binary") | .status')" "pass"
  assert "$prefix-ok tool field" "$(jq_val "$out" .tool)" "$(basename "$wrapper")"
}

run_bad_workdir() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-bad-dir ($wrapper, missing workdir)"
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run "$prefix-bad" /no/such/dir 2>&1)" || code=$?
  assert "$prefix-bad-dir exit=2" "$code" "2"
  assert "$prefix-bad-dir ok=false" "$(jq_val "$out" .ok)" "false"
  assert "$prefix-bad-dir workdir_exists=fail" "$(jq_val "$out" '.checks[] | select(.name=="workdir_exists") | .status')" "fail"
}

run_preexisting_sentinel() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-stale-sentinel ($wrapper, pre-existing sentinel)"
  touch "$WORK/$prefix-stale"
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --sentinel "$WORK/$prefix-stale" "$prefix-s" "$WORK" 2>&1)" || code=$?
  assert "$prefix-stale exit=2" "$code" "2"
  assert "$prefix-stale sentinel_path=fail" "$(jq_val "$out" '.checks[] | select(.name=="sentinel_path") | .status')" "fail"
}

run_on_exit_without_sentinel() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-orphan-on-exit ($wrapper, --on-exit without --sentinel)"
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --on-exit "echo done" "$prefix-x" "$WORK" 2>&1)" || code=$?
  assert "$prefix-orphan exit=2" "$code" "2"
  assert "$prefix-orphan on_exit_pairing=fail" "$(jq_val "$out" '.checks[] | select(.name=="on_exit_pairing") | .status')" "fail"
}

run_relative_transcript() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-relative-transcript ($wrapper, relative path rejected)"
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --transcript "relative.jsonl" "$prefix-r" "$WORK" 2>&1)" || code=$?
  assert "$prefix-relative exit=2" "$code" "2"
  assert "$prefix-relative transcript_path=fail" "$(jq_val "$out" '.checks[] | select(.name=="transcript_path") | .status')" "fail"
}

run_no_side_effects() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-no-side-effects ($wrapper, dry-run must not create session)"
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run "$prefix-side" "$WORK" >/dev/null 2>&1
  # If start_session actually ran, tmux would have created a real session.
  # Probe tmux directly because `status` returns 0 even for stopped sessions.
  local tmux_session
  if [[ "$wrapper" == *codex-tmux ]]; then
    tmux_session="codex-cli-$prefix-side"
  else
    tmux_session="claude-cli-$prefix-side"
  fi
  if tmux has-session -t "$tmux_session" 2>/dev/null; then
    echo "  FAIL $prefix-no-side-effects: dry-run leaked tmux session $tmux_session" >&2
    FAIL=$((FAIL + 1))
    tmux kill-session -t "$tmux_session" 2>/dev/null || true
  else
    echo "  ok   $prefix-no-side-effects: no tmux session created"
    PASS=$((PASS + 1))
  fi
}

run_wrong_env_var_does_not_cross_fallback() {
  # Regression for gemini HIGH-priority finding: claude-tmux must NOT
  # fall back to $CODEX when $CLAUDE is unset, and vice versa.
  local wrapper="$1" wrong_env="$2" prefix="$3"
  echo "case: $prefix-wrong-env ($wrapper, wrong env var should not satisfy CLI check)"
  local out code=0
  # Pass only the *other* tool's env var; the dry-run's correct env is unset.
  # Also unset PATH-resolved fallbacks by pointing the wrong env at a path
  # that exists but is wrong-tool — wrapper should still resolve via the
  # right env var only.
  out="$(env -u CODEX -u CLAUDE "$wrong_env=$WORK/fake.sh" "$wrapper" \
    start --exact --dry-run "$prefix-wrong" "$WORK" 2>&1)" || code=$?
  # The right env is unset; wrapper should fall back to `command -v <tool>`
  # which may or may not resolve depending on shell PATH. We only assert
  # that the wrong env's path was NOT what got reported.
  local reported
  reported="$(printf '%s' "$out" | jq -r '.checks[] | select(.name=="agent_cli_binary") | .detail' 2>/dev/null || true)"
  if [[ "$reported" == *"$WORK/fake.sh"* ]]; then
    echo "  FAIL $prefix-wrong-env: cross-fallback leaked $reported" >&2
    FAIL=$((FAIL + 1))
  else
    echo "  ok   $prefix-wrong-env: no cross-fallback (reported=$reported)"
    PASS=$((PASS + 1))
  fi
}

run_transcript_no_side_effect() {
  # Regression for gemini MEDIUM-priority finding: transcript writability
  # must not CREATE the file (was using `: > $path`).
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-transcript-no-side-effect ($wrapper)"
  local tpath="$WORK/$prefix-side-effect.jsonl"
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --transcript "$tpath" "$prefix-tse" "$WORK" >/dev/null 2>&1
  if [[ -e "$tpath" ]]; then
    echo "  FAIL $prefix transcript dry-run created $tpath" >&2
    FAIL=$((FAIL + 1))
    rm -f "$tpath"
  else
    echo "  ok   $prefix transcript path not touched by dry-run"
    PASS=$((PASS + 1))
  fi
}

run_model_passthrough() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix-model (--model appended to launch flags) ($wrapper)"
  local out code=0
  out="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --model claude-sonnet-4-6 "$prefix-m" "$WORK" 2>&1)" || code=$?
  assert "$prefix-model exit=0" "$code" "0"
  local flags; flags="$(jq_val "$out" .invocation.launch_flags)"
  if [[ "$flags" == *"--model claude-sonnet-4-6"* ]]; then
    echo "  ok   $prefix-model launch_flags carries --model"; PASS=$((PASS + 1))
  else
    echo "  FAIL $prefix-model launch_flags missing --model: $flags" >&2; FAIL=$((FAIL + 1))
  fi
  # value needing shell quoting must be preserved as one token
  local out2 code2=0
  out2="$(env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run \
    --model "spaced model" "$prefix-m2" "$WORK" 2>&1)" || code2=$?
  local flags2; flags2="$(jq_val "$out2" .invocation.launch_flags)"
  if [[ "$flags2" == *"--model 'spaced model'"* || "$flags2" == *'--model "spaced model"'* || "$flags2" == *'--model spaced\ model'* ]]; then
    echo "  ok   $prefix-model quotes spaced value"; PASS=$((PASS + 1))
  else
    echo "  FAIL $prefix-model did not quote spaced value: $flags2" >&2; FAIL=$((FAIL + 1))
  fi
  # missing value is rejected (--model is the final token, nothing follows)
  local code3=0
  env "$cli_env=$WORK/fake.sh" "$wrapper" start --exact --dry-run --model >/dev/null 2>&1 || code3=$?
  assert "$prefix-model missing-value exit=2" "$code3" "2"
}

for wrapper_pair in "$CODEX_TMUX|CODEX|cd" "$CLAUDE_TMUX|CLAUDE|cl"; do
  IFS='|' read -r wrapper env_var prefix <<< "$wrapper_pair"
  run_ok_case "$wrapper" "$env_var" "$prefix"
  run_model_passthrough "$wrapper" "$env_var" "$prefix"
  run_bad_workdir "$wrapper" "$env_var" "$prefix"
  run_preexisting_sentinel "$wrapper" "$env_var" "$prefix"
  run_on_exit_without_sentinel "$wrapper" "$env_var" "$prefix"
  run_relative_transcript "$wrapper" "$env_var" "$prefix"
  run_transcript_no_side_effect "$wrapper" "$env_var" "$prefix"
  run_no_side_effects "$wrapper" "$env_var" "$prefix"
done

run_wrong_env_var_does_not_cross_fallback "$CODEX_TMUX"  "CLAUDE" "xcd"
run_wrong_env_var_does_not_cross_fallback "$CLAUDE_TMUX" "CODEX"  "xcl"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
