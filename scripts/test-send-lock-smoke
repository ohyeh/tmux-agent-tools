#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke test for issue #102 advisory send lock.
#
# Validates that `send_lock_around` in agent-tmux (one CLI: the lock has no per-CLI branch):
#   - refuses a second acquirer while a holder is alive (rc 75, no entry), and
#     a new acquirer gets the lock once the holder is released
#   - hands the lock to two competing waiters one at a time after the holder
#     is killed -9
#   - exits with the inner command's return code
#   - tolerates a not-yet-existing $TMUX_AGENT_DIR/<name>
#
# The helper is sourced from agent-tmux via TMUX_AGENT_TOOLS_SOURCE_ONLY
# so we exercise the real implementation, not a copy. The engine is sourced
# once: every case runs in that one shell.
#
# Cases wait on files, never on a sleep that has to win a race: a holder
# blocks until the test creates its release file, and every wait loop has a
# deadline that only bounds a failing run.
#
# Exits non-zero on the first failure.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/tmux-agent-send-lock-smoke.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

# Case bodies -------------------------------------------------------------

# Shared helper sourced by the cases below. wait_for_file only bounds a run
# that is already failing; a passing run leaves the loop as soon as the file
# exists.
cat > "$WORK/helpers.zsh" <<'BODY'
wait_for_file() {
  local file="$1" i
  for (( i = 0; i < 1000; i++ )); do
    [[ -e "$file" ]] && return 0
    command sleep 0.01
  done
  echo "timeout waiting for $file" >&2
  return 1
}
# Start a holder that owns the lock until $1/release exists. Records the pid
# of the lock-holding subshell (the critical section's parent) in $1/holder.pid.
# Callers install their own EXIT trap to touch release (a trap set inside a zsh
# function ends with the function), so a failing case cannot leave it spinning.
start_holder() {
  local dir="$1" name="$2"
  ( send_lock_around "$name" 10 zsh -c '
      echo $PPID > "$1/holder.pid"
      touch "$1/held"
      while [[ ! -e "$1/release" ]]; do command sleep 0.01; done
    ' _ "$dir" ) &
  holder_job=$!
  wait_for_file "$dir/held"
}
BODY

cat > "$WORK/case-contended.zsh" <<'BODY'
# A live holder keeps the lock until the test releases it. A second acquirer
# must give up with rc 75 and never run its command; once the holder is
# released a new acquirer gets the lock.
source "$WORK/helpers.zsh"
name=contended
dir="$TMUX_AGENT_DIR/$name-case"
mkdir -p "$dir"
start_holder "$dir" "$name"
trap 'touch "$dir/release"' EXIT

entered="$dir/contender-entered"
set +e
send_lock_around "$name" 1 touch "$entered" 2>"$dir/contender.err"
rc=$?
set -e
[[ "$rc" -eq 75 ]] || { echo "expected rc=75 while held, got $rc" >&2; exit 1; }
[[ ! -e "$entered" ]] || { echo "contender entered the critical section while the holder held the lock" >&2; exit 1; }
grep -q "lock contended on $name" "$dir/contender.err" || { echo "missing contention message" >&2; cat "$dir/contender.err" >&2; exit 1; }

touch "$dir/release"
wait "$holder_job"
send_lock_around "$name" 5 touch "$entered"
[[ -e "$entered" ]] || { echo "lock not released after holder finished" >&2; exit 1; }
BODY

cat > "$WORK/case-killed-holder.zsh" <<'BODY'
# The holder is killed with SIGKILL while two waiters are queued. The OS must
# release the lock, and the waiters must then enter one at a time: each waiter
# claims a mutex directory, marks itself, and waits for the peer's mark. Under
# a correct lock the peer never enters, so the wait ends at its deadline with
# no mark and the mutex claim holds.
source "$WORK/helpers.zsh"
name=killed
dir="$TMUX_AGENT_DIR/$name-case"
mkdir -p "$dir"
start_holder "$dir" "$name"
trap 'touch "$dir/release"' EXIT

waiter() {
  local me="$1" peer="$2"
  send_lock_around "$name" 10 zsh -c '
    dir="$1"; me="$2"; peer="$3"
    mkdir "$dir/in-critical" 2>/dev/null || { echo "VIOLATION: $me entered while another waiter was inside" >> "$dir/violations"; exit 0; }
    touch "$dir/$me-in"
    for (( i = 0; i < 30; i++ )); do
      if [[ -e "$dir/$peer-in" ]]; then
        echo "VIOLATION: $me and $peer overlapped" >> "$dir/violations"
        break
      fi
      command sleep 0.01
    done
    touch "$dir/$me-done"
    rm "$dir/$me-in"
    rmdir "$dir/in-critical"
  ' _ "$dir" "$me" "$peer"
}
( waiter b c ) &
job_b=$!
( waiter c b ) &
job_c=$!

# The killed holder's critical-section child is orphaned and keeps running
# until release: the lock must be free without waiting for it to exit.
kill -9 "$(cat "$dir/holder.pid")"
wait "$holder_job" 2>/dev/null || true
wait "$job_b"
wait "$job_c"

[[ -e "$dir/b-done" && -e "$dir/c-done" ]] || { echo "a waiter never ran after the holder was killed" >&2; exit 1; }
if [[ -s "$dir/violations" ]]; then
  cat "$dir/violations" >&2
  exit 1
fi
BODY

cat > "$WORK/case-rc-missing-dir.zsh" <<'BODY'
# The inner return code comes back, and a missing <name> dir is created.
name=brand-new
[[ ! -e "$TMUX_AGENT_DIR/$name" ]] || { echo "precondition: dir should not exist" >&2; exit 1; }
set +e
send_lock_around "$name" 5 sh -c "exit 7"
rc=$?
set -e
[[ "$rc" -eq 7 ]] || { echo "expected rc=7 got $rc" >&2; exit 1; }
[[ -d "$TMUX_AGENT_DIR/$name" ]] || { echo "expected $name dir created" >&2; exit 1; }
BODY

mkdir -p "$WORK/state"
TMUX_AGENT_DIR="$WORK/state" TMUX_AGENT_TOOLS_SOURCE_ONLY=1 WORK="$WORK" ENGINE="$AGENT_TMUX" \
  zsh -c '
    set -euo pipefail
    set -- codex
    source "$ENGINE"
    for c in contended killed-holder rc-missing-dir; do
      echo "[$c] codex"
      ( source "$WORK/case-$c.zsh" ) || { echo "FAIL: $c" >&2; exit 1; }
    done
  ' || exit 1

echo "OK: send-lock smoke passed for agent-tmux codex."
