#!/usr/bin/env zsh
# Smoke test for issue #102 advisory send lock.
#
# Validates that `send_lock_around` in agent-tmux claude and codex:
#   - serializes concurrent acquirers on the same agent name
#   - recovers from a stale PID written into the lock dir
#   - retries mkdir when the lock dir vanishes during the no-pid wait
#   - tolerates a not-yet-existing $TMUX_AGENT_DIR/<name>
#   - exits with the inner command's return code
#
# The helper is sourced from agent-tmux via TMUX_AGENT_TOOLS_SOURCE_ONLY
# so we exercise the real implementation, not a copy. The cli launcher is
# `exec agent-tmux <cli>`; sourcing that replaces the shell and the
# source-only guard exits before the case body. The harness sources the
# engine with that <cli> name instead.
#
# Exits non-zero on the first failure.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CLAUDE_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" claude)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
CODEX_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" codex)"

WORK="$(mktemp -d -t tmux-agent-send-lock-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

# Each case is a zsh body written to a temp file. The wrapper is sourced
# by the harness so $send_lock_around / $ensure_agent_dir are in scope.
run_case() {
  local wrapper="$1" label="$2" body_file="$3"
  local cli
  cli="$(basename "$wrapper")"
  echo "[$label] $cli"
  local state_dir="$WORK/$label"
  mkdir -p "$state_dir"
  TMUX_AGENT_DIR="$state_dir" \
    TMUX_AGENT_TOOLS_SOURCE_ONLY=1 \
    ENGINE="$AGENT_TMUX" \
    CLI_NAME="$cli" \
    BODY="$body_file" \
    zsh -c '
      set -euo pipefail
      set -- "$CLI_NAME"
      source "$ENGINE"
      source "$BODY"
    ' || fail "$label on $cli"
}

# Case bodies -------------------------------------------------------------

cat > "$WORK/case-basic.zsh" <<'BODY'
sentinel="$TMUX_AGENT_DIR/basic-out"
send_lock_around basic 5 sh -c "echo ok > '$sentinel'"
[[ "$(cat "$sentinel")" == ok ]] || { echo "sentinel mismatch" >&2; exit 1; }
if [[ -d "$TMUX_AGENT_DIR/basic/send.lock.d" ]]; then
  echo "lock dir not cleaned up after success" >&2; exit 1
fi
BODY

cat > "$WORK/case-concurrent.zsh" <<'BODY'
out="$TMUX_AGENT_DIR/order.log"
: > "$out"
( send_lock_around concur 10 sh -c "echo A-start >> '$out'; sleep 1; echo A-end >> '$out'" ) &
pid_a=$!
sleep 0.2
( send_lock_around concur 10 sh -c "echo B-start >> '$out'; echo B-end >> '$out'" ) &
pid_b=$!
wait "$pid_a"
wait "$pid_b"
expected=$'A-start\nA-end\nB-start\nB-end'
actual="$(cat "$out")"
if [[ "$actual" != "$expected" ]]; then
  echo "order mismatch:" >&2
  echo "expected:" >&2; echo "$expected" >&2
  echo "actual:"   >&2; echo "$actual"   >&2
  exit 1
fi
BODY

cat > "$WORK/case-stale-pid.zsh" <<'BODY'
zmodload zsh/datetime 2>/dev/null || true
name=stale
mkdir -p "$TMUX_AGENT_DIR/$name"
lock_dir="$TMUX_AGENT_DIR/$name/send.lock.d"
mkdir "$lock_dir"
# Pick a PID essentially guaranteed dead (above MAX_PID on Linux/macOS).
dead_pid=2147483646
echo "$dead_pid" > "$lock_dir/pid"
# Force the mkdir fallback path by intercepting `command -v flock`.
command() {
  if [[ "$1" == "-v" && "$2" == "flock" ]]; then
    return 1
  fi
  builtin command "$@"
}
start="${EPOCHSECONDS:-$(date +%s)}"
send_lock_around "$name" 5 true
now="${EPOCHSECONDS:-$(date +%s)}"
elapsed=$(( now - start ))
if (( elapsed >= 3 )); then
  echo "stale lock recovery too slow: ${elapsed}s" >&2; exit 1
fi
BODY

cat > "$WORK/case-vanished-dir.zsh" <<'BODY'
# Holder created the lock dir and has not stamped a pid. During the wait
# the holder finishes and removes the dir. That is a release: retry mkdir.
# Removing the dir inside sleep is the wait itself, so the case does not
# depend on a timer.
name=vanish
mkdir -p "$TMUX_AGENT_DIR/$name"
lock_dir="$TMUX_AGENT_DIR/$name/send.lock.d"
mkdir "$lock_dir"
wait_hits=0
command() {
  if [[ "$1" == "-v" && "$2" == "flock" ]]; then
    return 1
  fi
  builtin command "$@"
}
sleep() {
  if [[ -d "$lock_dir" && ! -f "$lock_dir/pid" ]]; then
    wait_hits=$(( wait_hits + 1 ))
    rm -rf "$lock_dir" 2>/dev/null || true
  fi
  return 0
}
sentinel="$TMUX_AGENT_DIR/vanish-out"
set +e
send_lock_around "$name" 5 sh -c "echo ok > '$sentinel'"
rc=$?
set -e
if [[ "$rc" -eq 75 ]]; then
  echo "vanished lock dir returned 75 (treated as cannot create)" >&2
  exit 1
fi
[[ "$rc" -eq 0 ]] || { echo "expected rc=0 got $rc" >&2; exit 1; }
[[ "$wait_hits" -ge 1 ]] || { echo "no-pid wait did not run" >&2; exit 1; }
[[ "$(cat "$sentinel")" == ok ]] || { echo "sentinel mismatch" >&2; exit 1; }
if [[ -d "$lock_dir" ]]; then
  echo "lock dir not cleaned up after vanished-dir retry" >&2
  exit 1
fi
BODY

cat > "$WORK/case-missing-dir.zsh" <<'BODY'
name=brand-new
[[ ! -e "$TMUX_AGENT_DIR/$name" ]] || { echo "precondition: dir should not exist" >&2; exit 1; }
send_lock_around "$name" 5 true
[[ -d "$TMUX_AGENT_DIR/$name" ]] || { echo "expected $name dir created" >&2; exit 1; }
BODY

cat > "$WORK/case-rc.zsh" <<'BODY'
set +e
send_lock_around rc 5 sh -c "exit 7"
rc=$?
set -e
[[ "$rc" -eq 7 ]] || { echo "expected rc=7 got $rc" >&2; exit 1; }
BODY

cat > "$WORK/case-delayed-pid.zsh" <<'BODY'
# Holder creates lock dir and delays writing pid (>0.2s). Waiter must wait
# and NOT steal the lock or rm -rf the lock dir during the delay.
name=delayed-pid
mkdir -p "$TMUX_AGENT_DIR/$name"
lock_dir="$TMUX_AGENT_DIR/$name/send.lock.d"
mkdir "$lock_dir"
out="$TMUX_AGENT_DIR/delayed-out"
holder_err="$TMUX_AGENT_DIR/holder.err"
command() {
  if [[ "$1" == "-v" && "$2" == "flock" ]]; then
    return 1
  fi
  builtin command "$@"
}
(
  sleep 0.35
  if ! echo "$$" > "$lock_dir/pid" 2>"$holder_err"; then
    exit 1
  fi
  sleep 0.35
  rm -rf "$lock_dir"
) &
holder_pid=$!

sleep 0.05
send_lock_around "$name" 2 sh -c "echo acquired > '$out'"
wait "$holder_pid" || { echo "holder failed: lock dir was stolen or deleted" >&2; exit 1; }
[[ "$(cat "$out")" == acquired ]] || { echo "sentinel mismatch" >&2; exit 1; }
if [[ -d "$lock_dir" ]]; then
  echo "lock dir not cleaned up" >&2; exit 1
fi
BODY

for wrapper in "$CLAUDE_TMUX" "$CODEX_TMUX"; do
  tool="$(basename "$wrapper")"
  run_case "$wrapper" "$tool-basic"        "$WORK/case-basic.zsh"
  run_case "$wrapper" "$tool-concurrent"   "$WORK/case-concurrent.zsh"
  run_case "$wrapper" "$tool-stale-pid"    "$WORK/case-stale-pid.zsh"
  run_case "$wrapper" "$tool-vanished-dir" "$WORK/case-vanished-dir.zsh"
  run_case "$wrapper" "$tool-delayed-pid"  "$WORK/case-delayed-pid.zsh"
  run_case "$wrapper" "$tool-missing-dir"  "$WORK/case-missing-dir.zsh"
  run_case "$wrapper" "$tool-rc"           "$WORK/case-rc.zsh"
done

echo "OK: send-lock smoke passed for agent-tmux claude and codex."
