#!/usr/bin/env zsh
# The shared core (skills/tmux-agent-tools/scripts/lib/workers.ts) is run by plain
# node for every non-Claude host, so its contract is tested by plain node against
# an in-memory Host. The file is `*.contract.ts`, not `*.test.ts`: `claude plugin
# test` claims every `*.test.ts` in the plugin and refuses `node:` imports. It is
# kept out of tsconfig (no node typings there); running it is the check.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
cd "$SCRIPT_DIR/../skills/tmux-agent-tools/scripts/lib"

floor=22.18.0
have="$(node -p 'process.versions.node')"
if [[ "$(printf '%s\n%s\n' "$floor" "$have" | sort -V | head -1)" != "$floor" ]]; then
  echo "  FAIL node $have is below the core's floor $floor" >&2
  exit 1
fi

if out="$(node --test --test-reporter=tap workers.contract.ts 2>&1)"; then
  echo "  ok   core contract (node $have):$(print -r -- "$out" | rg -o '^# (pass|fail) \d+' | tr '\n' ' ' | sed 's/# / /g')"
  echo "1 passed, 0 failed"
else
  print -r -- "$out" >&2
  echo "  FAIL core contract tests (node $have)" >&2
  echo "0 passed, 1 failed" >&2
  exit 1
fi
