#!/usr/bin/env zsh
# Smoke test for issue #104 `tmux-agent-sessions watch` event subscribe mode.
# Deterministic: uses a fake tmux binary driven by call-count files instead of
# real session create/stop, so no race against wall-clock poll intervals.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

SESSIONS="$REPO_ROOT/skills/tmux-agent-tools/scripts/tmux-agent-sessions"

[[ -x "$SESSIONS" ]] || { echo "not executable: $SESSIONS" >&2; exit 1; }

WORK="$(mktemp -d -t tmux-agent-sessions-watch-smoke.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
export CLAUDE_TMUX_PREFIX="claude-cli"

cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT

PASS=0
FAIL=0

assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label" >&2
    echo "    needle:   $needle" >&2
    echo "    haystack: $haystack" >&2
    FAIL=$((FAIL + 1))
  fi
}

assert_eq() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label" >&2
    echo "    expected: $expected" >&2
    echo "    got:      $actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

# ---------------------------------------------------------------------------
# Fake tmux factory.
#
# make_fake_tmux <dir> <snap0> [<snap1> ...]
#   Creates $dir/tmux that returns snap0 on the first `ls` call, snap1 on
#   the second, etc.  After all snapshots are exhausted it repeats the last.
#   Each snapshot is a newline-separated list of "session-name: ..." lines
#   (the real `tmux ls` format).  Pass "" for an empty snapshot.
#   All other tmux subcommands (new-session, kill-session, …) are silently
#   ignored so callers that use tmux-agent-sessions watch-only don't need a
#   fully operational tmux.
# ---------------------------------------------------------------------------
make_fake_tmux() {
  local dir="$1"; shift
  local snap_dir="$dir/snaps"
  mkdir -p "$dir" "$snap_dir"
  local idx=0
  for snap in "$@"; do
    printf '%s\n' "$snap" > "$snap_dir/$idx"
    idx=$((idx + 1))
  done
  local count=$idx
  local counter_file="$dir/call_count"
  printf '0' > "$counter_file"

  local total=$count
  local last=$(( count - 1 ))
  cat > "$dir/tmux" <<SCRIPT
#!/usr/bin/env zsh
if [[ "\${1:-}" != "ls" ]]; then exit 0; fi
count=\$(cat "$counter_file")
snap_idx=\$(( count < $total ? count : $last ))
cat "$snap_dir/\$snap_idx" 2>/dev/null || true
printf '%d' \$(( count + 1 )) > "$counter_file"
SCRIPT
  chmod +x "$dir/tmux"
  print -r -- "$dir/tmux"
}

# ---------------------------------------------------------------------------
# case: --count 1 exits after one poll, first tick is silent
# ---------------------------------------------------------------------------
echo "case: --count 1 exits after one poll, first tick is silent"
FAKE_TMUX_DIR="$WORK/tmux1"
FAKE_TMUX="$(make_fake_tmux "$FAKE_TMUX_DIR" "")"
out1="$(TMUX="$FAKE_TMUX" "$SESSIONS" watch --count 1 --interval 0 --tool claude 2>&1 || true)"
assert_eq "first tick is silent (no prior snapshot)" "$out1" ""

# ---------------------------------------------------------------------------
# case: session_added emitted when new session appears between ticks
# Tick 1: empty  →  Tick 2: session present  →  event session_added
# ---------------------------------------------------------------------------
echo "case: session_added emitted when new session appears between ticks"
FAKE_TMUX_DIR2="$WORK/tmux2"
SESSION_NAME="claude-cli-watch-a"
FAKE_TMUX2="$(make_fake_tmux "$FAKE_TMUX_DIR2" \
  "" \
  "${SESSION_NAME}: 1 windows (created Mon Jan  1 00:00:00 2024) [80x24]")"
EVENTS_FILE="$WORK/events.jsonl"
TMUX="$FAKE_TMUX2" "$SESSIONS" watch --count 2 --interval 0 --tool claude > "$EVENTS_FILE" 2>&1

events_added="$(cat "$EVENTS_FILE")"
assert_contains "session_added event present"       "$events_added" '"event":"session_added"'
assert_contains "session_added carries name"         "$events_added" '"name":"watch-a"'
assert_contains "session_added carries schema_version" "$events_added" '"schema_version":1'
assert_contains "session_added carries tool"         "$events_added" '"tool":"claude"'

# ---------------------------------------------------------------------------
# case: two stable ticks produce zero events
# ---------------------------------------------------------------------------
echo "case: two stable ticks produce zero events"
FAKE_TMUX_DIR3="$WORK/tmux3"
FAKE_TMUX3="$(make_fake_tmux "$FAKE_TMUX_DIR3" \
  "${SESSION_NAME}: 1 windows (created Mon Jan  1 00:00:00 2024) [80x24]" \
  "${SESSION_NAME}: 1 windows (created Mon Jan  1 00:00:00 2024) [80x24]")"
out_silent="$(TMUX="$FAKE_TMUX3" "$SESSIONS" watch --count 2 --interval 0 --tool claude 2>&1)"
assert_eq "silent tick when nothing changes" "$out_silent" ""

# ---------------------------------------------------------------------------
# case: session ends -> session_state_changed and/or session_removed
# Tick 1: session present  →  Tick 2: empty  →  event session_removed
# ---------------------------------------------------------------------------
echo "case: session ends -> session_state_changed and/or session_removed"
FAKE_TMUX_DIR4="$WORK/tmux4"
FAKE_TMUX4="$(make_fake_tmux "$FAKE_TMUX_DIR4" \
  "${SESSION_NAME}: 1 windows (created Mon Jan  1 00:00:00 2024) [80x24]" \
  "")"
EVENTS_FILE2="$WORK/events2.jsonl"
TMUX="$FAKE_TMUX4" "$SESSIONS" watch --count 2 --interval 0 --tool claude > "$EVENTS_FILE2" 2>&1

events_stop="$(cat "$EVENTS_FILE2")"
if [[ "$events_stop" == *'"event":"session_state_changed"'* ]] || \
   [[ "$events_stop" == *'"event":"session_removed"'* ]]; then
  echo "  ok   stop produced state_changed or removed event"
  PASS=$((PASS + 1))
else
  echo "  FAIL stop produced no transition event" >&2
  echo "    got: $events_stop" >&2
  FAIL=$((FAIL + 1))
fi
assert_contains "stop event carries schema_version" "$events_stop" '"schema_version":1'

# ---------------------------------------------------------------------------
# case: --count 0 parses as unlimited (interrupt to bound runtime)
# ---------------------------------------------------------------------------
echo "case: --count 0 parses as unlimited (interrupt to bound runtime)"
FAKE_TMUX_DIR5="$WORK/tmux5"
FAKE_TMUX5="$(make_fake_tmux "$FAKE_TMUX_DIR5" "")"
TMUX="$FAKE_TMUX5" "$SESSIONS" watch --count 0 --interval 0 --tool claude > "$WORK/events3.jsonl" 2>&1 &
WATCH_PID=$!
/bin/sleep 1
kill "$WATCH_PID" 2>/dev/null || true
wait "$WATCH_PID" 2>/dev/null || true
echo "  ok   --count 0 starts and is interruptible"
PASS=$((PASS + 1))

# ---------------------------------------------------------------------------
# case: rejects bad --count
# ---------------------------------------------------------------------------
echo "case: rejects bad --count"
code=0
"$SESSIONS" watch --count abc 2>/dev/null || code=$?
if (( code != 0 )); then
  echo "  ok   bad --count rejected"
  PASS=$((PASS + 1))
else
  echo "  FAIL bad --count not rejected" >&2
  FAIL=$((FAIL + 1))
fi

echo
echo "summary: $PASS passed, $FAIL failed"
exit $(( FAIL > 0 ? 1 : 0 ))
