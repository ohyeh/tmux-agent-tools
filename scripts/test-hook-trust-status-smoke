#!/usr/bin/env zsh
# Smoke test for issue #283: `status --json` surfaces a plugin hook-trust prompt
# as confirmation_detected=true / blocked_reason=hook_trust_prompt, and does NOT
# false-trigger on ordinary "needs review" prose.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CODEX_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"

WORK="$(mktemp -d -t tmux-agent-hook-trust.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
trap 'rm -rf "$WORK"' EXIT

# Positive: pane shows a hook-trust prompt and stays alive.
cat > "$WORK/fake-trust.sh" <<'EOF'
#!/bin/sh
echo "1 hook needs review before this session can continue."
echo "Press t to trust the ponytail@ponytail SubagentStart hook."
while IFS= read -r line; do : ; done
EOF
chmod +x "$WORK/fake-trust.sh"

# Negative: ordinary prose containing "needs review" must NOT trigger.
cat > "$WORK/fake-prose.sh" <<'EOF'
#!/bin/sh
echo "The submitted pull request still needs review by a maintainer."
while IFS= read -r line; do : ; done
EOF
chmod +x "$WORK/fake-prose.sh"

cat > "$WORK/fake-mcp-login-warning.sh" <<'EOF'
#!/bin/sh
echo "The cloudflare-api MCP server is not logged in. Run codex mcp login cloudflare-api"
echo "› Write a prompt"
while IFS= read -r line; do : ; done
EOF
chmod +x "$WORK/fake-mcp-login-warning.sh"

cat > "$WORK/fake-scrollback-keywords-ready.sh" <<'EOF'
#!/bin/sh
i=1
while [ "$i" -le 76 ]; do
  echo "history $i"
  i=$((i + 1))
done
echo "commit summary: Fix Codex login prompt docs and detection; approval and permission prose only."
echo "more historical prose: please log in to codex is not the active prompt here."
echo "─ Worked for 1s ─"
echo "› Write a prompt"
while IFS= read -r line; do : ; done
EOF
chmod +x "$WORK/fake-scrollback-keywords-ready.sh"

cat > "$WORK/fake-permission.sh" <<'EOF'
#!/bin/sh
echo "Do you trust the contents of this directory?"
while IFS= read -r line; do echo "got:$line"; done
EOF
chmod +x "$WORK/fake-permission.sh"

cat > "$WORK/fake-permission-clears.sh" <<'EOF'
#!/bin/sh
echo "Do you trust the contents of this directory?"
if IFS= read -r answer; then
  echo "trusted:$answer"
fi
echo "› Write a prompt"
while IFS= read -r line; do echo "got:$line"; done
EOF
chmod +x "$WORK/fake-permission-clears.sh"

cat > "$WORK/fake-approval.sh" <<'EOF'
#!/bin/sh
echo "Approval required before continuing [y/n]"
while IFS= read -r line; do : ; done
EOF
chmod +x "$WORK/fake-approval.sh"

cat > "$WORK/fake-login.sh" <<'EOF'
#!/bin/sh
echo "Please log in to Codex to continue."
while IFS= read -r line; do : ; done
EOF
chmod +x "$WORK/fake-login.sh"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then echo "  ok   $label"; PASS=$((PASS + 1))
  else echo "  FAIL $label"; echo "    expected: $expected"; echo "    got:      $actual"; FAIL=$((FAIL + 1)); fi
}

assert_blocked_send_guard() {
  local label="$1" name="$2" marker="$3"
  shift 3
  local code=0 out json_line pane
  out="$("$@" 2>&1)" || code=$?
  json_line="${out##*$'\n'}"
  assert "$label blocked exit=1" "$code" "1"
  assert "$label blocked=true" "$(printf '%s' "$json_line" | jq -r .blocked)" "true"
  assert "$label submitted=false" "$(printf '%s' "$json_line" | jq -r .submitted)" "false"
  assert "$label blocked_reason permission_prompt" "$(printf '%s' "$json_line" | jq -r .blocked_reason)" "permission_prompt"
  assert "$label diagnostic non-null" "$(printf '%s' "$json_line" | jq -r '.diagnostic | type')" "string"
  pane="$(tmux capture-pane -J -t "codex-cli-$name" -p -S -80)"
  if [[ "$pane" == *"$marker"* ]]; then
    echo "  FAIL $label pasted text despite permission prompt" >&2
    FAIL=$((FAIL + 1))
  else
    echo "  ok   $label did not paste text before trust gate cleared"
    PASS=$((PASS + 1))
  fi
}

echo "case: hook-trust prompt detected"
P="hook-trust"
env CODEX="$WORK/fake-trust.sh" "$CODEX_TMUX" start --exact "$P" "$WORK" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$P")"
assert "confirmation_detected true" "$(printf '%s' "$st" | jq -r .confirmation_detected)" "true"
assert "blocked_reason hook_trust_prompt" "$(printf '%s' "$st" | jq -r .blocked_reason)" "hook_trust_prompt"
assert "diagnostic non-null" "$(printf '%s' "$st" | jq -r '.diagnostic | type')" "string"
"$CODEX_TMUX" stop "$P" >/dev/null 2>&1 || true

echo "case: ordinary 'needs review' prose is not a hook-trust prompt"
N="prose-review"
env CODEX="$WORK/fake-prose.sh" "$CODEX_TMUX" start --exact "$N" "$WORK" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$N")"
assert "no false hook_trust" "$(printf '%s' "$st" | jq -r '.blocked_reason // "null"')" "null"
assert "no false confirmation" "$(printf '%s' "$st" | jq -r .confirmation_detected)" "false"
"$CODEX_TMUX" stop "$N" >/dev/null 2>&1 || true

echo "case: unrelated MCP login warning with ready prompt is not blocked"
M="mcp-login-warning"
env CODEX="$WORK/fake-mcp-login-warning.sh" "$CODEX_TMUX" start --exact "$M" "$WORK" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$M")"
assert "no false login_prompt" "$(printf '%s' "$st" | jq -r '.blocked_reason // "null"')" "null"
assert "ready prompt not blocked" "$(printf '%s' "$st" | jq -r .confirmation_detected)" "false"
"$CODEX_TMUX" stop "$M" >/dev/null 2>&1 || true

echo "case: historical trigger keywords above current prompt are not blocked"
H="scrollback-ready"
env CODEX="$WORK/fake-scrollback-keywords-ready.sh" "$CODEX_TMUX" start --exact "$H" "$WORK" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$H")"
assert "historical triggers ignored" "$(printf '%s' "$st" | jq -r '.blocked_reason // "null"')" "null"
assert "current ready prompt not blocked" "$(printf '%s' "$st" | jq -r .confirmation_detected)" "false"
"$CODEX_TMUX" stop "$H" >/dev/null 2>&1 || true

echo "case: active approval prompt still blocks"
A="approval-current"
env CODEX="$WORK/fake-approval.sh" "$CODEX_TMUX" start --exact "$A" "$WORK" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$A")"
assert "approval confirmation_detected true" "$(printf '%s' "$st" | jq -r .confirmation_detected)" "true"
assert "blocked_reason approval_prompt" "$(printf '%s' "$st" | jq -r .blocked_reason)" "approval_prompt"
"$CODEX_TMUX" stop "$A" >/dev/null 2>&1 || true

echo "case: active Codex login prompt still blocks"
L="login-current"
env CODEX="$WORK/fake-login.sh" "$CODEX_TMUX" start --exact "$L" "$WORK" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$L")"
assert "login confirmation_detected true" "$(printf '%s' "$st" | jq -r .confirmation_detected)" "true"
assert "blocked_reason login_prompt" "$(printf '%s' "$st" | jq -r .blocked_reason)" "login_prompt"
"$CODEX_TMUX" stop "$L" >/dev/null 2>&1 || true

echo "case: start-time permission prompt blocks before initial prompt"
S="start-permission"
code=0
out="$(env CODEX="$WORK/fake-permission.sh" "$CODEX_TMUX" start --exact "$S" "$WORK" "must-not-send" 2>&1)" || code=$?
json_line="${out##*$'\n'}"
assert "start blocked exit=1" "$code" "1"
assert "start blocked submitted=false" "$(printf '%s' "$json_line" | jq -r .submitted)" "false"
assert "start blocked_reason permission_prompt" "$(printf '%s' "$json_line" | jq -r .blocked_reason)" "permission_prompt"
pane="$(tmux capture-pane -J -t "codex-cli-$S" -p -S -80)"
if [[ "$pane" == *"must-not-send"* ]]; then
  echo "  FAIL initial prompt was sent despite permission prompt" >&2
  FAIL=$((FAIL + 1))
else
  echo "  ok   initial prompt not sent before trust gate cleared"
  PASS=$((PASS + 1))
fi
"$CODEX_TMUX" stop "$S" >/dev/null 2>&1 || true

echo "case: send paths block active permission prompt after no-initial-text start"
B1="send-permission"
M1="must-not-send-plain"
env CODEX="$WORK/fake-permission.sh" "$CODEX_TMUX" start --exact "$B1" "$WORK" >/dev/null
sleep 1
assert_blocked_send_guard "send" "$B1" "$M1" "$CODEX_TMUX" send "$B1" "$M1"
"$CODEX_TMUX" stop "$B1" >/dev/null 2>&1 || true

B2="send-wait-permission"
M2="must-not-send-wait"
env CODEX="$WORK/fake-permission.sh" "$CODEX_TMUX" start --exact "$B2" "$WORK" >/dev/null
sleep 1
assert_blocked_send_guard "send-wait" "$B2" "$M2" "$CODEX_TMUX" send-wait "$B2" "$M2" 1
"$CODEX_TMUX" stop "$B2" >/dev/null 2>&1 || true

B3="send-wait-literal-permission"
M3="must-not-send-literal"
env CODEX="$WORK/fake-permission.sh" "$CODEX_TMUX" start --exact "$B3" "$WORK" >/dev/null
sleep 1
assert_blocked_send_guard "send-wait-literal" "$B3" "$M3" "$CODEX_TMUX" send-wait-literal "$B3" "$M3" "never-seen" 1
"$CODEX_TMUX" stop "$B3" >/dev/null 2>&1 || true

echo "case: send works after permission prompt is cleared"
C="send-permission-cleared"
CM="send-after-clear-marker"
env CODEX="$WORK/fake-permission-clears.sh" "$CODEX_TMUX" start --exact "$C" "$WORK" >/dev/null
sleep 1
"$CODEX_TMUX" send --raw --enter-count 1 "$C" "y" >/dev/null
sleep 1
st="$("$CODEX_TMUX" status --json "$C")"
assert "cleared prompt not blocked" "$(printf '%s' "$st" | jq -r '.blocked_reason // "null"')" "null"
"$CODEX_TMUX" send "$C" "$CM" >/dev/null
sleep 1
pane="$(tmux capture-pane -J -t "codex-cli-$C" -p -S -80)"
if [[ "$pane" == *"$CM"* ]]; then
  echo "  ok   send works after trust gate cleared"
  PASS=$((PASS + 1))
else
  echo "  FAIL send did not work after trust gate cleared" >&2
  FAIL=$((FAIL + 1))
fi
"$CODEX_TMUX" stop "$C" >/dev/null 2>&1 || true

echo "hook-trust-status smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
