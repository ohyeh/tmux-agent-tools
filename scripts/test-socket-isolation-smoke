#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
# Regression smoke for check-tmux-socket-isolation (findings N1, T1):
#   1. Clean repo passes socket isolation check
#   2. Unused decoy `const decoy = ['-S']` in wrapper body is rejected (N1)
#   3. Wrapper bodies exceeding 30 lines with real -S pass (T1)
#   4. Same-line decoy is rejected (R3)
#   5. A brace inside a string does not end the wrapper body (F4)
#   6. An argv declaration without a semicolon counts; an unused one does not (F5)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GUARD="$SCRIPT_DIR/check-tmux-socket-isolation"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

# 1. Clean repo passes
code=0
out="$("$GUARD" 2>&1)" || code=$?
assert "clean repo passes socket isolation check" "$code" 0

# 2. Finding N1: Unused decoy `const decoy = ['-S']` inside wrapper must fail
# Assemble server command dynamically so this smoke file does not trigger the guard.
b_srv() { printf '%s-%s' "kill" "server"; }
tmp_n1="$(mktemp "${TMPDIR:-/tmp}/n1_decoy.XXXXXX.contract.node.ts")"
cat <<EOF > "$tmp_n1"
function badWrapper(args) {
  const decoy = ["-S"]
  return execFile("tmux", args)
}
async function main() {
  badWrapper(["$(b_srv)"])
}
EOF

code=0
out="$("$GUARD" "$tmp_n1" 2>&1)" || code=$?
rm -f "$tmp_n1"
assert "unused decoy const decoy = ['-S'] is rejected (N1)" "$code" 1

# 3. Finding T1: Wrapper body > 30 lines with real -S passes
tmp_t1="$(mktemp "${TMPDIR:-/tmp}/t1_long.XXXXXX.contract.node.ts")"
{
  echo 'function longWrapper(args) {'
  for i in {1..35}; do
    echo "  const dummy$i = $i"
  done
  echo '  return execFile("tmux", ["-S", process.env.TMUX_TMPDIR + "/sock", ...args])'
  echo '}'
  echo 'async function main() {'
  echo "  longWrapper([\"$(b_srv)\"])"
  echo '}'
} > "$tmp_t1"

code=0
out="$("$GUARD" "$tmp_t1" 2>&1)" || code=$?
rm -f "$tmp_t1"
assert "wrapper body > 30 lines with real -S passes (T1)" "$code" 0

# 4. Finding R3: Line-level short-circuit with tmux and ['-S'] on same line must fail
tmp_r3="$(mktemp "${TMPDIR:-/tmp}/r3_line_decoy.XXXXXX.contract.node.ts")"
cat <<EOF > "$tmp_r3"
function badWrapperR3(args) {
  const note = "tmux ['-S']"
  return execFile("tmux", args)
}
async function main() {
  badWrapperR3(["$(b_srv)"])
}
EOF

code=0
out="$("$GUARD" "$tmp_r3" 2>&1)" || code=$?
rm -f "$tmp_r3"
assert "line-level short-circuit decoy is rejected (R3)" "$code" 1

# 5. Finding F4: a "}" inside a string must not end the wrapper body early
tmp_f4="$(mktemp "${TMPDIR:-/tmp}/f4_brace.XXXXXX.contract.node.ts")"
cat <<EOF > "$tmp_f4"
function safe(args) {
  const label = "}"
  return execFile("tmux", ["-S", process.env.TMUX_TMPDIR + "/sock", ...args])
}
safe(["$(b_srv)"])
EOF

code=0
out="$("$GUARD" "$tmp_f4" 2>&1)" || code=$?
rm -f "$tmp_f4"
assert "brace inside a string does not end the wrapper body (F4)" "$code" 0

# 6. Finding F5: argv declared without a semicolon passes; an unused one is rejected
tmp_f5="$(mktemp "${TMPDIR:-/tmp}/f5_asi.XXXXXX.contract.node.ts")"
cat <<EOF > "$tmp_f5"
function safe(args) {
  const argv = ["-S", process.env.TMUX_TMPDIR + "/sock", ...args]
  return execFile("tmux", argv)
}
safe(["$(b_srv)"])
EOF

code=0
out="$("$GUARD" "$tmp_f5" 2>&1)" || code=$?
rm -f "$tmp_f5"
assert "argv declared without a semicolon passes (F5)" "$code" 0

tmp_f5d="$(mktemp "${TMPDIR:-/tmp}/f5_asi_decoy.XXXXXX.contract.node.ts")"
cat <<EOF > "$tmp_f5d"
function unsafe(args) {
  const decoy = ["-S", process.env.TMUX_TMPDIR + "/sock"]
  const argv = [...args]
  return execFile("tmux", argv)
}
unsafe(["$(b_srv)"])
EOF

code=0
out="$("$GUARD" "$tmp_f5d" 2>&1)" || code=$?
rm -f "$tmp_f5d"
assert "unused decoy without a semicolon is rejected (F5)" "$code" 1

tmp_escape="$(mktemp "${TMPDIR:-/tmp}/socket-escape.XXXXXX.contract.node.ts")"
printf 'execFile("tmux", ["-S", "%s", "%s"])\n' /tmp/escape.sock "$(b_srv)" > "$tmp_escape"
code=0
out="$("$GUARD" "$tmp_escape" 2>&1)" || code=$?
rm -f "$tmp_escape"
assert "literal out-of-dir socket is rejected" "$code" 1

tmp_dir="$(mktemp "${TMPDIR:-/tmp}/socket-dir.XXXXXX.sh")"
printf 'export %s="/tmp/escape"\n' TMUX_TMPDIR > "$tmp_dir"
code=0
out="$("$GUARD" "$tmp_dir" 2>&1)" || code=$?
rm -f "$tmp_dir"
assert "smoke cannot replace the run directory" "$code" 1

echo "socket-isolation smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
