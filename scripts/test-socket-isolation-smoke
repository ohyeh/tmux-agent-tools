#!/usr/bin/env zsh
# Regression smoke for check-tmux-socket-isolation (findings N1, T1):
#   1. Clean repo passes socket isolation check
#   2. Unused decoy `const decoy = ['-S']` in wrapper body is rejected (N1)
#   3. Wrapper bodies exceeding 30 lines with real -S pass (T1)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GUARD="$SCRIPT_DIR/check-tmux-socket-isolation"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

# 1. Clean repo passes
code=0
out="$("$GUARD" 2>&1)" || code=$?
assert "clean repo passes socket isolation check" "$code" 0

# 2. Finding N1: Unused decoy `const decoy = ['-S']` inside wrapper must fail
# Assemble server command dynamically so this smoke file does not trigger the guard.
b_srv() { printf '%s-%s' "kill" "server"; }
tmp_n1="$(mktemp "${TMPDIR:-/tmp}/n1_decoy.XXXXXX.contract.node.ts")"
cat <<EOF > "$tmp_n1"
function badWrapper(args) {
  const decoy = ["-S"]
  return execFile("tmux", args)
}
async function main() {
  badWrapper(["$(b_srv)"])
}
EOF

code=0
out="$("$GUARD" "$tmp_n1" 2>&1)" || code=$?
rm -f "$tmp_n1"
assert "unused decoy const decoy = ['-S'] is rejected (N1)" "$code" 1

# 3. Finding T1: Wrapper body > 30 lines with real -S passes
tmp_t1="$(mktemp "${TMPDIR:-/tmp}/t1_long.XXXXXX.contract.node.ts")"
{
  echo 'function longWrapper(args) {'
  for i in {1..35}; do
    echo "  const dummy$i = $i"
  done
  echo '  return execFile("tmux", ["-S", "/tmp/sock", ...args])'
  echo '}'
  echo 'async function main() {'
  echo "  longWrapper([\"$(b_srv)\"])"
  echo '}'
} > "$tmp_t1"

code=0
out="$("$GUARD" "$tmp_t1" 2>&1)" || code=$?
rm -f "$tmp_t1"
assert "wrapper body > 30 lines with real -S passes (T1)" "$code" 0

echo "socket-isolation smoke: $PASS passed, $FAIL failed"
(( FAIL == 0 ))
