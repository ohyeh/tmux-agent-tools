#!/usr/bin/env zsh
# Smoke test for two assign defects seen live on 2026-09-25 (tmux-agent mod 0.7.6 e2e):
#
#  1. A workspace-trust dialog drawn AFTER assign sent the brief ate it (agy,
#     claude, claude-fable-gate on never-trusted dirs). assign must see the
#     dialog before sending, send nothing into it, never answer it, and leave
#     the brief whole for a resend once the caller has answered.
#  2. Every successful paste assign warned "result-path delivery UNCONFIRMED":
#     cursor-agent folds the paste into `[Pasted text #1 +24 lines]`, in its
#     transcript too, so the marker text never reaches the pane. A submitted
#     placeholder covering the whole payload is the proof; a short one is not.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"

WORK="$(mktemp -d -t tmux-agent-dialog.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
export AGENT_TMUX_PREFLIGHT_TIMEOUT=5
export TMUX_AGENT_TOOLS_AUDIT_LOG="$WORK/audit.jsonl"
export PATH="$WORK:$PATH"
cleanup() {
  "$AGENT_TMUX" trustcli stop trust-smoke >/dev/null 2>&1 || true
  "$AGENT_TMUX" bootcli stop boot-smoke >/dev/null 2>&1 || true
  "$AGENT_TMUX" foldcli stop fold-whole >/dev/null 2>&1 || true
  "$AGENT_TMUX" foldcli stop fold-short >/dev/null 2>&1 || true
  "$AGENT_TMUX" foldcli stop fold-oneline >/dev/null 2>&1 || true
  "$AGENT_TMUX" slowcli stop slow-smoke >/dev/null 2>&1 || true
  "$AGENT_TMUX" pickcli stop pick-trust >/dev/null 2>&1 || true
  "$AGENT_TMUX" pickcli stop pick-other >/dev/null 2>&1 || true
  AGENT_TMUX_PROFILE_DIR="$WORK/profiles" "$AGENT_TMUX" tailclaude stop tail-send >/dev/null 2>&1 || true
  AGENT_TMUX_PROFILE_DIR="$WORK/profiles" "$AGENT_TMUX" doneclaude stop done-turn >/dev/null 2>&1 || true
  "$AGENT_TMUX" updcli stop upd-smoke >/dev/null 2>&1 || true
  local n; for n in work-codex work-claude work-cursor work-frozen; do "$AGENT_TMUX" workcli stop "$n" >/dev/null 2>&1 || true; done
  rm -rf "$WORK"
}
trap cleanup EXIT

PASS=0; FAIL=0
assert() {
  local label="$1" got="$2" want="$3"
  if [[ "$got" == "$want" ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: got '$got' want '$want'"; FAIL=$((FAIL+1)); fi
}
assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: '$needle' not in output"; FAIL=$((FAIL+1)); fi
}
refute_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" != *"$needle"* ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: '$needle' is in output"; FAIL=$((FAIL+1)); fi
}

printf 'GOAL: prove the brief survives the dialog.\nACCEPTANCE: every line arrives.\nREPORT: say done.\n' > "$WORK/brief.txt"

# ---- case 1: the trust dialog comes up after boot -----------------------------
# trustcli boots for 2 s, then draws a trust dialog whose answer is the first
# line it reads — exactly how a paste that lands before the dialog is eaten.
# Paths arrive as launch flags: a running tmux server hands its own env to panes.
cat > "$WORK/trustcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "trustcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; *) shift ;; esac; done
echo "trustcli booting"
sleep 2
# On the alternate screen, as a TUI draws it: answered, the dialog is gone.
printf '\033[?1049hDo you trust the files in this folder?\n  1. Yes, proceed\n  2. No, exit\n'
IFS= read -r answer
printf '\033[?1049l'
printf 'dialog:%s\n' "$answer" >> "$LOG"
echo "> ready"
while IFS= read -r line; do printf 'input:%s\n' "$line" >> "$LOG"; printf 'got:%s\n' "$line"; done
EOF
chmod +x "$WORK/trustcli"

echo "case: a dialog drawn after boot is seen before the send, and nothing is sent into it"
LOG="$WORK/trust.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/trust-smoke"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG" \
  "$AGENT_TMUX" trustcli assign --timeout 60 --confirm-window 20 --detach \
    --prompt-delivery paste trust-smoke "$WORK" "$WORK/brief.txt" \
    >"$WORK/trust.out" 2>"$WORK/trust.err" || code=$?
assert "trust: assign failed" "$code" "1"
assert "trust: the failed step is send" "$(jq -r .failed_step "$WORK/trust.out" 2>/dev/null)" "send"
assert_contains "trust: the diagnostic says the brief was not sent" "$(jq -r .diagnostic "$WORK/trust.out" 2>/dev/null)" "the brief was NOT sent"
assert_contains "trust: it names the dialog" "$(jq -r .diagnostic "$WORK/trust.out" 2>/dev/null)" "permission_prompt"
assert "trust: the dialog got no input from assign" "$(cat "$LOG")" ""

# The caller answers the dialog, then resends: the whole brief arrives.
code=0; "$AGENT_TMUX" trustcli send --key enter trust-smoke >"$WORK/key.out" 2>&1 || code=$?
assert "trust: the caller's Enter was sent ($(tail -1 "$WORK/key.out"))" "$code" "0"
# As a caller would (peek): resend once the dialog is gone.
for _ in {1..20}; do
  [[ "$("$AGENT_TMUX" trustcli status --json trust-smoke 2>/dev/null | jq -r '.blocked_reason // empty')" == "" ]] && break
  sleep 0.5
done
code=0; "$AGENT_TMUX" trustcli send --from-file "$WORK/brief.txt" trust-smoke >"$WORK/resend.out" 2>&1 || code=$?
assert "trust: the resend was sent ($(tail -1 "$WORK/resend.out"))" "$code" "0"
sleep 2
got="$(cat "$LOG")"
assert "trust: the dialog was answered by the caller's key, with no brief text" "$(grep '^dialog:' "$LOG")" "dialog:"
assert_contains "trust: the brief's first line arrived" "$got" "input:GOAL: prove the brief survives the dialog."
assert_contains "trust: the brief's last line arrived" "$got" "input:REPORT: say done."
"$AGENT_TMUX" trustcli stop trust-smoke >/dev/null 2>&1 || true

# ---- case 1b: startup screen outlasts the look window, then a dialog ---------
# "Verifying your account" is startup_pending. It lasts longer than the 10s
# look, then the pane clears and a trust dialog follows 1s later. The look
# window must start over, or the brief is pasted into that dialog.
cat > "$WORK/bootcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "bootcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; *) shift ;; esac; done
printf '\033[?1049hVerifying your account eligibility\n'
sleep 12
printf '\033[2J\033[H> ready\n'
sleep 1
printf '\033[2J\033[HDo you trust the files in this folder?\n  1. Yes, proceed\n'
IFS= read -r answer
printf 'dialog:%s\n' "$answer" >> "$LOG"
EOF
chmod +x "$WORK/bootcli"

echo
echo "case: a startup screen longer than the look window, then a dialog, gets no brief"
LOG="$WORK/boot.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/boot-smoke"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG" \
  "$AGENT_TMUX" bootcli assign --timeout 60 --confirm-window 20 --detach \
    --prompt-delivery paste boot-smoke "$WORK" "$WORK/brief.txt" \
    >"$WORK/boot.out" 2>"$WORK/boot.err" || code=$?
assert "boot: assign failed" "$code" "1"
assert "boot: the failed step is send" "$(jq -r .failed_step "$WORK/boot.out" 2>/dev/null)" "send"
assert_contains "boot: the diagnostic says the brief was not sent" "$(jq -r .diagnostic "$WORK/boot.out" 2>/dev/null)" "the brief was NOT sent"
assert "boot: the dialog got no input from assign" "$(cat "$LOG")" ""
"$AGENT_TMUX" bootcli stop boot-smoke >/dev/null 2>&1 || true

# ---- case 1c: a workspace-trust dialog is trusted, any other dialog is not ----
# pickcli draws a dialog with its cursor on option 1, as claude does, and takes
# the first line it reads as the answer. --other asks a non-trust question.
cat > "$WORK/pickcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "pickcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null; RES=""; ASK="Do you trust the files in this folder?"
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; --result) RES="$2"; shift 2 ;; --other) ASK="Do you want to proceed with rm -rf build?"; shift ;; *) shift ;; esac; done
sleep 1
printf '\033[?1049h%s\n\xe2\x9d\xaf 1. Yes, proceed\n  2. No, exit\n' "$ASK"
IFS= read -r answer
printf '\033[?1049l'
printf 'dialog:%s\n' "$answer" >> "$LOG"
echo "> ready"
while IFS= read -r line; do
  printf 'input:%s\n' "$line" >> "$LOG"
  [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"picked","artifacts":[],"errors":[]}\n' > "$RES"
done
EOF
chmod +x "$WORK/pickcli"

echo
echo "case: a workspace-trust dialog is answered with Enter, then the brief is sent"
LOG="$WORK/pick.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/pick-trust"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG --result $TMUX_AGENT_DIR/pick-trust/result.json" \
  "$AGENT_TMUX" pickcli assign --timeout 60 --confirm-window 30 --detach \
    --prompt-delivery paste pick-trust "$WORK" "$WORK/brief.txt" \
    >"$WORK/pick.out" 2>"$WORK/pick.err" || code=$?
assert "pick: assign confirmed the worker" "$code" "0"
assert_contains "pick: assign says it trusted the dir" "$(cat "$WORK/pick.err")" "workspace trust dialog — trusting"
assert "pick: the dialog got a bare Enter, no brief text" "$(grep '^dialog:' "$LOG")" "dialog:"
assert_contains "pick: the brief arrived after the dialog" "$(cat "$LOG")" "input:GOAL: prove the brief survives the dialog."
"$AGENT_TMUX" pickcli stop pick-trust >/dev/null 2>&1 || true

echo
echo "case: a dialog that is not a workspace trust is never answered"
LOG="$WORK/pick2.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/pick-other"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG --other" \
  "$AGENT_TMUX" pickcli assign --timeout 60 --confirm-window 20 --detach \
    --prompt-delivery paste pick-other "$WORK" "$WORK/brief.txt" \
    >"$WORK/pick2.out" 2>"$WORK/pick2.err" || code=$?
assert "other: assign failed" "$code" "1"
assert_contains "other: the brief was not sent" "$(jq -r .diagnostic "$WORK/pick2.out" 2>/dev/null)" "the brief was NOT sent"
assert "other: the dialog got no input from assign" "$(cat "$LOG")" ""
"$AGENT_TMUX" pickcli stop pick-other >/dev/null 2>&1 || true

# ---- case 2: the CLI folds the paste into a placeholder ----------------------
# foldcli reads one paste burst, draws `[Pasted text #1 +N lines]` (N = lines
# read, or --show N), writes its result and returns to an empty composer.
cat > "$WORK/foldcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "foldcli 1.0"; exit 0; }
stty -echo 2>/dev/null
RES=""; SHOW=""; SHORT=""
while [ $# -gt 0 ]; do case "$1" in --result) RES="$2"; shift 2 ;; --show) SHOW="$2"; shift 2 ;; --short) SHORT="$2"; shift 2 ;; *) shift ;; esac; done
echo "> ready"
while IFS= read -r line; do
  n=1
  while IFS= read -r -t 1 line; do n=$((n+1)); done
  show="${SHOW:-$n}"
  [ -n "$SHORT" ] && show=$((n - SHORT))
  printf '  [Pasted text #1 +%s lines]\n' "$show"
  [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"folded","artifacts":[],"errors":[]}\n' > "$RES"
  printf '> \n'
done
EOF
chmod +x "$WORK/foldcli"

fold_assign() {  # <name> [extra launch flags]
  mkdir -p "$TMUX_AGENT_DIR/$1"
  code=0
  AGENT_TMUX_LAUNCH_FLAGS="--result $TMUX_AGENT_DIR/$1/result.json ${2:-}" \
    "$AGENT_TMUX" foldcli assign --timeout 60 --confirm-window 30 --detach \
      --prompt-delivery paste "$1" "$WORK" "$WORK/brief.txt" \
      >"$WORK/$1.out" 2>"$WORK/$1.err" || code=$?
}

echo
echo "case: a folded paste that covers the whole payload confirms both instructions"
fold_assign fold-whole
assert "fold: assign confirmed the worker" "$code" "0"
refute_contains "fold: no UNCONFIRMED warning" "$(cat "$WORK/fold-whole.err")" "UNCONFIRMED"
assert "fold: result-path instruction recorded as landed" \
  "$([[ -e "$TMUX_AGENT_DIR/fold-whole/.result-path-injected" ]] && echo yes || echo no)" "yes"
assert "fold: scope-guard instruction recorded as landed" \
  "$([[ -e "$TMUX_AGENT_DIR/fold-whole/scope-guard-injected" ]] && echo yes || echo no)" "yes"
"$AGENT_TMUX" foldcli stop fold-whole >/dev/null 2>&1 || true

echo
echo "case: a placeholder shorter than the payload is no proof, and the warning stays"
fold_assign fold-short "--show 2"
assert "short: assign confirmed the worker" "$code" "0"
assert_contains "short: the warning is kept" "$(cat "$WORK/fold-short.err")" "WARNING: result-path delivery UNCONFIRMED"
assert "short: result-path instruction not recorded" \
  "$([[ -e "$TMUX_AGENT_DIR/fold-short/.result-path-injected" ]] && echo yes || echo no)" "no"
"$AGENT_TMUX" foldcli stop fold-short >/dev/null 2>&1 || true

echo
echo "case: a placeholder one line short of the payload is not accepted"
fold_assign fold-oneline "--short 1"
assert "oneline: assign confirmed the worker" "$code" "0"
assert_contains "oneline: the warning is kept" "$(cat "$WORK/fold-oneline.err")" "WARNING: result-path delivery UNCONFIRMED"
assert "oneline: result-path instruction not recorded" \
  "$([[ -e "$TMUX_AGENT_DIR/fold-oneline/.result-path-injected" ]] && echo yes || echo no)" "no"
"$AGENT_TMUX" foldcli stop fold-oneline >/dev/null 2>&1 || true

# ---- case 2b: a CLI that draws nothing while it boots ------------------------
# Live 2026-09-25, cursor-agent: the pane sat still under the launcher header
# while node booted, the brief was pasted there, and the TUI kept it unsent.
# slowcli is silent for 15 s with the tty echo on, then logs any input already
# waiting (stale) before it reads.
cat > "$WORK/slowcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "slowcli 1.0"; exit 0; }
LOG=/dev/null; RES=""
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; --result) RES="$2"; shift 2 ;; *) shift ;; esac; done
sleep 15
stty -echo 2>/dev/null
while IFS= read -r -t 1 s; do printf 'stale:%s\n' "$s" >> "$LOG"; done
echo "> ready"
while IFS= read -r line; do
  printf 'input:%s\n' "$line" >> "$LOG"
  [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"slow","artifacts":[],"errors":[]}\n' > "$RES"
done
EOF
chmod +x "$WORK/slowcli"

echo
echo "case: a CLI that draws nothing while it boots gets the brief only after it draws"
LOG="$WORK/slow.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/slow-smoke"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG --result $TMUX_AGENT_DIR/slow-smoke/result.json" \
  "$AGENT_TMUX" slowcli assign --timeout 60 --confirm-window 30 --detach \
    --prompt-delivery paste slow-smoke "$WORK" "$WORK/brief.txt" \
    >"$WORK/slow.out" 2>"$WORK/slow.err" || code=$?
assert "slow: assign confirmed the worker" "$code" "0"
refute_contains "slow: nothing was pasted before the CLI drew" "$(cat "$LOG")" "stale:"
assert_contains "slow: the brief arrived after the draw" "$(cat "$LOG")" "input:GOAL: prove the brief survives the dialog."
"$AGENT_TMUX" slowcli stop slow-smoke >/dev/null 2>&1 || true

# ---- case 2c: a send whose markers never show waits one window, not two ------
# Live 2026-09-25: claude shows only the tail of a long message, so neither
# injected line reached the pane and send looked 10 s for each: 22.6 s a tell.
# foldcli never echoes the text; as a claude-family profile its markers are polled.
mkdir -p "$WORK/profiles"
printf 'bin=%s\nheuristic_family=claude\n' "$WORK/foldcli" > "$WORK/profiles/tailclaude.conf"
echo
echo "case: a send with two unseen markers spends one look window"
AGENT_TMUX_PROFILE_DIR="$WORK/profiles" "$AGENT_TMUX" tailclaude start --exact tail-send "$WORK" >/dev/null 2>&1
sleep 2
t0=$SECONDS
AGENT_TMUX_PROFILE_DIR="$WORK/profiles" "$AGENT_TMUX" tailclaude send --from-file "$WORK/brief.txt" tail-send >"$WORK/tail.out" 2>"$WORK/tail.err" || true
took=$(( SECONDS - t0 ))
assert "tail: both instructions are still reported unconfirmed" "$(grep -c 'delivery UNCONFIRMED' "$WORK/tail.err")" "2"
assert "tail: the send took under 16 s (took ${took}s; two windows is 20 s+)" "$(( took < 16 ))" "1"
AGENT_TMUX_PROFILE_DIR="$WORK/profiles" "$AGENT_TMUX" tailclaude stop tail-send >/dev/null 2>&1 || true

# ---- case 2d: a turn that finished before two looks is processing --------------
# Live 2026-09-25: claude answered in 9 s; its counter showed between two looks
# only, the pane went idle, and the brief was sent again. donecli answers each
# line with claude's finished-turn line and nothing else.
cat > "$WORK/donecli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "donecli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; *) shift ;; esac; done
echo "❯ "
while IFS= read -r line; do
  printf 'input:%s\n' "$line" >> "$LOG"
  printf '\n⏺ done\n\n✻ Sautéed for 2s · done 9:38 PM\n\n❯ \n'
done
EOF
chmod +x "$WORK/donecli"
printf 'bin=%s\nheuristic_family=claude\n' "$WORK/donecli" > "$WORK/profiles/doneclaude.conf"
echo
echo "case: a claude turn that finished between looks confirms, with no resend (C locale caller)"
LOG="$WORK/done.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/done-turn"
code=0
# LC_ALL=C: a caller with no UTF-8 locale (launchd, cron) made `✻` a byte class.
LC_ALL=C AGENT_TMUX_PROFILE_DIR="$WORK/profiles" AGENT_TMUX_LAUNCH_FLAGS="--log $LOG" \
  "$AGENT_TMUX" doneclaude assign --timeout 60 --confirm-window 30 --detach done-turn "$WORK" "$WORK/brief.txt" \
    >"$WORK/done.out" 2>"$WORK/done.err" || code=$?
assert "done: assign confirmed the worker" "$code" "0"
assert_contains "done: the finished turn confirmed it" "$(cat "$WORK/done.err")" "finished a turn since the send"
refute_contains "done: no resend" "$(cat "$WORK/done.err")" "resending"
assert_contains "done: the claude family got the file-ref line" "$(cat "$LOG")" "input:Your task is in the file"
AGENT_TMUX_PROFILE_DIR="$WORK/profiles" "$AGENT_TMUX" doneclaude stop done-turn >/dev/null 2>&1 || true

# ---- case 3: a self-update menu at boot --------------------------------------
# Live 2026-09-25, codex 0.156.1: the send's Enter chose "1. Update now", which
# ran an unapproved `curl … | sh` install and the CLI exited. updcli draws that
# menu and takes the first line it reads as the answer.
cat > "$WORK/updcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "updcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; *) shift ;; esac; done
printf '\033[?1049h'
printf '  Update available · 0.156.1 → 0.157.0\n\n'
printf "  › 1. Update now (runs \`sh -c 'curl -fsSL https://example.invalid/install.sh | sh'\`)\n"
printf '    2. Skip\n    3. Skip until next version\n\n  enter continue · esc skip\n'
IFS= read -r answer
printf 'dialog:%s\n' "$answer" >> "$LOG"
EOF
chmod +x "$WORK/updcli"

echo
echo "case: an update menu at boot gets no brief and no key"
LOG="$WORK/upd.log"; : > "$LOG"
mkdir -p "$TMUX_AGENT_DIR/upd-smoke"
code=0
AGENT_TMUX_LAUNCH_FLAGS="--log $LOG" \
  "$AGENT_TMUX" updcli assign --timeout 60 --confirm-window 20 --detach \
    --prompt-delivery paste upd-smoke "$WORK" "$WORK/brief.txt" \
    >"$WORK/upd.out" 2>"$WORK/upd.err" || code=$?
assert "update: assign failed" "$code" "1"
assert "update: the failed step is send" "$(jq -r .failed_step "$WORK/upd.out" 2>/dev/null)" "send"
assert_contains "update: the diagnostic names update_prompt" "$(jq -r .diagnostic "$WORK/upd.out" 2>/dev/null)" "update_prompt"
assert_contains "update: the diagnostic says the brief was not sent" "$(jq -r .diagnostic "$WORK/upd.out" 2>/dev/null)" "the brief was NOT sent"
assert "update: the menu got no input from assign" "$(cat "$LOG")" ""
"$AGENT_TMUX" updcli stop upd-smoke >/dev/null 2>&1 || true

# ---- case 4: a worker that is processing but never shows the brief -----------
# Live 2026-09-25: codex 0.157.0 queued the brief as a one-line preview of the
# injected first line, and claude folded it; neither showed the brief's first
# line, so confirm-processing called both launch-failed and pasted the brief a
# second time. workcli reads the paste, then redraws an elapsed counter every
# second (--frozen: once) and never echoes the brief. Every line read is logged.
cat > "$WORK/workcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "workcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null; SHAPE=codex; FROZEN=""
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; --shape) SHAPE="$2"; shift 2 ;; --frozen) FROZEN=1; shift ;; *) shift ;; esac; done
idle() {
  if [ "$SHAPE" = codex ]; then printf '› Ask Codex to do anything\n  GPT-6-Astra medium · agent-scripts\n'
  elif [ "$SHAPE" = cursor ]; then printf ' → Add a follow-up                ctrl+c to stop\n  [Claude Opus 5.5 300K Medium]\n'
  else printf '❯\n[Opus 5.5 ◔ medium] │ github/tmux-agent-tools git:(main* ↑3)\n'; fi
}
draw() {
  printf '\033[2J\033[H'
  if [ "$SHAPE" = codex ]; then
    printf '• Working (%dm %02ds • esc to interrupt)\n' $(($1 / 60)) $(($1 % 60))
    printf '• Messages to be submitted after next tool call (press esc to interrupt and send immediately)\n'
    printf '  ↳ Write final JSON to this exact path: …/result.json\n'
  elif [ "$SHAPE" = cursor ]; then
    printf ' ⠘⠤ Reading  %d.%dk tokens\n    Tip: Use subagents to parallelize work.\n' $(($1 / 10)) $(($1 % 10))
  else
    printf '● Orbiting… (%ds · ↓ 1.4k tokens · thinking with medium effort)\n' "$1"
  fi
  idle
}
printf '\033[?1049h'; idle
IFS= read -r line; printf 'input:%s\n' "$line" >> "$LOG"
if [ -n "$FROZEN" ]; then draw 27
else ( s=180; while :; do draw "$s"; s=$((s + 1)); sleep 1; done ) & fi
while IFS= read -r line; do printf 'input:%s\n' "$line" >> "$LOG"; done
EOF
chmod +x "$WORK/workcli"

work_assign() {  # <name> <launch flags>
  mkdir -p "$TMUX_AGENT_DIR/$1"; : > "$WORK/$1.log"
  code=0
  AGENT_TMUX_LAUNCH_FLAGS="--log $WORK/$1.log $2" \
    "$AGENT_TMUX" workcli assign --timeout 60 --confirm-window 30 --detach \
      --prompt-delivery paste "$1" "$WORK" "$WORK/brief.txt" \
      >"$WORK/$1.out" 2>"$WORK/$1.err" || code=$?
}
brief_count() { grep -c '^input:GOAL: prove the brief survives the dialog.' "$WORK/$1.log" || true; }

for shape in codex claude cursor; do
  echo
  echo "case: a $shape pane whose elapsed counter moves is processing"
  work_assign "work-$shape" "--shape $shape"
  assert "$shape: assign confirmed the worker" "$code" "0"
  refute_contains "$shape: no resend" "$(cat "$WORK/work-$shape.err")" "resending once"
  assert "$shape: the brief arrived exactly once" "$(brief_count "work-$shape")" "1"
  "$AGENT_TMUX" workcli stop "work-$shape" >/dev/null 2>&1 || true
done

echo
echo "case: a failed confirm never resends while an elapsed counter is on screen"
work_assign work-frozen "--shape claude --frozen"
assert "frozen: assign failed" "$code" "1"
assert "frozen: the failed step is confirm-processing" "$(jq -r .failed_step "$WORK/work-frozen.out" 2>/dev/null)" "confirm-processing"
refute_contains "frozen: no resend" "$(cat "$WORK/work-frozen.err")" "resending once"
assert "frozen: the brief arrived exactly once" "$(brief_count work-frozen)" "1"
"$AGENT_TMUX" workcli stop work-frozen >/dev/null 2>&1 || true

echo
echo "summary: $PASS passed, $FAIL failed"
(( FAIL == 0 )) || exit 1
echo "PASS: assign dialog smoke"
