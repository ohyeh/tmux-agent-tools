#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke test for what assign does with the screen before and after its send
# (assign defects seen live 2026-09-25, tmux-agent mod 0.7.6 e2e):
#
#  1. A dialog drawn AFTER a long startup screen ate the brief. One real
#     integration keeps the 12 s startup: it must outlast assign's 10 s look
#     window (agent-tmux _ASSIGN_SEND_LOOK), which must start over once that
#     screen is gone. The other screens draw at once and need no wait: a
#     workspace-trust dialog is answered with Enter, any other dialog and a
#     self-update menu get no key and no brief.
#  2. A CLI that folds a paste into `[Pasted text #1 +N lines]`: a SUBMITTED
#     placeholder covering the whole payload proves delivery, a short one does
#     not. (An UNSENT placeholder still in the composer is a different
#     condition: test-dispatch-delivery-smoke.)
#  3. Processing signals that never show the brief: a moving elapsed counter
#     and a finished-turn line confirm; a frozen counter fails with no resend.
# All launches run concurrently and are asserted afterwards.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"

WORK="$(mktemp -d "$TMPDIR/work.XXXXXX")"
export TMUX_AGENT_DIR="$WORK/state"
export AGENT_TMUX_PREFLIGHT_TIMEOUT=5
export TMUX_AGENT_TOOLS_AUDIT_LOG="$WORK/audit.jsonl"
export AGENT_TMUX_PROFILE_DIR="$WORK/profiles"
export PATH="$WORK:$PATH"
# smoke-tmux.sh kills this run's tmux server, and with it every worker.
trap 'rm -rf "$WORK"' EXIT

PASS=0; FAIL=0
assert() {
  local label="$1" got="$2" want="$3"
  if [[ "$got" == "$want" ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: got '$got' want '$want'"; FAIL=$((FAIL+1)); fi
}
assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: '$needle' not in output"; FAIL=$((FAIL+1)); fi
}
refute_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" != *"$needle"* ]]; then print -r -- "  ok   $label"; PASS=$((PASS+1))
  else print -r -- "  FAIL $label: '$needle' is in output"; FAIL=$((FAIL+1)); fi
}
exists() { [[ -e "$1" ]] && echo yes || echo no; }

printf 'GOAL: prove the brief survives the dialog.\nMODEL: none — isolated transport fixture\nACCEPTANCE: every line arrives.\nREPORT: say done.\n' > "$WORK/brief.txt"
mkdir -p "$WORK/profiles"

# Every fake takes its paths as launch flags (a running tmux server hands its
# own env to new panes) and logs each line it reads to --log.

# bootcli: "Verifying your account" (startup_pending) for 12 s, a ready line,
# then a trust dialog 1 s later with no cursor glyph — not a workspace trust
# assign may answer. The first line read is the dialog's answer.
cat > "$WORK/bootcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "bootcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; *) shift ;; esac; done
printf '\033[?1049hVerifying your account eligibility\n'
sleep 12
printf '\033[2J\033[H> ready\n'
sleep 1
printf '\033[2J\033[HDo you trust the files in this folder?\n  1. Yes, proceed\n'
IFS= read -r answer
printf 'dialog:%s\n' "$answer" >> "$LOG"
EOF

# screencli: draws one screen at once and logs every line it reads.
#   --screen pick   workspace trust with the cursor on option 1 (claude)
#   --screen other  a non-trust question in the same shape
#   --screen update codex's self-update menu (Enter runs an installer)
# After the first line (the dialog's answer) it shows a ready prompt and
# writes --result on the next line it reads.
cat > "$WORK/screencli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "screencli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null; RES=""; SCREEN=pick
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; --result) RES="$2"; shift 2 ;; --screen) SCREEN="$2"; shift 2 ;; *) shift ;; esac; done
printf '\033[?1049h'
case "$SCREEN" in
  pick)  printf 'Do you trust the files in this folder?\n\xe2\x9d\xaf 1. Yes, proceed\n  2. No, exit\n' ;;
  other) printf 'Do you want to proceed with rm -rf build?\n\xe2\x9d\xaf 1. Yes, proceed\n  2. No, exit\n' ;;
  update)
    printf '  Update available · 0.156.1 → 0.157.0\n\n'
    printf "  › 1. Update now (runs \`sh -c 'curl -fsSL https://example.invalid/install.sh | sh'\`)\n"
    printf '    2. Skip\n    3. Skip until next version\n\n  enter continue · esc skip\n' ;;
esac
IFS= read -r answer
printf '\033[?1049l'
printf 'dialog:%s\n' "$answer" >> "$LOG"
echo "> ready"
while IFS= read -r line; do
  printf 'input:%s\n' "$line" >> "$LOG"
  [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"picked","artifacts":[],"errors":[]}\n' > "$RES"
done
EOF

# foldcli: reads one paste burst, draws `[Pasted text #1 +N lines]` in its
# transcript (N = lines read, minus --short), writes --result and returns to
# an empty composer: a submitted placeholder.
cat > "$WORK/foldcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "foldcli 1.0"; exit 0; }
stty -echo 2>/dev/null
RES=""; SHORT=0
while [ $# -gt 0 ]; do case "$1" in --result) RES="$2"; shift 2 ;; --short) SHORT="$2"; shift 2 ;; *) shift ;; esac; done
echo "> ready"
while IFS= read -r line; do
  n=1
  while IFS= read -r -t 1 line; do n=$((n+1)); done
  printf '  [Pasted text #1 +%s lines]\n' $((n - SHORT))
  [ -n "$RES" ] && printf '{"schema_version":1,"status":"success","summary":"folded","artifacts":[],"errors":[]}\n' > "$RES"
  printf '> \n'
done
EOF

# workcli: reads the paste, then redraws an elapsed counter (--frozen: once)
# in a codex / claude / cursor shape, and never echoes the brief.
cat > "$WORK/workcli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "workcli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null; SHAPE=codex; FROZEN=""
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; --shape) SHAPE="$2"; shift 2 ;; --frozen) FROZEN=1; shift ;; *) shift ;; esac; done
idle() {
  if [ "$SHAPE" = codex ]; then printf '› Ask Codex to do anything\n  GPT-6-Astra medium · agent-scripts\n'
  elif [ "$SHAPE" = cursor ]; then printf ' → Add a follow-up                ctrl+c to stop\n  [Claude Opus 5.5 300K Medium]\n'
  else printf '❯\n[Opus 5.5 ◔ medium] │ github/tmux-agent-tools git:(main* ↑3)\n'; fi
}
draw() {
  printf '\033[2J\033[H'
  if [ "$SHAPE" = codex ]; then
    printf '• Working (%dm %02ds • esc to interrupt)\n' $(($1 / 60)) $(($1 % 60))
    printf '• Messages to be submitted after next tool call (press esc to interrupt and send immediately)\n'
    printf '  ↳ Write final JSON to this exact path: …/result.json\n'
  elif [ "$SHAPE" = cursor ]; then
    printf ' ⠘⠤ Reading  %d.%dk tokens\n    Tip: Use subagents to parallelize work.\n' $(($1 / 10)) $(($1 % 10))
  else
    printf '● Orbiting… (%ds · ↓ 1.4k tokens · thinking with medium effort)\n' "$1"
  fi
  idle
}
printf '\033[?1049h'; idle
IFS= read -r line; printf 'input:%s\n' "$line" >> "$LOG"
if [ -n "$FROZEN" ]; then draw 27
else ( s=180; while :; do draw "$s"; s=$((s + 1)); sleep 0.5; done ) & fi
while IFS= read -r line; do printf 'input:%s\n' "$line" >> "$LOG"; done
EOF

# donecli: answers each line with claude's finished-turn line and nothing else.
cat > "$WORK/donecli" <<'EOF'
#!/bin/bash
[ "$1" = "--version" ] && { echo "donecli 1.0"; exit 0; }
stty -echo 2>/dev/null
LOG=/dev/null
while [ $# -gt 0 ]; do case "$1" in --log) LOG="$2"; shift 2 ;; *) shift ;; esac; done
echo "❯ "
while IFS= read -r line; do
  printf 'input:%s\n' "$line" >> "$LOG"
  printf '\n⏺ done\n\n✻ Sautéed for 2s · done 9:38 PM\n\n❯ \n'
done
EOF
chmod +x "$WORK"/bootcli "$WORK"/screencli "$WORK"/foldcli "$WORK"/workcli "$WORK"/donecli
printf 'bin=%s\nheuristic_family=claude\n' "$WORK/donecli" > "$WORK/profiles/doneclaude.conf"

# ---- concurrent launches ----------------------------------------------------
typeset -A PIDS
launch() {  # <name> <cli> <launch flags> <assign flags...>: background assign --detach
  local n="$1" cli="$2" flags="$3"; shift 3
  mkdir -p "$TMUX_AGENT_DIR/$n"; : > "$WORK/$n.log"
  AGENT_TMUX_LAUNCH_FLAGS="--log $WORK/$n.log $flags" \
    "$AGENT_TMUX" "$cli" assign --detach "$@" "$n" "$WORK" "$WORK/brief.txt" \
    >"$WORK/$n.out" 2>"$WORK/$n.err" &
  PIDS[$n]="$!"
}
collect() {  # <name>: sets code to the assign exit
  code=0; wait "${PIDS[$1]}" || code=$?
}
RES() { print -r -- "--result $TMUX_AGENT_DIR/$1/result.json"; }

# Failing cases fail before the confirm window; it is fixed so a regression ends fast.
launch boot bootcli "" --timeout 8 --confirm-window 5 --prompt-delivery paste
launch pick screencli "--screen pick $(RES pick)" --timeout 8 --confirm-window 5 --prompt-delivery paste
launch other screencli "--screen other" --timeout 8 --confirm-window 5 --prompt-delivery paste
launch upd screencli "--screen update" --timeout 8 --confirm-window 5 --prompt-delivery paste
launch fold-whole foldcli "$(RES fold-whole)" --timeout 8 --confirm-window 5 --prompt-delivery paste
launch fold-oneline foldcli "$(RES fold-oneline) --short 1" --timeout 8 --confirm-window 5 --prompt-delivery paste
# The mod always assigns with --result-path; the sentinel records only the default path.
launch rp-whole foldcli "$(RES rp-whole)" --timeout 8 --confirm-window 5 --prompt-delivery paste \
  --result-path "$WORK/rp-whole-ep1.json"
launch rp-short foldcli "$(RES rp-short) --short 1" --timeout 8 --confirm-window 5 --prompt-delivery paste \
  --result-path "$WORK/rp-short-ep1.json"
# A moving counter needs two looks 3 s apart inside the window; under the full
# suite a look can take over 2 s, and a 5 s window then fits only one. 15 s fits four
# and stays under assign's 20 s floor, so only the counter can confirm.
for shape in codex claude cursor; do
  launch "work-$shape" workcli "--shape $shape" --timeout 8 --confirm-window 15 --prompt-delivery paste
done
launch work-frozen workcli "--shape claude --frozen" --timeout 8 --confirm-window 3 --prompt-delivery paste
# LC_ALL=C: a caller with no UTF-8 locale (launchd, cron) made `✻` a byte class.
LC_ALL=C launch done doneclaude "" --timeout 8 --confirm-window 5
# A send whose two markers never show spends ONE look window, not two (live
# 2026-09-25: claude shows only the tail of a long message, 22.6 s a tell).
# foldcli never echoes; as a claude-family paste profile its markers are polled.
printf 'bin=%s\nheuristic_family=claude\nprompt_delivery=paste\n' "$WORK/foldcli" > "$WORK/profiles/tailclaude.conf"
(
  "$AGENT_TMUX" tailclaude start --exact tail-send "$WORK" >/dev/null 2>&1
  for _ in {1..40}; do "$AGENT_TMUX" tailclaude capture --strip-ansi tail-send 2>/dev/null | grep -q '> ready' && break; sleep 0.05; done
  t0=$SECONDS
  "$AGENT_TMUX" tailclaude send --from-file "$WORK/brief.txt" tail-send >/dev/null 2>"$WORK/tail.err" || true
  echo $(( SECONDS - t0 )) > "$WORK/tail.took"
) &
PIDS[tail]="$!"

brief_count() { grep -c '^input:GOAL: prove the brief survives the dialog.' "$WORK/$1.log" || true; }
diag() { jq -r .diagnostic "$WORK/$1.out" 2>/dev/null; }

echo "case: a workspace-trust dialog is answered with Enter, then the brief is sent"
collect pick
assert "pick: assign confirmed the worker" "$code" "0"
assert_contains "pick: assign says it trusted the dir" "$(cat "$WORK/pick.err")" "workspace trust dialog — trusting"
assert "pick: the dialog got a bare Enter, no brief text" "$(grep '^dialog:' "$WORK/pick.log")" "dialog:"
assert_contains "pick: the brief arrived after the dialog" "$(cat "$WORK/pick.log")" "input:GOAL: prove the brief survives the dialog."

echo
echo "case: a dialog that is not a workspace trust is never answered"
collect other
assert "other: assign failed" "$code" "1"
assert "other: the failed step is send" "$(jq -r .failed_step "$WORK/other.out" 2>/dev/null)" "send"
assert_contains "other: the brief was not sent" "$(diag other)" "the brief was NOT sent"
assert_contains "other: it names the dialog" "$(diag other)" "permission_prompt"
assert "other: the dialog got no input from assign" "$(cat "$WORK/other.log")" ""

echo
echo "case: an update menu at boot gets no brief and no key"
collect upd
assert "update: assign failed" "$code" "1"
assert "update: the failed step is send" "$(jq -r .failed_step "$WORK/upd.out" 2>/dev/null)" "send"
assert_contains "update: the diagnostic names update_prompt" "$(diag upd)" "update_prompt"
assert_contains "update: the brief was not sent" "$(diag upd)" "the brief was NOT sent"
assert "update: the menu got no input from assign" "$(cat "$WORK/upd.log")" ""

echo
echo "case: a submitted placeholder covering the whole payload confirms both instructions"
collect fold-whole
assert "fold: assign confirmed the worker" "$code" "0"
refute_contains "fold: no UNCONFIRMED warning" "$(cat "$WORK/fold-whole.err")" "UNCONFIRMED"
refute_contains "fold: a submitted placeholder needs no composer nudge" "$(cat "$WORK/fold-whole.err")" "composer nudge"
assert "fold: result-path instruction recorded as landed" "$(exists "$TMUX_AGENT_DIR/fold-whole/.result-path-injected")" "yes"
assert "fold: scope-guard instruction recorded as landed" "$(exists "$TMUX_AGENT_DIR/fold-whole/scope-guard-injected")" "yes"

echo
echo "case: a placeholder one line short of the payload is no proof, and the warning stays"
collect fold-oneline
assert "oneline: assign confirmed the worker" "$code" "0"
assert_contains "oneline: the warning is kept" "$(cat "$WORK/fold-oneline.err")" "WARNING: result-path delivery UNCONFIRMED"
assert "oneline: result-path instruction not recorded" "$(exists "$TMUX_AGENT_DIR/fold-oneline/.result-path-injected")" "no"

echo
echo "case: --result-path delivered and proven: no warning"
collect rp-whole
assert "rp: assign confirmed the worker" "$code" "0"
refute_contains "rp: no result-path warning" "$(cat "$WORK/rp-whole.err")" "result-path delivery UNCONFIRMED"

echo
echo "case: --result-path not proven: the warning names that path and a plain send"
collect rp-short
assert "rp-short: assign confirmed the worker" "$code" "0"
assert_contains "rp-short: the warning names the episode path" "$(cat "$WORK/rp-short.err")" "told $WORK/rp-short-ep1.json"
assert_contains "rp-short: the warning says send, not tell" "$(cat "$WORK/rp-short.err")" "in a plain \`agent-tmux foldcli send\`"

for shape in codex claude cursor; do
  echo
  echo "case: a $shape pane whose elapsed counter moves is processing"
  collect "work-$shape"
  assert "$shape: assign confirmed the worker" "$code" "0"
  assert_contains "$shape: the moving counter confirmed it" "$(cat "$WORK/work-$shape.err")" "an elapsed counter is moving"
  refute_contains "$shape: no resend" "$(cat "$WORK/work-$shape.err")" "resending once"
  assert "$shape: the brief arrived exactly once" "$(brief_count "work-$shape")" "1"
done

echo
echo "case: a failed confirm never resends while an elapsed counter is on screen"
collect work-frozen
assert "frozen: assign failed" "$code" "1"
assert "frozen: the failed step is confirm-processing" "$(jq -r .failed_step "$WORK/work-frozen.out" 2>/dev/null)" "confirm-processing"
refute_contains "frozen: no resend" "$(cat "$WORK/work-frozen.err")" "resending once"
assert "frozen: the brief arrived exactly once" "$(brief_count work-frozen)" "1"

echo
echo "case: a claude turn that finished between looks confirms, with no resend (C locale caller)"
collect done
assert "done: assign confirmed the worker" "$code" "0"
assert_contains "done: the finished turn confirmed it" "$(cat "$WORK/done.err")" "finished a turn since the send"
refute_contains "done: no resend" "$(cat "$WORK/done.err")" "resending"
assert_contains "done: the claude family got the file-ref line" "$(cat "$WORK/done.log")" "input:Your task is in the file"

echo
echo "case: a send with two unseen markers spends one look window"
collect tail
took="$(cat "$WORK/tail.took" 2>/dev/null || echo 99)"
assert "tail: both instructions are still reported unconfirmed" "$(grep -c 'delivery UNCONFIRMED' "$WORK/tail.err" || true)" "2"
# 19, not 16: a slow macOS runner took 16 s for one window; two windows is still 20 s+.
assert "tail: the send took under 19 s (took ${took}s; two windows is 20 s+)" "$(( took < 19 ))" "1"

echo
echo "case: a startup screen longer than the look window, then a dialog, gets no brief"
collect boot
assert "boot: assign failed" "$code" "1"
assert "boot: the failed step is send" "$(jq -r .failed_step "$WORK/boot.out" 2>/dev/null)" "send"
assert_contains "boot: the diagnostic says the brief was not sent" "$(diag boot)" "the brief was NOT sent"
assert "boot: the dialog got no input from assign" "$(cat "$WORK/boot.log")" ""

echo
echo "summary: $PASS passed, $FAIL failed"
(( FAIL == 0 )) || exit 1
echo "PASS: assign dialog smoke"
