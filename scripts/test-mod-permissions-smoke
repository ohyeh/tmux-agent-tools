#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
# The mod's permission surface is a contract with whoever installs it: the
# events it hooks, the engine calls it makes, the env it reads and writes. The
# community's first reaction to function-hook mods was to scan them for exactly
# this (r/ClaudeCode, 2026-09-15), so a change here must be a visible diff in a
# reviewed file, never a side effect of a refactor.
#
# `claude plugin validate` derives that surface from the source. This smoke
# pins its output to mods/tmux-agent/permissions.txt: a drift FAILS and prints
# the diff; an intended change is committed by refreshing the file with
# `scripts/test-mod-permissions-smoke --update`.
#
# Also type-checks the mod and the node core: `claude plugin validate` and `claude
# plugin test` do NOT, and v0.3.0 shipped four tsc errors past both (an omitted
# required argument, an unassignable render child, two malformed ConfigRow mocks).
# It runs the TypeScript pinned in mcp-adapter: npx would download it into each job's HOME.
# The mod's own suite (`claude plugin test`) is its own release lane, not a smoke.
#
# CLAUDE_BIN names the real Claude Code binary when a stub `claude` shadows it
# on PATH (some smokes put sleep-stubs on PATH).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

CLAUDE="${CLAUDE_BIN:-claude}"
MOD=mods/tmux-agent
PINNED="$MOD/permissions.txt"

pass=0
fail=0
ok()   { echo "  ok   $1"; pass=$((pass + 1)); }
bad()  { echo "  FAIL $1" >&2; fail=$((fail + 1)); }

if ! command -v "$CLAUDE" >/dev/null 2>&1; then
  bad "Claude Code binary not found ($CLAUDE); set CLAUDE_BIN"
  echo "$pass passed, $fail failed" >&2
  exit 1
fi
if ! "$CLAUDE" plugin validate --help </dev/null >/dev/null 2>&1; then
  bad "$CLAUDE is not a Claude Code that knows 'plugin validate' (a stub on PATH?) — set CLAUDE_BIN"
  echo "$pass passed, $fail failed" >&2
  exit 1
fi

actual="$(mktemp "${TMPDIR:-/tmp}/mod-permissions.XXXXXX")"
trap 'rm -f "$actual"' EXIT
# Only the derived surface lines; the header carries an absolute path.
# Capture first: under pipefail a failing validate or a grep with no match
# would abort here, before the diagnostic below.
vout="$("$CLAUDE" plugin validate "$MOD" </dev/null 2>&1 || true)"
printf '%s\n' "$vout" | grep '❯' | sed 's/^[[:space:]]*❯ //' > "$actual" || true
if [[ ! -s "$actual" ]]; then
  bad "plugin validate printed no surface lines"
  printf '%s\n' "$vout" >&2
  echo "$pass passed, $fail failed" >&2
  exit 1
fi

if [[ "${1:-}" == "--update" ]]; then
  cp "$actual" "$PINNED"
  echo "  wrote $PINNED"
fi

if [[ ! -f "$PINNED" ]]; then
  bad "$PINNED missing — run: scripts/test-mod-permissions-smoke --update"
elif diff -u "$PINNED" "$actual"; then
  ok "permission surface matches $PINNED"
else
  bad "permission surface drifted from $PINNED (diff above). Intended? Review, then --update"
fi

# The mod config covers hooks/lib, the mod's byte-identical copy of the non-node core
# files (scripts/sync-mod-core --check). The node-run core files (`lib/*.node.ts`) get
# their own config with @types/node from mcp-adapter.
# The copy that ships with mcp-adapter first; `tsc` on PATH only when it is absent.
# The floor: tsc 5.0.2 rejects target es2023.
autoload -Uz is-at-least
tsc_bin=mcp-adapter/node_modules/.bin/tsc
[[ -x "$tsc_bin" ]] || tsc_bin="$(command -v tsc 2>/dev/null || true)"
tsc_ver="$([[ -n "$tsc_bin" ]] && "$tsc_bin" -v 2>/dev/null | sed -n 's/^Version //p' || true)"
if [[ -z "$tsc_bin" || ! -d mcp-adapter/node_modules/@types/node ]]; then
  bad "typescript or @types/node missing: run npm --prefix mcp-adapter ci"
elif ! is-at-least 5.6.3 "${tsc_ver:-0}"; then
  bad "tsc $tsc_bin is ${tsc_ver:-unknown}; need >= 5.6.3 (run npm --prefix mcp-adapter ci)"
else
  echo "  tsc: $tsc_bin ($tsc_ver)"
  for cfg in $MOD/tsconfig.json tsconfig.node.json; do
    if "$tsc_bin" --noEmit -p "$cfg"; then ok "typecheck clean: $cfg"
    else bad "typecheck errors in $cfg (above)"; fi
  done
fi

echo "$pass passed, $fail failed"
[[ $fail -eq 0 ]]
