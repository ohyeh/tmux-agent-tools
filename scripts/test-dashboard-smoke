#!/usr/bin/env zsh
# Smoke for issue #123 v1 dashboard JSON snapshot.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DASH="$REPO_ROOT/skills/tmux-agent-tools/scripts/tmux-agent-dashboard"
AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
CODEX_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" codex)"

WORK="$(mktemp -d -t tmux-agent-dash-smoke.XXXXXX)"
export TMUX_AGENT_DIR="$WORK/state"
trap 'rm -rf "$WORK"' EXIT

cat > "$WORK/fake.sh" <<'EOF'
#!/bin/sh
sleep 30
EOF
chmod +x "$WORK/fake.sh"

PASS=0
FAIL=0
assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"; PASS=$((PASS + 1))
  else
    echo "  FAIL $label expected=$expected got=$actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

echo "case: empty snapshot shape"
out="$("$DASH" 2>&1)"
assert "schema_version=1" "$(printf '%s' "$out" | jq -r .schema_version)" "1"
assert "totals.total numeric" "$(printf '%s' "$out" | jq -r '.totals.total | type')" "number"
assert "sessions array" "$(printf '%s' "$out" | jq -r '.sessions | type')" "array"

echo "case: snapshot includes started session"
CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact dash-test "$WORK" >/dev/null
/bin/sleep 1
out="$("$DASH" 2>&1)"
total="$(printf '%s' "$out" | jq -r '.totals.total')"
if (( total >= 1 )); then
  echo "  ok   total >= 1 after start (got $total)"; PASS=$((PASS + 1))
else
  echo "  FAIL total expected >=1, got $total" >&2; FAIL=$((FAIL + 1))
fi
"$CODEX_TMUX" stop dash-test >/dev/null 2>&1 || true

echo "case: snapshot includes ledger-enriched session"
mkdir -p "$WORK/state/.v3/dash-worker/episodes/1"
now_ms="$(perl -MTime::HiRes=time -e 'printf "%d\n", time()*1000')"
jq -n \
  --arg profile codex --arg name dash-worker --arg dir "$WORK" \
  --argjson since "$now_ms" --arg owner me --arg ownerCwd "$WORK" \
  '{profile:$profile,name:$name,dir:$dir,since:$since,owner:$owner,ownerCwd:$ownerCwd,origin:"assign"}' \
  > "$WORK/state/.v3/dash-worker/worker.json"
jq -n \
  --arg profile codex --arg name dash-worker --arg dir "$WORK" \
  --argjson since "$now_ms" --arg owner me --arg goal "dash test" \
  --arg resultPath "$WORK/state/.v3/dash-worker/result.json" \
  '{seq:1,since:$since,owner:$owner,goal:$goal,resultPath:$resultPath,origin:"launch"}' \
  > "$WORK/state/.v3/dash-worker/episodes/1/dispatch.json"
touch "$WORK/state/.v3/dash-worker/episodes/1/sent"
CODEX="$WORK/fake.sh" "$CODEX_TMUX" start --exact dash-worker "$WORK" >/dev/null
/bin/sleep 1
out="$("$DASH" 2>&1)"
worker_name="$(printf '%s' "$out" | jq -r '.sessions[] | select(.name=="dash-worker") | .worker.name // empty')"
assert "ledger-enriched entry has worker.name" "$worker_name" "dash-worker"
"$CODEX_TMUX" stop dash-worker >/dev/null 2>&1 || true

echo "case: --watch --count 1 exits"
out="$("$DASH" --watch --count 1 --interval 1 2>&1)"
lines="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
if (( lines >= 1 )); then
  echo "  ok   --count 1 emitted ($lines lines)"; PASS=$((PASS + 1))
else
  echo "  FAIL --count 1 emitted nothing" >&2; FAIL=$((FAIL + 1))
fi

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
