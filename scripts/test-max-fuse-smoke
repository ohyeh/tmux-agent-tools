#!/usr/bin/env zsh
. "$(cd "$(dirname "$0")" && pwd)/lib/smoke-home-guard.sh"  # never the real HOME (2026-10-09 home-deletion incident)
source "$(cd "$(dirname "${(%):-%x}")" && pwd)/lib/smoke-tmux.sh"
# Smoke test for issue #105 safety fuses (--max-runtime / --max-idle).
#
# Two real trips run side by side: --max-runtime 1 (with --max-idle set too:
# runtime wins) proves fuse -> sentinel 124 + reason + on-exit hook, and
# --max-idle 1 on the silent fake proves reason=max_idle. stop kills a live watcher.
# --max-runtime / --max-idle values are no-launch fixtures.
#
# Exits non-zero on the first failure. Run from any cwd; the script
# resolves the in-tree wrapper paths automatically.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

AGENT_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/agent-tmux"
CODEX_TMUX="$("$REPO_ROOT/scripts/lib/cli-launcher" codex)"

WORK="$(mktemp -d "$TMPDIR/fuse.XXXXXX")"
export TMUX_AGENT_DIR="$WORK/state"
export CODEX="$WORK/fake-sleep.sh"
trap 'rm -rf "$WORK"' EXIT

# Fake CLI that sleeps a long time so only the fuse can stop it.
cat > "$WORK/fake-sleep.sh" <<'EOF'
#!/bin/sh
sleep 600
EOF
cat > "$WORK/hook.sh" <<'EOF'
#!/bin/sh
printf 'hook: code=%s name=%s reason=%s\n' \
  "${ON_EXIT_CODE:-MISSING}" "${ON_EXIT_NAME:-MISSING}" "${ON_EXIT_REASON:-MISSING}"
EOF
chmod +x "$WORK/fake-sleep.sh" "$WORK/hook.sh"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label (got='$actual' expected='$expected')" >&2
    FAIL=$((FAIL + 1))
  fi
}

# wait_until <cmd...>: poll 0.05 s, bound 4 s (the watcher ticks every 1 s: a 1 s fuse trips at 1-2 s).
wait_until() {
  local i
  for (( i = 0; i < 80; i++ )); do "$@" && return 0; sleep 0.05; done
  return 1
}

echo "case: --max-runtime trips: sentinel 124, reason, hook; --max-idle trips"
idle_sentinel="$WORK/idle.exit"
"$CODEX_TMUX" start --exact --sentinel "$idle_sentinel" --max-idle 1 fuse-idle "$WORK" >/dev/null
sentinel="$WORK/runtime.exit"
"$CODEX_TMUX" start --exact --sentinel "$sentinel" --on-exit "$WORK/hook.sh" \
  --max-runtime 1 --max-idle 30 fuse-rt "$WORK" >/dev/null
wait_until test -s "$sentinel.hook.log" || true
assert "sentinel code" "$(cat "$sentinel" 2>/dev/null)" "124"
assert "sentinel reason (runtime fires before idle)" "$(cat "$sentinel.reason" 2>/dev/null)" "max_runtime"
assert "hook log line" "$(head -n1 "$sentinel.hook.log" 2>/dev/null)" "hook: code=124 name=fuse-rt reason=max_runtime"
"$CODEX_TMUX" stop fuse-rt >/dev/null 2>&1 || true
wait_until test -s "$idle_sentinel.reason" || true
assert "idle sentinel code" "$(cat "$idle_sentinel" 2>/dev/null)" "124"
assert "idle sentinel reason" "$(cat "$idle_sentinel.reason" 2>/dev/null)" "max_idle"
"$CODEX_TMUX" stop fuse-idle >/dev/null 2>&1 || true

echo "case: stop kills a live watcher"
"$CODEX_TMUX" start --exact --max-runtime 300 fuse-stop "$WORK" >/dev/null
pid_file="$TMUX_AGENT_DIR/fuse-stop/fuse.pid"
pid="$(cat "$pid_file" 2>/dev/null || true)"
assert "fuse.pid written at start" "$([[ "$pid" == <-> ]] && echo yes || echo no)" "yes"
"$CODEX_TMUX" stop fuse-stop >/dev/null 2>&1 || true
dead() { ! kill -0 "$pid" 2>/dev/null; }
if [[ -n "$pid" ]] && ! wait_until dead; then alive=alive; kill "$pid" 2>/dev/null || true; else alive=dead; fi
assert "watcher dead after stop" "$alive" "dead"
assert "fuse.pid cleaned up" "$([[ -f "$pid_file" ]] && echo present || echo absent)" "absent"

echo "case: fuse values (no launch)"
for row in "--max-runtime foo" "--max-idle foo" "--max-runtime 0" "--max-idle"; do
  rc=0; "$CODEX_TMUX" start --exact ${=row} fuse-bad "$WORK" >/dev/null 2>&1 || rc=$?
  assert "$row rejected" "$rc" "2"
done
rc=0; "$CODEX_TMUX" start --exact --dry-run --max-runtime 5 --max-idle 3 fuse-dry "$WORK" >/dev/null 2>&1 || rc=$?
assert "valid values pass a dry-run" "$rc" "0"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
