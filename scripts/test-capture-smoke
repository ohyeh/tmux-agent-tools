#!/usr/bin/env zsh
# Smoke test for issue #96 token-efficient capture variants.
#
# Exercises --strip-ansi / --since-marker / --json against synthetic
# panes that emit known content. No real Claude / Codex required.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CODEX_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/codex-tmux"
CLAUDE_TMUX="$REPO_ROOT/skills/tmux-agent-tools/scripts/claude-tmux"

for wrapper in "$CODEX_TMUX" "$CLAUDE_TMUX"; do
  if [[ ! -x "$wrapper" ]]; then
    echo "wrapper not executable: $wrapper" >&2
    exit 1
  fi
done

WORK="$(mktemp -d -t tmux-agent-capture-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT

# Synthetic CLI: emits a colored line + a literal marker + two follow-up
# lines, then sleeps so the pane remains capturable.
cat > "$WORK/fake-content.sh" <<'EOF'
#!/bin/sh
# #135 extended strip-ansi: emit one example of every escape category so
# the smoke can verify all are stripped under --strip-ansi.
#   CSI/SGR: \033[31m ... \033[0m
#   OSC (BEL-terminated):  \033]0;TITLE\007
#   OSC (ST-terminated):   \033]8;;https://example.com\033\\link\033]8;;\033\\
#   DCS:                   \033PHIDE\033\\
#   APC:                   \033_APPLE\033\\
#   PM:                    \033^PRIVATE\033\\
#   SOS:                   \033XSTART\033\\
printf '\033[31mRED-LINE\033[0m\n'
printf '\033]0;OSC-TITLE\007OSC-AFTER\n'
printf '\033]8;;https://example.com\033\\OSC8-VISIBLE\033]8;;\033\\\n'
printf '\033PHIDE-DCS\033\\DCS-AFTER\n'
printf '\033_APC-HIDDEN\033\\APC-AFTER\n'
printf '\033^PM-HIDDEN\033\\PM-AFTER\n'
printf '\033XSOS-HIDDEN\033\\SOS-AFTER\n'
printf 'MARKER-CAP\nafter1\nafter2\n'
sleep 30
EOF
chmod +x "$WORK/fake-content.sh"

PASS=0
FAIL=0

assert() {
  local label="$1" actual="$2" expected="$3"
  if [[ "$actual" == "$expected" ]]; then
    echo "  ok   $label"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label" >&2
    echo "    expected: $expected" >&2
    echo "    got:      $actual" >&2
    FAIL=$((FAIL + 1))
  fi
}

assert_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" == *"$needle"* ]]; then
    echo "  ok   $label (contains '$needle')"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label (missing '$needle')" >&2
    echo "    haystack head: $(printf '%s' "$haystack" | head -2)" >&2
    FAIL=$((FAIL + 1))
  fi
}

assert_not_contains() {
  local label="$1" haystack="$2" needle="$3"
  if [[ "$haystack" != *"$needle"* ]]; then
    echo "  ok   $label (does not contain '$needle')"
    PASS=$((PASS + 1))
  else
    echo "  FAIL $label (unexpected '$needle')" >&2
    FAIL=$((FAIL + 1))
  fi
}

run_capture_variants() {
  local wrapper="$1" cli_env="$2" prefix="$3"
  echo "case: $prefix ($wrapper)"
  env "$cli_env=$WORK/fake-content.sh" "$wrapper" start --exact \
    "$prefix" "$WORK" >/dev/null
  sleep 2

  local raw_output strip_output since_output json_output

  raw_output="$("$wrapper" capture "$prefix" 20 2>&1)"
  assert_contains "$prefix raw includes marker" "$raw_output" "MARKER-CAP"
  assert_contains "$prefix raw includes after2" "$raw_output" "after2"

  strip_output="$("$wrapper" capture --strip-ansi "$prefix" 20 2>&1)"
  # The literal escape introducer (\x1b[31m) must be absent after stripping.
  # Use printf so the comparison is exact even if tmux renders colors.
  assert_not_contains "$prefix --strip-ansi removes ESC[31m" "$strip_output" "$(printf '\033[31m')"
  assert_contains "$prefix --strip-ansi keeps body" "$strip_output" "RED-LINE"

  # #135 extended strip categories. Each escape introducer must be absent
  # while the visible payload around it must survive.
  assert_not_contains "$prefix strip removes OSC introducer" "$strip_output" "$(printf '\033]')"
  assert_not_contains "$prefix strip removes DCS introducer" "$strip_output" "$(printf '\033P')"
  assert_not_contains "$prefix strip removes APC introducer" "$strip_output" "$(printf '\033_')"
  assert_not_contains "$prefix strip removes PM introducer"  "$strip_output" "$(printf '\033^')"
  assert_not_contains "$prefix strip removes SOS introducer" "$strip_output" "$(printf '\033X')"
  assert_contains "$prefix strip keeps OSC-AFTER body"  "$strip_output" "OSC-AFTER"
  assert_contains "$prefix strip keeps OSC8-VISIBLE body" "$strip_output" "OSC8-VISIBLE"
  assert_contains "$prefix strip keeps DCS-AFTER body"  "$strip_output" "DCS-AFTER"
  assert_contains "$prefix strip keeps APC-AFTER body"  "$strip_output" "APC-AFTER"
  assert_contains "$prefix strip keeps PM-AFTER body"   "$strip_output" "PM-AFTER"
  assert_contains "$prefix strip keeps SOS-AFTER body"  "$strip_output" "SOS-AFTER"

  since_output="$("$wrapper" capture --since-marker MARKER-CAP "$prefix" 20 2>&1)"
  assert_contains "$prefix --since-marker keeps after1" "$since_output" "after1"
  assert_not_contains "$prefix --since-marker drops MARKER-CAP" "$since_output" "MARKER-CAP"
  assert_not_contains "$prefix --since-marker drops RED-LINE" "$since_output" "RED-LINE"

  json_output="$("$wrapper" capture --strip-ansi --since-marker MARKER-CAP --json "$prefix" 20 2>&1)"
  local marker_found stripped name_in_json
  marker_found="$(printf '%s' "$json_output" | jq -r .marker_found 2>/dev/null || echo "PARSE_FAIL")"
  stripped="$(printf '%s' "$json_output" | jq -r .stripped_ansi 2>/dev/null || echo "PARSE_FAIL")"
  name_in_json="$(printf '%s' "$json_output" | jq -r .name 2>/dev/null || echo "PARSE_FAIL")"
  local schema_ver
  schema_ver="$(printf '%s' "$json_output" | jq -r .schema_version 2>/dev/null || echo "PARSE_FAIL")"
  assert "$prefix --json marker_found" "$marker_found" "true"
  assert "$prefix --json stripped_ansi" "$stripped" "true"
  assert "$prefix --json name field" "$name_in_json" "$prefix"
  assert "$prefix --json schema_version=1" "$schema_ver" "1"

  # Marker not found
  local miss_output miss_found
  miss_output="$("$wrapper" capture --since-marker NOPE-NOT-THERE --json "$prefix" 20 2>&1)"
  miss_found="$(printf '%s' "$miss_output" | jq -r .marker_found 2>/dev/null || echo "PARSE_FAIL")"
  assert "$prefix --json marker_found=false when missing" "$miss_found" "false"

  # #P1 --tail alias: scan-anywhere (after <name>), leading, and equal to the
  # positional [lines]. lines_requested must reflect the --tail value.
  local tail_after tail_lead tail_lr
  tail_after="$("$wrapper" capture "$prefix" --tail 20 2>&1)"
  assert_contains "$prefix --tail after name works" "$tail_after" "MARKER-CAP"
  tail_lead="$("$wrapper" capture --tail 20 "$prefix" 2>&1)"
  assert_contains "$prefix --tail leading works" "$tail_lead" "after2"
  tail_lr="$("$wrapper" capture --tail 7 --json "$prefix" 2>&1 | jq -r .lines_requested 2>/dev/null || echo PARSE_FAIL)"
  assert "$prefix --tail sets lines_requested" "$tail_lr" "7"

  # --tail wins over positional [lines] and warns on stderr.
  local tail_over_err tail_over_lr
  tail_over_err="$("$wrapper" capture --tail 7 "$prefix" 20 2>&1 >/dev/null)"
  assert_contains "$prefix --tail overrides positional (warns)" "$tail_over_err" "overrides positional"
  tail_over_lr="$("$wrapper" capture --tail 7 --json "$prefix" 20 2>/dev/null | jq -r .lines_requested 2>/dev/null || echo PARSE_FAIL)"
  assert "$prefix --tail wins over positional value" "$tail_over_lr" "7"

  "$wrapper" stop "$prefix" >/dev/null 2>&1 || true
}

run_missing_value_reject() {
  local wrapper="$1" prefix="$2"
  echo "case: $prefix-missing-value ($wrapper, --since-marker without value)"
  local rc=0
  "$wrapper" capture --since-marker 2>/dev/null || rc=$?
  assert "$prefix-missing-value rejected" "$rc" "2"
  # #P1 --tail without a value must also reject with exit 2.
  local tail_rc=0
  "$wrapper" capture "$prefix" --tail 2>/dev/null || tail_rc=$?
  assert "$prefix --tail missing-value rejected" "$tail_rc" "2"
  # Non-numeric --tail reuses the existing lines validator (exit 2).
  local tail_bad_rc=0
  "$wrapper" capture "$prefix" --tail abc 2>/dev/null || tail_bad_rc=$?
  assert "$prefix --tail non-numeric rejected" "$tail_bad_rc" "2"
  # #P1 review F3: --tail= (empty value) must exit 2, not fall back to default.
  local tail_empty_rc=0
  "$wrapper" capture "$prefix" --tail= 2>/dev/null || tail_empty_rc=$?
  assert "$prefix --tail= empty rejected" "$tail_empty_rc" "2"
  # #P1 review F4: --since-marker may legally take the literal value "--tail";
  # the prepass must not steal it. Correct parse reaches session lookup (exit 1).
  local marker_rc=0
  "$wrapper" capture --since-marker --tail "$prefix-nosess" >/dev/null 2>&1 || marker_rc=$?
  assert "$prefix --since-marker keeps literal --tail" "$marker_rc" "1"
  # Flags other than --tail appearing AFTER <name> are rejected, not ignored.
  local after_rc=0
  "$wrapper" capture "$prefix-nosess" --json 2>/dev/null || after_rc=$?
  assert "$prefix flags-after-name rejected" "$after_rc" "2"
  # #P1 review F4 (round 2): the -- boundary must survive the global argv
  # prepass — tokens after it are positional and never mined for --tail.
  local bound_rc=0
  "$wrapper" capture -- "$prefix-nosess" --tail 7 2>/dev/null || bound_rc=$?
  assert "$prefix -- boundary keeps --tail positional (exit 2)" "$bound_rc" "2"
}

run_capture_variants "$CODEX_TMUX"  "CODEX"  "capture-codex"
run_capture_variants "$CLAUDE_TMUX" "CLAUDE" "capture-claude"
run_missing_value_reject "$CODEX_TMUX"  "codex"
run_missing_value_reject "$CLAUDE_TMUX" "claude"

echo
echo "summary: $PASS passed, $FAIL failed"
[[ $FAIL -eq 0 ]]
