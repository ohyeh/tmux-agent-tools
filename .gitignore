.DS_Store
*.swp
*.tmp

# Agent worktrees (issue #126 dispatch)
.claude/worktrees/
# macOS SMB transient files
**/.smbdelete*
.tmux-agent-result.json
# .claude: ignore local/runtime by default, but track shared artifacts
.claude/*
!.claude/handoffs/
!.claude/workflows/
skills/tmux-agent-tools-workspace/

# Personal agent-tmux profiles (live locally in ~/.config/agent-tmux/profiles/,
# never in this repo). Belt-and-suspenders: if a filled-in profile is ever
# copied here by mistake, ignore it. Only .conf.example templates are tracked.
skills/tmux-agent-tools/scripts/profiles/*.conf
!skills/tmux-agent-tools/scripts/profiles/*.conf.example
